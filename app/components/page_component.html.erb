<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10">
  <%= tag.div class: "mx-auto w-full #{@width} flex flex-col gap-5", data: { page: @width.delete_prefix("max-w-") }.merge(@data) do %>
    <% if intro? || actions? %>
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" data-page-header>
        <div class="min-w-0 text-body text-ink-700"><%= intro %></div>
        <% if actions? %><div class="flex flex-wrap items-center gap-2 shrink-0"><%= actions %></div><% end %>
      </div>
    <% end %>
    <%= content %>
  <% end %>
</div>
