<div class="bg-surface border border-line-soft rounded-card shadow-md overflow-hidden">
  <div class="overflow-x-auto px-7">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-line-soft">
          <th scope="col" class="<%= header_cell_classes %>">Nombre completo</th>
          <th scope="col" class="<%= header_cell_classes %>">Estaca / Distrito</th>
          <th scope="col" class="<%= header_cell_classes %> hidden lg:table-cell">Barrio / Rama</th>
          <% if @is_staff %>
            <th scope="col" class="<%= header_cell_classes %>">Rol</th>
          <% end %>
          <th scope="col" class="<%= header_cell_classes %> hidden lg:table-cell">Edad</th>
          <th scope="col" class="<%= header_cell_classes %> hidden xl:table-cell">Género</th>
          <th scope="col" class="<%= header_cell_classes %>">Compañía</th>
          <th scope="col" class="<%= header_cell_classes %> hidden lg:table-cell">Cuarto</th>
          <th scope="col" class="<%= header_cell_classes %>"><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line-soft">
        <% @participants.each do |participant| %>
          <tr class="hover:bg-primary-50/60 dark:hover:bg-muted/40 transition-colors">
            <td class="<%= cell_classes %>">
              <div class="flex items-center gap-3">
                <%= render(AvatarComponent.new(participant: participant)) %>
                <%= link_to participant.full_name,
                      participant_path(participant, from: from_path, return_to: request.fullpath),
                      data: { turbo_frame: "_top" },
                      class: "font-semibold text-ink-900 hover:text-primary-600 dark:hover:text-primary-300" %>
              </div>
            </td>
            <td class="<%= cell_classes %>">
              <%= render(StakeSpanComponent.new(stake: participant.stake, name: participant.stake_name)) %>
            </td>
            <td class="<%= cell_classes %> hidden lg:table-cell"><%= participant.ward_name || "—" %></td>
            <% if @is_staff %>
              <td class="<%= cell_classes %>">
                <%= render(RoleSpanComponent.new(role: participant.rol)) %>
              </td>
            <% end %>
            <td class="<%= cell_classes %> hidden lg:table-cell"><%= participant.age %></td>
            <td class="<%= cell_classes %> hidden xl:table-cell"><%= gender_label(participant) %></td>
            <td class="<%= cell_classes %>"><%= company_name(participant) %></td>
            <td class="<%= cell_classes %> hidden lg:table-cell">
              <% if participant.room.present? %>
                <span class="inline-flex px-2.5 py-0.5 rounded-[7px] bg-muted border border-line text-xs font-semibold"><%= participant.room %></span>
              <% else %>
                —
              <% end %>
            </td>
            <td class="py-2">
              <div class="flex justify-end gap-1">
                <%= link_to participant_path(participant, from: from_path, return_to: request.fullpath),
                      data: { turbo_frame: "_top" }, class: row_button_classes, title: "Ver perfil" do %>
                  <%= icon "eye", class: "w-[17px] h-[17px]" %>
                <% end %>
                <% if editable?(participant) %>
                  <%= link_to edit_participant_path(participant, from: from_path, return_to: request.fullpath),
                        data: { turbo_frame: "_top" }, class: row_button_classes, title: "Editar" do %>
                    <%= icon "square-pen", class: "w-[17px] h-[17px]" %>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
