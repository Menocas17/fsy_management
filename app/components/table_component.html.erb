<section class="mt-5">
  <div class="overflow-x-auto shadow-md rounded-lg border border-gray-200">
    <table class="w-full text-left border-collapse bg-white">
      <thead>
        <tr class="bg-primary-gradient text-center text-white">
          <th class="py-3 pl-5 md:pl-10 text-left">Nombre Completo</th>
          <th class="py-3 px-4 hidden sm:table-cell">Estaca</th>
          <th class="py-3 px-4 hidden lg:table-cell">Barrio</th>
          <% if @is_staff %>
            <th class="py-3 px-4">Rol</th>
          <% end %>
          <th class="py-3 px-4 hidden lg:table-cell">Edad</th>
          <th class="py-3 px-4 hidden lg:table-cell">Genero</th>
          <th class="py-3 px-4 <%= show_cell %>">Compania</th>
          <th class="py-3 px-4  hidden lg:table-cell">Cuarto</th>
          <th class="py-3 px-4 hidden lg:table-cell"></th>
          <% if isAdmin?%>
            <th class="py-3 px-4 hidden lg:table-cell"></th>
          <%end%>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm text-gray-600 text-center">
        <% @participants.each do |participant| %>
          <tr class="">
            <td class="py-3 px-4 font-medium text-blue-950 md:pl-10 ">
              <div class="flex items-center gap-2 ">
                <%= render (AvatarComponent.new(participant: participant)) %>
                <%= link_to participant.full_name, participant_path(participant, from: from_path, return_to: request.fullpath), data: { turbo_frame: "_top" } %>
              </div>
            </td>
            <td class="py-3 px-4 hidden sm:table-cell">
              <%= render(StakeSpanComponent.new(stake: participant.stake)) %>
            </td>
            <td class="py-3 px-4 hidden lg:table-cell">
              <%= participant.ward&.titleize %>
            </td>
            <% if @is_staff %>
              <td class="py-3 px-4">
                <%= render(RoleSpanComponent.new(role: participant.rol))%>
              </td>
            <% end %>
            <td class="py-3 px-4 hidden lg:table-cell">
              <%= participant.age %>
            </td>
            <td class="py-3 px-4 hidden lg:table-cell">
              <%= participant.genre.capitalize %>
            </td>
            <td class="py-3 px-4 <%= show_cell %>">
              Comp. <%= participant.company %>
            </td>
            <td class="py-3 px-4  hidden lg:table-cell">
              <div class="rounded-xl border border-slate-300 2xl:max-w-[60%] m-auto bg-slate-100 ">
                <%= participant.room %>
              </div>
            </td>
            <td>
              <%= link_to participant_path(participant, from: from_path, return_to: request.fullpath), data: { turbo_frame: "_top" }, class: "text-gray-900 underline hidden lg:table-cell" do %>
                <%= icon "eye", class: "text-gray-600 w-[22px] h-[22px] hover:text-blue-700 transition-all duration-300"%>
              <%end%>
            </td>
            <td>
              <% if isAdmin?%>
                <%= link_to edit_participant_path(participant, from: from_path, return_to: request.fullpath), data: { turbo_frame: "_top" }, class: "text-gray-900 underline hidden lg:table-cell" do %>
                  <%= icon "square-pen", class: "text-gray-600 w-[22px] h-[22px] hover:text-blue-700 transition-all duration-300"%>
                <%end%>
              <%end%>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>