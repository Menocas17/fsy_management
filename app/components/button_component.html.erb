<% if @is_submit %>
  <button type="submit" class="<%= styles %>">
    <div class="flex gap-1 items-center justify-center">
      <% if @icon %>
        <%= image_tag(@icon, class: "w-[15px] h-[15px]") %>
      <% end %>
      <span><%= @text %></span>
    </div>
  </button>
<% elsif @is_delete %>
  <%= button_to @url, method: :delete, data: { turbo_confirm: "Estas seguro que deseas borrar? Esta accion es irreversible" }, class: styles do %>
    <div class="flex gap-1 items-center justify-center">
      <% if @icon %>
        <%= image_tag(@icon, class: "w-[15px] h-[15px]") %>
      <% end %>
      <span><%= @text %></span>
    </div>
  <% end %>
<% elsif @is_button %>
  <button type="button" class="<%= styles %>">
    <div class="flex gap-1 items-center justify-center">
      <% if @icon %>
        <%= image_tag(@icon, class: "w-[15px] h-[15px]") %>
      <% end %>
      <span><%= @text %></span>
    </div>
  </button>
<% elsif @is_nav && disabled? %>
  <span aria-disabled="true" class="text-gray-400 dark:text-slate-500 cursor-not-allowed <%= styles %>">
    <div class="flex gap-4 items-center">
      <% if @secondary_icon.present? %>
        <%= image_tag(@secondary_icon, class: "w-[20px] h-[20px] opacity-50") %>
      <% end %>
      <span><%= @text %></span>
    </div>
  </span>
<% elsif @is_nav %>
  <%= link_to @url, class: "#{active_classes} #{styles}" do %>
    <div class="flex gap-4 items-center">
      <% if current_icon.present? %>
        <%= image_tag(current_icon, class: "w-[20px] h-[20px]") %>
      <% end %>
      <span><%= @text %></span>
    </div>
  <% end %>
<% else %>
  <%= link_to @url, class: styles do %>
    <div class="flex gap-3 items-center">
      <% if @icon %>
        <%= image_tag(@icon, class: "w-[20px] h-[20px]") %>
      <% end %>
      <span><%= @text %></span>
    </div>
  <% end %>
<% end %>