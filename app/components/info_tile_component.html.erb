<div class="mb-5 ">
  <dt class="">
    <div class="flex gap-1.5 items-center">
      <%= helpers.icon(@icon, class: "w-[18px] h-[18px] text-primary-500 dark:text-primary-300") %>
      <span class="text-gray-600 dark:text-slate-400 text-sm"><%= @title%></span>
    </div>
  </dt>
  <% value.each do |val| %>
    <dd class="font-semibold text-gray-900 dark:text-slate-100 text-sm break-all <%= text_alignment(@title) %>"><%= val%></dd>
  <% end %>
</div>
