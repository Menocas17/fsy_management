<div class="mb-5 ">
  <dt class="">
    <div class="flex gap-1 items-center">
      <%= image_tag(@icon, class: "w-[25px] h-[25px]")%>
      <span class="text-gray-600 text-sm"><%= @title%></span>
    </div>
  </dt>
  <% value.each do |val| %>
    <dd class="font-semibold text-gray-900 text-sm break-all <%= text_alignment(val) %>"><%= val%></dd>
  <% end %>
</div>