<label for="<%= @id %>" class="flex items-center justify-between gap-4 cursor-pointer">
  <span class="pr-4">
    <span class="block text-sm font-semibold text-ink-900 dark:text-slate-100"><%= @label %></span>
    <% if @description.present? %>
      <span class="block text-[12.5px] text-ink-500 dark:text-slate-400 mt-0.5"><%= @description %></span>
    <% end %>
  </span>
  <span class="relative inline-flex items-center shrink-0">
    <%= tag.input type: "checkbox", id: @id, class: "sr-only peer", data: input_data %>
    <span class="w-[42px] h-6 bg-line dark:bg-slate-600 rounded-full transition-colors peer-checked:bg-primary-600
                 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary-500
                 after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:shadow-sm
                 after:h-5 after:w-5 after:transition-all peer-checked:after:translate-x-[18px]"></span>
  </span>
</label>
