<%
  url = item.persisted? ? inventory_item_path(item) : inventory_items_path(inventory)
%>
<%= form_with model: item, url: url, class: "space-y-5" do |form| %>
  <% if item.errors.any? %>
    <div class="rounded-[14px] border border-cat-rose/30 bg-cat-rose/10 px-5 py-3 text-sm font-semibold text-cat-rose" role="alert">
      <% item.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <section class="<%= card_classes("p-5 md:p-6") %>">
    <%= section_heading "Datos del artículo", "package" %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
      <div class="sm:col-span-2">
        <%= form.label :name, "Nombre", class: field_label_classes %>
        <%= form.text_field :name, required: true, maxlength: 80, placeholder: "Ej. Manillas de tela", class: field_input_classes %>
      </div>
      <div>
        <%= form.label :unit, "Unidad", class: field_label_classes %>
        <%= form.text_field :unit, required: true, maxlength: 12, placeholder: "u, cajas, litros", class: field_input_classes %>
      </div>
      <div>
        <%= form.label :minimum, "Mínimo antes de avisar", class: field_label_classes %>
        <%= form.number_field :minimum, min: 0, step: 1, class: field_input_classes %>
        <p class="mt-1.5 text-[11.5px] font-medium text-ink-500 dark:text-slate-400">Por debajo de esto el artículo se marca «por agotarse».</p>
      </div>
      <% unless item.persisted? %>
        <div>
          <%= label_tag "inventory_item[starting_quantity]", "Existencia inicial", class: field_label_classes %>
          <%= number_field_tag "inventory_item[starting_quantity]", 0, min: 0, step: 1, class: field_input_classes %>
          <p class="mt-1.5 text-[11.5px] font-medium text-ink-500 dark:text-slate-400">Queda registrada como el primer movimiento del artículo.</p>
        </div>
      <% end %>
      <div>
        <%= form.label :location, "Ubicación", class: field_label_classes %>
        <%= form.text_field :location, maxlength: 60, placeholder: "Ej. Bodega 2, estante A", class: field_input_classes %>
      </div>
      <div class="sm:col-span-2">
        <%= form.label :notes, "Notas", class: field_label_classes %>
        <%= form.text_area :notes, rows: 3, class: field_textarea_classes %>
      </div>
    </div>
    <% if item.persisted? %>
      <p class="mt-4 px-3.5 py-2.5 rounded-[11px] bg-canvas dark:bg-slate-900 text-[12.5px] font-semibold text-ink-500 dark:text-slate-400">
        La existencia (<%= item.quantity_label %>) no se edita acá: se mueve con los ajustes, y así queda el registro de quién y por qué.
      </p>
    <% end %>
  </section>

  <div class="<%= card_classes("px-5 py-4 flex gap-2.5 sm:justify-end") %>">
    <%= link_to "Cancelar", item.persisted? ? item : inventory,
          class: "flex-1 sm:flex-none inline-flex items-center justify-center h-10 px-4 rounded-[11px] border border-line dark:border-slate-600 bg-surface dark:bg-slate-800 text-sm font-semibold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 transition" %>
    <%= form.submit item.persisted? ? "Guardar cambios" : "Agregar artículo",
          class: "flex-1 sm:flex-none inline-flex items-center justify-center h-10 px-5 rounded-[11px] bg-primary-700 text-sm font-semibold text-white shadow-sm hover:bg-primary-800 transition cursor-pointer" %>
  </div>
<% end %>
