<% content_for :title, @item.name %>
<% content_for :eyebrow, @inventory.name %>
<% back_to @inventory.name, inventory_path(@inventory) %>
<%
  secondary = "inline-flex items-center gap-2 h-10 px-3.5 rounded-[11px] border border-line dark:border-slate-600 bg-surface dark:bg-slate-800 text-[13px] font-semibold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 transition"
%>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-6xl mx-auto"
     data-controller="inventory-adjust" data-inventory-adjust-auto-open-value="<%= params[:ajuste].present? %>">
  <%# El enlace de volver vive en la barra superior, igual que en el resto de las vistas. %>
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] gap-5 items-start">
    <div class="space-y-5">
      <section class="<%= card_classes("p-5 md:p-6") %>">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0">
            <h1 class="text-[21px] font-extrabold tracking-tight text-ink-900 dark:text-slate-100"><%= @item.name %></h1>
            <p class="mt-1 text-[12.5px] font-semibold text-ink-500 dark:text-slate-400">
              <%= @inventory.name %> · <span class="font-mono"><%= @item.code %></span>
              <%= " · #{@item.location}" if @item.location.present? %>
            </p>
          </div>
          <%= inventory_status_chip(@item) %>
        </div>

        <div class="mt-5 grid grid-cols-2 sm:grid-cols-3 gap-3">
          <div class="rounded-[13px] border border-line-soft dark:border-slate-700 px-4 py-3">
            <p class="text-[26px] font-extrabold leading-none tabular-nums text-ink-900 dark:text-slate-100" data-item-quantity><%= @item.quantity %></p>
            <p class="mt-1 text-[11.5px] font-bold text-ink-500 dark:text-slate-400">en existencia (<%= @item.unit %>)</p>
          </div>
          <div class="rounded-[13px] border border-line-soft dark:border-slate-700 px-4 py-3">
            <p class="text-[26px] font-extrabold leading-none tabular-nums text-ink-700 dark:text-slate-300"><%= @item.minimum %></p>
            <p class="mt-1 text-[11.5px] font-bold text-ink-500 dark:text-slate-400">mínimo</p>
          </div>
          <div class="rounded-[13px] border border-line-soft dark:border-slate-700 px-4 py-3">
            <p class="text-[26px] font-extrabold leading-none tabular-nums text-ink-700 dark:text-slate-300"><%= @item.movements.size %></p>
            <p class="mt-1 text-[11.5px] font-bold text-ink-500 dark:text-slate-400">movimientos</p>
          </div>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          <% [ [ "1", "plus", "Sumar", "bg-cat-green" ], [ "-1", "minus", "Restar", "bg-cat-rose" ] ].each do |sign, icon_name, label, tone| %>
            <button type="button" data-action="inventory-adjust#open" data-adjust-item="<%= @item.name %>"
                    data-adjust-code="<%= @item.code %>" data-adjust-inventory="<%= @inventory.name %>"
                    data-adjust-stock="<%= @item.quantity %>" data-adjust-unit="<%= @item.unit %>"
                    data-adjust-sign="<%= sign %>" data-adjust-source="<%= params[:origen] == 'escaneo' ? 'escaneo' : 'manual' %>"
                    data-adjust-url="<%= inventory_item_movements_path(@item) %>"
                    class="inline-flex items-center gap-2 h-10 px-5 rounded-[11px] <%= tone %> text-sm font-semibold text-white shadow-sm hover:opacity-90 cursor-pointer transition">
              <%= icon icon_name, class: "w-4 h-4" %>
              <%= label %>
            </button>
          <% end %>
          <%= link_to edit_inventory_item_path(@item), class: secondary do %>
            <%= icon "square-pen", class: "w-4 h-4" %>
            Editar artículo
          <% end %>
        </div>

        <% if @item.notes.present? %>
          <p class="mt-4 text-[13px] leading-relaxed text-ink-700 dark:text-slate-300"><%= @item.notes %></p>
        <% end %>
      </section>

      <section class="<%= card_classes("p-5 md:p-6") %>">
        <%= section_heading "Movimientos", "arrow-down-up" %>
        <% if @movements.any? %>
          <ul class="divide-y divide-line-soft dark:divide-slate-700">
            <% @movements.each do |movement| %>
              <li class="flex items-start gap-3 py-3 first:pt-0 last:pb-0">
                <span class="w-[52px] shrink-0 text-center py-1.5 rounded-[9px] text-[13.5px] font-extrabold tabular-nums <%= movement.adds? ? 'text-cat-green bg-cat-green/10' : 'text-cat-rose bg-cat-rose/10' %>">
                  <%= movement.delta_label %>
                </span>
                <div class="min-w-0">
                  <p class="text-[13px] font-semibold text-ink-900 dark:text-slate-100"><%= movement.reason_label %></p>
                  <p class="mt-0.5 text-[11.5px] font-semibold text-ink-500 dark:text-slate-400">
                    <%= SpanishDates.short_with_time(movement.created_at) %> · <%= movement.participant_name %><%= " · escaneado" if movement.source_escaneo? %>
                  </p>
                  <% if movement.note.present? %>
                    <p class="mt-0.5 text-[12px] text-ink-500 dark:text-slate-400"><%= movement.note %></p>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-[13px] text-ink-500 dark:text-slate-400">Todavía no hay movimientos de este artículo.</p>
        <% end %>
      </section>
    </div>

    <section class="<%= card_classes("p-5 md:p-6 flex flex-col items-center text-center gap-3") %>">
      <%= inventory_qr_tag(@item) %>
      <div>
        <p class="text-[13.5px] font-extrabold font-mono text-ink-900 dark:text-slate-100"><%= @item.code %></p>
        <p class="mt-1 text-[11.5px] font-semibold text-ink-500 dark:text-slate-400">Pegá este código en la caja</p>
      </div>
      <%= link_to labels_reports_path(inventory: @inventory.id), target: "_blank", rel: "noopener", class: "#{secondary} w-full justify-center" do %>
        <%= icon "printer", class: "w-4 h-4" %>
        Imprimir etiquetas
      <% end %>
    </section>
  </div>

  <%= render "inventories/adjust_dialog" %>
</div>
