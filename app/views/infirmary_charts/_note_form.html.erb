<%# Agregar a la ficha clínica de una visita (solo enfermería): una nota o un medicamento que se le dio y, si se
    tomaron, sus signos vitales (desplegables: no siempre se toman). Un medicamento se elige del inventario de
    enfermería con su cantidad, y al guardar se descuenta de ahí (InfirmaryNote#save_with_doses). Mostrar el
    selector, buscar y armar las filas lo hace infirmary_note_controller.js. %>
<%= form_with model: note, url: infirmary_visit_notes_path(visit), class: "m-5 mt-1 p-4 rounded-tile border border-line bg-canvas flex flex-col gap-3",
      data: { infirmary_note_form: visit.id, controller: "infirmary-note" } do |form| %>
  <% if note.errors.any? %>
    <p class="text-label font-semibold text-cat-rose-ink" role="alert" data-infirmary-note-errors><%= note.errors.full_messages.to_sentence %></p>
  <% end %>
  <fieldset class="flex flex-wrap gap-1.5">
    <legend class="sr-only">¿Qué anotas?</legend>
    <% [ [ false, "Nota", "notebook-pen" ], [ true, "Medicamento", "pill" ] ].each do |value, label, icon_name| %>
      <label class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full border border-line bg-surface text-label font-bold text-ink-700 cursor-pointer transition
                    hover:bg-muted has-[:checked]:bg-primary-700 has-[:checked]:border-primary-700 has-[:checked]:text-white
                    has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-primary-500">
        <%= form.radio_button :medication, value, id: "note_#{visit.id}_#{label.downcase}", class: "sr-only",
              data: { action: "infirmary-note#mode", medication_toggle: value } %>
        <%= icon icon_name, class: "w-3.5 h-3.5" %>
        <%= label %>
      </label>
    <% end %>
  </fieldset>

  <div class="flex flex-col gap-2" data-infirmary-note-target="medicines" data-medicine-panel <%= "hidden" unless note.medication? %>>
    <% if @medicines.any? %>
      <div class="relative">
        <label for="medicine_query_<%= visit.id %>" class="sr-only">Buscar medicamento</label>
        <%= icon "search", class: "absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-ink-500 pointer-events-none" %>
        <input type="search" id="medicine_query_<%= visit.id %>" placeholder="Buscar medicamento…" autocomplete="off"
               data-infirmary-note-target="query" data-action="input->infirmary-note#filter keydown->infirmary-note#pickFirst"
               class="<%= field_input_classes %> pl-9">
      </div>
      <ul class="max-h-52 overflow-y-auto rounded-control border border-line bg-surface divide-y divide-line-soft" aria-label="Medicamentos del inventario">
        <% @medicines.each do |item| %>
          <li data-infirmary-note-target="option" data-id="<%= item.id %>" data-search="<%= "#{item.name} #{item.code}" %>">
            <button type="button" data-action="infirmary-note#add" <%= "disabled" if item.out? %>
                    data-id="<%= item.id %>" data-name="<%= item.name %>" data-unit="<%= item.unit %>" data-stock="<%= item.quantity %>"
                    data-medicine-option="<%= item.code %>"
                    class="w-full flex items-center gap-3 px-3 py-2.5 text-left cursor-pointer hover:bg-canvas transition-colors disabled:cursor-not-allowed disabled:opacity-55 focus:outline-none focus-visible:bg-canvas">
              <span class="min-w-0 flex-1">
                <span class="block text-body font-bold text-ink-900 truncate"><%= item.name %></span>
                <span class="block text-meta font-semibold text-ink-500 truncate"><%= [ item.code, item.location.presence ].compact.join(" · ") %></span>
              </span>
              <% if item.out? %>
                <%= render ChipComponent.new(label: "Agotado", tone: :rose) %>
              <% else %>
                <%= render ChipComponent.new(label: item.quantity_label, tone: item.low? ? :amber : :neutral) %>
                <%= icon "plus", class: "w-4 h-4 shrink-0 text-primary-700 dark:text-primary-300" %>
              <% end %>
            </button>
          </li>
        <% end %>
      </ul>
      <p class="text-label text-ink-500" data-infirmary-note-target="noMatch" hidden>Ningún medicamento coincide.</p>

      <ul class="flex flex-col gap-2" data-infirmary-note-target="chosen" aria-label="Medicamentos que se le dan">
        <% note.pending_doses.each do |item, quantity| %>
          <%= render "infirmary_charts/dose_row", item_id: item.id, name: item.name, unit: item.unit, stock: item.quantity, quantity: quantity %>
        <% end %>
      </ul>
      <template data-infirmary-note-target="template">
        <%= render "infirmary_charts/dose_row", item_id: "", name: "", unit: "", stock: 0, quantity: 1 %>
      </template>
    <% else %>
      <p class="flex items-start gap-2.5 rounded-tile bg-surface border border-line-soft px-3.5 py-3 text-label text-ink-700" data-no-medicines>
        <%= icon "boxes", class: "w-4 h-4 shrink-0 mt-px" %>
        Todavía no hay un inventario de enfermería: escribe el medicamento y la dosis en la nota. Se crea en Inventario, marcándolo «Inventario de enfermería».
      </p>
    <% end %>
  </div>

  <%= form.label :body, "Nota", for: "note_body_#{visit.id}", class: "sr-only" %>
  <%= form.text_area :body, id: "note_body_#{visit.id}", rows: 2, maxlength: 2000, class: field_textarea_classes,
        placeholder: note.medication? ? "Notas adicionales (opcional)…" : "Qué observaste…",
        data: { infirmary_note_target: "body", placeholder_note: "Qué observaste…",
                placeholder_medication: @medicines.any? ? "Notas adicionales (opcional)…" : "Medicamento y dosis…" } %>
  <details class="group" <%= "open" if note.vitals.present? %>>
    <summary class="inline-flex items-center gap-1.5 text-label font-bold text-primary-700 dark:text-primary-300 cursor-pointer list-none">
      <%= icon "thermometer", class: "w-4 h-4" %>
      Signos vitales
      <%= icon "chevron-down", class: "w-4 h-4 transition-transform group-open:rotate-180" %>
    </summary>
    <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-2">
      <% InfirmaryNote::VITALS.each do |key, meta| %>
        <div>
          <%= form.label key, "#{meta[:label]} (#{meta[:unit]})", for: "note_#{visit.id}_#{key}", class: "block mb-1 text-meta font-bold text-ink-500" %>
          <%= form.text_field key, id: "note_#{visit.id}_#{key}", maxlength: 12, inputmode: (key == "blood_pressure" ? "text" : "decimal"),
                placeholder: { "temperature" => "37.5", "heart_rate" => "80", "blood_pressure" => "110/70", "oxygen" => "98" }[key],
                class: field_input_classes %>
        </div>
      <% end %>
    </div>
  </details>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="text-label text-ink-500">Queda con tu nombre y la hora; no se edita.</p>
    <button type="submit" data-turbo-submits-with="Guardando…" class="<%= button_classes(size: :sm) %>">Agregar a la ficha</button>
  </div>
<% end %>
