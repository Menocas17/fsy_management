<%
  # Alergias, dietas y medicinas viven en cada ficha; sumadas aquí, la cocina y la enfermería las ven de un vistazo.
  cells = [
    { key: "allergies", value: special_care[:allergies], label: "con alergias", icon: "heart-pulse", tone: :rose },
    { key: "diet", value: special_care[:diet], label: "con dieta especial", icon: "salad", tone: :green },
    { key: "medicines", value: special_care[:medicines], label: "toman medicinas", icon: "pill", tone: :blue }
  ]
%>
<section class="<%= card_classes("p-5 md:p-6") %>" data-care>
  <%= section_heading "Atenciones especiales", "heart-pulse", tone: :rose %>

  <%# Cada número abre la lista de jóvenes ya filtrada: de la cifra a los nombres en un clic. %>
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    <% cells.each do |cell| %>
      <%= render StatTileComponent.new(value: cell[:value], label: cell[:label], icon: cell[:icon], tone: cell[:tone], size: :sm,
            href: participants_path(care: cell[:key]), data: { care_link: cell[:key] }, value_data: { care_count: cell[:key] }) %>
    <% end %>
  </div>

  <% if dining_halls.any? %>
    <div class="mt-3 grid grid-cols-2 gap-3">
      <% dining_halls.each do |hall, count| %>
        <%= render StatTileComponent.new(value: count, label: hall, icon: "hand-platter", tone: :amber, size: :sm, data: { dining_hall: hall }) %>
      <% end %>
    </div>
  <% end %>

  <p class="mt-3 text-label font-medium text-ink-500">
    Cuenta a los jóvenes cuya ficha trae algo que atender; «Ninguna» o «Sin restricciones» no suman.
  </p>
</section>
