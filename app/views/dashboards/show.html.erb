<% content_for :title, "Panel general" %>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 space-y-5 md:space-y-6">
  <section class="relative overflow-hidden rounded-[22px] bg-hero shadow-lg px-6 py-7 md:px-10 md:py-9">
    <svg class="absolute inset-0 w-full h-full opacity-50 pointer-events-none" aria-hidden="true">
      <defs>
        <pattern id="hero-dots" width="34" height="34" patternUnits="userSpaceOnUse">
          <circle cx="1.2" cy="1.2" r="1.2" fill="rgb(255 255 255 / 0.14)"></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-dots)"></rect>
    </svg>
    <div class="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div class="max-w-xl">
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-white/15 border border-white/20 text-white text-[11px] font-bold tracking-[.06em] uppercase">FSY 2026 · Managua-Caribe</span>
        <h1 class="mt-4 text-2xl md:text-[32px] font-extrabold leading-tight tracking-tight text-white">Todo el registro del evento, en un solo lugar</h1>
        <figure class="mt-4 rounded-[14px] bg-white/10 border border-white/15 px-5 py-4">
          <blockquote class="text-[13px] md:text-[14.5px] leading-relaxed italic text-white/90">
            “He aquí mi Espíritu reposa sobre ti; por consiguiente justificaré todas tus palabras; y las montañas huirán de tu presencia, y los ríos se desviarán de su cauce; y tú permanecerás en mí, y yo en ti; por tanto, anda conmigo.”
          </blockquote>
          <figcaption class="mt-2.5 text-[11px] font-bold tracking-[.05em] uppercase text-white/70">Moisés 6:34</figcaption>
        </figure>
      </div>
      <% if Current.user&.admin_or_staff_manager? %>
        <%= link_to new_participant_path, class: "inline-flex items-center justify-center gap-2 rounded-[11px] bg-white px-5 py-2.5 text-sm font-semibold text-primary-800 shadow-sm hover:bg-primary-50 transition shrink-0" do %>
          <%= icon "plus", class: "w-4 h-4" %>
          Nuevo participante
        <% end %>
      <% end %>
    </div>
  </section>

  <%= render "main_kpis", total_jovenes: @dashboard.total_jovenes, total_participants: @dashboard.total_participants, total_staff: @dashboard.total_staff %>
  <%= render "main_charts", count_by_stake: @dashboard.count_by_stake, count_by_role: @dashboard.count_by_role %>
  <%= render "secondary_charts", data_by_age: @dashboard.participants_by_age, shirt_counts: @dashboard.shirt_count, male_count: @dashboard.male_count, female_count: @dashboard.female_count %>
</div>
