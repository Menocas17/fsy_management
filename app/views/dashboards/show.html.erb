<div class="relative">
  <div class="h-40 md:h-50 w-full bg-cover bg-center rounded-b-xl flex justify-center lg:justify-end items-end shadow-lg lg:shadow-none" 
       style="background-image: url('<%= image_path('top-header-4.png') %>');">
    <%if Current.user&.admin_or_staff_manager?%>
      <%= render(ButtonComponent.new(text:"Nuevo Participante", url: new_participant_path, type:"primary", classes:"!bg-white/25 hover:!bg-white/50 transition-all duration-300 !border-0 mb-4 lg:mb-18 lg:mr-10"))%>
    <%end%>
  </div>
  <div class="m-auto mt-8 lg:mt-0 lg:absolute top-40 w-full px-7">
    <%= render "main_kpis", total_jovenes: @dashboard.total_jovenes, total_participants: @dashboard.total_participants, total_staff: @dashboard.total_staff %>
  </div>
</div>
<div class="lg:mt-25 sm:px-2 md:px-7">
  <%= render "main_charts", count_by_stake: @dashboard.count_by_stake, count_by_role: @dashboard.count_by_role%>
  <%= render "secondary_charts", data_by_age: @dashboard.participants_by_age, shirt_counts: @dashboard.shirt_count, male_count: @dashboard.male_count, female_count: @dashboard.female_count%>
</div>
