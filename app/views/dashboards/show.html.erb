<% content_for :title, "Panel general" %>
<% content_for :eyebrow, "Panel general" %>
<% content_for :heading, "Bienvenido de nuevo" %>
<% content_for :page_h1, true %>
<%= render PageComponent.new(width: :page, banner: true, data: { controller: "dashboard-entrance" }) do %>
  <%# El banner de la cuenta regresiva queda tal cual: es la única pieza fuera de la guía, a propósito. %>
  <%# En el teléfono el banner llena la primera pantalla (la altura visible menos la barra de 60px, el relleno de
      arriba de la página, 12px, y 16px de aire): según el teléfono se asomaban solo los iconos de los KPI, que parecían
      un menú inferior. Así los KPI empiezan siempre bajo el borde, y los atajos quedan abajo, a mano del pulgar. %>
  <section class="relative overflow-hidden rounded-panel bg-hero shadow-lg px-6 py-7 md:px-10 md:py-9 max-sm:flex max-sm:flex-col max-sm:min-h-[calc(100dvh-88px)]" data-entrance="hero">
    <%# La luz del sol detrás de la cuenta regresiva: en la entrada del panel sube como un amanecer. %>
    <span class="hero-sunglow" aria-hidden="true" data-entrance="sunglow"></span>
    <%# El lockup oficial ocupa el aire de la derecha; donde no cabe, el mismo texto queda en la píldora. %>
    <%= image_tag "fsy-lettering.png", alt: "#{Rails.configuration.x.event_name} · Nicaragua #{Rails.configuration.x.event_region}", aria: { hidden: true },
          data: { hero_lettering: true },
          class: "hidden lg:block absolute top-10 right-12 xl:top-10 xl:right-12 w-[220px] xl:w-[270px] opacity-50 pointer-events-none select-none" %>
    <div class="relative flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 max-sm:flex-1">
      <div class="max-w-xl">
        <span class="lg:hidden inline-flex items-center px-3 py-1 rounded-full bg-white/15 border border-white/20 text-white text-[11px] font-bold tracking-[.06em] uppercase"><%= Rails.configuration.x.event_name %> · <%= Rails.configuration.x.event_region %></span>
        <% countdown = event_countdown %>
        <%# El título de la página es estable; la cuenta regresiva cambia cada segundo y no debe ser el h1. %>
        <h1 class="sr-only">Inicio · <%= Rails.configuration.x.event_name %></h1>
        <div class="mt-4" data-controller="countdown" data-countdown-starts-at-value="<%= event_start_at.iso8601 %>">
          <% if countdown[:started] %>
            <span class="block text-2xl md:text-[32px] font-extrabold leading-tight tracking-tight text-white [--entrance-at:180ms]" data-entrance="rise">¡El FSY ya comenzó!</span>
          <% else %>
            <span class="sr-only">Faltan <%= countdown[:days] %> días, <%= countdown[:hours] %> horas y <%= countdown[:minutes] %> minutos para el inicio del FSY</span>
            <span class="block text-[13px] md:text-sm font-bold tracking-[.08em] uppercase text-sun" data-entrance="kicker">Faltan para el inicio</span>
            <%# En el teléfono, cuatro columnas iguales que nunca se parten: números y etiquetas escalan con el
                ancho de la pantalla (vw), no con la escala de texto móvil, que ensanchaba «SEGUNDOS» y en
                pantallas de ~384px (Galaxy A56) mandaba el último bloque a otra línea. %>
            <span class="mt-2.5 grid grid-cols-4 gap-1 max-w-sm sm:flex sm:flex-nowrap sm:gap-x-6 sm:max-w-none" aria-hidden="true">
              <%# Cada número en su ventana (overflow-hidden): entra rodando como un marcador y cada cambio sube. %>
              <% [ [ :days, "Días" ], [ :hours, "Horas" ], [ :minutes, "Minutos" ], [ :seconds, "Segundos" ] ].each_with_index do |(key, label), index| %>
                <span class="min-w-0 flex flex-col items-center text-center">
                  <span class="block overflow-hidden">
                    <span class="block text-[clamp(26px,9vw,34px)] md:text-[44px] font-extrabold leading-none tracking-tight text-white tabular-nums whitespace-nowrap"
                          style="--entrance-at: <%= 180 + index * 50 %>ms" data-entrance="digits"
                          data-countdown-target="<%= key %>"><%= key == :days ? countdown[key] : format("%02d", countdown[key]) %></span>
                  </span>
                  <span class="mt-1.5 text-[clamp(9.5px,2.7vw,11px)] font-bold tracking-[.03em] sm:tracking-[.08em] uppercase text-white/70 whitespace-nowrap"><%= label %></span>
                </span>
              <% end %>
            </span>
          <% end %>
        </div>
        <p class="mt-3 text-[13px] font-semibold text-white/80 [--entrance-at:300ms]" data-entrance="rise">Comienza el <%= event_start_label %></p>
        <figure class="mt-4 rounded-tile bg-white/10 border border-white/15 px-5 py-4 [--entrance-at:360ms]" data-entrance="rise">
          <blockquote class="text-[13px] md:text-[14.5px] leading-relaxed italic text-white/90">
            “He aquí mi Espíritu reposa sobre ti; por consiguiente justificaré todas tus palabras; y las montañas huirán de tu presencia, y los ríos se desviarán de su cauce; y tú permanecerás en mí, y yo en ti; por tanto, anda conmigo.”
          </blockquote>
          <figcaption class="mt-2.5 text-[11px] font-bold tracking-[.05em] uppercase text-white/70">Moisés 6:34</figcaption>
        </figure>
      </div>
      <%
        # En móvil los atajos se apilan a lo ancho, así los dos quedan del mismo tamaño.
        shortcut_base = "inline-flex items-center justify-center gap-2 w-full sm:w-auto rounded-control px-5 py-2.5 text-sm font-semibold transition"
        shortcut_primary = "#{shortcut_base} bg-white text-primary-800 shadow-sm hover:bg-primary-50"
      %>
      <%# En los teléfonos altos sobra aire en el banner: lo llena «Lo que sigue», la próxima fecha (la misma de
          «Próximas fechas», más abajo), y una segunda y una tercera mientras sobre aire. Por alto de pantalla: por
          debajo de cada umbral no caben sin empujar los KPI a la vista. %>
      <% hero_next = next_up_items(@dashboard.next_activities) %>
      <% row_visibility = [ "flex", "hidden [@media(min-height:830px)]:flex", "hidden [@media(min-height:890px)]:flex" ] %>
      <% if hero_next.any? %>
        <div class="hidden max-sm:[@media(min-height:770px)]:block max-sm:-mt-2 rounded-tile bg-white/10 border border-white/15 px-4 py-3.5 [--entrance-at:400ms]" data-hero-next data-entrance="rise">
          <div class="flex items-center justify-between gap-3 mb-2.5">
            <span class="text-[11px] font-bold tracking-[.08em] uppercase text-white/70">Lo que sigue</span>
            <%= link_to "Ver agenda ›", agenda_path, class: "text-label font-bold text-sun hover:underline" %>
          </div>
          <% hero_next.each_with_index do |item, index| %>
            <%= link_to item[:url], data: { hero_next_item: item[:key] },
                  class: "#{row_visibility[index]} #{"mt-2.5 pt-2.5 border-t border-white/10" unless index.zero?} items-center gap-3 rounded-inner" do %>
              <span class="w-[38px] h-[38px] shrink-0 rounded-tile flex items-center justify-center <%= item[:tone] == :amber ? "bg-sun/20 text-sun" : "bg-white/15 text-white" %>">
                <%= icon item[:icon], class: "w-[18px] h-[18px]" %>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold leading-tight text-white truncate"><%= item[:title] %></span>
                <span class="block text-[12px] font-medium text-white/70 truncate"><%= item[:meta] %></span>
              </span>
              <% if (label = countdown_label(item[:days])) %>
                <span class="shrink-0 px-2 py-0.5 rounded-full bg-sun/20 text-[11px] font-bold text-sun whitespace-nowrap"><%= label.sub(/\AFaltan? /, "") %></span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% end %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-2.5 w-full lg:w-auto shrink-0 max-sm:mt-auto [--entrance-at:420ms]" data-entrance="rise">
        <% if can_create_participants? %>
          <%= link_to new_participant_path, class: shortcut_primary do %>
            <%= icon "plus", class: "w-4 h-4" %>
            Nuevo participante
          <% end %>
          <%= link_to scan_path, data: { shortcut: "qr" },
                class: "#{shortcut_base} border border-white/25 bg-white/10 text-white hover:bg-white/20" do %>
            <%= icon "scan-qr-code", class: "w-4 h-4" %>
            Escanear QR
          <% end %>
        <% else %>
          <% if (my_company = my_company_link) %>
            <%= link_to my_company, data: { shortcut: "my-company" }, class: shortcut_primary do %>
              <%= icon "building-2", class: "w-4 h-4" %>
              Ver mi compañía
            <% end %>
          <% end %>
          <%# Quien no registra a nadie muestra su propio código: el mismo del gafete, por si no lo trae puesto. %>
          <% if (me = Current.user&.participant) %>
            <div data-controller="dialog" class="contents">
              <button type="button" data-action="dialog#open" data-dialog-name="qr" data-shortcut="my-qr"
                      class="<%= shortcut_base %> <%= my_company ? "border border-white/25 bg-white/10 text-white hover:bg-white/20" : "bg-white text-primary-800 shadow-sm hover:bg-primary-50" %> cursor-pointer">
                <%= icon "qr-code", class: "w-4 h-4" %>
                Mi código QR
              </button>
              <%= render "participants/qr_dialog", participant: me %>
            </div>
          <% end %>
          <%# Ver la ficha de cualquiera escaneando su gafete (un consejero con un joven que no conoce). Solo
              abre la ficha: registrar llegadas sigue siendo del registro. %>
          <%= link_to scan_path, data: { shortcut: "qr" },
                class: "#{shortcut_base} border border-white/25 bg-white/10 text-white hover:bg-white/20" do %>
            <%= icon "scan-qr-code", class: "w-4 h-4" %>
            Escanear gafete
          <% end %>
        <% end %>
      </div>
    </div>
  </section>

  <%= render "main_kpis", total_jovenes: @dashboard.total_jovenes, total_participants: @dashboard.total_participants, total_staff: @dashboard.total_staff %>
  <%# Primero lo que viene y lo que la cocina necesita saber; después el análisis. %>
  <%= render "next_up", next_activities: @dashboard.next_activities %>
  <% if can_view_reports? || can_view_inventory? %>
    <%= render "care", special_care: @dashboard.special_care, dining_halls: @dashboard.jovenes_by_dining_hall %>
  <% end %>
  <%= render "main_charts", count_by_stake: @dashboard.count_by_stake, count_by_role: @dashboard.count_by_role %>
  <%= render "secondary_charts", data_by_age: @dashboard.participants_by_age, shirt_counts: @dashboard.shirt_count, male_count: @dashboard.male_count, female_count: @dashboard.female_count %>
<% end %>
