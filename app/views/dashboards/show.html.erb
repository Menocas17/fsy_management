<div class="relative">
  <div class="h-50 w-full bg-cover bg-center rounded-b-xl" 
       style="background-image: url('<%= image_path('top-header.png') %>');">
  </div>
  <div class="absolute top-40 left-7 w-[95%]">
    <%= render "main_kpis", total_jovenes: @dashboard.total_jovenes, total_participants: @dashboard.total_participants, total_staff: @dashboard.total_staff %>
  </div>
  <div class="flex justify-between items-center mb-5 px-12 absolute top-10 w-full">
    <div class="text-white">
      <h1 class="font-bold text-2xl ">Bienvenido, Rodolfo!</h1>
      <p>Que cuando os halláis al servicio de vuestros semejantes, solo estáis al servicio de vuestro Dios.</p>
      <span class="font-thin ml-2"> -Mosiah 2:17</span>
    </div>
    <%if Current.user&.admin_or_staff_manager?%>
      <div>
        <%= render(ButtonComponent.new(text:"Nuevo", url: new_participant_path, type:"primary", classes:"!bg-white/35 !border-0"))%>
      </div>
    <%end%>
  </div>
</div>
<div class="mt-30 sm:px-2 md:px-7">
  <%= render "main_charts", count_by_stake: @dashboard.count_by_stake, count_by_role: @dashboard.count_by_role%>
  <%= render "secondary_charts", data_by_age: @dashboard.participants_by_age, shirt_counts: @dashboard.shirt_count, male_count: @dashboard.male_count, female_count: @dashboard.female_count%>
</div>
