<%
  # Durante la semana del FSY manda la agenda: las dos próximas actividades. Antes, las capacitaciones
  # que faltan y el arranque del evento.
  items = if event_in_progress?
    next_activities.map do |activity|
      { key: "activity-#{activity.id}", eyebrow: "Agenda", title: activity.title,
        meta: [ SpanishDates.long(activity.starts_at.to_date), activity.time_range, activity.location.presence ].compact.join(" · "),
        days: days_until(activity.starts_at.to_date), icon: "calendar-days", tone: "bg-primary-600",
        chip: "bg-primary-50 dark:bg-primary-700/30 text-primary-700 dark:text-primary-100",
        url: agenda_path(date: activity.starts_at.to_date, activity_id: activity.id) }
    end
  else
    trainings = next_trainings.map do |date|
      { key: "training-#{date}", eyebrow: "Capacitación", title: SpanishDates.long(date),
        meta: "Capacitación del staff · #{date.year}", days: days_until(date),
        icon: "graduation-cap", tone: "bg-cat-amber", chip: "bg-cat-amber/15 text-amber-700 dark:text-cat-amber" }
    end
    start_on = Rails.configuration.x.event_start_on
    trainings + [ { key: "event", eyebrow: "FSY 2026", title: "Comienza el evento",
                    meta: "#{SpanishDates.long(start_on)} de #{start_on.year} · Managua-Caribe",
                    days: days_until(start_on), icon: "party-popper", tone: "bg-cat-indigo",
                    chip: "bg-cat-indigo/15 text-cat-indigo", url: agenda_path } ]
  end
  items = items.first(3)
  columns = { 1 => "", 2 => "lg:grid-cols-2", 3 => "lg:grid-cols-3" }.fetch(items.size, "lg:grid-cols-3")
%>
<section class="<%= card_classes("p-5 md:p-6") %>" data-next-up>
  <%= render "dashboards/card_heading", eyebrow: "Lo que viene",
             title: event_in_progress? ? "Próximas actividades" : "Próximas fechas",
             icon_name: "calendar-clock", tone: "bg-cat-indigo/15 text-cat-indigo", spacing: "mb-4", size: "sm" %>

  <% if items.any? %>
    <div class="grid grid-cols-1 <%= columns %> gap-3">
      <% items.each do |item| %>
        <%
          body = capture do %>
            <span class="w-10 h-10 shrink-0 rounded-[12px] flex items-center justify-center text-white <%= item[:tone] %>">
              <%= icon item[:icon], class: "w-[19px] h-[19px]" %>
            </span>
            <span class="min-w-0">
              <span class="block text-[11px] font-bold tracking-[.07em] uppercase text-ink-300 dark:text-slate-500"><%= item[:eyebrow] %></span>
              <span class="block mt-1 text-[15.5px] font-extrabold leading-tight text-ink-900 dark:text-slate-100"><%= item[:title] %></span>
              <span class="block mt-1 text-[12.5px] font-semibold text-ink-500 dark:text-slate-400"><%= item[:meta] %></span>
              <% if (label = countdown_label(item[:days])) %>
                <span class="mt-2 inline-flex items-center px-2.5 py-1 rounded-full text-[11.5px] font-bold <%= item[:chip] %>"><%= label %></span>
              <% end %>
            </span>
          <% end
          cell = "flex items-start gap-3.5 rounded-[14px] bg-canvas dark:bg-slate-900/60 px-4 py-4"
        %>
        <% if item[:url] %>
          <%= link_to item[:url], data: { next_item: item[:key] }, class: "#{cell} hover:bg-line-soft/60 dark:hover:bg-slate-700/60 transition" do %><%= body %><% end %>
        <% else %>
          <div class="<%= cell %>" data-next-item="<%= item[:key] %>"><%= body %></div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-[13px] text-ink-500 dark:text-slate-400">
      La agenda del evento ya terminó. <%= link_to "Ver la agenda", agenda_path, class: "font-bold text-primary-600 dark:text-primary-300 hover:underline" %>
    </p>
  <% end %>
</section>
