<%
  # Durante la semana del FSY manda la agenda: las dos próximas actividades. Antes, las capacitaciones
  # que faltan y el arranque del evento.
  items = if event_in_progress?
    next_activities.map do |activity|
      { key: "activity-#{activity.id}", eyebrow: "Agenda", title: activity.title,
        meta: [ SpanishDates.long(activity.starts_at.to_date), activity.time_range, activity.location.presence ].compact.join(" · "),
        days: days_until(activity.starts_at.to_date), icon: "calendar-days", tone: :primary,
        url: agenda_path(date: activity.starts_at.to_date, activity_id: activity.id) }
    end
  else
    trainings = next_trainings.map do |training|
      { key: "training-#{training.held_on}", eyebrow: "Capacitación", title: SpanishDates.long(training.held_on),
        meta: "#{training.name} · #{training.held_on.year}", days: days_until(training.held_on),
        icon: "graduation-cap", tone: :amber,
        url: agenda_training_path(training, return_to: return_here) }
    end
    start_on = Rails.configuration.x.event_start_on
    trainings + [ { key: "event", eyebrow: Rails.configuration.x.event_name, title: "Comienza el evento",
                    meta: "#{SpanishDates.long(start_on)} de #{start_on.year} · Managua-Caribe",
                    days: days_until(start_on), icon: "party-popper", tone: :indigo, url: agenda_path } ]
  end
  items = items.first(3)
  columns = { 1 => "", 2 => "lg:grid-cols-2", 3 => "lg:grid-cols-3" }.fetch(items.size, "lg:grid-cols-3")
%>
<section class="<%= card_classes("p-5 md:p-6") %>" data-next-up>
  <%= section_heading event_in_progress? ? "Próximas actividades" : "Próximas fechas", "calendar-clock", tone: :indigo %>

  <% if items.any? %>
    <div class="grid grid-cols-1 <%= columns %> gap-3">
      <% items.each do |item| %>
        <%
          body = capture do %>
            <%= render IconTileComponent.new(icon: item[:icon], tone: item[:tone], size: :md) %>
            <span class="min-w-0">
              <span class="block text-meta font-bold tracking-[.07em] uppercase text-ink-500"><%= item[:eyebrow] %></span>
              <span class="block mt-0.5 text-title font-extrabold leading-tight text-ink-900"><%= item[:title] %></span>
              <span class="block mt-0.5 text-label font-semibold text-ink-500"><%= item[:meta] %></span>
              <% if (label = countdown_label(item[:days])) %>
                <span class="mt-2 inline-flex"><%= render ChipComponent.new(label: label, tone: item[:tone]) %></span>
              <% end %>
            </span>
          <% end
          cell = "flex items-start gap-3 rounded-tile bg-sunken p-4"
        %>
        <% if item[:url] %>
          <%= link_to item[:url], data: { next_item: item[:key] }, class: "#{cell} hover:bg-line-soft/70 transition-colors" do %><%= body %><% end %>
        <% else %>
          <div class="<%= cell %>" data-next-item="<%= item[:key] %>"><%= body %></div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-body text-ink-500">
      La agenda del evento ya terminó. <%= link_to "Ver la agenda", agenda_path, class: "font-bold text-primary-600 dark:text-primary-300 hover:underline" %>
    </p>
  <% end %>
</section>
