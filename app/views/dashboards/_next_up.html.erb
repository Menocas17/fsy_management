<%
  items = next_up_items(next_activities)
  columns = { 1 => "", 2 => "lg:grid-cols-2", 3 => "lg:grid-cols-3" }.fetch(items.size, "lg:grid-cols-3")
%>
<section class="<%= card_classes("p-5 md:p-6") %>" data-next-up>
  <%= section_heading event_in_progress? ? "Próximas actividades" : "Próximas fechas", "calendar-clock", tone: :indigo %>

  <% if items.any? %>
    <div class="grid grid-cols-1 <%= columns %> gap-3">
      <% items.each do |item| %>
        <%
          body = capture do %>
            <%= render IconTileComponent.new(icon: item[:icon], tone: item[:tone], size: :md) %>
            <span class="min-w-0">
              <span class="block text-meta font-bold tracking-[.07em] uppercase text-ink-500"><%= item[:eyebrow] %></span>
              <span class="block mt-0.5 text-title font-extrabold leading-tight text-ink-900"><%= item[:title] %></span>
              <span class="block mt-0.5 text-label font-semibold text-ink-500"><%= item[:meta] %></span>
              <% if (label = countdown_label(item[:days])) %>
                <span class="mt-2 inline-flex"><%= render ChipComponent.new(label: label, tone: item[:tone]) %></span>
              <% end %>
            </span>
          <% end
          cell = "flex items-start gap-3 rounded-tile bg-sunken p-4"
        %>
        <% if item[:url] %>
          <%= link_to item[:url], data: { next_item: item[:key] }, class: "#{cell} hover:bg-line-soft/70 transition-colors" do %><%= body %><% end %>
        <% else %>
          <div class="<%= cell %>" data-next-item="<%= item[:key] %>"><%= body %></div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-body text-ink-500">
      La agenda del evento ya terminó. <%= link_to "Ver la agenda", agenda_path, class: "font-bold text-primary-600 dark:text-primary-300 hover:underline" %>
    </p>
  <% end %>
</section>
