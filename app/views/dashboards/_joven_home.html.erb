<%# El inicio del joven (teléfono y computadora): en vez de las cifras del evento, su compañía (los avisos los trae la campanita), o «Próximamente» hasta que se finaliza el registro. %>
<% joven = Current.user.participant %>
<% company = joven.company %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-5 items-start" data-entrance="kpis" data-joven-home>
  <%# Hasta que se finaliza el registro (CompanyReveal) la tarjeta queda, pero sin ningún dato. %>
  <% if Current.user.company_coming_soon? %>
    <%= link_to my_company_path, class: card_classes("p-5 flex items-center gap-3 transition-transform active:scale-[0.98]"), data: { joven_company: true, company_coming_soon: true, tour: "joven-company" } do %>
      <span aria-hidden="true" class="size-[52px] shrink-0 rounded-tile bg-cat-green/15 text-cat-green-ink flex items-center justify-center"><%= icon "hourglass", class: "size-6" %></span>
      <span class="min-w-0 flex-1">
        <span class="block text-meta font-bold tracking-[.07em] uppercase text-ink-500">Mi compañía</span>
        <span class="block text-title font-bold text-ink-900">Próximamente</span>
        <span class="block text-label font-semibold text-ink-500">Se abre cuando termine el registro.</span>
      </span>
      <%= icon "chevron-right", class: "size-[18px] shrink-0 text-ink-500" %>
    <% end %>
  <% elsif company %>
    <% counselors = company.counselors_in_order %>
    <%= link_to my_company_path, class: card_classes("p-5 flex flex-col gap-3.5 transition-transform active:scale-[0.98]"), data: { joven_company: true, tour: "joven-company" } do %>
      <div class="flex items-center gap-3">
        <span aria-hidden="true" class="size-[52px] shrink-0 rounded-tile bg-cat-green-solid text-white flex items-center justify-center text-display font-extrabold"><%= company.number || "–" %></span>
        <span class="min-w-0 flex-1">
          <span class="block text-meta font-bold tracking-[.07em] uppercase text-ink-500">Mi compañía</span>
          <span class="block text-title font-bold text-ink-900 truncate"><%= [ company.name, company.nickname.presence ].compact.join(" · ") %></span>
        </span>
        <%= icon "chevron-right", class: "size-[18px] shrink-0 text-ink-500" %>
      </div>
      <% if counselors.any? %>
        <span class="flex items-center gap-3">
          <span class="flex -space-x-1.5 shrink-0">
            <% counselors.each do |counselor| %><%= render AvatarComponent.new(participant: counselor, size: :sm) %><% end %>
          </span>
          <span class="min-w-0">
            <span class="block text-label font-semibold text-ink-500">Tus consejeros</span>
            <span class="block text-body font-bold text-ink-900 truncate"><%= counselors.map { |counselor| counselor.first_name.to_s.split.first }.to_sentence(two_words_connector: " y ", last_word_connector: " y ") %></span>
          </span>
        </span>
      <% end %>
      <span class="flex flex-wrap gap-1.5">
        <% if company.dining_hall_label %><%= render ChipComponent.new(label: company.dining_hall_label, tone: :amber, icon: "utensils") %><% end %>
        <% if joven.room.present? %><%= render ChipComponent.new(label: "Cuarto #{joven.room}", tone: :indigo, icon: "bed-double") %><% end %>
      </span>
    <% end %>
  <% else %>
    <%= render EmptyStateComponent.new(title: "Todavía no tienes compañía", icon: "building-2", tone: :green,
          text: "Te la asignan antes del evento o al llegar. Aquí verás a tus consejeros, tu comedor y tu cuarto.") %>
  <% end %>
</div>
