<%# "Personal" only charts staff roles; jóvenes already have their own KPI card. %>
<% staff_roles = count_by_role.except("joven").select { |_, count| count.positive? } %>
<section class="grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-4 md:gap-5">
  <div class="min-w-0 bg-surface dark:bg-slate-800 border border-line-soft dark:border-slate-700 rounded-[18px] shadow-md px-6 py-6 md:px-7">
    <%= render "dashboards/card_heading", eyebrow: "Distribución", title: "Participantes por estaca",
               icon_name: "map-pin", tone: "bg-cat-blue/15 text-cat-blue", spacing: "mb-4" %>
    <%= tag.div role: "img", aria: { label: "Participantes por estaca. #{chart_summary(count_by_stake.keys, count_by_stake.values)}" },
          data: { controller: "chart", chart_kind_value: "columns", chart_name_value: "Participantes",
                  chart_labels_value: count_by_stake.keys.map(&:split), chart_series_value: count_by_stake.values,
                  chart_colors_value: ChartsHelper::CATEGORY_COLORS, chart_gradient_value: true, chart_height_value: 220 } do %>
      <div data-chart-target="canvas" class="min-h-[220px]"></div>
    <% end %>
  </div>
  <div class="min-w-0 flex flex-col bg-surface dark:bg-slate-800 border border-line-soft dark:border-slate-700 rounded-[18px] shadow-md px-6 py-6 md:px-7">
    <%= render "dashboards/card_heading", eyebrow: "Personal", title: "Distribución por rol",
               icon_name: "user-cog", tone: "bg-cat-indigo/15 text-cat-indigo", spacing: "mb-5" %>
    <% if staff_roles.any? %>
      <div class="flex flex-col sm:flex-row items-center gap-6 flex-1">
        <%= tag.div class: "w-[180px] shrink-0", role: "img",
              aria: { label: "Distribución por rol. #{chart_summary(staff_roles.keys.map { |role| role_chart_label(role) }, staff_roles.values)}" },
              data: { controller: "chart", chart_kind_value: "donut",
                      chart_labels_value: staff_roles.keys.map { |role| role_chart_label(role) }, chart_series_value: staff_roles.values,
                      chart_colors_value: staff_roles.keys.map { |role| role_chart_color(role) }, chart_height_value: 180,
                      chart_gradient_value: true, chart_total_value: staff_roles.values.sum } do %>
          <div data-chart-target="canvas" class="min-h-[180px]"></div>
        <% end %>
        <ul class="w-full sm:w-auto flex flex-col gap-[9px]" aria-hidden="true">
          <% staff_roles.each do |role, count| %>
            <li class="flex items-center gap-2 text-[12.5px] font-semibold text-ink-700 dark:text-slate-300">
              <span class="w-2 h-2 rounded-full shrink-0" style="background: <%= role_chart_color(role) %>"></span>
              <%= role_chart_label(role) %>
              <span class="ml-auto pl-4 tabular-nums text-ink-500 dark:text-slate-400"><%= count %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="flex-1 flex items-center justify-center text-sm text-ink-500 dark:text-slate-400">Aún no hay personal registrado.</p>
    <% end %>
  </div>
</section>
