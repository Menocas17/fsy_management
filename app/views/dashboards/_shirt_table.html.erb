<div class="bg-surface dark:bg-slate-800 border border-line-soft dark:border-slate-700 rounded-[18px] shadow-md pt-6 pb-2 overflow-hidden">
  <div class="px-6 pb-4">
    <p class="text-[11px] font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300">Tallas</p>
    <h2 class="mt-0.5 text-[15px] font-bold text-ink-900 dark:text-slate-100">Camisas registradas</h2>
  </div>
  <table class="w-full text-[12.5px] font-semibold">
    <caption class="sr-only">Camisas registradas por talla</caption>
    <tbody>
      <% %w[xs s m l xl].each_with_index do |size, index| %>
        <tr class="<%= index.odd? ? "bg-canvas dark:bg-slate-700/40" : "" %>">
          <th scope="row" class="px-6 py-2.5 text-left uppercase font-semibold <%= index.odd? ? "text-ink-900 dark:text-slate-100" : "text-ink-500 dark:text-slate-400" %>"><%= size %></th>
          <td class="px-6 py-2.5 text-right <%= index.odd? ? "text-ink-900 dark:text-slate-100" : "text-ink-500 dark:text-slate-400" %>" data-shirt-size="<%= size %>"><%= shirt_counts[size] || 0 %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
