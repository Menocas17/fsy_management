<section class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1.2fr] gap-4 md:gap-5">
  <div class="bg-surface dark:bg-slate-800 border border-line-soft dark:border-slate-700 rounded-[18px] shadow-md px-6 py-6">
    <p class="text-[11px] font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300">Género</p>
    <h2 class="mt-0.5 mb-5 text-[15px] font-bold text-ink-900 dark:text-slate-100">Jóvenes por género</h2>
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[11px] flex items-center justify-center bg-cat-blue/15 text-cat-blue">
          <%= icon "mars", class: "w-5 h-5" %>
        </div>
        <p class="text-xl font-extrabold text-ink-900 dark:text-slate-100" data-kpi="male_count"><%= male_count %></p>
        <p class="text-[12.5px] font-semibold text-ink-500 dark:text-slate-400">hombres</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[11px] flex items-center justify-center bg-cat-rose/15 text-cat-rose">
          <%= icon "venus", class: "w-5 h-5" %>
        </div>
        <p class="text-xl font-extrabold text-ink-900 dark:text-slate-100" data-kpi="female_count"><%= female_count %></p>
        <p class="text-[12.5px] font-semibold text-ink-500 dark:text-slate-400">mujeres</p>
      </div>
    </div>
  </div>

  <%= render "shirt_table", shirt_counts: shirt_counts %>

  <div class="min-w-0 bg-surface dark:bg-slate-800 border border-line-soft dark:border-slate-700 rounded-[18px] shadow-md px-6 py-6">
    <p class="text-[11px] font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300">Edad</p>
    <h2 class="mt-0.5 mb-4 text-[15px] font-bold text-ink-900 dark:text-slate-100">Jóvenes por edad</h2>
    <% ages = data_by_age.reject { |age, _| age.nil? }.sort.to_h %>
    <%= tag.div role: "img", aria: { label: "Jóvenes por edad. #{chart_summary(ages.keys, ages.values)}" },
          data: { controller: "chart", chart_kind_value: "columns", chart_name_value: "Participantes",
                  chart_labels_value: ages.keys.map(&:to_s), chart_series_value: ages.values,
                  chart_colors_value: age_bar_colors(ages.values), chart_radius_value: 6, chart_column_width_value: "70%", chart_height_value: 170 } do %>
      <div data-chart-target="canvas" class="min-h-[170px]"></div>
    <% end %>
  </div>
</section>
