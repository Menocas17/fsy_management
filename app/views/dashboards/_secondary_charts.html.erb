<section class="grid grid-cols-1 lg:grid-cols-[1fr_1fr_1.2fr] gap-4 md:gap-5">
  <div class="<%= card_classes("p-5 md:p-6") %>">
    <%= section_heading "Jóvenes por género", "venus-and-mars", tone: :rose %>
    <%
      jovenes_total = male_count + female_count
      share = ->(count) { jovenes_total.zero? ? 0 : (count * 100.0 / jovenes_total).round }
      rows = [ [ "male_count", male_count, "hombres", "mars", :blue ],
               [ "female_count", female_count, "mujeres", "venus", :rose ] ]
    %>
    <div class="space-y-3">
      <% rows.each do |key, count, label, icon_name, tone| %>
        <div class="flex items-center gap-3.5">
          <%= render IconTileComponent.new(icon: icon_name, tone: tone, size: :md) %>
          <div class="min-w-0">
            <p class="text-display font-extrabold leading-tight tabular-nums text-ink-900" data-kpi="<%= key %>"><%= count %></p>
            <p class="text-label font-semibold text-ink-500"><%= label %></p>
          </div>
          <p class="ml-auto text-body font-bold tabular-nums text-ink-500" data-kpi-share="<%= key %>"><%= share.(count) %> %</p>
        </div>
      <% end %>
      <% if jovenes_total.positive? %>
        <div class="flex h-2 rounded-full overflow-hidden bg-canvas" aria-hidden="true">
          <span class="bg-cat-blue-solid" style="width: <%= share.(male_count) %>%"></span>
          <span class="bg-cat-rose-solid" style="width: <%= share.(female_count) %>%"></span>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "shirt_table", shirt_counts: shirt_counts %>

  <div class="<%= card_classes("min-w-0 p-5 md:p-6") %>">
    <%= section_heading "Jóvenes por edad", "cake", tone: :green %>
    <% ages = data_by_age.reject { |age, _| age.nil? }.sort.to_h %>
    <%= tag.div role: "img", aria: { label: "Jóvenes por edad. #{chart_summary(ages.keys, ages.values)}" },
          data: { controller: "chart", chart_kind_value: "columns", chart_name_value: "Participantes",
                  chart_labels_value: ages.keys.map(&:to_s), chart_series_value: ages.values,
                  chart_colors_value: age_bar_colors(ages.values), chart_radius_value: 5, chart_column_width_value: "64%",
                  chart_height_value: 180, chart_show_values_value: true } do %>
      <div data-chart-target="canvas" class="min-h-[170px]"></div>
    <% end %>
  </div>
</section>
