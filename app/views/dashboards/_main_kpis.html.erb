<%
  kpis = [
    { key: "total_jovenes", label: "Total de jóvenes", value: total_jovenes, icon: "user", chip: "bg-cat-green/15 text-cat-green" },
    { key: "total_participants", label: "Total de personas", value: total_participants, icon: "users", chip: "bg-cat-indigo/15 text-cat-indigo" },
    { key: "total_staff", label: "Total de staff", value: total_staff, icon: "user-star", chip: "bg-cat-amber/20 text-amber-700 dark:text-cat-amber" }
  ]
%>
<section class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-5">
  <% kpis.each do |kpi| %>
    <div class="flex sm:block items-center gap-4 bg-surface dark:bg-slate-800 border border-line-soft dark:border-slate-700 rounded-[18px] shadow-md px-5 py-5 md:px-6">
      <div class="w-11 h-11 rounded-[13px] flex items-center justify-center shrink-0 <%= kpi[:chip] %>">
        <%= icon kpi[:icon], class: "w-5 h-5" %>
      </div>
      <div>
        <p class="sm:mt-4 text-3xl md:text-[42px] font-extrabold leading-none tracking-tight text-ink-900 dark:text-slate-100" data-kpi="<%= kpi[:key] %>"><%= kpi[:value] %></p>
        <p class="mt-1.5 text-[13.5px] font-semibold text-ink-500 dark:text-slate-400"><%= kpi[:label] %></p>
      </div>
    </div>
  <% end %>
</section>
