<%
  # La cifra manda; el icono va en una baldosa suave igual para las tres, porque el color aquí no
  # significaría nada. Cada tarjeta lleva a su lista: la cifra es la puerta de entrada.
  kpis = [
    { key: "total_jovenes", label: "Total de jóvenes", value: total_jovenes, icon: "user", url: participants_path },
    { key: "total_participants", label: "Total de personas", value: total_participants, icon: "users", url: nil },
    { key: "total_staff", label: "Total de staff", value: total_staff, icon: "user-star", url: staff_participants_path }
  ]
  card = "flex items-center gap-4 bg-surface border border-line-soft rounded-card shadow-md px-5 py-[18px] md:px-6"
%>
<section class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-5">
  <% kpis.each do |kpi| %>
    <%
      body = capture do %>
        <span class="w-11 h-11 rounded-tile flex items-center justify-center shrink-0 bg-primary-50 text-primary-700 dark:bg-primary-700/30 dark:text-primary-100">
          <%= icon kpi[:icon], class: "w-5 h-5" %>
        </span>
        <span class="min-w-0">
          <span class="block text-[36px] font-extrabold leading-none tracking-tight text-ink-900 tabular-nums" data-kpi="<%= kpi[:key] %>"><%= kpi[:value] %></span>
          <span class="block mt-1 text-[13px] font-semibold text-ink-500 truncate"><%= kpi[:label] %></span>
        </span>
        <% if kpi[:url] %>
          <%= icon "arrow-right", class: "w-[18px] h-[18px] ml-auto shrink-0 text-ink-500" %>
        <% end %>
      <% end
    %>
    <% if kpi[:url] %>
      <%= link_to kpi[:url], data: { kpi_link: kpi[:key] }, class: "#{card} hover:border-primary-300 dark:hover:border-primary-300 transition" do %><%= body %><% end %>
    <% else %>
      <div class="<%= card %>"><%= body %></div>
    <% end %>
  <% end %>
</section>
