<%# Modo simple, solo en el teléfono: las tres cifras del rol (DashboardFacade#simple_kpis) en vez de las del evento.
    La que lleva a su módulo es un enlace; la línea chica dice de qué es la cifra («de 12 · anoche») y el momento («Ahora», «Hoy») va en gris junto al icono. %>
<section class="md:hidden grid grid-cols-3 max-[374px]:grid-cols-1 gap-2.5" data-entrance="kpis" data-simple-kpis>
  <% kpis.each do |kpi| %>
    <% url = simple_kpi_url(kpi[:link]) %>
    <%= content_tag(url ? :a : :div, href: url, data: { simple_kpi: kpi[:label] },
          class: card_classes("min-w-0 flex flex-col items-start max-[374px]:flex-row max-[374px]:items-center gap-2.5 max-[374px]:gap-3 p-3.5 #{"transition-transform active:scale-[0.98]" if url}")) do %>
      <span class="w-full flex items-center justify-between gap-1.5 max-[374px]:contents">
        <%= render IconTileComponent.new(icon: kpi[:icon], tone: kpi[:tone], variant: :solid, size: :md) %>
        <% if kpi[:badge] %><span class="min-w-0 text-meta font-semibold text-ink-500 truncate max-[374px]:order-last max-[374px]:ml-auto" data-kpi-badge><%= kpi[:badge] %></span><% end %>
      </span>
      <span class="min-w-0 w-full max-[374px]:w-auto max-[374px]:flex-1">
        <span class="block text-display font-extrabold leading-none tracking-tight tabular-nums text-ink-900"><%= kpi[:value] %></span>
        <span class="block mt-1 text-label font-semibold leading-tight text-ink-700 line-clamp-2"><%= kpi[:label] %></span>
        <% if kpi[:sub] %><span class="block mt-0.5 text-meta font-semibold text-ink-500 truncate"><%= kpi[:sub] %></span><% end %>
      </span>
    <% end %>
  <% end %>
</section>
