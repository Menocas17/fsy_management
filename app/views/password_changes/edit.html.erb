<% content_for :title, "Cambiar contraseña" %>
<% content_for :eyebrow, "Cuenta" %>
<% back_to "Configuración", settings_path %>

<%= render PageComponent.new(width: :form) do %>
  <section class="max-w-[640px] <%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="password-change" data-password-change>
    <h2 id="password-change" class="flex items-center gap-[9px] text-title font-bold text-ink-900">
      <%= icon "key-round", class: "w-[17px] h-[17px]" %>
      Cambiar contraseña
    </h2>
    <p class="mt-1.5 text-body text-ink-500">
      Al guardarla se cierran tus sesiones en otros dispositivos; en este sigues adentro.
    </p>

    <%= render "shared/password_errors", user: @user %>

    <%= form_with url: password_change_path, method: :patch, class: "mt-6 space-y-4" do |form| %>
      <%= render "shared/password_field", form: form, attribute: :password_challenge, label: "Contraseña actual",
                 autocomplete: "current-password", placeholder: "La que usas ahora" %>

      <%= render "shared/password_field", form: form, attribute: :password, label: "Nueva contraseña",
                 autocomplete: "new-password", placeholder: "Tu nueva contraseña", rules: true %>

      <%= render "shared/password_field", form: form, attribute: :password_confirmation, label: "Repetir la nueva contraseña",
                 autocomplete: "new-password", placeholder: "Escríbela de nuevo" %>

      <div class="flex gap-2.5 sm:justify-end">
        <%= link_to "Cancelar", settings_path, class: button_classes(:secondary, extra: "flex-1 sm:flex-none") %>
        <button type="submit" data-turbo-submits-with="Guardando…" class="<%= button_classes(:primary, extra: "flex-1 sm:flex-none") %>">
          <%= icon "check", class: "w-4 h-4" %>
          Guardar contraseña
        </button>
      </div>
    <% end %>
  </section>
<% end %>
