<% content_for :title, "Reportes" %>
<% content_for :eyebrow, "Seguimiento" %>
<%
  card = card_classes("p-5 flex flex-col gap-3 h-full")
  # Una pantalla de puros documentos: generar el de cada tarjeta es la acción de esa tarjeta, así que va en azul
  # (excepción a «un botón principal por pantalla», pedida a propósito: en gris la página se veía apagada).
  action = button_classes
  secondary = "inline-flex items-center justify-center gap-2 h-10 px-4 rounded-control border border-line bg-surface text-sm font-semibold text-ink-700 hover:bg-muted transition"
  inert = "inline-flex items-center justify-center gap-2 h-10 px-4 rounded-control border border-line text-sm font-semibold text-ink-500 cursor-not-allowed"
%>
<%= render PageComponent.new(width: :page) do %>
  <% if can_import_participants? %>
    <section class="<%= card_classes("p-5 md:p-6 flex flex-col md:flex-row md:items-center gap-4") %>">
      <span class="w-11 h-11 shrink-0 rounded-tile bg-primary-50 dark:bg-primary-700/30 text-primary-600 dark:text-primary-100 flex items-center justify-center">
        <%= icon "file-spreadsheet", class: "w-5 h-5" %>
      </span>
      <div class="flex-1 min-w-0">
        <h2 class="text-title font-bold text-ink-900">Carga masiva de participantes</h2>
        <p class="mt-1 text-body text-ink-500">
          Sube el Excel del registro y se crean las fichas en bloque. Te decimos fila por fila qué entró y qué no.
        </p>
      </div>
      <%= link_to new_participant_import_path, class: "#{action} shrink-0" do %>
        <%= icon "upload", class: "w-4 h-4" %>
        Cargar participantes
      <% end %>
    </section>
  <% end %>

  <% if can_view_participant_reports? %>
    <section>
      <h2 class="mb-3 text-title font-bold text-ink-900">Listas para imprimir</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <%
          printables = [
            { title: "Participantes", text: "Todos los jóvenes agrupados por compañía, con edad, estaca, cuarto y teléfono.",
              icon: "users", url: participants_reports_path,
              extras: [ [ "Solo mujeres", participants_reports_path(scope: "mujeres") ],
                        [ "Solo hombres", participants_reports_path(scope: "hombres") ] ] },
            { title: "Staff", text: "El personal del evento con su rol, compañía y datos de contacto.",
              icon: "user-check", url: participants_reports_path(scope: "staff") },
            { title: "Cuartos", text: "Cada cuarto con sus ocupantes y la compañía a la que pertenecen.",
              icon: "bed-double", url: rooms_reports_path },
            { title: "Agenda", text: "Los seis días del evento con horario, lugar y a quién va dirigida cada actividad.",
              icon: "calendar-days", url: agenda_reports_path },
            { title: "Cumpleañeros", text: "Quiénes cumplen años en #{SpanishDates.month(Rails.configuration.x.event_start_on)} y, aparte, durante la semana del FSY, con la edad que cumplen.",
              icon: "cake", url: birthdays_reports_path },
            { title: "Gafetes para lanyard", text: "Dos etiquetas por persona: el frente con su nombre y compañía, y el QR de su ficha para pegar detrás.",
              icon: "id-card", url: badges_reports_path,
              extras: [ [ "Solo jóvenes", badges_reports_path(scope: "jovenes") ],
                        [ "Solo staff", badges_reports_path(scope: "staff") ] ] }
          ]
        %>
        <% printables.each do |report| %>
          <article class="<%= card %>">
            <div class="flex items-center gap-3">
              <%= render IconTileComponent.new(icon: report[:icon]) %>
              <h3 class="text-title font-bold text-ink-900"><%= report[:title] %></h3>
            </div>
            <p class="text-body leading-relaxed text-ink-500 flex-1"><%= report[:text] %></p>
            <div class="flex flex-wrap gap-2">
              <%= link_to report[:url], target: "_blank", rel: "noopener", class: action do %>
                <%= icon "printer", class: "w-4 h-4" %>
                Generar PDF
              <% end %>
              <% Array(report[:extras]).each do |label, url| %>
                <%= link_to label, url, target: "_blank", rel: "noopener", class: secondary %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if can_view_logistics_reports? %>
    <section>
      <h2 class="mb-3 text-title font-bold text-ink-900">Logística y finanzas</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-4">
        <% [
             { title: "Inventario", text: "Existencias de cada inventario con su mínimo, estado y ubicación, listo para el conteo físico.",
               icon: "package", url: inventory_reports_path, extras: [ [ "Ver el módulo", inventories_path ] ] },
             { title: "Etiquetas QR", text: "Hoja para recortar y pegar en las cajas: el QR, el nombre y el código de cada artículo.",
               icon: "tags", url: labels_reports_path }
           ].each do |report| %>
          <article class="<%= card %>">
            <div class="flex items-center gap-3">
              <%= render IconTileComponent.new(icon: report[:icon]) %>
              <h3 class="text-title font-bold text-ink-900"><%= report[:title] %></h3>
            </div>
            <p class="text-body leading-relaxed text-ink-500 flex-1"><%= report[:text] %></p>
            <div class="flex flex-wrap gap-2">
              <%= link_to report[:url], target: "_blank", rel: "noopener", class: action do %>
                <%= icon "printer", class: "w-4 h-4" %>
                Generar PDF
              <% end %>
              <% Array(report[:extras]).each do |label, url| %>
                <%= link_to label, url, class: secondary %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <% if can_view_finances? %>
          <article class="<%= card %>" data-report="expenses">
            <div class="flex items-center gap-3">
              <%= render IconTileComponent.new(icon: "wallet") %>
              <h3 class="text-title font-bold text-ink-900">Rendición de gastos</h3>
            </div>
            <p class="text-body leading-relaxed text-ink-500 flex-1">Presupuesto contra lo gastado por categoría y por área, cada gasto con quién lo aprobó, y las facturas al final. Para tesorería.</p>
            <div class="flex flex-wrap gap-2">
              <%= link_to expenses_reports_path, target: "_blank", rel: "noopener", class: action do %>
                <%= icon "printer", class: "w-4 h-4" %>
                Generar PDF
              <% end %>
              <%= link_to expenses_workbook_reports_path, class: secondary do %>
                <%= icon "sheet", class: "w-4 h-4" %>
                Excel
              <% end %>
            </div>
          </article>
        <% end %>
        <%# Espera a que exista la carga de ajustes en bloque. %>
        <% [
             { title: "Ajustes de inventario", text: "Subir un archivo con entradas y salidas en bloque, para no ajustar artículo por artículo.", icon: "upload", label: "Subir ajustes" }
           ].each do |report| %>
          <article class="<%= card %>">
            <div class="flex items-center gap-2.5">
              <%= icon report[:icon], class: "w-[18px] h-[18px] text-ink-500" %>
              <h3 class="text-title font-bold text-ink-500"><%= report[:title] %></h3>
              <span class="ml-auto text-meta font-bold tracking-[.06em] uppercase px-2 py-0.5 rounded-full bg-muted text-ink-500">Pronto</span>
            </div>
            <p class="text-body leading-relaxed text-ink-500 flex-1"><%= report[:text] %></p>
            <span aria-disabled="true" class="<%= inert %>"><%= report[:label] %></span>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
