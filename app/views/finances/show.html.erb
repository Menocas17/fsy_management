<% content_for :title, "Finanzas" %>
<% content_for :eyebrow, "Logística" %>
<% total = @summary.total %>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2.5">
      <p class="text-body font-medium text-ink-700">
        Todo en córdobas<%= " · dólar a C$ #{FinanceSettings.usd_rate}" if FinanceSettings.usd_rate %>.
      </p>
      <% unless can_operate_finances? %>
        <span role="note" title="Los gastos los presentan y aprueban el área de Finanzas y el director de logística.">
          <%= render ChipComponent.new(label: "Solo lectura", icon: "eye", data: { finance_readonly: true }) %>
        </span>
      <% end %>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to expenses_path, class: button_classes(:secondary) do %>
        <%= icon "list", class: "size-4" %>
        Ver gastos
      <% end %>
      <%= link_to expenses_reports_path, target: "_blank", rel: "noopener", class: button_classes(:secondary) do %>
        <%= icon "printer", class: "size-4" %>
        Rendición PDF
      <% end %>
      <%= link_to expenses_workbook_reports_path, class: button_classes(:secondary) do %>
        <%= icon "sheet", class: "size-4" %>
        Excel
      <% end %>
      <% if can_configure_finances? %>
        <%= link_to edit_finances_path, class: button_classes(:secondary) do %>
          <%= icon "settings", class: "size-4" %>
          Presupuesto
        <% end %>
      <% end %>
      <% if can_operate_finances? %>
        <%= link_to new_expense_path, class: button_classes do %>
          <%= icon "plus", class: "size-4" %>
          Nuevo gasto
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Las cuatro cifras que abren Finanzas (mosaicos de cifra grandes), como en el inicio. %>
  <section class="grid grid-cols-2 gap-3 md:gap-4" aria-label="Resumen del gasto">
    <% [ [ "Ejecutado", total.executed, "Consolidado con factura o justificación", "circle-check", :green ],
         [ "Comprometido", total.committed, "Aprobado, falta consolidar", "clock", :blue ],
         [ "Por aprobar", total.presented, "Presentado, sin aprobar", "hourglass", :amber ],
         [ "Asignado a categorías", @summary.assigned_cents, "Suma de los presupuestos propios", "layout-grid", :indigo, "Asignado" ] ].each do |label, value, hint, icon_name, tone, short| %>
      <%= render StatTileComponent.new(value: money(value), label: label, short_label: short, hint: hint, icon: icon_name, tone: tone, value_data: { finance_figure: label.parameterize }) %>
    <% end %>
  </section>

  <section class="<%= card_classes("p-5 md:p-6") %>" data-finance-total>
    <%= section_heading "Presupuesto general", "wallet" %>
    <% if total.budget.nil? %>
      <%= render EmptyStateComponent.new(title: "Todavía no hay presupuesto general", icon: "circle-alert", tone: :amber, name: "finance-budget",
            text: "Lo fija el director de logística. Mientras tanto los gastos se presentan y aprueban igual; la barra de avance aparece en cuanto haya un monto.") do |empty| %>
        <% if can_configure_finances? %>
          <% empty.with_action { link_to "Fijarlo ahora", edit_finances_path, class: button_classes(:secondary) } %>
        <% end %>
      <% end %>
    <% else %>
      <div class="flex flex-wrap items-end justify-between gap-3 mb-3">
        <p class="text-stat font-extrabold tracking-tight tabular-nums text-ink-900"><%= money(total.budget) %></p>
        <p class="text-body font-semibold text-ink-500 tabular-nums">Disponible: <span class="font-bold text-ink-900" data-available><%= money(total.available) %></span></p>
      </div>
      <%= budget_bar(total) %>
      <% if @summary.assigned_cents > total.budget %>
        <p class="mt-3 text-label font-semibold text-cat-rose-ink">Los presupuestos de las categorías suman más que el general.</p>
      <% end %>
    <% end %>
  </section>

  <% if @summary.rows.any? %>
    <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" data-finance-categories>
      <% @summary.rows.each do |row| %>
        <div class="<%= card_classes("p-5") %>" data-category-row="<%= row.name.parameterize %>">
          <div class="flex items-center gap-3">
            <%= category_tile(row.category) %>
            <div class="min-w-0">
              <p class="text-title font-bold text-ink-900 truncate"><%= row.name %></p>
              <p class="text-label font-semibold text-ink-500 tabular-nums">
                <%= row.budget ? "de #{money(row.budget)}" : "sin presupuesto propio" %>
              </p>
            </div>
          </div>
          <p class="mt-1 text-display font-extrabold tabular-nums text-ink-900"><%= money(row.spent) %></p>
          <% if row.budget %>
            <div class="mt-2"><%= budget_bar(row) %></div>
            <p class="mt-1.5 text-label font-semibold <%= row.tone == :over ? "text-cat-rose-ink" : "text-ink-500" %> tabular-nums">
              <%= row.tone == :over ? "Pasado por #{money(-row.available)}" : "Quedan #{money(row.available)}" %>
            </p>
          <% end %>
          <p class="mt-1 text-label font-medium text-ink-500 tabular-nums">
            Ejecutado <%= money(row.executed) %> · comprometido <%= money(row.committed) %><%= " · por aprobar #{money(row.presented)}" if row.presented.positive? %>
          </p>
        </div>
      <% end %>
    </section>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    <section class="<%= card_classes("p-5 md:p-6") %>" data-waiting>
      <%= section_heading "Esperan aprobación", "hourglass" %>
      <%= render "expenses/compact_list", expenses: @waiting, empty: "Nada espera aprobación." %>
    </section>
    <section class="<%= card_classes("p-5 md:p-6") %>" data-missing-receipt>
      <%= section_heading "Aprobados sin factura", "receipt" %>
      <%= render "expenses/compact_list", expenses: @missing_receipt, empty: "Todos los gastos aprobados tienen su factura." %>
    </section>
  </div>
<% end %>
