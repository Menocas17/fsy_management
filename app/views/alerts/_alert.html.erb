<%
  compact = local_assigns.fetch(:compact, false)
  unread = local_assigns.fetch(:unread, false)
  # En la campanita y en Notificaciones cada quien puede quitar la alerta de su lista (no la borra para los demás).
  dismissible = local_assigns.fetch(:dismissible, false)
  # En Alertas (gestión) el mismo gesto borra la alerta para todos, así que pasa su propia ruta y confirmación.
  dismiss_path = local_assigns.fetch(:dismiss_path) { notification_path(alert) }
  dismiss_label = local_assigns.fetch(:dismiss_label, "Quitar «#{alert.title}» de mis notificaciones")
  dismiss_confirm = local_assigns.fetch(:dismiss_confirm, nil)
  dismiss_form_data = dismiss_confirm ? { turbo_confirm: dismiss_confirm } : {}
  # Toda la tarjeta lleva a lo que anuncia, salvo en la página de la alerta misma.
  linked = local_assigns.fetch(:linked, true)
%>
<% if dismissible %>
<%# En el celular se desliza a la izquierda y aparece «Eliminar» detrás; en escritorio, la X al pasar el ratón. %>
<div class="relative overflow-hidden" data-alert-item="<%= alert.id %>" data-controller="alert-item" <%= "data-alert-tutorial" if alert.source_tutorial? %>
     data-action="turbo:submit-start->alert-item#leave turbo:submit-end->alert-item#settle">
  <div class="absolute inset-y-0 right-0 flex" data-alert-item-target="actions" hidden>
    <%= button_to dismiss_path, method: :delete, form: { class: "flex", data: dismiss_form_data },
          class: "w-24 flex flex-col items-center justify-center gap-1 bg-danger text-white text-label font-bold cursor-pointer",
          data: { alert_swipe_delete: true } do %>
      <%= icon "trash-2", class: "w-5 h-5" %>
      Eliminar
    <% end %>
  </div>
<% end %>
<article class="group relative <%= compact ? "px-5 py-3.5" : "px-5 py-4 md:px-6" %> <%= unread ? "bg-primary-50 dark:bg-sunken" : "bg-surface" %> <%= "hover:bg-canvas dark:hover:bg-muted/60 has-[[data-alert-open]:focus-visible]:ring-2 has-[[data-alert-open]:focus-visible]:ring-inset has-[[data-alert-open]:focus-visible]:ring-primary-500 transition-colors" if linked %> <%= "touch-pan-y" if dismissible %>"
         data-alert-id="<%= alert.id %>" data-alert-priority="<%= alert.priority %>" <%= tag.attributes(data: { alert_item_target: "panel" }) if dismissible %>>
  <div class="flex items-start gap-3">
    <span class="mt-0.5 w-9 h-9 shrink-0 rounded-control flex items-center justify-center <%= alert.priority_styles %>">
      <%= icon alert.priority_critica? ? "triangle-alert" : "megaphone", class: "w-[18px] h-[18px]" %>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <p class="text-body font-bold text-ink-900">
          <% if linked %>
            <%# after:inset-0 estira el enlace sobre toda la tarjeta: se toca en cualquier parte. %>
            <%= link_to alert.title, alert_destination_path(alert), class: "after:absolute after:inset-0 focus:outline-none",
                  data: { alert_open: true, turbo_frame: "_top" } %>
          <% else %>
            <%= alert.title %>
          <% end %>
        </p>
        <div class="shrink-0 flex items-center gap-1">
          <%# The es locale defines no date formats, so format here instead of going through I18n. %>
          <time class="text-meta font-semibold text-ink-500" datetime="<%= alert.created_at.iso8601 %>">
            <%= alert.created_at.strftime("%d/%m · %H:%M") %>
          </time>
          <% if dismissible %>
            <%# Sobre el enlace estirado (relative z-10). En pantallas táctiles no hay hover: ahí se desliza. %>
            <%= button_to dismiss_path, method: :delete,
                  form: { class: "relative z-10 -my-1 -mr-1.5 [@media(hover:none)]:hidden", data: dismiss_form_data },
                  aria: { label: dismiss_label }, title: dismiss_confirm ? "Eliminar" : "Quitar",
                  class: "w-7 h-7 rounded-inner flex items-center justify-center text-ink-500 opacity-0 group-hover:opacity-100 focus-visible:opacity-100 hover:bg-line-soft hover:text-ink-900 cursor-pointer transition",
                  data: { alert_dismiss: true } do %>
              <%= icon "x", class: "w-4 h-4" %>
            <% end %>
          <% end %>
        </div>
      </div>
      <p class="mt-1 text-label leading-relaxed text-ink-700 <%= "line-clamp-2" if compact %>"><%= alert.body %></p>

      <% if !compact && alert.images.attached? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% alert.images.each do |image| %>
            <%= image_tag storage_url(image), class: "h-24 w-auto rounded-tile border border-line-soft object-cover", alt: "Imagen de la alerta #{alert.title}" %>
          <% end %>
        </div>
      <% end %>

      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-meta font-bold <%= alert.priority_styles %>"><%= alert.priority_label %></span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-meta font-semibold bg-muted text-ink-500 dark:text-ink-700"><%= alert.audience_label %></span>
        <% if alert.send_email? %>
          <span class="inline-flex items-center gap-1 text-meta font-semibold text-ink-500">
            <%= icon "mail", class: "w-3.5 h-3.5" %>
            También por correo
          </span>
        <% end %>
        <% if alert.source_agenda? %>
          <span class="inline-flex items-center gap-1 text-meta font-semibold text-ink-500">
            <%= icon "calendar-days", class: "w-3.5 h-3.5" %>
            Cambio de agenda
          </span>
        <% elsif alert.source_novedades? %>
          <span class="inline-flex items-center gap-1 text-meta font-semibold text-ink-500">
            <%= icon "sparkles", class: "w-3.5 h-3.5" %>
            Novedades de la app
          </span>
        <% elsif alert.source_asignacion? %>
          <span class="inline-flex items-center gap-1 text-meta font-semibold text-ink-500">
            <%= icon "clipboard-list", class: "w-3.5 h-3.5" %>
            Asignación
          </span>
        <% end %>
        <span class="text-meta font-semibold text-ink-500">· <%= alert.sender_name %></span>
      </div>
    </div>
  </div>
</article>
<% if dismissible %>
</div>
<% end %>
