<%
  compact = local_assigns.fetch(:compact, false)
  unread = local_assigns.fetch(:unread, false)
%>
<article class="<%= compact ? "px-5 py-3.5" : "px-5 py-4 md:px-6" %> <%= "bg-primary-50/70 dark:bg-primary-700/15" if unread %>"
         data-alert-id="<%= alert.id %>" data-alert-priority="<%= alert.priority %>">
  <div class="flex items-start gap-3">
    <span class="mt-0.5 w-9 h-9 shrink-0 rounded-[11px] flex items-center justify-center <%= alert.priority_styles %>">
      <%= icon alert.priority_critica? ? "triangle-alert" : "megaphone", class: "w-[18px] h-[18px]" %>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <p class="text-[13.5px] font-bold text-ink-900 dark:text-slate-100"><%= alert.title %></p>
        <%# The es locale defines no date formats, so format here instead of going through I18n. %>
        <time class="shrink-0 text-[11px] font-semibold text-ink-300 dark:text-slate-500" datetime="<%= alert.created_at.iso8601 %>">
          <%= alert.created_at.strftime("%d/%m · %H:%M") %>
        </time>
      </div>
      <p class="mt-1 text-[12.5px] leading-relaxed text-ink-700 dark:text-slate-300 <%= "line-clamp-2" if compact %>"><%= alert.body %></p>

      <% if alert.images.attached? && !compact %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% alert.images.each do |image| %>
            <%= image_tag image, class: "h-24 w-auto rounded-xl border border-line-soft dark:border-slate-700 object-cover", alt: "Imagen de la alerta #{alert.title}" %>
          <% end %>
        </div>
      <% end %>

      <div class="mt-2 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold <%= alert.priority_styles %>"><%= alert.priority_label %></span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-canvas dark:bg-slate-700 text-ink-500 dark:text-slate-300"><%= alert.audience_label %></span>
        <% if alert.send_email? %>
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-ink-500 dark:text-slate-400">
            <%= icon "mail", class: "w-3.5 h-3.5" %>
            También por correo
          </span>
        <% end %>
        <% if alert.source_agenda? %>
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-ink-500 dark:text-slate-400">
            <%= icon "calendar-days", class: "w-3.5 h-3.5" %>
            Cambio de agenda
          </span>
        <% elsif alert.source_asignacion? %>
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-ink-500 dark:text-slate-400">
            <%= icon "clipboard-list", class: "w-3.5 h-3.5" %>
            Asignación
          </span>
        <% end %>
        <span class="text-[11px] font-semibold text-ink-300 dark:text-slate-500">· <%= alert.sender_name %></span>
      </div>
    </div>
  </div>
</article>
