<% content_for :title, @alert.title %>
<% content_for :eyebrow, "Alertas" %>
<% content_for :heading, "Alerta" %>
<% back_to "Alertas", alerts_path %>
<%= render PageComponent.new(width: :form) do %>
  <div class="<%= card_classes("overflow-hidden") %>">
    <%= render "alerts/alert", alert: @alert, linked: false %>
  </div>
  <%= link_to notifications_path, class: "mt-5 inline-flex items-center gap-2 text-body font-semibold text-ink-500 hover:text-ink-900" do %>
    <%= icon "arrow-left", class: "w-4 h-4" %>
    Volver a notificaciones
  <% end %>
<% end %>
