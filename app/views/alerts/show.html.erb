<% content_for :title, @alert.title %>
<% content_for :eyebrow, "Alertas" %>
<% content_for :heading, "Alerta" %>
<%# Quien administra alertas llega desde su lista; los demás, desde la campanita (Alertas no la pueden abrir). %>
<% can_manage_alerts? ? back_to("Alertas", alerts_path) : back_to("Notificaciones", notifications_path) %>
<%= render PageComponent.new(width: :form) do %>
  <div class="<%= card_classes("overflow-hidden") %>">
    <%= render "alerts/alert", alert: @alert, linked: false %>
  </div>
<% end %>
