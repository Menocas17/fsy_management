<% content_for :title, "Alertas" %>
<% content_for :eyebrow, "Evento" %>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <p class="text-body font-medium text-ink-500" data-alerts-sent-total><%= pluralize(@pagy.count, "alerta enviada", plural: "alertas enviadas") %></p>
    <%= link_to new_alert_path, class: button_classes do %>
      <%= icon "plus", class: "w-4 h-4" %>
      Nueva alerta
    <% end %>
  </div>

  <div class="<%= card_classes("overflow-hidden") %>" data-alerts-sent-list>
    <% if @alerts.any? %>
      <div class="divide-y divide-line-soft">
        <% @alerts.each do |alert| %>
          <%# Igual que en Notificaciones: X al pasar el ratón, deslizar a la izquierda en el celular. Aquí borra para todos. %>
          <%= render "alerts/alert", alert: alert, dismissible: true, dismiss_path: alert_path(alert),
                dismiss_label: "Eliminar la alerta «#{alert.title}»",
                dismiss_confirm: "¿Eliminar la alerta «#{alert.title}»?" %>
        <% end %>
      </div>
      <% if @pagy.last > 1 %>
        <div class="flex items-center justify-between gap-3 px-5 py-4 border-t border-line-soft">
          <p class="text-label font-medium text-ink-500">Mostrando <%= @pagy.from %>–<%= @pagy.to %> de <%= @pagy.count %></p>
          <%== @pagy.series_nav(anchor_string: 'data-turbo-action="advance"') %>
        </div>
      <% end %>
    <% else %>
      <%= render "alerts/empty_state" %>
    <% end %>
  </div>
<% end %>
