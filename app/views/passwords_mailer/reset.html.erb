<% url = edit_password_url(@user.password_reset_token) %>
<% valid_for = "#{@user.password_reset_token_expires_in.in_minutes.to_i} minutos" %>
<% content_for :preheader, "Alguien pidió restablecer tu contraseña de #{Rails.configuration.x.event_name}. El enlace vale #{valid_for}." %>
<%= render "passwords_mailer/link_email",
      eyebrow: "Recuperar acceso", title: "Restablece tu contraseña",
      name: @user.participant&.first_name || @user.email_address,
      body: "Recibimos una solicitud para restablecer la contraseña de #{@user.email_address}. Elige una nueva con el botón; al guardarla se cierran tus sesiones abiertas.",
      button: "Restablecer contraseña", url: url, valid_for: valid_for,
      note: "Si no lo pediste tú, ignora este correo: tu contraseña actual sigue funcionando." %>
