<div class="px-3 md:px-7 pt-10">
  <div class="flex justify-between mb-5 px-3">
    <h1 class="font-bold text-2xl">Compañías</h1>
    <% if full_company_access? %>
      <%= render(ButtonComponent.new(text: "Nueva", url: new_company_path, type: "primary")) %>
    <% end %>
  </div>

  <% @auxiliar_companies.each do |ac| %>
    <section class="mb-8">
      <div class="flex items-center gap-2 mb-3 px-1">
        <%= image_tag "company.svg", class: "w-6 h-6 opacity-70" %>
        <h2 class="font-bold text-xl text-blue-950"><%= link_to ac.name, ac %></h2>
        <span class="text-sm text-gray-500">· <%= ac.companies.count %> compañía(s)</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <% ac.companies.each do |c| %>
          <%= render "companies/company_card", c: c %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @orphan_companies.any? %>
    <section class="mb-8">
      <h2 class="font-bold text-xl text-blue-950 mb-3 px-1">Sin compañía auxiliar</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        <% @orphan_companies.each do |c| %>
          <%= render "companies/company_card", c: c %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if @auxiliar_companies.empty? && @orphan_companies.empty? %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center text-gray-500">
      No hay compañías aún.
    </div>
  <% end %>
</div>
