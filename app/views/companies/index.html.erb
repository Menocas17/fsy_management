<% content_for :title, "Compañías" %>
<% content_for :eyebrow, "Participantes" %>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3">
    <%= form_with url: companies_path, method: :get, role: "search", class: "relative w-full lg:w-[320px] lg:shrink-0",
          data: { turbo_frame: "companies_grid", turbo_action: "advance", controller: "auto-submit" } do |form| %>
      <%= icon "search", class: "w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-500 pointer-events-none" %>
      <%= form.search_field :query, value: params[:query], autocomplete: "off",
            placeholder: "Buscar por número, nombre o consejero…", aria: { label: "Buscar compañías" },
            class: "w-full h-10 pl-10 pr-3 rounded-control bg-surface border border-line text-body text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500",
            data: { action: "input->auto-submit#typed" } %>
    <% end %>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to auxiliar_companies_path, class: button_classes(:secondary) do %>
        <%= icon "network", class: "w-4 h-4" %>
        Compañías auxiliares
      <% end %>
      <%= link_to overview_companies_path, class: button_classes(:secondary) do %>
        <%= icon "chart-column", class: "w-4 h-4" %>
        Vista general
      <% end %>
      <% if full_company_access? %>
        <%= link_to new_company_path, class: button_classes do %>
          <%= icon "plus", class: "w-4 h-4" %>
          Nueva compañía
        <% end %>
      <% end %>
    </div>
  </div>

  <%= turbo_frame_tag "companies_grid" do %>
    <%= render "companies/grid", companies: @companies, jovenes_counts: @jovenes_counts,
                                 room_counts: @room_counts, total_companies: @total_companies %>
  <% end %>
<% end %>
