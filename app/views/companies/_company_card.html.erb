<%
  counselors = company.counselors.sort_by { |counselor| counselor.gender == "H" ? 0 : 1 }
  stats = [
    [ jovenes_counts.fetch(company.id, 0), "Jóvenes" ],
    [ room_counts.fetch(company.id, 0), "Cuartos" ],
    [ company.dining_hall_label&.delete_prefix("Salón ") || "—", "Salón" ]
  ]
%>
<%= link_to company_path(company), data: { turbo_frame: "_top", company_card: company.number },
      class: card_classes("group block px-5 pt-[18px] pb-4 transition duration-200 hover:-translate-y-0.5 active:scale-[0.99] hover:shadow-lg focus:outline-none focus-visible:ring-3 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-canvas") do %>
  <div class="flex items-center gap-3">
    <span class="w-11 h-11 shrink-0 rounded-tile bg-brand-tile text-white text-[17px] font-extrabold flex items-center justify-center shadow-sm"><%= company.number || "–" %></span>
    <div class="min-w-0 flex-1">
      <p class="text-[15.5px] font-extrabold text-ink-900 truncate"><%= company.name %></p>
      <p class="mt-px text-[12px] font-semibold text-ink-500 truncate">
        <% if company.nickname.present? %>
          <span class="text-primary-600 dark:text-primary-300"><%= company.nickname %></span>
        <% else %>
          <span class="text-ink-500">Sin nombre elegido</span>
        <% end %>
        · <%= company.auxiliar_company&.name || "Sin compañía auxiliar" %>
      </p>
    </div>
    <%= render "companies/staff_status", company: company %>
  </div>

  <div class="flex items-center gap-2 mt-3.5 min-h-7">
    <% if counselors.any? %>
      <span class="flex shrink-0">
        <% counselors.each_with_index do |counselor, index| %>
          <span class="rounded-full ring-2 ring-surface <%= "-ml-2" if index.positive? %>">
            <%= render(AvatarComponent.new(participant: counselor, size: :sm)) %>
          </span>
        <% end %>
      </span>
      <span class="text-[12px] font-semibold text-ink-700 truncate"><%= counselors.map(&:full_name).join(" · ") %></span>
    <% else %>
      <span class="w-7 h-7 shrink-0 rounded-full border-[1.5px] border-dashed border-line"></span>
      <span class="text-[12px] font-semibold text-ink-500">Consejeros por asignar</span>
    <% end %>
  </div>

  <div class="grid grid-cols-3 gap-2 mt-3.5">
    <% stats.each do |value, label| %>
      <div class="px-1 py-2 rounded-control bg-canvas dark:bg-slate-900/60 text-center">
        <p class="<%= value.is_a?(String) ? "text-[12.5px] leading-[22px]" : "text-[15px] leading-[22px]" %> font-extrabold text-ink-900 truncate"><%= value %></p>
        <p class="text-[10.5px] font-semibold text-ink-500"><%= label %></p>
      </div>
    <% end %>
  </div>
<% end %>
