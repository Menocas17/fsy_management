<section class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 mb-6">
  <h3 class="font-bold text-xl mb-4">Asignación de personal</h3>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <% [ "consejero", "auxiliar", "participant" ].each do |role| %>
      <div>
        <p class="font-semibold text-gray-600 mb-2 capitalize"><%= role %></p>
        <div class="flex flex-col gap-2">
          <% c.memberships.includes(:participant).where(role: role).each do |m| %>
            <div class="flex items-center justify-between border border-gray-200 rounded-lg px-3 py-2 text-sm">
              <span class="truncate">
                <%= m.participant.full_name %>
                <span class="text-gray-400">(<%= m.participant.gender %>)</span>
              </span>
              <%= button_to "Quitar", remove_staff_company_path(c, membership_id: m.id), method: :delete, class: "text-rose-700 text-xs underline cursor-pointer shrink-0" %>
            </div>
          <% end %>
          <% remaining = (role != "participant" ? 2 : 0) - c.memberships.where(role: role).count %>
          <% [ remaining, 0 ].max.times do %>
            <div class="border border-dashed border-gray-300 rounded-lg px-3 py-2 text-gray-400 text-sm">Vacante</div>
          <% end %>
          <% if c.memberships.where(role: role).empty? && role == "participant" %>
            <div class="border border-dashed border-gray-300 rounded-lg px-3 py-2 text-gray-400 text-sm">Sin jóvenes</div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-5 border-t border-gray-100 pt-4">
    <h4 class="font-semibold text-gray-600 mb-2">Agregar miembro</h4>
    <%= form_with url: assign_staff_company_path(c), method: :post, class: "flex gap-3 items-end" do |f| %>
      <div class="flex-1">
        <%= f.label :participant_id, "Participante", class: "block text-sm font-medium mb-1" %>
        <%= f.select :participant_id,
            options_for_select(
              Participant.staff.map { |p| [ "#{p.full_name} · #{p.rol} · #{p.gender}", p.id ] }
            ),
            { prompt: "Selecciona un participante" },
            class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm" %>
      </div>
      <%= f.submit "Asignar", class: "bg-primary-600 text-white py-2 px-4 rounded-lg text-sm font-bold cursor-pointer" %>
    <% end %>
  </div>
</section>
