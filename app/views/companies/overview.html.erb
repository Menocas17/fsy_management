<% content_for :title, "Vista general" %>
<% content_for :eyebrow, "Compañías" %>
<%
  secondary_link = button_classes(:secondary)
  counselor_total = @companies.sum { |company| company.counselors.size }
  men = @companies.map { |company| @gender_counts.fetch([ company.id, "H" ], 0) }
  women = @companies.map { |company| @gender_counts.fetch([ company.id, "M" ], 0) }
  kpis = [
    [ "Compañías auxiliares", @auxiliar_companies.size, "network", :indigo, "Auxiliares" ],
    [ "Compañías", @companies.size, "building-2", :blue, "Compañías" ],
    [ "Consejeros asignados", "#{counselor_total}/#{@companies.size * 2}", "user-check", :green, "Consejeros" ],
    [ "Jóvenes en compañías", @jovenes_counts.values.sum, "users", :amber, "Jóvenes" ]
  ]
  dining_colors = { "Salón Nicaragua" => ChartsHelper.hex("blue"), "Salón Las Américas" => ChartsHelper.hex("indigo") }
  groups = @auxiliar_companies.map { |auxiliar_company| [ auxiliar_company, @companies.select { |company| company.auxiliar_company_id == auxiliar_company.id } ] }
  orphans = @companies.select { |company| company.auxiliar_company_id.nil? }
  groups << [ nil, orphans ] if orphans.any?
%>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-wrap justify-end gap-2">
    <%= link_to companies_path, class: secondary_link do %>
      <%= icon "building-2", class: "w-4 h-4" %>
      Compañías
    <% end %>
    <%= link_to auxiliar_companies_path, class: secondary_link do %>
      <%= icon "network", class: "w-4 h-4" %>
      Compañías auxiliares
    <% end %>
  </div>

  <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
    <% kpis.each do |label, value, icon_name, tone, short| %>
      <%= render StatTileComponent.new(value: value, label: label, short_label: short, icon: icon_name, tone: tone, value_data: { overview_kpi: label.parameterize }) %>
    <% end %>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-4 md:gap-5">
    <div class="<%= card_classes("min-w-0 p-5 md:p-6") %>">
      <%= section_heading "Jóvenes por compañía y género", "venus-and-mars", tone: :rose %>
      <% if @companies.any? %>
        <%= tag.div role: "img",
              aria: { label: "Jóvenes por compañía y género. " + @companies.each_with_index.map { |company, index| "#{company.name}: #{men[index]} hombres y #{women[index]} mujeres" }.join(", ") },
              data: { controller: "chart", chart_kind_value: "stacked",
                      chart_labels_value: @companies.map { |company| company.number&.to_s || company.name },
                      chart_series_value: [ { name: "Hombres", data: men }, { name: "Mujeres", data: women } ],
                      chart_colors_value: [ gender_chart_color("H"), gender_chart_color("M") ], chart_radius_value: 5, chart_column_width_value: "55%", chart_height_value: 280 } do %>
          <div data-chart-target="canvas" class="min-h-[280px]"></div>
        <% end %>
        <p class="mt-1 text-label font-medium text-ink-500">Cada columna es una compañía (por número). Ayuda a equilibrar el tamaño y los cuartos por género.</p>
      <% else %>
        <%= render EmptyStateComponent.new(title: "Aún no hay compañías", icon: "building-2", name: "overview-companies") %>
      <% end %>
    </div>

    <div class="<%= card_classes("min-w-0 flex flex-col p-5 md:p-6") %>">
      <%= section_heading "Jóvenes por salón", "hand-platter", tone: :amber %>
      <% if @dining_counts.values.sum.positive? %>
        <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row items-center gap-6 flex-1">
          <%= tag.div class: "w-[180px] shrink-0", role: "img",
                aria: { label: "Jóvenes por salón. #{chart_summary(@dining_counts.keys, @dining_counts.values)}" },
                data: { controller: "chart", chart_kind_value: "donut",
                        chart_labels_value: @dining_counts.keys, chart_series_value: @dining_counts.values,
                        chart_colors_value: @dining_counts.keys.map { |label| dining_colors.fetch(label, ChartsHelper.hex("neutral")) }, chart_height_value: 180 } do %>
            <div data-chart-target="canvas" class="min-h-[180px]"></div>
          <% end %>
          <ul class="w-full sm:w-auto flex flex-col gap-2.5" aria-hidden="true">
            <% @dining_counts.each do |label, count| %>
              <li class="flex items-center gap-2 text-label font-semibold text-ink-700">
                <span class="w-2 h-2 rounded-full shrink-0" style="background: <%= dining_colors.fetch(label, ChartsHelper.hex("neutral")) %>"></span>
                <%= label %>
                <span class="ml-auto pl-4 tabular-nums text-ink-500"><%= count %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <div class="flex-1"><%= render EmptyStateComponent.new(title: "Aún no hay jóvenes con salón", text: "Aparecen cuando su compañía tiene un salón asignado.", icon: "hand-platter", tone: :amber, name: "overview-dining") %></div>
      <% end %>
    </div>
  </section>

  <section class="<%= card_classes("p-5 md:p-6") %>">
    <%= section_heading "Estado por compañía", "list-checks", tone: :indigo %>
    <%# En el teléfono la tabla (760 px) obligaba a desplazarse de lado y partía los nombres: va como lista, cada
        compañía en una tarjeta con sus datos en una línea que se acomoda sola. %>
    <div class="md:hidden flex flex-col gap-4" data-overview-list>
      <% groups.each do |auxiliar_company, companies| %>
        <div>
          <p class="px-3 py-2 rounded-inner bg-sunken text-label font-bold text-ink-700">
            <% if auxiliar_company %>
              <%= link_to auxiliar_company.name, auxiliar_company, class: "hover:underline" %>
              <span class="block font-semibold text-ink-500">Auxiliares: <%= auxiliar_company.auxiliars.map(&:full_name).join(", ").presence || "sin asignar" %></span>
            <% else %>
              Sin compañía auxiliar
            <% end %>
          </p>
          <ul class="divide-y divide-line-soft">
            <% companies.each do |company| %>
              <li>
                <%= link_to company_path(company, return_to: return_here), class: "flex items-start gap-3 px-1 py-3", data: { overview_card: company.number } do %>
                  <span class="min-w-0 flex-1">
                    <span class="block text-body font-bold text-ink-900"><%= company.name %></span>
                    <span class="block text-label font-semibold text-ink-500 truncate"><%= company.nickname.presence || "Sin nombre elegido" %></span>
                    <span class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-label text-ink-700 tabular-nums">
                      <span class="whitespace-nowrap"><%= company.counselors.size %>/2 consejeros</span>
                      <span class="whitespace-nowrap"><b class="text-ink-900"><%= @jovenes_counts.fetch(company.id, 0) %></b> jóvenes (<%= @gender_counts.fetch([ company.id, "H" ], 0) %> H · <%= @gender_counts.fetch([ company.id, "M" ], 0) %> M)</span>
                      <span class="whitespace-nowrap"><%= pluralize(@room_counts.fetch(company.id, 0), "cuarto") %></span>
                      <% if company.dining_hall_label %><span class="whitespace-nowrap"><%= company.dining_hall_label %></span><% end %>
                    </span>
                  </span>
                  <%= render "companies/staff_status", company: company %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
    <div class="max-md:hidden overflow-x-auto">
      <table class="w-full min-w-[760px] text-left">
        <thead>
          <tr class="text-meta tracking-[.06em] uppercase text-ink-500">
            <th scope="col" class="pb-2.5 px-3 font-bold">Compañía</th>
            <th scope="col" class="pb-2.5 px-3 font-bold">Consejeros</th>
            <th scope="col" class="pb-2.5 px-3 font-bold">Jóvenes</th>
            <th scope="col" class="pb-2.5 px-3 font-bold">Hombres / Mujeres</th>
            <th scope="col" class="pb-2.5 px-3 font-bold">Cuartos</th>
            <th scope="col" class="pb-2.5 px-3 font-bold">Salón</th>
            <th scope="col" class="pb-2.5 px-3 font-bold">Estado</th>
          </tr>
        </thead>
        <tbody>
          <% groups.each do |auxiliar_company, companies| %>
            <tr class="bg-sunken">
              <td colspan="7" class="px-3 py-2 text-label font-bold text-ink-700">
                <% if auxiliar_company %>
                  <%= link_to auxiliar_company.name, auxiliar_company, class: "hover:underline" %>
                  <span class="font-semibold text-ink-500">· Auxiliares: <%= auxiliar_company.auxiliars.map(&:full_name).join(", ").presence || "sin asignar" %></span>
                <% else %>
                  Sin compañía auxiliar
                <% end %>
              </td>
            </tr>
            <% companies.each do |company| %>
              <tr class="border-t border-line-soft text-body text-ink-700" data-overview-row="<%= company.number %>">
                <td class="px-3 py-2.5">
                  <%= link_to company_path(company, return_to: return_here), class: "group block" do %>
                    <span class="block font-bold text-ink-900 group-hover:underline"><%= company.name %></span>
                    <span class="block text-label font-semibold text-ink-500"><%= company.nickname.presence || "Sin nombre elegido" %></span>
                  <% end %>
                </td>
                <td class="px-3 py-2.5 tabular-nums"><%= company.counselors.size %>/2</td>
                <td class="px-3 py-2.5 font-bold text-ink-900 tabular-nums"><%= @jovenes_counts.fetch(company.id, 0) %></td>
                <td class="px-3 py-2.5 tabular-nums"><%= @gender_counts.fetch([ company.id, "H" ], 0) %> / <%= @gender_counts.fetch([ company.id, "M" ], 0) %></td>
                <td class="px-3 py-2.5 tabular-nums"><%= @room_counts.fetch(company.id, 0) %></td>
                <td class="px-3 py-2.5"><%= company.dining_hall_label || "—" %></td>
                <td class="px-3 py-2.5"><%= render "companies/staff_status", company: company %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
