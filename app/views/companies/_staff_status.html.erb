<%
  label, classes = {
    complete: [ "Completa", "bg-cat-green/15 text-cat-green-ink" ],
    missing_counselor: [ "Falta consejero", "bg-cat-amber/20 text-cat-amber-ink" ],
    no_counselors: [ "Sin consejeros", "bg-cat-rose/15 text-cat-rose-ink" ]
  }.fetch(company.staff_status)
%>
<span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-meta font-bold whitespace-nowrap <%= classes %>"><%= label %></span>
