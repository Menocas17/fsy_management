<% if participants.load.any? %>
  <%# Tabla en la compu y lista en el teléfono; al teléfono que lo dice (DeviceHelper) solo le va la suya. %>
  <% if render_desktop_layout? %>
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="text-meta tracking-[.06em] uppercase text-ink-500">
          <th scope="col" class="pb-2.5 pr-4 font-bold">Nombre</th>
          <th scope="col" class="pb-2.5 pr-4 font-bold">Estaca / Distrito</th>
          <th scope="col" class="pb-2.5 pr-4 font-bold">Edad</th>
          <th scope="col" class="pb-2.5 font-bold">Cuarto</th>
        </tr>
      </thead>
      <tbody>
        <% participants.each do |participant| %>
          <tr class="border-t border-line-soft" data-participant-row>
            <td class="py-2.5 pr-4">
              <%= link_to participant_path(participant, return_to: request.fullpath), data: { turbo_frame: "_top" },
                    class: "group flex items-center gap-2.5 min-w-0" do %>
                <%= render(AvatarComponent.new(participant: participant, size: :sm)) %>
                <span class="truncate text-body font-semibold text-ink-900 group-hover:underline"><%= participant.full_name %></span>
              <% end %>
            </td>
            <td class="py-2.5 pr-4"><%= render(StakeSpanComponent.new(stake: participant.stake, name: participant.stake_name)) %></td>
            <td class="py-2.5 pr-4 text-body text-ink-700 tabular-nums"><%= participant.age %></td>
            <td class="py-2.5 text-body font-bold text-ink-900"><%= participant.room.presence || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% end %>

  <ul class="<%= layout_split("md:hidden") %> divide-y divide-line-soft">
    <% participants.each do |participant| %>
      <li>
        <%= link_to participant_path(participant, return_to: request.fullpath), data: { turbo_frame: "_top" },
              class: "flex items-center gap-3 py-2.5" do %>
          <%= render(AvatarComponent.new(participant: participant)) %>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-body font-bold text-ink-900"><%= participant.full_name %></span>
            <span class="block text-label font-semibold text-ink-500">
              <%= [ participant.stake_name, participant.age && "#{participant.age} años" ].compact.join(" · ") %>
            </span>
          </span>
          <span class="text-body font-bold text-ink-900"><%= participant.room.presence || "—" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mt-3 pt-4 border-t border-line-soft">
    <p class="text-label font-medium text-ink-500">Mostrando <%= pagy.from %>–<%= pagy.to %> de <%= pagy.count %></p>
    <% if pagy.last > 1 %>
      <div class="overflow-x-auto"><%== pagy.series_nav(anchor_string: 'data-turbo-action="advance"') %></div>
    <% end %>
  </div>
<% else %>
  <%= render EmptyStateComponent.new(icon: params[:query].present? ? "search-x" : "users", tone: :green, name: "company-participants",
        title: params[:query].present? ? "Ningún joven coincide con “#{params[:query]}”" : "Esta compañía aún no tiene jóvenes asignados") %>
<% end %>
