<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Jóvenes y cuartos", "users" %>
  <div class="grid grid-cols-2 gap-2.5">
    <% [ [ company.participants.count, "Jóvenes" ], [ company.room_occupancy.size, "Cuartos" ] ].each do |value, label| %>
      <div class="px-3.5 py-3 rounded-[13px] bg-canvas dark:bg-slate-900/60">
        <p class="text-xl font-extrabold text-ink-900 dark:text-slate-100 tabular-nums"><%= value %></p>
        <p class="text-[11.5px] font-semibold text-ink-500 dark:text-slate-400"><%= label %></p>
      </div>
    <% end %>
  </div>
  <p class="mt-3.5 flex gap-2 rounded-[13px] px-3.5 py-3 bg-primary-50 text-primary-700 dark:bg-primary-700/25 dark:text-primary-100 text-[12.5px] font-semibold leading-snug">
    <%= icon "info", class: "w-4 h-4 mt-0.5 shrink-0" %>
    <span>Los jóvenes y sus cuartos se asignan desde el perfil de cada participante.</span>
  </p>
  <%= link_to "Ver jóvenes de la compañía", company_path(company, anchor: "participantes"),
        class: "mt-3.5 w-full inline-flex items-center justify-center h-10 rounded-[11px] border border-line dark:border-slate-600 bg-surface dark:bg-slate-800 text-sm font-semibold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 transition" %>
</section>
