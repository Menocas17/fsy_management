<% content_for :title, "Editar #{@company.name}" %>
<% content_for :eyebrow, "Compañías" %>
<% content_for :heading, "Editar compañía" %>
<% back_to @company.name, company_path(@company) %>
<%= render PageComponent.new(width: :page) do %>
  <%= render "companies/form_banner", company: @company %>
  <%= render "companies/form", company: @company %>

  <div class="mt-5 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-5 items-start">
    <%= render "companies/staff", company: @company, counselors: @counselors, auxiliars: @auxiliars,
               membership_ids: @counselor_membership_ids, candidates: @counselor_candidates %>
    <%= render "companies/jovenes_summary", company: @company %>
  </div>

  <%= render "companies/form_actions", company: @company %>
<% end %>
