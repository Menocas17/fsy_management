<% content_for :title, "Jóvenes" %>
<% content_for :eyebrow, "Participantes" %>
<%= render PageComponent.new(width: :page) do |page| %>
  <% page.with_intro { pluralize(@pagy.count, "joven registrado", plural: "jóvenes registrados") } %>
  <% if can_create_participants? %>
    <% page.with_actions do %>
      <%= link_to new_participant_path, class: button_classes do %>
        <%= icon "plus", class: "size-4" %>
        Nuevo participante
      <% end %>
    <% end %>
  <% end %>
  <%= render "filters", form_url: participants_path %>
  <%= turbo_frame_tag "participants_table" do %>
    <%= render "results", participants: @participants, pagy: @pagy, is_staff: false,
                          empty_message: "No hay jóvenes que coincidan con la búsqueda." %>
  <% end %>
<% end %>
