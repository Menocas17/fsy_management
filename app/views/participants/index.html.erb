<div class="px-3 md:px-7 pt-10">
  <div class="flex justify-between mb-5 px-3">
    <% if Current.user&.admin_or_staff_manager? %>
      <%= render(ButtonComponent.new(text: "Nuevo", url: new_participant_path, type: "primary")) %>
    <% end %>
  </div>
  <%= render "filters", form_url: participants_path %>
  <%= turbo_frame_tag "participants_table" do %>
    <%= render(TableComponent.new(participants: @participants)) %>
  <% end %>
</div>
