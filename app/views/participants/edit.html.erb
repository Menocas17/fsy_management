<% content_for :title, "Editar participante" %>
<% content_for :eyebrow, "Participantes" %>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-6xl mx-auto space-y-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p class="min-w-0 text-[13px] text-ink-500 dark:text-slate-400 truncate">Editando el registro de <span class="font-semibold text-ink-700 dark:text-slate-200"><%= @participant.full_name %></span></p>
    <%= link_to safe_return_to(dashboard_path),
          class: "inline-flex items-center gap-2 text-[13px] font-semibold text-ink-500 dark:text-slate-400 hover:text-ink-900 dark:hover:text-slate-100" do %>
      <%= icon "arrow-left", class: "w-4 h-4" %>
      Volver
    <% end %>
  </div>
  <%= render "participants/form/form", participant: @participant %>
  <%= render "participants/form/form_actions", participant: @participant %>
</div>
