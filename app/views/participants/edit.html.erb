<% content_for :title, "Editar participante" %>
<% content_for :eyebrow, "Participantes" %>
<% params[:from] == "myprofile" ? back_to("Mi perfil", myprofile_participants_path) : back_to(@participant.first_name, participant_path(@participant, from: params[:from])) %>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-6xl mx-auto space-y-5">
  <%# El volver vive en la barra superior; aquí solo queda de quién es la ficha que se está editando. %>
  <p class="min-w-0 text-[13px] text-ink-500 truncate">Editando el registro de <span class="font-semibold text-ink-700 dark:text-slate-200"><%= @participant.full_name %></span></p>
  <%= render "participants/form/form", participant: @participant %>
  <%= render "participants/form/form_actions", participant: @participant %>
</div>
