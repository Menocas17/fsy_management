<%= link_to participant_path(participant, from: is_staff ? "staff" : "jovenes", return_to: list_path),
      data: { turbo_frame: "_top" },
      class: card_classes("flex items-center gap-3 p-3.5 mb-2.5") do %>
  <%= render(AvatarComponent.new(participant: participant)) %>
  <div class="flex-1 min-w-0">
    <p class="text-body font-bold text-ink-900 truncate"><%= participant.full_name %></p>
    <div class="flex flex-wrap items-center gap-1.5 mt-1">
      <% if is_staff %>
        <%= render(RoleSpanComponent.new(role: participant.rol)) %>
      <% else %>
        <%= render(StakeSpanComponent.new(stake: participant.stake)) %>
        <span class="text-label font-semibold text-ink-500"><%= participant.age %> años</span>
      <% end %>
    </div>
  </div>
  <div class="text-right shrink-0">
    <p class="text-label font-bold text-ink-900"><%= participant.company&.name || "Sin compañía" %></p>
    <% if participant.room.present? %>
      <p class="text-meta font-semibold text-ink-500 mt-0.5">Cuarto <%= participant.room %></p>
    <% end %>
  </div>
<% end %>
