<%# Lo de adentro del diálogo del QR (participants/_qr_dialog): en línea, o por ParticipantQrsController al abrirlo. %>
<%# Margen a ambos lados del ancho del botón de cerrar: el título sigue centrado y un nombre largo baja de línea en vez de quedar debajo de la X. %>
<h2 class="mb-4 px-9 pt-1 text-title font-bold text-balance break-words text-ink-900">Código de <%= participant.full_name %></h2>
<%= qr_svg_tag participant_url(participant), label: "Código QR de #{participant.full_name}", size: 200 %>
<%# El código corto, por si el QR no se lee: se escribe en el campo del escáner. %>
<% if participant.code.present? %>
  <p class="mt-3 font-mono text-display font-bold tracking-[.08em] text-ink-900" data-badge-code><%= participant.code %></p>
<% end %>
<p class="mt-2 text-body font-bold text-ink-900"><%= participant.full_name %></p>
<p class="mt-0.5 text-label font-semibold text-ink-500">
  <%= [ participant.role_label, participant.company&.name, participant.room.presence && "Cuarto #{participant.room}" ].compact.join(" · ") %>
</p>
<p class="mt-3 text-label text-ink-500">Al escanearlo se abre esta ficha. Si no se lee, escribe el código en el escáner.</p>
