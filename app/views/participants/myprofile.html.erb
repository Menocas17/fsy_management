<% content_for :title, "Mi perfil" %>
<% content_for :eyebrow, "Cuenta" %>
<% content_for :page_h1, "true" %>
<% if @participant %>
  <%= render "participants/profile/profile", participant: @participant, show_back: false, edit_from: "myprofile" %>
<% else %>
  <div class="px-4 md:px-8 pt-10 pb-10 max-w-xl mx-auto">
    <div class="<%= card_classes("p-8 text-center") %>">
      <span class="mx-auto w-12 h-12 rounded-full flex items-center justify-center bg-primary-50 text-primary-600 dark:bg-primary-700/30 dark:text-primary-100">
        <%= icon "key-round", class: "w-5 h-5" %>
      </span>
      <h1 class="mt-4 text-lg font-bold text-ink-900 dark:text-slate-100">Administrador del sistema</h1>
      <p class="mt-1.5 text-sm text-ink-500 dark:text-slate-400">Esta cuenta no tiene un perfil de participante vinculado.</p>
    </div>
  </div>
<% end %>
