<%= form_with model: participant, id: "participant-form", class: "space-y-5" do |form| %>
  <%= hidden_field_tag :from, params[:from] %>
  <% if form.object.errors.any? %>
    <div class="rounded-[14px] border border-cat-rose/30 bg-cat-rose/10 px-5 py-3 text-sm font-semibold text-cat-rose" role="alert">
      <%= form.object.errors.full_messages.first %>
    </div>
  <% end %>

  <%= render "participants/form/essential_info_form", form: form %>

  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] gap-5 items-start">
    <div class="space-y-5">
      <%= render "participants/form/general_info_form", form: form %>
      <%= render "participants/form/asignaciones_form", form: form %>
    </div>
    <div class="space-y-5">
      <%= render "participants/form/contact_info_form", form: form %>
      <%= render "participants/form/medical_info_form", form: form %>
      <%= render "participants/form/note_info_form", form: form %>
    </div>
  </div>
<% end %>
