<div class="<%= card_classes("px-5 py-4 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3") %>">
  <div class="flex flex-wrap items-center gap-2">
    <% if participant.persisted? && can_delete_participant?(participant) %>
      <%= button_to participant_path(participant), method: :delete,
            form: { data: { turbo_confirm: "¿Seguro que deseas borrar este registro? Esta acción es irreversible." } },
            class: "inline-flex items-center gap-2 h-10 px-3 rounded-control text-sm font-semibold text-cat-rose-ink hover:bg-cat-rose/10 transition cursor-pointer" do %>
        <%= icon "trash-2", class: "w-4 h-4" %>
        Borrar participante
      <% end %>
    <% end %>
    <%# Solo en la propia ficha: la contraseña de otro no se toca desde aquí. %>
    <% if participant.persisted? && participant == Current.user&.participant %>
      <%= link_to edit_password_change_path,
            class: "inline-flex items-center gap-2 h-10 px-4 rounded-control border border-line text-sm font-semibold text-ink-700 hover:bg-canvas dark:hover:bg-slate-700 transition cursor-pointer" do %>
        <%= icon "key-round", class: "w-4 h-4" %>
        Cambiar contraseña
      <% end %>
    <% end %>
  </div>
  <div class="flex gap-2.5 sm:justify-end">
    <%# Sin return_to, cancelar vuelve a la ficha que se editaba o a la lista de la que se vino, no a Inicio. %>
    <% cancel_fallback = if participant.persisted? then participant_path(participant)
                         elsif params[:from] == "staff" then staff_participants_path
                         else participants_path end %>
    <%= link_to "Cancelar", safe_return_to(cancel_fallback),
          class: button_classes(:secondary, extra: "flex-1 sm:flex-none") %>
    <button type="submit" form="participant-form" data-turbo-submits-with="Guardando…"
            class="<%= button_classes(:primary, extra: "flex-1 sm:flex-none") %>">
      <%= icon "check", class: "w-4 h-4" %>
      <%= submit_button_text(participant) %>
    </button>
  </div>
</div>
