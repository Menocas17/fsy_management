<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Médico", "shield-plus" %>
  <div class="space-y-4">
    <div>
      <%= form.label :allergies, "Alergias", class: field_label_classes %>
      <%= form.text_area :allergies, rows: 2, class: field_textarea_classes, placeholder: "Ninguna" %>
    </div>
    <div>
      <%= form.label :medicines, "Medicinas", class: field_label_classes %>
      <%= form.text_area :medicines, rows: 2, class: field_textarea_classes, placeholder: "Ninguna" %>
    </div>
    <div>
      <%= form.label :diet, "Dieta", class: field_label_classes %>
      <%= form.text_area :diet, rows: 2, class: field_textarea_classes, placeholder: "Sin restricciones" %>
    </div>
  </div>
</section>
