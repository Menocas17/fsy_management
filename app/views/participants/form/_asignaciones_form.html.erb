<%# Assignments are managed from the profile card, where they can be added, confirmed and removed one by one. %>
<% participant = form.object %>
<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Asignaciones", "clipboard-check" %>
  <p class="-mt-1 text-body leading-relaxed text-ink-500">
    Las asignaciones se agregan desde el perfil: se eligen de la agenda o se crean aparte, con su hora y lugar.
  </p>
  <% if participant.persisted? %>
    <p class="mt-3 text-body font-semibold text-ink-700">
      <%= pluralize(participant.assignments.count, "asignación registrada", plural: "asignaciones registradas") %>.
    </p>
    <%= link_to participant_path(participant, anchor: "asignaciones"),
          class: button_classes(:secondary, extra: "mt-3") do %>
      <%= icon "clipboard-list", class: "w-4 h-4" %>
      Ver asignaciones en el perfil
    <% end %>
  <% else %>
    <p class="mt-3 text-body text-ink-500">Primero guarda el registro; después podrás asignarle tareas desde su perfil.</p>
  <% end %>
</section>
