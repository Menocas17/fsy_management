<%# No assignments model exists yet: this is a disabled preview, and its inputs have no name so nothing is submitted. %>
<section class="<%= card_classes("p-6") %>">
  <div class="flex items-start justify-between gap-3">
    <%= section_heading "Asignaciones", "clipboard-check" %>
    <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full bg-primary-50 dark:bg-primary-700/30 text-[11px] font-bold text-primary-600 dark:text-primary-100">Próximamente</span>
  </div>
  <p class="-mt-1 text-[13px] leading-relaxed text-ink-500 dark:text-slate-400">
    Pronto podrás registrar la asignación actual de cada participante —tarea, hora, lugar y fecha— y consultar su historial.
  </p>
  <fieldset disabled class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4 opacity-60">
    <div class="sm:col-span-2">
      <span class="<%= field_label_classes %>">Asignación actual</span>
      <input type="text" class="<%= field_input_classes %>" placeholder="Ej. Primera oración en el devocional" aria-label="Asignación actual">
    </div>
    <div>
      <span class="<%= field_label_classes %>">Hora</span>
      <input type="text" class="<%= field_input_classes %>" placeholder="Ej. 6:30 a.m." aria-label="Hora">
    </div>
    <div>
      <span class="<%= field_label_classes %>">Fecha</span>
      <input type="text" class="<%= field_input_classes %>" placeholder="Ej. Miércoles, 18 de marzo" aria-label="Fecha">
    </div>
    <div class="sm:col-span-2">
      <span class="<%= field_label_classes %>">Lugar</span>
      <input type="text" class="<%= field_input_classes %>" placeholder="Ej. Auditorio principal" aria-label="Lugar">
    </div>
  </fieldset>
</section>
