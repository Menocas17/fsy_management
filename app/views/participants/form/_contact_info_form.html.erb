<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Contacto", "phone" %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :phone_number, "Número de teléfono", class: field_label_classes %>
      <%= form.phone_field :phone_number, class: field_input_classes, autocomplete: "tel", placeholder: "+505 0000 0000" %>
    </div>
    <div>
      <%= form.label :email_address, "Correo electrónico", class: field_label_classes %>
      <%= form.email_field :email_address, class: field_input_classes, autocomplete: "email", placeholder: "correo@ejemplo.com" %>
    </div>
  </div>

  <div class="mt-5 pt-4 border-t border-line-soft dark:border-slate-700">
    <h3 class="mb-3 text-[11px] font-bold tracking-[.07em] uppercase text-amber-700 dark:text-cat-amber">Contacto de emergencia</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :emergency_contact_number, "Número", class: field_label_classes %>
        <%= form.phone_field :emergency_contact_number, class: field_input_classes, placeholder: "+505 0000 0000" %>
      </div>
      <div>
        <%= form.label :emergency_contact_name, "Nombre", class: field_label_classes %>
        <%= form.text_field :emergency_contact_name, class: field_input_classes, placeholder: "Nombre completo" %>
      </div>
      <div class="sm:max-w-xs">
        <%= form.label :emergency_contact_relation, "Parentesco", class: field_label_classes %>
        <%= form.text_field :emergency_contact_relation, class: field_input_classes, placeholder: "Ej. Madre, Padre, Tutor" %>
      </div>
    </div>
  </div>
</section>
