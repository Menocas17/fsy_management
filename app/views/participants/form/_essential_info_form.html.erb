<section class="flex flex-col md:flex-row gap-5 md:gap-30 border-t-2 border-b-2 justify-left py-4 mx-3  border-gray-300 ">
  <legend class="font-bold mt-5 text-3xl md:text-xl">Esencial</legend>
  <fieldset class="flex-1">
    <% if Current.user.admin_or_staff_manager?%>
      <div class="mb-4">
        <%= form.label :first_name, class:" font-semibold block mb-1"%>
        <%= form.text_field :first_name, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm md:max-w-3/4" %>
      </div>
      <div class="mb-4">
        <%= form.label :last_name, class:" font-semibold block mb-1"%>
        <%= form.text_field :last_name, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm md:max-w-3/4"%>
      </div>
      <div class="mb-4">
        <%= form.label :rol, class:" font-semibold block mb-1"%>
        <%= form.select :rol, Participant.rols.keys.map { |key| [key.titleize, key]}, {prompt: "Seleciona un rol"}, {class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm md:max-w-3/4"}%>
      </div>
    <%end%>
    <div class="mb-4">
      <%= form.label :avatar, class:" font-semibold block mb-3"%>
      <%= form.file_field :avatar, accept: "image/*", class: "block w-full text-sm text-gray-500 md:max-w-3/4 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border file:border-gray-200 file:text-sm file:font-semibold file:bg-gray-100 file:text-black hover:file:bg-gray-300 transition file:cursor-pointer" %>
    </div>
  </fieldset>
</section>