<div class="min-h-100 rounded-xl border border-gray-200 pb-5 shadow-md">
  <%= render "participants/profile/profile_banner", participant: @participant%>
  <div class="grid grid-cols-[1fr_1fr_2fr] px-10 gap-4">
    <%= render "participants/profile/general_info", participant: @participant%>
    <%= render "participants/profile/contact_info", participant: @participant%>
    <%= render "participants/profile/medical_info", participant: @participant%>
  </div>
  <%# this is the adittional notes section %>
  <section class="border border-gray-200 bg-white rounded-xl shadow-[0_0_4px_#0000001a] mt-3 mx-10">
    <h3 class="font-bold text-lg bg-[#0A5681] px-3 py-2 rounded-t-xl text-white">Notas Adicionales</h3>
    <p class="font-thin italic text-center p-4">
      <% if @participant.additional_instructions.present?%>
        <%= check_notes(@participant.additional_instructions)%>
      <%else%>
        No hay notas adicional
      <%end%>
    </p>
  </section>
</div>
