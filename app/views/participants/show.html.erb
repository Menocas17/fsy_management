<%# //TODO - Separate this view into partilas for better maintenance %>
<div class=" max-w-255 mx-auto min-h-100 rounded-xl border border-gray-200 pb-5 shadow-md mt-5">
  <%# This is the banner profile photo section %>
  <%# This div contains the thumbnail shpown in the profile but also all the logic for openind a dialog to show the full picture %>
  <div class="relative h-32 w-full bg-fsy-pattern bg-repeat-space bg-center rounded-t-xl shadow-md" data-controller="dialog">
    <button type="button" data-action="click->dialog#open" class="absolute -bottom-20 left-5 z-10 cursor-pointer group rounded-full focus:outline-none">
      <%= avatar_for(@participant, class: "w-24 h-24 rounded-full border-4 border-white shadow-md object-cover group-hover:brightness-95 transition") %>
    </button>
    <%# This is the modal/dialog %>
    <dialog data-dialog-target="modal" data-action="click->dialog#clickOutside" class="p-0 rounded-2xl shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm max-w-lg w-full m-auto">
      <div class="p-4 bg-white rounded-2xl relative ">
        <button type="button" data-action="click->dialog#close" class="absolute top-3 right-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full w-8 h-8 flex items-center justify-center font-bold cursor-pointer transition">
          ✕
        </button>
        <h3 class="text-lg font-bold text-gray-800 mb-3 px-2">Fotografía de <%= @participant.full_name %></h3>
        <% if @participant.avatar.attached? %>
          <%= image_tag @participant.avatar, class: "w-full max-h-[70vh] object-contain rounded-xl bg-gray-50" %>
        <% end %>
      </div>
    </dialog>
  </div>
  <section class="mt-20 px-5">
    <div class="flex justify-between items-center">
      <div class="flex flex-col gap-1 items-start">
        <h2 class="font-bold text-2xl"><%= @participant.full_name %></h2>
        <span class="bg-green-100 py-1.5 px-3 rounded-2xl text-sm text-gray-600"><%= @participant.rol.capitalize %></span>
      </div>
      <%= render(ButtonComponent.new(text: "Editar", url: edit_participant_path(@participant, from: params[:from]), type: "muted", icon: "edit.svg")) %>
    </div>
  </section>
  <%# This is the section of the general information %>
  <div class="mt-7 px-5">
    <section class="border border-gray-200 rounded-xl shadow-[0_0_4px_#0000001a]">
      <h3 class="font-bold text-lg bg-[#A1DFEC] px-3 py-2 rounded-t-xl">Informacion General</h3>
      <dl class="mt-5 grid grid-cols-2 md:grid-cols-4 p-3">
        <%= render(InfoTileComponent.new(title: "Compañia", icon: "company.svg", data: [@participant.company ]))%>
        <%= render(InfoTileComponent.new(title: "Cuarto", icon: "room.svg", data: [@participant.room ] ))%>
        <%= render(InfoTileComponent.new(title: "Consejeros", icon: "respond_to.svg", data: [@participant.m_person_in_charge, @participant.h_person_in_charge] ))%>
        <%= render(InfoTileComponent.new(title: "Estaca", icon: "stake.svg", data: [@participant.stake.titleize ] ))%>
        <%= render(InfoTileComponent.new(title: "Barrio", icon: "ward.svg", data: [@participant.ward&.titleize] ))%>
        <%= render(InfoTileComponent.new(title: "Genero", icon: "gender.svg", data: [@participant.genre ] ))%>
        <%= render(InfoTileComponent.new(title: "Identificacion", icon: "id.svg", data: [@participant.identity_document ] ))%>
        <%= render(InfoTileComponent.new(title: "Camisa", icon: "shirt.svg", data: [@participant.shirt_number.capitalize ] ))%>
      </dl>
    </section>
    <%# This is the contact information section %>
    <section class="border border-gray-200  rounded-xl shadow-[0_0_4px_#0000001a] mt-3">
      <h3 class="font-bold text-lg bg-[#C8E8E5] px-3 py-2 rounded-t-xl">Informacion de Contacto</h3>
      <dl class="mt-8 grid grid-cols-2 md:grid-cols-4 p-3 gap-4">
        <%= render(InfoTileComponent.new(title: "Numero", icon: "phone.svg", data: [@participant.phone_number ]))%>
        <%= render(InfoTileComponent.new(title: "Correo", icon: "email.svg", data: [@participant.email_address ]))%>
        <div class="col-span-2  w-full mt-4">
          <h4 class="mb-3 text-md font-bold bg-[#FCB446] px-3 rounded-xl">Contacto de Emergencia</h4>
          <div class="grid grid-cols-2">
            <%= render(InfoTileComponent.new(title: "Numero", icon: "phone.svg", data: [@participant.emergency_contact_number]))%>
            <%= render(InfoTileComponent.new(title: "Nombre", icon: "name_emergency.svg", data: [@participant.emergency_contact_name ]))%>
            <%= render(InfoTileComponent.new(title: "Parentesco", icon: "company.svg", data: [@participant.emergency_contact_relation ]))%>
          </div>
        </div>
      </dl>
    </section>
    <%# This the medical information section %>
    <section class="border border-gray-200 rounded-xl shadow-[0_0_4px_#0000001a] mt-3">
      <h3 class="font-bold text-lg bg-[#A1CD98] px-3 py-2 rounded-t-xl">Informacion Medica</h3>
      <dl class="mt-5 grid grid-cols-2 md:grid-cols-4 p-3">
        <%= render(InfoTileComponent.new(title: "Alergias", icon: "allergies.svg", data: [@participant.allergies ]))%>
        <%= render(InfoTileComponent.new(title: "Medicinas", icon: "medicine.svg", data: [@participant.medicines ] ))%>
        <%= render(InfoTileComponent.new(title: "Dieta", icon: "diet.svg", data: [@participant.diet] ))%>
      </dl>
    </section>
    <%# this is the adittional notes section %>
    <section class="border border-gray-200 rounded-xl shadow-[0_0_4px_#0000001a] mt-3">
      <h3 class="font-bold text-lg bg-[#0A5681] px-3 py-2 rounded-t-xl text-white">Notas Adicionales</h3>
      <p class="font-thin italic text-center p-4">
        <%= check_notes(@participant.additional_instructions)%>
      </p>
    </section>
  </div>
</div>
