<%# Crear la cuenta de la ficha (ver el comentario del formulario sobre qué correo usa).
    Va dentro del data-controller="dialog" del banner y lo abre el botón data-dialog-name="account". %>
<dialog data-dialog-target="modal" data-dialog-name="account" data-action="click->dialog#clickOutside" aria-modal="true"
        aria-labelledby="account-dialog-title"
        class="p-0 m-auto w-full max-w-md rounded-card shadow-lg backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <div class="relative p-5 md:p-6 bg-surface rounded-card">
    <button type="button" data-action="click->dialog#close" aria-label="Cerrar"
            class="absolute top-3 right-3 w-8 h-8 after:absolute after:-inset-1.5 rounded-full flex items-center justify-center bg-muted text-ink-700 dark:text-ink-700 hover:bg-line-soft cursor-pointer transition">
      <%= icon "x", class: "w-4 h-4" %>
    </button>
    <h2 id="account-dialog-title" class="pr-10 text-title font-bold text-balance break-words text-ink-900">Crear la cuenta de <%= participant.full_name %></h2>
    <p class="mt-1.5 text-body text-ink-500">Revisa el correo con cuidado: es con el que va a entrar.</p>

    <%# Si la ficha ya tiene correo, se elige entre ese y otro; el otro se escribe dos veces (con uno mal escrito
        la persona no entra) y queda también como el correo de la ficha. Sin correo en la ficha, solo los campos. %>
    <% ficha_email = participant.email_address.presence %>
    <%= form_with url: participant_account_path(participant), method: :post, class: "mt-5 space-y-4",
          data: { account_form: true, controller: "account-email" } do |form| %>
      <% if ficha_email %>
        <fieldset class="space-y-2.5">
          <legend class="sr-only">¿Con qué correo va a entrar?</legend>
          <% [ [ "ficha", "Usar el de su ficha", ficha_email ], [ "otro", "Usar otro correo", "Se guarda también en su ficha" ] ].each do |value, title, detail| %>
            <label class="relative flex items-start gap-3 rounded-tile border border-line px-3.5 py-3 cursor-pointer transition hover:bg-canvas has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50 dark:has-[:checked]:bg-primary-700/30" data-email-choice="<%= value %>">
              <%= radio_button_tag :email_choice, value, value == "ficha", class: "mt-[3px] w-4 h-4 accent-primary-600",
                    data: { action: "account-email#toggle" } %>
              <span class="min-w-0">
                <span class="block text-body font-bold text-ink-900"><%= title %></span>
                <span class="block mt-0.5 text-label font-medium text-ink-500 [overflow-wrap:anywhere]"><%= detail %></span>
              </span>
            </label>
          <% end %>
        </fieldset>
      <% end %>

      <div class="space-y-4 <%= "hidden" if ficha_email %>" data-account-email-target="fields">
        <div>
          <%= form.label :email_address, "Correo electrónico", class: field_label_classes %>
          <%= form.email_field :email_address, required: true, autocomplete: "off", disabled: ficha_email.present?,
                placeholder: "correo@ejemplo.com", class: auth_input_classes %>
        </div>
        <div>
          <%= form.label :email_address_confirmation, "Confirmar el correo", class: field_label_classes %>
          <%= form.email_field :email_address_confirmation, required: true, autocomplete: "off", disabled: ficha_email.present?,
                placeholder: "Escríbelo de nuevo", class: auth_input_classes %>
        </div>
        <% unless ficha_email %>
          <p class="text-label font-medium text-ink-500">La ficha no tiene correo: este queda guardado también en ella.</p>
        <% end %>
      </div>

      <div class="flex items-start gap-2.5 rounded-tile bg-primary-50 dark:bg-primary-700/30 px-3.5 py-3 text-label text-ink-700 dark:text-ink-700">
        <%= icon "mail", class: "w-4 h-4 shrink-0 mt-px" %>
        <p>
          Le llega a ese correo un enlace para elegir su contraseña (vale <%= User::INVITATION_VALID_FOR.in_days.to_i %> días).
          Nadie más la conoce.
        </p>
      </div>

      <div class="flex gap-2.5 justify-end">
        <button type="button" data-action="click->dialog#close" class="<%= button_classes(:secondary) %>">Cancelar</button>
        <button type="submit" data-turbo-submits-with="Creando…" class="<%= button_classes(:primary) %>">
          <%= icon "user-plus", class: "w-4 h-4" %>
          Crear cuenta
        </button>
      </div>
    <% end %>
  </div>
</dialog>
