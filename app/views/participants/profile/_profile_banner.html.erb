<%# This is the banner profile photo section %>
<div class="relative h-50 w-full bg-fsy-pattern bg-cover bg-center rounded-b-xl shadow-md mb-15" data-controller="dialog">
  <div class="absolute top-40 left-4 right-4 md:left-10 md:right-10 bg-white rounded-xl shadow-sm p-4 md:p-6">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-4 min-w-0">
        <button type="button" data-action="click->dialog#open" aria-label="Ver fotografía" class="-mt-10 z-10 cursor-pointer group rounded-full shrink-0 focus:outline-none">
          <%= render(AvatarComponent.new(participant: participant, is_profile: true)) %>
        </button>
        <div class="flex flex-col gap-1 min-w-0">
          <div class="flex flex-wrap items-center gap-3">
            <h2 class="font-bold text-xl md:text-2xl"><%= participant.full_name %></h2>
            <%= render(RoleSpanComponent.new(role: participant.rol))%>
          </div>
        </div>
      </div>
      <div class="flex gap-3 flex-wrap sm:flex-nowrap md:justify-end">
        <% if !current_page?(myprofile_participants_path)%>
          <%= render(ButtonComponent.new(text: "Volver", type:"muted", url: params[:return_to] || dashboard_path, icon:"return.svg", classes: "w-2/4 md:w-full"))%>
        <%end%>
        <% origin_path = current_page?(myprofile_participants_path) ? "myprofile" : params[:from] %>
        <%= render(ButtonComponent.new(text: "Editar", url: edit_participant_path(participant, from: origin_path, return_to: request.fullpath), type: "muted", icon: "edit.svg", classes: "w-2/4 md:w-full")) %>
      </div>
    </div>
    <%# This is the modal/dialog %>
    <dialog data-dialog-target="modal" data-action="click->dialog#clickOutside" aria-modal="true" class="p-0 rounded-2xl shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm max-w-lg w-full m-auto">
      <div class="p-4 bg-white rounded-2xl relative ">
        <button type="button" data-action="click->dialog#close" aria-label="Cerrar" class="absolute top-3 right-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full w-8 h-8 flex items-center justify-center cursor-pointer transition">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <h3 class="text-lg font-bold text-gray-800 mb-3 px-2">Fotografía de <%= participant.full_name %></h3>
        <% if participant.avatar.attached? %>
          <%= image_tag participant.avatar, class: "w-full max-h-[70vh] object-contain rounded-xl bg-gray-50" %>
        <% end %>
      </div>
    </dialog>
  </div>
</div>