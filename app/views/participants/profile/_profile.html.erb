<%= render PageComponent.new(width: :page) do %>
  <%= render "participants/profile/profile_banner", participant: participant, edit_from: edit_from %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,336px)_minmax(0,1fr)] gap-5 items-start">
    <div class="space-y-5">
      <%# En el teléfono la información médica va primero: es lo que busca enfermería o un consejero. %>
      <div class="lg:hidden"><%= render "participants/profile/medical_info", participant: participant %></div>
      <%= render "participants/profile/general_info", participant: participant %>
      <%= render "participants/profile/asignaciones", participant: participant %>
      <%= render "participants/profile/registro", participant: participant %>
    </div>
    <%# On very wide screens this column splits in two, so the page uses three columns instead of stretching. %>
    <div class="space-y-5 2xl:space-y-0 2xl:grid 2xl:grid-cols-2 2xl:gap-5 2xl:items-start">
      <%= render "participants/profile/contact_info", participant: participant %>
      <div class="hidden lg:block"><%= render "participants/profile/medical_info", participant: participant %></div>
      <%= render "participants/profile/capacitaciones", participant: participant %>
    </div>
  </div>
<% end %>
