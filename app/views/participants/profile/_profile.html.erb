<%= render PageComponent.new(width: :page, banner: true) do %>
  <%= render "participants/profile/profile_banner", participant: participant, edit_from: edit_from %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,336px)_minmax(0,1fr)] 2xl:grid-cols-3 gap-5 items-start 2xl:items-stretch">
    <%# Desde 2xl las dos columnas se deshacen (contents) y sus tarjetas se reacomodan en la cuadrícula de tres:
        arriba General · Contacto · Médica a la misma altura; abajo, a todo el ancho, Asignaciones y Capacitaciones.
        Registro pasa al banner. Más angosto, todo queda como siempre. %>
    <div class="space-y-5 2xl:space-y-0 2xl:contents">
      <%# En el teléfono la información médica va primero: es lo que busca enfermería o un consejero. %>
      <div class="lg:hidden"><%= render "participants/profile/medical_info", participant: participant %></div>
      <%= render "participants/profile/general_info", participant: participant %>
      <%= render "participants/profile/asignaciones", participant: participant %>
      <%= render "participants/profile/registro", participant: participant %>
    </div>
    <div class="space-y-5 2xl:space-y-0 2xl:contents">
      <%= render "participants/profile/contact_info", participant: participant %>
      <div class="hidden lg:block 2xl:contents"><%= render "participants/profile/medical_info", participant: participant %></div>
      <%= render "participants/profile/capacitaciones", participant: participant %>
    </div>
  </div>
<% end %>
