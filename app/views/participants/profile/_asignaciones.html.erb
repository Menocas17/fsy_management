<%
  assignments = participant.assignments.includes(:activity).chronological
  editable = can_assign_to?(participant)
%>
<section class="<%= card_classes("p-5 md:p-6") %>" data-assignments>
  <%# La acción principal de la ficha es Editar: aquí «Nueva» va como secundaria, a la derecha del encabezado. %>
  <%= section_heading "Asignaciones", "clipboard-check", tone: :green do %>
    <% if editable %>
      <%= link_to new_participant_assignment_path(participant), class: button_classes(:secondary, size: :sm, extra: "shrink-0") do %>
        <%= icon "plus", class: "size-3.5" %>
        Nueva
      <% end %>
    <% end %>
  <% end %>

  <% if assignments.any? %>
    <ul class="flex flex-col gap-2.5">
      <% assignments.each do |assignment| %>
        <li class="rounded-tile border border-line-soft px-3.5 py-3" data-assignment-id="<%= assignment.id %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-body font-bold text-ink-900"><%= assignment.display_title %></p>
              <% if assignment.when_label %>
                <p class="mt-0.5 flex items-center gap-1.5 text-label font-semibold text-ink-500">
                  <%= icon "clock", class: "w-3.5 h-3.5" %>
                  <%= assignment.when_label %>
                </p>
              <% end %>
              <% if assignment.place.present? %>
                <p class="mt-0.5 flex items-center gap-1.5 text-label font-semibold text-ink-500">
                  <%= icon "map-pin", class: "w-3.5 h-3.5" %>
                  <%= assignment.place %>
                </p>
              <% end %>
            </div>
            <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-meta font-bold <%= assignment.status_styles %>" data-assignment-status><%= assignment.status_label %></span>
          </div>

          <% if assignment.details.present? %>
            <p class="mt-2 text-label leading-relaxed text-ink-700"><%= assignment.details %></p>
          <% end %>

          <div class="mt-2.5 pt-2.5 border-t border-line-soft flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="inline-flex items-center gap-1 text-meta font-semibold text-ink-500">
              <%= icon assignment.from_agenda? ? "calendar-days" : "clipboard-list", class: "w-3.5 h-3.5" %>
              <%= assignment.from_agenda? ? "De la agenda" : "Otra" %> · <%= assignment.assigned_by_name %>
            </span>
            <% if editable %>
              <div class="ml-auto flex items-center gap-1.5">
                <% next_status = assignment.status_pendiente? ? "confirmada" : (assignment.status_confirmada? ? "completada" : "pendiente") %>
                <%= button_to assignment_path(assignment, assignment: { status: next_status }), method: :patch,
                      class: "inline-flex items-center min-h-11 md:min-h-0 px-1 text-label font-bold text-primary-600 dark:text-primary-300 hover:underline cursor-pointer" do %>
                  Marcar <%= Assignment::STATUS_LABELS[next_status].downcase %>
                <% end %>
                <%= button_to assignment_path(assignment), method: :delete,
                      form: { data: { turbo_confirm: "¿Quitar «#{assignment.display_title}»?", turbo_confirm_detail: "Se puede volver a asignar después.", turbo_confirm_button: "Sí, quitar" } },
                      aria: { label: "Eliminar asignación" },
                      class: "relative w-7 h-7 after:absolute after:-inset-2 rounded-inner flex items-center justify-center text-ink-500 hover:text-cat-rose-ink hover:bg-cat-rose/10 cursor-pointer transition" do %>
                  <%= icon "trash-2", class: "w-3.5 h-3.5" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render EmptyStateComponent.new(title: "Sin asignaciones todavía", icon: "inbox", tone: :green, name: "asignaciones",
          text: editable ? "Agrega una actividad de la agenda o una asignación aparte." : "Aquí aparecerán las tareas de la agenda y las asignaciones aparte.") %>
  <% end %>
</section>
