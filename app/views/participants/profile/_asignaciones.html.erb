<%
  assignments = participant.assignments.includes(:activity).chronological
  editable = can_assign_to?(participant)
%>
<section class="<%= card_classes("p-6") %>" data-assignments>
  <div class="flex items-start justify-between gap-3">
    <%= section_heading "Asignaciones", "clipboard-check" %>
    <% if editable %>
      <%= link_to new_participant_assignment_path(participant), class: "shrink-0 -mt-1 inline-flex items-center gap-1.5 h-8 px-3 rounded-[10px] bg-primary-700 text-[12.5px] font-semibold text-white shadow-sm hover:bg-primary-800 transition" do %>
        <%= icon "plus", class: "w-3.5 h-3.5" %>
        Nueva
      <% end %>
    <% end %>
  </div>

  <% if assignments.any? %>
    <ul class="flex flex-col gap-2.5">
      <% assignments.each do |assignment| %>
        <li class="rounded-[14px] border border-line-soft dark:border-slate-700 px-3.5 py-3" data-assignment-id="<%= assignment.id %>">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="text-[13.5px] font-bold text-ink-900 dark:text-slate-100"><%= assignment.display_title %></p>
              <% if assignment.when_label %>
                <p class="mt-0.5 flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-500 dark:text-slate-400">
                  <%= icon "clock", class: "w-3.5 h-3.5" %>
                  <%= assignment.when_label %>
                </p>
              <% end %>
              <% if assignment.place.present? %>
                <p class="mt-0.5 flex items-center gap-1.5 text-[11.5px] font-semibold text-ink-500 dark:text-slate-400">
                  <%= icon "map-pin", class: "w-3.5 h-3.5" %>
                  <%= assignment.place %>
                </p>
              <% end %>
            </div>
            <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold <%= assignment.status_styles %>" data-assignment-status><%= assignment.status_label %></span>
          </div>

          <% if assignment.details.present? %>
            <p class="mt-2 text-[12px] leading-relaxed text-ink-700 dark:text-slate-300"><%= assignment.details %></p>
          <% end %>

          <div class="mt-2.5 pt-2.5 border-t border-line-soft dark:border-slate-700 flex flex-wrap items-center gap-x-3 gap-y-2">
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-ink-300 dark:text-slate-500">
              <%= icon assignment.from_agenda? ? "calendar-days" : "clipboard-list", class: "w-3.5 h-3.5" %>
              <%= assignment.from_agenda? ? "De la agenda" : "Otra" %> · <%= assignment.assigned_by_name %>
            </span>
            <% if editable %>
              <div class="ml-auto flex items-center gap-1.5">
                <% next_status = assignment.status_pendiente? ? "confirmada" : (assignment.status_confirmada? ? "completada" : "pendiente") %>
                <%= button_to assignment_path(assignment, assignment: { status: next_status }), method: :patch,
                      class: "text-[11.5px] font-bold text-primary-600 dark:text-primary-300 hover:underline cursor-pointer" do %>
                  Marcar <%= Assignment::STATUS_LABELS[next_status].downcase %>
                <% end %>
                <%= button_to assignment_path(assignment), method: :delete,
                      form: { data: { turbo_confirm: "¿Quitar «#{assignment.display_title}»?" } },
                      aria: { label: "Eliminar asignación" },
                      class: "w-7 h-7 rounded-lg flex items-center justify-center text-ink-300 dark:text-slate-500 hover:text-cat-rose hover:bg-cat-rose/10 cursor-pointer transition" do %>
                  <%= icon "trash-2", class: "w-3.5 h-3.5" %>
                <% end %>
              </div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="flex flex-col items-center text-center px-2 py-4 rounded-[14px] border border-dashed border-line dark:border-slate-600" data-empty-state="asignaciones">
      <span class="w-10 h-10 rounded-full flex items-center justify-center bg-canvas dark:bg-slate-700 text-ink-300 dark:text-slate-400">
        <%= icon "inbox", class: "w-5 h-5" %>
      </span>
      <p class="mt-2.5 text-[13.5px] font-bold text-ink-900 dark:text-slate-100">Sin asignaciones todavía</p>
      <p class="mt-1 text-[12.5px] leading-relaxed text-ink-500 dark:text-slate-400">
        <%= editable ? "Agrega una actividad de la agenda o una asignación aparte." : "Aquí aparecerán las tareas de la agenda y las asignaciones aparte." %>
      </p>
    </div>
  <% end %>
</section>
