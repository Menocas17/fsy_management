<%# No assignments model exists yet, so this is an honest empty state rather than sample data. %>
<section class="<%= card_classes("p-6") %>" data-empty-state="asignaciones">
  <div class="flex items-start justify-between gap-3">
    <%= section_heading "Asignaciones", "clipboard-check" %>
    <span class="shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full bg-primary-50 dark:bg-primary-700/30 text-[11px] font-bold text-primary-600 dark:text-primary-100">Próximamente</span>
  </div>
  <div class="flex flex-col items-center text-center px-2 py-4 rounded-[14px] border border-dashed border-line dark:border-slate-600">
    <span class="w-10 h-10 rounded-full flex items-center justify-center bg-canvas dark:bg-slate-700 text-ink-300 dark:text-slate-400">
      <%= icon "inbox", class: "w-5 h-5" %>
    </span>
    <p class="mt-2.5 text-[13.5px] font-bold text-ink-900 dark:text-slate-100">Sin asignaciones todavía</p>
    <p class="mt-1 text-[12.5px] leading-relaxed text-ink-500 dark:text-slate-400">Aquí aparecerá la asignación actual —tarea, hora, lugar y fecha— junto con su historial.</p>
  </div>
</section>
