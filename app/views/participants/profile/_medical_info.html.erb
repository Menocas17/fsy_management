<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Información médica", "shield-plus" %>
  <%# Lo que hay que atender salta a la vista; si todo dice «Ninguna», no aparece nada. %>
  <% notes = { "Alergias" => participant.allergies, "Medicinas" => participant.medicines, "Dieta" => participant.diet }.select { |_, value| medical_note?(value) } %>
  <% if notes.any? %>
    <div class="mb-4 flex items-start gap-3 rounded-tile border border-cat-rose/30 bg-cat-rose/10 px-4 py-3 text-rose-800 dark:text-rose-200" role="note">
      <%= icon "triangle-alert", class: "w-[18px] h-[18px] mt-0.5 shrink-0" %>
      <div class="min-w-0 text-[13px] font-semibold leading-snug">
        <p class="font-bold">Requiere atención</p>
        <% notes.each do |label, value| %>
          <p class="break-words"><span class="font-bold"><%= label %>:</span> <%= value %></p>
        <% end %>
      </div>
    </div>
  <% end %>
  <div>
    <%= info_row "Alergias", "shield-plus", participant.allergies %>
    <%= info_row "Medicinas", "pill", participant.medicines %>
    <%= info_row "Dieta", "leaf", participant.diet %>
  </div>

  <div class="mt-5 rounded-tile bg-canvas dark:bg-slate-900/60 border border-line-soft px-5 py-4">
    <p class="text-[11px] font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300">Notas adicionales</p>
    <% if participant.additional_instructions.present? %>
      <p class="mt-1.5 text-[13px] leading-relaxed italic text-ink-700"><%= participant.additional_instructions %></p>
    <% else %>
      <p class="mt-1.5 text-[13px] text-ink-500">No hay notas adicionales.</p>
    <% end %>
  </div>
</section>
