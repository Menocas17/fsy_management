<section class="<%= card_classes("p-6 2xl:order-3") %>">
  <%= section_heading "Información médica", "shield-plus", tone: :rose %>
  <%# Si algo pide atención salta a la vista en rojo; el detalle ya está justo abajo, así que el aviso no lo repite.
      Si todo dice «Ninguna», no aparece nada. %>
  <% if [ participant.medical_information, participant.diet ].any? { |value| medical_note?(value) } %>
    <p class="mb-4 flex items-center gap-2.5 rounded-tile border border-cat-rose/40 bg-cat-rose/15 px-4 py-3 text-body font-bold text-cat-rose-ink" role="note" data-medical-alert>
      <%= icon "triangle-alert", class: "size-[18px] shrink-0" %>
      Requiere atención
    </p>
  <% end %>
  <div>
    <%= info_row "Información médica", "stethoscope", participant.medical_information %>
    <%= info_row "Dieta", "leaf", participant.diet %>
  </div>

  <%# Privada: la ven enfermería, el director, sus consejeros y su auxiliar (y la persona misma). %>
  <% if can_read_emotional_information?(participant) %>
    <div class="mt-4 rounded-tile border border-cat-indigo/25 bg-cat-indigo/10 px-4 py-3.5" data-emotional-information>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="flex items-center gap-2 text-body font-bold text-ink-900">
          <%= icon "heart-handshake", class: "size-4 text-cat-indigo-ink" %>
          Información emocional
        </p>
        <%= render ChipComponent.new(label: "Privada", tone: :indigo, icon: "lock") %>
      </div>
      <% if participant.emotional_information.present? %>
        <p class="mt-1.5 text-body leading-relaxed text-ink-700 whitespace-pre-line"><%= participant.emotional_information %></p>
      <% else %>
        <p class="mt-1.5 text-body text-ink-500">No hay información emocional.</p>
      <% end %>
    </div>
  <% end %>

  <%# Sus visitas a enfermería: si está adentro ahora salta a la vista; si no, cuántas lleva. %>
  <% if participant.joven? && can_view_infirmary? %>
    <% visits = participant.infirmary_visits.to_a %>
    <% ongoing = visits.find { |visit| visit.discharged_at.nil? } %>
    <%= link_to infirmary_chart_path(participant, **practice_link_params(participant)), data: { profile_infirmary: ongoing&.status || "ninguna" },
          class: "mt-4 flex items-center gap-3 rounded-tile border border-line-soft px-4 py-3 hover:bg-canvas transition-colors" do %>
      <%= render IconTileComponent.new(icon: "heart-pulse", tone: ongoing ? :rose : :neutral) %>
      <span class="min-w-0 flex-1">
        <span class="block text-body font-bold text-ink-900">Ficha de enfermería</span>
        <span class="block text-label font-semibold <%= ongoing ? "text-cat-rose-ink" : "text-ink-500" %>">
          <%= if ongoing
                ongoing.en_camino? ? "Va en camino a enfermería" : "En enfermería desde las #{ongoing.started_at.strftime("%H:%M")}"
              else
                visits.any? ? pluralize(visits.size, "visita") : "No ha pasado por enfermería"
              end %>
        </span>
      </span>
      <%= icon "chevron-right", class: "w-4 h-4 shrink-0 text-ink-500" %>
    <% end %>
  <% end %>

  <div class="mt-5 rounded-tile bg-sunken border border-line-soft px-5 py-4">
    <p class="text-body font-bold text-ink-700">Notas adicionales</p>
    <% if participant.additional_instructions.present? %>
      <p class="mt-1.5 text-body leading-relaxed italic text-ink-700"><%= participant.additional_instructions %></p>
    <% else %>
      <p class="mt-1.5 text-body text-ink-500">No hay notas adicionales.</p>
    <% end %>
  </div>
</section>
