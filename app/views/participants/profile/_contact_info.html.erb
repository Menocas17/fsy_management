<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Contacto", "phone" %>
  <div class="grid grid-cols-1 sm:grid-cols-2 sm:gap-x-6">
    <div><%= info_row "Número", "phone", participant.phone_number %></div>
    <div class="border-t border-line-soft dark:border-slate-700 pt-3 sm:border-t-0 sm:pt-0"><%= info_row "Correo", "mail", participant.email_address %></div>
  </div>

  <div class="mt-5 pt-4 border-t border-line-soft dark:border-slate-700">
    <h3 class="mb-3 text-[11px] font-bold tracking-[.07em] uppercase text-amber-700 dark:text-cat-amber">Contacto de emergencia</h3>
    <div>
      <%= info_row "Número", "phone", participant.emergency_contact_number %>
      <%= info_row "Nombre", "user-round", participant.emergency_contact_name %>
      <%= info_row "Parentesco", "heart-handshake", participant.emergency_contact_relation %>
    </div>
  </div>
</section>
