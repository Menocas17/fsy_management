<section class="bg-white border border-slate-100 rounded-lg shadow-lg">
  <h3 class="font-bold text-lg bg-primary-gradient text-white px-3 py-2 rounded-t-lg">Información General</h3>
  <dl class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-7 p-3">
    <%= render(InfoTileComponent.new(title: "Compañía", icon: "company.svg", data: [@participant.company&.name]))%>
    <%= render(InfoTileComponent.new(title: "Cuarto", icon: "room.svg", data: [@participant.room]))%>
    <%= render(InfoTileComponent.new(title: "Consejeros", icon: "respond_to.svg", data: [@participant.m_person_in_charge, @participant.h_person_in_charge]))%>
    <%= render(InfoTileComponent.new(title: "Estaca", icon: "stake.svg", data: [@participant.stake&.titleize]))%>
    <%= render(InfoTileComponent.new(title: "Barrio", icon: "ward.svg", data: [@participant.ward&.titleize]))%>
    <%= render(InfoTileComponent.new(title: "Género", icon: "gender.svg", data: [@participant.gender]))%>
    <%= render(InfoTileComponent.new(title: "Identificación", icon: "id.svg", data: [@participant.identity_document]))%>
    <%= render(InfoTileComponent.new(title: "Camisa", icon: "shirt.svg", data: [@participant.shirt_number&.capitalize]))%>
  </dl>
</section>