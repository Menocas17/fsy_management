<% list_path = is_staff ? staff_participants_path : participants_path %>
<%= render "participants/active_filters", is_staff: is_staff, pagy: pagy %>
<% if participants.load.any? %>
  <div class="hidden md:block">
    <%= render(TableComponent.new(participants: participants, is_staff: is_staff)) %>
    <div class="flex items-center justify-between gap-4 mt-4 px-1">
      <p class="text-[12.5px] font-medium text-ink-500 dark:text-slate-400">
        Mostrando <%= pagy.from %>–<%= pagy.to %> de <%= pagy.count %>
      </p>
      <% if pagy.last > 1 %>
        <%== pagy.series_nav(anchor_string: 'data-turbo-action="advance"') %>
      <% end %>
    </div>
  </div>

  <%# Mobile: each page lives in its own frame; the lazy frame for the next page fetches itself once scrolled into view. %>
  <div class="md:hidden">
    <%= turbo_frame_tag "participants_page_#{pagy.page}" do %>
      <%= render partial: "participants/participant_card", collection: participants, as: :participant,
                 locals: { is_staff: is_staff, list_path: list_path } %>
      <% if pagy.next %>
        <%= turbo_frame_tag "participants_page_#{pagy.next}", src: pagy.page_url(:next), loading: :lazy do %>
          <div class="flex items-center justify-center gap-2.5 py-3">
            <span class="w-4 h-4 rounded-full border-2 border-line dark:border-slate-600 border-t-primary-500 animate-spin"></span>
            <span class="text-xs font-semibold text-ink-500 dark:text-slate-400">Cargando más…</span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="bg-surface dark:bg-slate-800 rounded-[18px] shadow-md border border-line-soft dark:border-slate-700 p-10 text-center">
    <p class="text-ink-500 dark:text-slate-400"><%= empty_message %></p>
  </div>
<% end %>
