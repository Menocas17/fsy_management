<% list_path = is_staff ? staff_participants_path : participants_path %>
<%= render "participants/active_filters", is_staff: is_staff, pagy: pagy %>
<% if preload_thumbs(participants.load).any? %>
  <div class="hidden md:block">
    <%= render(TableComponent.new(participants: participants, is_staff: is_staff)) %>
    <div class="flex items-center justify-between gap-4 mt-4 px-1">
      <p class="text-label font-medium text-ink-500">
        Mostrando <%= pagy.from %>–<%= pagy.to %> de <%= pagy.count %>
      </p>
      <% if pagy.last > 1 %>
        <%== pagy.series_nav(anchor_string: 'data-turbo-action="advance"') %>
      <% end %>
    </div>
  </div>

  <%# Mobile: each page lives in its own frame; the lazy frame for the next page fetches itself once scrolled into view. %>
  <div class="md:hidden">
    <%= turbo_frame_tag "participants_page_#{pagy.page}" do %>
      <%= render partial: "participants/participant_card", collection: participants, as: :participant,
                 locals: { is_staff: is_staff, list_path: list_path } %>
      <% if pagy.next %>
        <%= turbo_frame_tag "participants_page_#{pagy.next}", src: pagy.page_url(:next), loading: :lazy do %>
          <div class="flex items-center justify-center gap-2.5 py-3">
            <span class="w-4 h-4 rounded-full border-2 border-line border-t-primary-500 animate-spin"></span>
            <span class="text-label font-semibold text-ink-500">Cargando más…</span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%# Una lista vacía por filtros ofrece la salida ahí mismo. %>
  <% filtered = request.query_parameters.except("page", "from", "return_to").values.any?(&:present?) %>
  <div class="<%= card_classes("p-5 md:p-6") %>">
    <%= render EmptyStateComponent.new(title: empty_message, icon: filtered ? "search-x" : "users", name: "participants",
          text: (filtered ? "Prueba con otra búsqueda o quita los filtros." : "Aquí aparecerán en cuanto se registren.")) do |empty| %>
      <% if filtered %>
        <% empty.with_action { link_to "Limpiar filtros", list_path, data: { turbo_frame: "_top" }, class: button_classes(:secondary) } %>
      <% end %>
    <% end %>
  </div>
<% end %>
