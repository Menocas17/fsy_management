<div class="px-3 md:px-7 pt-10">
  <div class="flex justify-between mb-5 px-3">
    <h1 class="font-bold text-2xl">Staff</h1>
    <% if Current.user&.admin_or_staff_manager? %>
      <%= render(ButtonComponent.new(text: "Nuevo", url: new_participant_path, type: "primary")) %>
    <% end %>
  </div>
  <%= render "filters", form_url: staff_participants_path, clear_url: staff_participants_path, show_role: true %>
  <%= turbo_frame_tag "participants_table" do %>
    <% if @participants.any? %>
      <%= render(TableComponent.new(participants: @participants, is_staff: true)) %>
    <% else %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center">
        <p class="text-gray-500">No hay personal que coincida con la búsqueda.</p>
      </div>
    <% end %>
  <% end %>
</div>