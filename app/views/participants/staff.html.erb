<% content_for :title, "Staff" %>
<% content_for :eyebrow, "Participantes" %>
<%= render PageComponent.new(width: :page) do |page| %>
  <% page.with_intro { pluralize(@pagy.count, "miembro del staff", plural: "miembros del staff") } %>
  <% if can_create_participants? %>
    <% page.with_actions do %>
      <%= link_to new_participant_path, class: button_classes do %>
        <%= icon "plus", class: "size-4" %>
        Nuevo participante
      <% end %>
    <% end %>
  <% end %>
  <%= render "filters", form_url: staff_participants_path, show_role: true %>
  <%= turbo_frame_tag "participants_table" do %>
    <%= render "results", participants: @participants, pagy: @pagy, is_staff: true,
                          empty_message: "No hay personal que coincida con la búsqueda." %>
  <% end %>
<% end %>
