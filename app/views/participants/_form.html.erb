  <%= form_with model: participant do |form| %>
  <% if form.object.errors.any? %>
    <p class="error"><%= form.object.errors.full_messages.first %></p>
  <% end %>
  <div class="md:max-w-3/4">
    <%= render "essential_info_form", form: form%>
    <%= render "general_info_form", form: form%>
    <%= render "contact_info_form", form: form%>
    <%= render "medical_info_form", form: form%>
    <%= render "note_info_form", form: form%>
    <div class="my-5 flex justify-end px-5 md:px-10 ">
      <%# <div></div> %>
      <div class="flex gap-3">
        <%= render(ButtonComponent.new(text: "Cancelar", type:"cancel", url: @participant))%>
        <%= render(ButtonComponent.new(text: submit_button_text(participant), type:"primary", is_submit: true))%>
      </div>
    </div>
  </div>
<% end %>