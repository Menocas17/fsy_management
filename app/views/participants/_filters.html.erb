<%
  form_url = local_assigns.fetch(:form_url, participants_path)
  clear_url = local_assigns.fetch(:clear_url, participants_path)
  show_role = local_assigns.fetch(:show_role, false)
  staff_roles = Participant.rols.keys.reject { |k| k == "joven" }
%>
<div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 mb-6">
  <%= form_with url: form_url, method: :get, data: { turbo_frame: "participants_table", turbo_action: "advance" }, class: "flex flex-col md:flex-row md:flex-wrap gap-4 md:items-center" do |f| %>
    <div class="w-full md:flex-1 md:min-w-50">
      <%= f.text_field :query,
          value: params[:query],
          placeholder: "Buscar por nombre...",
          class: "w-full px-4 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 outline-none",
          oninput: "this.form.requestSubmit()" %>
    </div>
    <div class="w-full md:w-48">
      <%= f.select :stake,
          options_for_select(Participant.stakes.keys.map { |k| [k.titleize, k] }, params[:stake]),
          { include_blank: "Todas las Estacas" },
          class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 outline-none",
          onchange: "this.form.requestSubmit()" %>
    </div>
    <div class="w-full md:w-48">
      <%= f.select :ward,
          options_for_select(Participant.wards.keys.map { |k| [k.titleize, k] }, params[:ward]),
          { include_blank: "Todos los Barrios" },
          class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 outline-none",
          onchange: "this.form.requestSubmit()" %>
    </div>
    <div class="w-full md:w-40">
      <%= f.select :gender,
          options_for_select([["Hombre", "H"], ["Mujer", "M"]], params[:gender]),
          { include_blank: "Todos los Géneros" },
          class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 outline-none",
          onchange: "this.form.requestSubmit()" %>
    </div>
    <div class="w-full md:w-40">
      <%= f.text_field :company,
          value: params[:company],
          placeholder: "Compañía...",
          class: "w-full px-4 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 outline-none",
          oninput: "this.form.requestSubmit()" %>
    </div>
    <% if show_role %>
      <div class="w-full md:w-40">
        <%= f.select :rol,
            options_for_select(staff_roles.map { |k| [k.titleize, k] }, params[:rol]),
            { include_blank: "Todos los roles" },
            class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 outline-none",
            onchange: "this.form.requestSubmit()" %>
      </div>
    <% end %>
    <%= link_to "Limpiar", clear_url, class: "self-start md:self-center text-xs text-gray-500 border border-gray-200 hover:border-gray-400 py-2 px-3 rounded-lg" %>
  <% end %>
</div>
