<%
  # Las fichas de lo aplicado viven en participants/_active_filters, dentro del frame de la tabla.
  form_url = local_assigns.fetch(:form_url, participants_path)
  show_role = local_assigns.fetch(:show_role, false)
  staff_roles = Participant.rols.keys.reject { |key| key == "joven" }
  chip_classes = "h-10 pl-3 pr-8 rounded-control bg-surface border border-line text-body font-semibold text-ink-700 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500 shrink-0"
%>
<%= form_with url: form_url, method: :get, data: { turbo_frame: "participants_table", turbo_action: "advance", controller: "auto-submit" },
      class: "flex flex-col lg:flex-row lg:items-start gap-3" do |f| %>
  <%# Todo en una sola fila. La búsqueda toma el ancho que sobra y es la que cede (hasta 11rem); los filtros
      no ceden y miden como mucho lo que queda, y si aun así no caben se deslizan de lado, como en el
      teléfono, en vez de bajar el último a una segunda fila. %>
  <div class="relative w-full lg:w-auto lg:flex-[1_100_18rem] lg:min-w-44 lg:max-w-80">
    <%= icon "search", class: "w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-500 pointer-events-none" %>
    <%= f.text_field :query,
          value: params[:query],
          placeholder: "Buscar por nombre…",
          aria: { label: "Buscar por nombre" },
          class: "w-full h-10 pl-10 pr-3 rounded-control bg-surface border border-line text-body text-ink-900 placeholder:text-ink-300 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500",
          data: { action: "input->auto-submit#typed" } %>
  </div>
  <div data-controller="scroll-reveal" data-participant-filters
       class="scroll-reveal-x flex items-start gap-2 overflow-x-auto p-0.5 -m-0.5 pb-1.5 lg:flex-none lg:max-w-[calc(100%-11rem-0.75rem)]">
    <%= f.select :stake,
          options_for_select(Participant.stakes.keys.map { |key| [ key.titleize, key ] }, params[:stake]),
          { include_blank: "Estaca" }, class: chip_classes, aria: { label: "Filtrar por estaca" }, data: { action: "change->auto-submit#changed" } %>
    <%= f.select :ward,
          options_for_select(Participant.wards.keys.map { |key| [ key.titleize, key ] }, params[:ward]),
          { include_blank: "Barrio" }, class: chip_classes, aria: { label: "Filtrar por barrio" }, data: { action: "change->auto-submit#changed" } %>
    <%= f.select :gender,
          options_for_select(Participant::GENDER_LABELS.map { |key, label| [ label, key ] }, params[:gender]),
          { include_blank: "Género" }, class: chip_classes, aria: { label: "Filtrar por género" }, data: { action: "change->auto-submit#changed" } %>
    <% if show_role %>
      <%= f.select :rol,
            options_for_select(staff_roles.map { |key| [ Participant.role_label(key), key ] }, params[:rol]),
            { include_blank: "Rol" }, class: chip_classes, aria: { label: "Filtrar por rol" }, data: { action: "change->auto-submit#changed" } %>
    <% else %>
      <%= f.select :care,
            options_for_select(Participant::CARE_FILTERS.map { |key, label| [ label, key ] }, params[:care]),
            { include_blank: "Cocina y salud" }, class: chip_classes, aria: { label: "Filtrar por cocina y salud" }, data: { action: "change->auto-submit#changed" } %>
    <% end %>
    <%# Ahora que «Limpiar» bajó con las fichas de filtros, este campo puede decir qué es y respirar. %>
    <%= f.text_field :company,
          value: params[:company],
          placeholder: "Compañía o número",
          aria: { label: "Filtrar por compañía" },
          title: "Número o nombre de la compañía",
          class: "h-10 w-40 px-3 rounded-control bg-surface border border-line text-body font-semibold text-ink-700 placeholder:text-ink-300 placeholder:font-medium focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500 shrink-0",
          data: { action: "input->auto-submit#typed" } %>
  </div>
<% end %>
