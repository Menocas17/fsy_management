<%# El QR lleva a la ficha de la persona: se escanea desde el gafete y se abre el perfil. Va dentro de un
    data-controller="dialog" y se abre con un botón data-dialog-name="qr" (la ficha y el panel de inicio). %>
<dialog data-dialog-target="modal" data-dialog-name="qr" data-action="click->dialog#clickOutside" aria-modal="true"
        class="p-0 m-auto w-full max-w-xs rounded-2xl shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <div class="relative p-5 bg-surface rounded-2xl text-center">
    <button type="button" data-action="click->dialog#close" aria-label="Cerrar"
            class="absolute top-3 right-3 w-8 h-8 after:absolute after:-inset-1.5 rounded-full flex items-center justify-center bg-canvas dark:bg-slate-700 text-ink-700 dark:text-slate-200 hover:bg-line-soft cursor-pointer transition">
      <%= icon "x", class: "w-4 h-4" %>
    </button>
    <%# Margen a ambos lados del ancho del botón de cerrar: el título sigue centrado y un nombre largo baja de línea en vez de quedar debajo de la X. %>
    <h2 class="mb-4 px-9 pt-1 text-[15px] font-bold text-balance break-words text-ink-900">Código de <%= participant.full_name %></h2>
    <%= qr_svg_tag participant_url(participant), label: "Código QR de #{participant.full_name}", size: 200 %>
    <%# El código corto, por si el QR no se lee: se escribe en el campo del escáner. %>
    <% if participant.code.present? %>
      <p class="mt-3 font-mono text-[20px] font-bold tracking-[.08em] text-ink-900" data-badge-code><%= participant.code %></p>
    <% end %>
    <p class="mt-2 text-[13px] font-bold text-ink-900"><%= participant.full_name %></p>
    <p class="mt-0.5 text-[12px] font-semibold text-ink-500">
      <%= [ participant.role_label, participant.company&.name, participant.room.presence && "Cuarto #{participant.room}" ].compact.join(" · ") %>
    </p>
    <p class="mt-3 text-[11.5px] text-ink-500">Al escanearlo se abre esta ficha. Si no se lee, escribe el código en el escáner.</p>
  </div>
</dialog>
