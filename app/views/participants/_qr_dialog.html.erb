<%# El QR lleva a la ficha de la persona: se escanea desde el gafete y se abre el perfil. Va dentro de un
    data-controller="dialog" y se abre con un botón data-dialog-name="qr" (la ficha, el panel de inicio y la barra inferior). %>
<dialog data-dialog-target="modal" data-dialog-name="qr" data-action="click->dialog#clickOutside" aria-modal="true"
        class="p-0 m-auto w-full max-w-xs rounded-card shadow-lg backdrop:bg-black/60 backdrop:backdrop-blur-sm">
  <div class="relative p-5 bg-surface rounded-card text-center">
    <button type="button" data-action="click->dialog#close" aria-label="Cerrar"
            class="absolute top-3 right-3 w-8 h-8 after:absolute after:-inset-1.5 rounded-full flex items-center justify-center bg-muted text-ink-700 dark:text-ink-700 hover:bg-line-soft cursor-pointer transition">
      <%= icon "x", class: "w-4 h-4" %>
    </button>
    <%# lazy: el de la barra inferior va en todas las páginas, así que el código se pide al abrir el diálogo. %>
    <% if local_assigns[:lazy] %>
      <%= turbo_frame_tag dom_id(participant, :qr), src: participant_qr_path(participant), loading: :lazy do %>
        <%= render SkeletonComponent.new(variant: :qr, label: "Cargando el código…") %>
      <% end %>
    <% else %>
      <%= render "participants/qr_card", participant: participant %>
    <% end %>
  </div>
</dialog>
