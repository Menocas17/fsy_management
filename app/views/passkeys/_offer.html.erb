<%# Después de entrar con la contraseña: «¿Entrar con tu huella la próxima vez?». La abre passkey_controller solo si
    este dispositivo tiene huella (o cara, o PIN) y aquí no se dijo antes «Ahora no». %>
<dialog data-controller="passkey dialog" data-dialog-target="modal" data-action="click->dialog#clickOutside"
        data-passkey-offer-value="true" data-passkey-dismiss-key-value="fsy:passkey-offer-dismissed"
        data-passkey-options-url-value="<%= options_passkeys_path %>" data-passkey-url-value="<%= passkeys_path %>"
        aria-labelledby="passkey-offer-title" data-passkey-offer
        class="p-0 m-auto w-[calc(100%-2rem)] max-w-sm rounded-card bg-transparent shadow-lg backdrop:bg-black/50 backdrop:backdrop-blur-sm">
  <div class="p-6 bg-surface rounded-card text-center">
    <span class="mx-auto mb-4 size-14 rounded-panel bg-primary-100 text-primary-700 dark:bg-primary-700/40 dark:text-primary-100 flex items-center justify-center">
      <%= icon "fingerprint-pattern", class: "size-7" %>
    </span>
    <h2 id="passkey-offer-title" class="text-title font-bold text-ink-900">¿Entrar con tu huella la próxima vez?</h2>
    <p class="mt-2 text-body leading-relaxed text-ink-500">
      Sin escribir tu correo ni tu contraseña: el teléfono te pide la huella (o tu cara) y entras. Tu huella no sale del teléfono.
    </p>
    <p hidden data-passkey-target="error" role="alert" class="mt-3 text-label font-semibold text-cat-rose-ink"></p>
    <div class="mt-5 flex flex-col gap-2.5">
      <button type="button" data-action="passkey#register" data-passkey-target="button" class="<%= button_classes(:primary, extra: "w-full disabled:opacity-60") %>">
        <%= icon "fingerprint-pattern", class: "w-4 h-4" %>
        Usar mi huella
      </button>
      <button type="button" data-action="passkey#dismiss" class="<%= button_classes(:secondary, extra: "w-full") %>">Ahora no</button>
    </div>
  </div>
</dialog>
