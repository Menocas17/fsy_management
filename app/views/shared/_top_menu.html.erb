<div data-controller="mobile-menu" class="relative">
  <%# Main nav bar %>
  <div class="border-b border-slate-200 py-0 px-5 h-15.25 flex items-center justify-between md:justify-end">
    <div class="flex gap-3 md:hidden">
      <button type="button" class="text-gray-700 hover:text-gray-700 focus:outline-none p-2 rounded-md cursor-pointer" data-action="click->mobile-menu#toggle">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
      <div class="flex gap-3 items-center">
        <%= image_tag "fsy_letters.svg", class:"w-15 h-15"%>
        <%= image_tag "fsy-logo.svg", class:"w-10 h-10"%>
      </div>
    </div>
    <nav class="flex items-center justify-center gap-3 md:mr-10">
      <%= link_to myprofile_participants_path, class:"cursor-pointer" do%>
        <%= current_user_avatar_tag%>
      <%end%>
      <div>
        <p class=""><%= Current.user.full_name%></p>
        <span class="block -mt-1 font-semibold text-gray-400"><%= Current.user.rol.capitalize%></span>
      </div>
      <%= button_to "Cerrar sesión", session_path, method: :delete, class: " transition cursor-pointer shadow-md rounded-xl text-sm flex items-center justify-center bg-[#C8E7E9] border border-[#268EB5] font-semibold hidden md:block py-1 px-2 text-gray-600 rounded-lg hover:border-gray-700"%>
    </nav>
  </div>
  <%# backdrop %>
  <div class="fixed inset-0 z-100 bg-black/50 transition-opacity hidden" data-mobile-menu-target="backdrop" data-action="click->mobile-menu#close">
  </div>
  <%# slide mobile menu%>
  <div class="fixed inset-y-0 left-0 bg-white h-screen w-3/5 z-200 transform -translate-x-full transition-transform duration-300 ease-in-out shadow-xl" data-mobile-menu-target="menu">
    <div class="flex items-center justify-between px-3 pt-3">
      <div class="flex gap-3 items-center">
        <%= image_tag "fsy_letters.svg", class:"w-15 h-15"%>
        <%= image_tag "fsy-logo.svg", class:"w-10 h-10"%>
      </div>
      <button type="button" class="text-gray-700 hover:text-gray-700 focus:outline-none p-2 rounded-md cursor-pointer" data-action="click->mobile-menu#close">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="mt-8 px-2 flex flex-col ">
      <div class="flex flex-col gap-4">
        <%= render(ButtonComponent.new(text:"Inicio", url: dashboard_path, icon: "home.svg", secondary_icon: "home-s.svg", is_nav:true , classes: ""))%>
        <%= render(ButtonComponent.new(text:"Jovenes", url: participants_path, icon: "nav-people.svg", secondary_icon: "nav-people-s.svg", is_nav:true , section: "jovenes"))%>
        <%= render(ButtonComponent.new(text:"Staff", url: staff_participants_path, icon: "nav-people.svg", secondary_icon: "nav-people-s.svg", is_nav:true , section: "staff"))%>
        <%= render(ButtonComponent.new(text:"My profile", url: myprofile_participants_path, icon: "profile.svg", secondary_icon: "profile-s.svg", is_nav:true , section: "myprofile"))%>
      </div>
      <%= button_to "Cerrar sesión", session_path, method: :delete, class: " transition cursor-pointer shadow-md rounded-xl text-sm justify-center bg-[#C8E7E9] border border-[#268EB5] font-semibold  py-1 px-2 text-gray-600 rounded-lg hover:border-gray-700 w-full mt-[530px]"%>
    </nav>
  </div>
</div>
