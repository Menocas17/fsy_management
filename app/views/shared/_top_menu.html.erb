<div data-controller="mobile-menu" data-action="keydown.esc@window->mobile-menu#closeOnEscape" class="relative shrink-0">
  <%# Main nav bar %>
  <header class="h-[60px] md:h-[72px] px-3.5 md:px-8 flex items-center justify-between gap-4 bg-surface border-b border-line-soft">
    <div class="flex items-center gap-2 min-w-0">
      <%# En el teléfono, una página que se abre desde otra (page_back) cambia el menú por el volver, como en iPhone:
          la flecha ‹ y, en el lugar de la sección, a dónde vuelve; la flecha y los dos textos se tocan para volver.
          El menú lateral queda en las páginas principales. %>
      <button type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" data-mobile-menu-target="trigger"
              class="<%= "max-sm:hidden" if page_back %> md:hidden -ml-2.5 size-11 inline-flex items-center justify-center rounded-inner text-ink-700 hover:bg-muted cursor-pointer"
              data-action="click->mobile-menu#toggle">
        <%= icon "menu", class: "w-[22px] h-[22px]" %>
      </button>
      <% if content_for?(:back) %>
        <div data-page-back class="hidden sm:block mr-0.5"><%= yield :back %></div>
      <% end %>
      <div class="relative min-w-0 flex items-center <%= "max-sm:-ml-2" if page_back %>" data-page-header>
        <% if page_back %>
          <%= icon "chevron-left", class: "sm:hidden w-[26px] h-[26px] shrink-0 -mr-px text-primary-600 dark:text-primary-300", aria: { hidden: true } %>
        <% end %>
        <div class="min-w-0">
          <% if page_back %>
            <%= link_to page_back[:label], page_back[:url], data: { scroll_restore: true, page_back_mobile: true }, aria: { label: "Volver a #{page_back[:label]}" },
                  class: "sm:hidden block text-label font-bold text-primary-600 dark:text-primary-300 truncate after:absolute after:-inset-y-1.5 after:-inset-x-1 after:rounded-control active:after:bg-primary-500/10 focus:outline-none focus-visible:after:ring-2 focus-visible:after:ring-primary-500" %>
          <% end %>
          <p class="<%= "max-sm:hidden" if page_back %> text-meta md:text-meta font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300 truncate"><%= page_eyebrow %></p>
          <%= content_tag page_heading_tag, page_heading, class: "mt-px text-sm md:text-display leading-tight font-bold text-ink-900 truncate" %>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-2 md:gap-[18px] shrink-0">
      <%= form_with url: participants_path, method: :get, role: "search", class: "hidden lg:block relative" do %>
        <%= icon "search", class: "absolute left-[13px] top-1/2 -translate-y-1/2 w-[18px] h-[18px] text-ink-500 pointer-events-none" %>
        <%= search_field_tag :query, (params[:query] if controller_name == "participants" && action_name == "index"),
              placeholder: "Buscar participante…", aria: { label: "Buscar participante" },
              class: "w-[220px] h-10 rounded-control pl-[38px] pr-3 text-body bg-canvas border border-line text-ink-900 placeholder:text-ink-300 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-500/30" %>
      <% end %>

      <%= render "shared/notifications_bell" %>

      <%# En el teléfono la foto sola no parecía botón: lleva colgada de su esquina una insignia redonda con la
          flecha hacia abajo (como WhatsApp o Gmail). En escritorio, el nombre y la flecha van al lado. %>
      <div data-controller="dropdown" class="relative ml-1 md:ml-0">
        <button type="button" aria-haspopup="true" aria-expanded="false" aria-label="Menú de cuenta"
                class="relative flex items-center gap-2.5 rounded-tile after:absolute after:-inset-1.5 md:after:hidden md:py-1.5 md:pl-1.5 md:pr-3 hover:bg-muted cursor-pointer transition"
                data-action="click->dropdown#toggle click@window->dropdown#hide keydown.esc@window->dropdown#close">
          <%= current_user_avatar_tag(class: "w-8 h-8 md:w-9 md:h-9 text-label md:text-body") %>
          <span class="md:hidden absolute -right-1.5 -bottom-1.5 size-[17px] rounded-full bg-surface border border-line flex items-center justify-center text-ink-700 shadow-sm">
            <%= icon "chevron-down", class: "size-[11px] stroke-[3] transition-transform duration-200", data: { dropdown_target: "chevron" } %>
          </span>
          <span class="hidden md:block text-left leading-tight">
            <span class="block text-body font-bold text-ink-900"><%= Current.user.full_name %></span>
            <span class="block text-label font-medium text-ink-500"><%= Current.user.role_label %></span>
          </span>
          <%= icon "chevron-down", class: "hidden md:block w-4 h-4 text-ink-500 transition-transform duration-200", data: { dropdown_target: "chevron" } %>
        </button>

        <div class="dropdown-menu hidden absolute right-0 top-full mt-2 w-56 max-h-[calc(100dvh-80px)] overflow-y-auto z-50 py-1.5 bg-surface border border-line-soft rounded-tile shadow-lg"
             data-dropdown-target="menu">
          <%# En el teléfono la barra no dice quién es la cuenta: el menú lo dice antes de las opciones. %>
          <div class="md:hidden flex items-center gap-2.5 mx-1.5 px-3 pt-1.5 pb-3 mb-1.5 border-b border-line-soft">
            <%= current_user_avatar_tag(class: "w-9 h-9 text-body") %>
            <span class="min-w-0 leading-tight">
              <span class="block text-body font-bold text-ink-900 truncate"><%= Current.user.full_name %></span>
              <span class="block text-label font-medium text-ink-500 truncate"><%= Current.user.role_label %></span>
            </span>
          </div>
          <%= link_to settings_path, class: "flex items-center gap-2.5 mx-1.5 px-3 py-2 rounded-inner text-body font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-muted dark:hover:text-ink-900 transition" do %>
            <%= icon "settings", class: "w-4 h-4" %>
            Configuración
          <% end %>
          <%= link_to myprofile_participants_path, class: "flex items-center gap-2.5 mx-1.5 px-3 py-2 rounded-inner text-body font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-muted dark:hover:text-ink-900 transition" do %>
            <%= icon "user-round", class: "w-4 h-4" %>
            Mi perfil
          <% end %>
          <%# Accesos es cosa de la cuenta del sistema, no del trabajo del evento: vive aquí y no en el menú lateral. %>
          <% if Current.user.superadmin? %>
            <%= link_to accesses_path, data: { account_menu: "accesses" },
                  class: "flex items-center gap-2.5 mx-1.5 px-3 py-2 rounded-inner text-body font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-muted dark:hover:text-ink-900 transition" do %>
              <%= icon "shield-check", class: "w-4 h-4" %>
              Accesos
            <% end %>
          <% end %>
          <%# «Ver como» (ViewAsController): el superadmin prueba el menú y los permisos de cada rol. %>
          <% if Current.real_user.superadmin? %>
            <div class="border-t border-line-soft my-1.5"></div>
            <% if Current.viewing_as? %>
              <%= button_to view_as_path, method: :delete, form_class: "mx-1.5",
                    class: "w-full flex items-center gap-2.5 px-3 py-2 rounded-inner text-left text-body font-medium text-ink-700 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-muted dark:hover:text-ink-900 cursor-pointer transition" do %>
                <%= icon "undo-2", class: "w-4 h-4" %>
                Volver a superadmin
              <% end %>
            <% end %>
            <p class="mx-1.5 px-3 pt-1.5 pb-1 text-meta font-bold tracking-[.07em] uppercase text-ink-500">Ver como</p>
            <div data-view-as-roles>
              <% Participant::VIEW_AS_ROLES.each do |rol| %>
                <%= button_to view_as_path, params: { rol: rol }, form_class: "mx-1.5",
                      class: "w-full flex items-center gap-2.5 px-3 py-1.5 rounded-inner text-left text-body font-medium cursor-pointer transition #{Current.user.rol.to_s == rol ? "bg-primary-50 text-primary-700 dark:bg-muted dark:text-ink-900" : "text-ink-700 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-muted dark:hover:text-ink-900"}" do %>
                  <%= icon "eye", class: "w-4 h-4" %>
                  <%= Participant.role_label(rol) %>
                <% end %>
              <% end %>
            </div>
          <% end %>
          <div class="border-t border-line-soft my-1.5"></div>
          <%= button_to session_path, method: :delete, form_class: "mx-1.5",
                class: "w-full flex items-center gap-2.5 px-3 py-2 rounded-inner text-left text-body font-medium text-cat-rose-ink hover:bg-cat-rose/10 cursor-pointer transition" do %>
            <%= icon "log-out", class: "w-4 h-4" %>
            Cerrar sesión
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <%# backdrop %>
  <div class="fixed inset-0 z-100 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-200" data-mobile-menu-target="backdrop" data-action="click->mobile-menu#close">
  </div>
  <%# slide mobile menu %>
  <%# La curva de los paneles de iOS: arranca rápido y frena suave, en vez del ease-in-out que arranca lento. %>
  <div id="mobile-menu" role="dialog" aria-modal="true" aria-label="Menú"
       class="fixed inset-y-0 left-0 z-200 w-72 max-w-[85vw] h-dvh flex flex-col bg-surface shadow-lg transform -translate-x-full transition-transform duration-[280ms] ease-[cubic-bezier(0.32,0.72,0,1)]" data-mobile-menu-target="menu">
    <div class="flex items-center justify-between gap-2 mx-4 pt-5 pb-4 border-b border-line-soft">
      <%= render "shared/brand" %>
      <button type="button" aria-label="Cerrar menú" data-mobile-menu-target="closeButton"
              class="size-11 -mr-2 inline-flex items-center justify-center rounded-inner text-ink-500 dark:text-ink-700 hover:bg-muted cursor-pointer"
              data-action="click->mobile-menu#close">
        <%= icon "x", class: "w-5 h-5" %>
      </button>
    </div>
    <div data-controller="scroll-reveal" class="scroll-reveal flex-1 overflow-y-auto px-4 pt-2 pb-4">
      <%= render "shared/nav_sections", context: "drawer" %>
    </div>
    <div class="mx-4 pt-3 pb-5 border-t border-line-soft">
      <%= button_to session_path, method: :delete,
            class: "w-full flex items-center justify-center gap-2 h-10 rounded-control border border-line text-sm font-semibold text-ink-700 hover:border-cat-rose hover:text-cat-rose-ink cursor-pointer transition" do %>
        <%= icon "log-out", class: "w-4 h-4" %>
        Cerrar sesión
      <% end %>
    </div>
  </div>
</div>
