<%
  # Marco común de las tres pantallas de acceso: marca a la izquierda, formulario a la derecha.
  headline = local_assigns.fetch(:headline)
  meta_icon = local_assigns.fetch(:meta_icon)
  meta_text = local_assigns.fetch(:meta_text)
%>
<div class="w-full max-w-4xl">
  <div class="grid md:grid-cols-[minmax(0,0.88fr)_minmax(0,1.12fr)] rounded-[22px] overflow-hidden border border-line-soft bg-surface shadow-lg">
    <aside class="bg-hero text-white px-6 py-7 md:px-8 md:py-9 flex flex-col gap-4">
      <div class="flex items-center gap-3">
        <span class="w-[52px] h-[52px] shrink-0 rounded-[15px] bg-white/15 border border-white/20 flex items-center justify-center">
          <%= image_tag "fsy-mark.png", alt: "", aria: { hidden: true }, class: "w-8 h-8" %>
        </span>
        <span>
          <span class="block text-[15px] font-extrabold leading-tight">FSY Management</span>
          <span class="block mt-0.5 text-[11px] font-bold tracking-[.07em] uppercase text-white/70">Managua-Caribe</span>
        </span>
      </div>

      <h2 class="text-[21px] md:text-[25px] font-extrabold leading-tight tracking-tight text-balance"><%= headline %></h2>

      <p class="inline-flex items-center gap-2 text-[12.5px] font-semibold text-white/80">
        <%= icon meta_icon, class: "w-4 h-4 shrink-0" %>
        <%= meta_text %>
      </p>

      <figure class="hidden md:block mt-auto rounded-[14px] bg-white/10 border border-white/15 px-4 py-4">
        <blockquote class="text-[12.5px] leading-relaxed italic text-white/90">
          “He aquí mi Espíritu reposa sobre ti; por consiguiente justificaré todas tus palabras… por tanto, anda conmigo.”
        </blockquote>
        <figcaption class="mt-2 text-[10.5px] font-bold tracking-[.06em] uppercase text-white/70">Moisés 6:34</figcaption>
      </figure>
    </aside>

    <div class="px-6 py-8 md:px-9 md:py-10 flex flex-col justify-center">
      <% if flash[:alert].present? %>
        <div id="alert" role="alert" class="mb-5 flex items-start gap-2.5 rounded-xl border border-cat-rose/30 bg-cat-rose/10 px-3.5 py-3 text-[13px] font-semibold leading-snug text-cat-rose">
          <%= icon "circle-alert", class: "w-[17px] h-[17px] shrink-0 mt-px" %>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>
      <% if flash[:notice].present? %>
        <div id="notice" role="status" class="mb-5 flex items-start gap-2.5 rounded-xl border border-cat-green/30 bg-cat-green/10 px-3.5 py-3 text-[13px] font-semibold leading-snug text-cat-green">
          <%= icon "check", class: "w-[17px] h-[17px] shrink-0 mt-px" %>
          <span><%= flash[:notice] %></span>
        </div>
      <% end %>

      <%= yield %>
    </div>
  </div>

  <p class="mt-5 text-center text-[11.5px] font-semibold text-ink-300">FSY 2027 · Managua-Caribe · 11 al 16 de enero</p>
</div>
