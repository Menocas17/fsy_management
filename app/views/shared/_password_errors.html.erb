<% if user.errors.any? %>
  <div role="alert" class="mt-5 rounded-xl border border-cat-rose/30 bg-cat-rose/10 px-3.5 py-3">
    <p class="flex items-start gap-2.5 text-[13px] font-bold text-cat-rose-ink">
      <%= icon "circle-alert", class: "w-[17px] h-[17px] shrink-0 mt-px" %>
      No se pudo cambiar la contraseña:
    </p>
    <ul class="mt-1.5 ml-7 list-disc text-[12.5px] font-semibold text-cat-rose-ink">
      <% user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
