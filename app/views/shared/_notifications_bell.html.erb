<%
  # Se renderiza también desde un job para refrescar la campanita en vivo: de ahí el local `user`,
  # porque fuera de una petición no hay Current.user ni helpers del controlador.
  user = local_assigns.fetch(:user, Current.user)
  unread = user&.unread_alerts_count.to_i
  badge = "absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-cat-rose text-white text-meta font-extrabold flex items-center justify-center border-2 border-surface empty:hidden"
%>
<div id="notifications_bell" class="contents" data-controller="alert-chime" data-alert-chime-unread-value="<%= unread %>"
     data-action="alerts:changed@window->alert-chime#check"
     data-alert-chime-count-url-value="<%= count_notifications_path %>" data-alert-chime-read-url-value="<%= read_notifications_path %>">
<%= link_to notifications_path, aria: { label: "Notificaciones#{unread.positive? ? ", #{unread} sin leer" : ""}" }, data: { tour: "bell" },
      class: "md:hidden relative w-8 h-8 after:absolute after:-inset-1.5 rounded-control border border-line bg-canvas flex items-center justify-center text-ink-500 dark:text-ink-700" do %>
  <%= icon "bell", class: "w-[17px] h-[17px]" %>
  <span class="<%= badge %>" data-unread-count data-alert-chime-target="badge" <%= "hidden" unless unread.positive? %>><%= unread %></span>
<% end %>
<div data-controller="dropdown" class="relative hidden md:block">
  <button type="button" data-notifications-trigger aria-haspopup="true"
          aria-label="Notificaciones<%= ", #{unread} sin leer" if unread.positive? %>"
          data-action="click->dropdown#toggle click->alert-chime#markRead click@window->dropdown#hide keydown.esc@window->dropdown#close"
          class="relative w-10 h-10 rounded-control border border-line bg-canvas flex items-center justify-center text-ink-500 dark:text-ink-700 hover:text-ink-900 cursor-pointer transition">
    <%= icon "bell", class: "w-5 h-5" %>
    <span class="<%= badge %>" data-unread-count data-alert-chime-target="badge" <%= "hidden" unless unread.positive? %>><%= unread %></span>
  </button>
  <div class="dropdown-menu hidden absolute right-0 top-full mt-2 w-96 z-50 overflow-hidden bg-surface border border-line-soft rounded-tile shadow-lg"
       data-dropdown-target="menu">
    <%# La lista se pide al abrir el menú (NotificationsController#menu): el frame perezoso carga cuando se ve. %>
    <%= turbo_frame_tag "notifications_menu", src: menu_notifications_path, loading: :lazy, target: "_top" do %>
      <p class="px-5 py-6 text-center text-label text-ink-500">Cargando…</p>
    <% end %>
  </div>
</div>
</div>
