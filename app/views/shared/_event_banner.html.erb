<%# FSY 2026 wordmark banner that heads profile pages; the identity card below overlaps its bottom edge. %>
<div class="relative h-32 md:h-[150px] rounded-panel overflow-hidden bg-hero shadow-lg">
  <div class="h-full flex items-center justify-center pb-11 md:pb-[52px]" data-banner-wordmark>
    <p class="flex items-baseline gap-2.5">
      <span class="text-[30px] md:text-[38px] font-extrabold leading-none tracking-[-.01em] text-[oklch(88%_0.03_230)]">fsy</span>
      <span>
        <span class="block text-lg md:text-2xl font-extrabold leading-none text-[oklch(74%_0.02_250)]"><%= Rails.configuration.x.event_name.split.last %></span>
        <span class="block mt-[3px] text-meta md:text-meta font-semibold tracking-[.02em] text-[oklch(66%_0.02_250)]"><%= Rails.configuration.x.event_region %></span>
      </span>
    </p>
  </div>
</div>
