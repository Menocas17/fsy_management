<%
  # Campo de contraseña con el ojo para verla; con rules: true muestra los requisitos que valida el modelo.
  attribute = local_assigns.fetch(:attribute)
  label = local_assigns.fetch(:label)
  autocomplete = local_assigns.fetch(:autocomplete)
  rules = local_assigns.fetch(:rules, false)
%>
<div data-controller="password">
  <%= form.label attribute, label, class: field_label_classes %>
  <div class="relative flex items-center">
    <%= form.password_field attribute, required: true, autocomplete: autocomplete, maxlength: 72,
          placeholder: local_assigns[:placeholder],
          class: "#{auth_input_classes} pr-12",
          data: { password_target: "field", action: ("input->password#check" if rules) }.compact %>
    <button type="button" data-action="password#toggle" data-password-target="button" aria-label="Mostrar la contraseña"
            class="absolute right-1.5 w-8 h-8 rounded-[9px] flex items-center justify-center text-ink-300 hover:text-primary-600 hover:bg-primary-50 transition cursor-pointer">
      <%= icon "eye", class: "w-[17px] h-[17px]", data: { password_target: "showIcon" } %>
      <%= icon "eye-off", class: "w-[17px] h-[17px] hidden", data: { password_target: "hideIcon" } %>
    </button>
  </div>

  <% if rules %>
    <ul class="mt-2.5 grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1.5">
      <% { "length" => "8 caracteres", "uppercase" => "Una mayúscula", "digit" => "Un número", "special" => "Un carácter especial" }.each do |key, text| %>
        <li data-password-target="rule" data-rule="<%= key %>" class="flex items-center gap-1.5 text-[12px] font-semibold text-ink-500">
          <%= icon "circle", class: "w-3.5 h-3.5 shrink-0", data: { rule_icon: "pending" } %>
          <%= icon "check", class: "w-3.5 h-3.5 shrink-0 hidden", data: { rule_icon: "met" } %>
          <%= text %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
