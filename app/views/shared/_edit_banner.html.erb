<%# Short hero banner for edit/new pages: a back link and, when editing, the record's name. %>
<div class="h-[110px] rounded-[22px] bg-hero shadow-lg px-4 md:px-7 pt-4 md:pt-5 flex items-start justify-between gap-3">
  <%= link_to back_path,
        class: "inline-flex items-center gap-2 h-9 px-3.5 shrink-0 rounded-[11px] bg-white/15 border border-white/25 text-white text-[13px] font-bold hover:bg-white/25 transition" do %>
    <%= icon "arrow-left", class: "w-4 h-4" %>
    <%= back_label %>
  <% end %>
  <p class="mt-2 min-w-0 truncate text-[12px] font-semibold text-white/75">
    <% if local_assigns[:editing].present? %>
      Editando <b class="text-white"><%= editing %></b>
    <% else %>
      <%= local_assigns[:caption] %>
    <% end %>
  </p>
</div>
