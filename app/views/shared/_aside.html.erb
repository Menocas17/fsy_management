    <%= image_tag "fsy_letters.svg", class:"w-15 h-15"%>
    <%= image_tag "fsy-logo.svg", class:"w-10 h-10"%>
  </div>
  <nav class="mt-8 flex flex-col gap-1">
    <% nav_items.each do |item| %>
      <%= render(ButtonComponent.new(**item)) %>
    <% end %>
  </nav>
</aside>