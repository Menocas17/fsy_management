<%# La marca queda fija arriba; solo la lista de opciones se desplaza (con su barra discreta, .scroll-reveal). %>
<aside class="hidden md:flex md:flex-col w-56 shrink-0 bg-surface border-r border-line-soft">
  <div class="shrink-0 px-4 pt-[22px]">
    <div class="px-2 pt-1.5 pb-[22px] mb-2 border-b border-line-soft">
      <%= render "shared/brand" %>
    </div>
  </div>
  <div data-controller="scroll-reveal" data-scroll-reveal-key-value="aside" class="scroll-reveal flex-1 min-h-0 overflow-y-auto pl-4 pr-2.5 pt-2.5 pb-6">
    <%= render "shared/nav_sections" %>
  </div>
  <%# El joven no tiene menú de cuenta en la barra superior: sale desde el pie del menú, como en el cajón. %>
  <% if Current.user.participant&.joven? %>
    <div class="shrink-0 mx-4 pt-3 pb-5 border-t border-line-soft">
      <%= button_to session_path, method: :delete, data: { aside_sign_out: true },
            class: "w-full flex items-center justify-center gap-2 h-10 rounded-control border border-line text-sm font-semibold text-ink-700 hover:border-cat-rose hover:text-cat-rose-ink cursor-pointer transition" do %>
        <%= icon "log-out", class: "w-4 h-4" %>
        Cerrar sesión
      <% end %>
    </div>
  <% end %>
</aside>
