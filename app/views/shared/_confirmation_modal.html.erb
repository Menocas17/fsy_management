<%# Turbo pide la confirmación aquí (confirm_controller). El formulario que dispara puede cambiar el
    detalle y el botón con data-turbo-confirm-detail / data-turbo-confirm-button; si no, se asume un borrado. %>
<div data-controller="confirm">
  <dialog data-confirm-target="modal" aria-labelledby="confirm-title" aria-describedby="confirm-detail"
          data-action="close->confirm#settle click->confirm#clickOutside"
          class="app-dialog p-0 rounded-card shadow-lg backdrop:bg-ink-900/55 max-w-sm w-[calc(100%-2rem)] m-auto bg-surface text-ink-900">
    <form method="dialog" class="p-6 text-center">
      <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-cat-rose/12 text-cat-rose-ink">
        <%= icon "triangle-alert", class: "w-6 h-6" %>
      </div>
      <h2 id="confirm-title" data-confirm-target="message" class="text-display font-bold text-ink-900 mb-2">
        ¿Estás seguro?
      </h2>
      <p id="confirm-detail" data-confirm-target="detail" class="text-body text-ink-500 mb-6"></p>
      <div class="flex justify-center gap-3">
        <button value="cancel" autofocus
                class="h-11 px-4 rounded-control border border-line bg-surface text-body font-semibold text-ink-700 hover:bg-canvas active:scale-[0.97] transition cursor-pointer dark:text-slate-200 dark:hover:bg-slate-700">
          Cancelar
        </button>
        <button value="confirm" data-confirm-target="confirmButton"
                class="h-11 px-4 rounded-control bg-danger text-body font-semibold text-white hover:bg-danger/90 active:scale-[0.97] transition cursor-pointer">
          Sí, eliminar
        </button>
      </div>
    </form>
  </dialog>
</div>
