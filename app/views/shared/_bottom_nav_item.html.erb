<%# Una opción de la barra inferior; la de la página abierta lleva la rayita de sol arriba. %>
<%= link_to item[:url], aria: { current: ("page" if item[:active]) }, data: { bottom_nav_item: item[:text], tour: local_assigns[:tour] },
      class: "relative min-w-0 min-h-[60px] flex flex-col items-center justify-center gap-1 px-0.5 text-meta tracking-tight whitespace-nowrap transition-colors #{item[:active] ? "font-extrabold text-ink-900" : "font-semibold text-ink-500 hover:text-ink-900"}" do %>
  <% if item[:active] %><span class="absolute top-0 inset-x-[24%] h-[3px] rounded-b-full bg-sun" aria-hidden="true"></span><% end %>
  <%= icon item[:icon], class: "size-[22px]" %>
  <span class="max-w-full truncate"><%= item[:text] %></span>
<% end %>
