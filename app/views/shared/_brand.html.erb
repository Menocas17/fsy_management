<%= link_to dashboard_path, class: "flex items-center gap-[11px] min-w-0", aria: { label: "#{Rails.configuration.x.event_name} #{Rails.configuration.x.event_region}, ir al inicio" } do %>
  <span class="w-[42px] h-[42px] shrink-0 rounded-xl bg-brand-tile p-[7px] flex shadow-sm">
    <%= image_tag "fsy-mark.png", alt: "", class: "w-full h-full object-contain" %>
  </span>
  <span class="leading-tight min-w-0">
    <span class="block text-[15px] font-extrabold text-ink-900"><%= Rails.configuration.x.event_name %></span>
    <span class="block text-[11.5px] font-medium text-ink-500">Managua · Caribe</span>
  </span>
<% end %>
