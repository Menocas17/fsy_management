<%# Elegir icono y color viéndolos: cada opción muestra su dibujo y su nombre, y arriba se ve cómo queda.
    Lo usan los inventarios y las categorías de gasto (form con atributos icon y color). %>
<% current_icon = local_assigns[:icon].presence_in(Appearance::ICONS.keys) || local_assigns.fetch(:default_icon, "package") %>
<% current_color = local_assigns[:color].presence_in(Appearance::COLORS.keys) || "primary" %>
<div data-controller="appearance-picker"
     data-appearance-picker-icon-label-value="<%= Appearance::ICONS[current_icon] %>"
     data-appearance-picker-color-label-value="<%= Appearance::COLORS[current_color] %>"
     data-appearance-picker-color-class-value="<%= Appearance.color_class(current_color) %>">
  <div class="flex items-center gap-3 mb-5 rounded-tile bg-canvas px-4 py-3" aria-live="polite">
    <span data-appearance-picker-target="tile"
          class="w-11 h-11 shrink-0 rounded-tile text-white flex items-center justify-center <%= Appearance.color_class(current_color) %>">
      <span data-appearance-picker-target="icon" class="contents"><%= icon current_icon, class: "w-5 h-5" %></span>
    </span>
    <p class="text-body font-semibold text-ink-500">
      Así se verá:
      <span class="font-bold text-ink-900" data-appearance-picker-target="summary"><%= Appearance::ICONS[current_icon] %> · <%= Appearance::COLORS[current_color] %></span>
    </p>
  </div>

  <fieldset>
    <legend class="<%= field_label_classes %>">Color</legend>
    <div class="flex flex-wrap gap-2">
      <% Appearance::COLORS.each do |key, label| %>
        <label class="relative cursor-pointer">
          <%= form.radio_button :color, key, checked: key == current_color, class: "peer sr-only",
                data: { action: "change->appearance-picker#pickColor", label: label, color_class: Appearance.color_class(key) } %>
          <span class="inline-flex items-center gap-2 h-9 pl-1.5 pr-3 rounded-full border border-line text-label font-semibold text-ink-700 hover:bg-canvas transition
                       peer-checked:border-primary-500 peer-checked:bg-primary-50 peer-checked:text-primary-800 dark:peer-checked:bg-primary-700/40 dark:peer-checked:text-white
                       peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500">
            <span class="w-6 h-6 rounded-full <%= Appearance.color_class(key) %>" aria-hidden="true"></span>
            <%= label %>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="mt-6">
    <legend class="<%= field_label_classes %>">Icono</legend>
    <div class="max-h-96 overflow-y-auto pr-1 -mr-1">
      <% Appearance::ICON_GROUPS.each do |group, icons| %>
        <p class="mt-3 first:mt-0 mb-1.5 text-label font-semibold text-ink-500"><%= group %></p>
        <div class="grid grid-cols-3 min-[420px]:grid-cols-4 sm:grid-cols-6 lg:grid-cols-8 gap-1.5">
          <% icons.each do |key, label| %>
            <label class="relative cursor-pointer">
              <%= form.radio_button :icon, key, checked: key == current_icon, class: "peer sr-only",
                    data: { action: "change->appearance-picker#pickIcon", label: label } %>
              <span class="h-full flex flex-col items-center justify-center gap-1 rounded-control border border-line px-1 py-2 text-ink-700 hover:bg-canvas transition
                           peer-checked:border-primary-500 peer-checked:bg-primary-50 peer-checked:text-primary-800 dark:peer-checked:bg-primary-700/40 dark:peer-checked:text-white
                           peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500">
                <%= icon key, class: "w-5 h-5" %>
                <span class="text-meta font-semibold leading-tight text-center"><%= label %></span>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
  </fieldset>
</div>
