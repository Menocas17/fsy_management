<%#
  La hoja de instalar la app (install_controller.js). No viaja con cada página: el controlador la pide a
  InstallSheetsController y la pone en shared/_install_sheet cuando va a abrirla. Sale sola al entrar, una vez por
  visita, a quien abre la app desde el navegador del teléfono; instalada, ya no. «Ahora no» la calla un día;
  también se abre desde Configuración → Instalar la app (cualquier elemento con data-install-open).

  Cada teléfono ve su panel:
    android        Chrome dio permiso de instalar: un botón y listo, con el diálogo del propio Android.
    android-manual Sin ese permiso (Firefox, o se pidió desde Configuración): dónde está en el menú.
    ios            iPhone no deja instalar desde la página: los pasos, en láminas que se deslizan. Lo que cambia
                   entre Safari 26, el Safari de antes y Chrome del iPhone va en data-only.
    inapp          Dentro de Facebook, Instagram o Messenger no se puede de ninguna forma: a abrirla afuera.
%>
<% benefit = ->(icon_name, text) do %>
  <li class="flex items-center gap-3">
    <span class="size-9 shrink-0 rounded-tile bg-sun/15 text-sun-ink flex items-center justify-center"><%= icon icon_name, class: "size-[18px]" %></span>
    <span class="text-body leading-snug text-ink-700"><%= text %></span>
  </li>
<% end %>
<% intro = ->(title, subtitle) do %>
  <div class="flex flex-col items-center text-center">
    <img src="/icon-192.png" alt="" width="64" height="64" class="size-16 rounded-tile shadow-md">
    <h2 class="mt-3 text-title font-extrabold text-ink-900" data-install-title><%= title %></h2>
    <p class="mt-1 text-body leading-snug text-ink-500"><%= subtitle %></p>
  </div>
<% end %>
<% benefits = capture do %>
  <ul class="mt-5 flex flex-col gap-3">
    <% benefit.("zap", "Se abre con un toque desde tu pantalla de inicio, sin buscar el enlace.") %>
    <% benefit.("maximize", "A pantalla completa, sin la barra del navegador.") %>
    <% benefit.("bell-ring", "Te llegan las alertas aunque la tengas cerrada.") %>
  </ul>
<% end %>
<% step_badge = ->(number) do %>
  <span class="text-meta font-bold tracking-[.08em] uppercase text-sun-ink">Paso <%= number %> de 3</span>
<% end %>

<dialog data-install-target="sheet" data-action="click->install#clickOutside cancel->install#cancel" aria-labelledby="install-sheet-title"
        class="install-sheet md:hidden p-0 mt-auto mb-0 mx-0 w-full max-w-none bg-transparent backdrop:bg-black/50 backdrop:backdrop-blur-[2px]">
  <%# autofocus aquí: si no, el diálogo enfoca lo primero que encuentra (las láminas, un botón) y lo marca con el aro. %>
  <div class="px-5 pt-2.5 pb-[max(env(safe-area-inset-bottom),20px)] rounded-t-panel bg-surface shadow-lg outline-none"
       tabindex="-1" autofocus data-controller="sheet-drag" data-action="sheet-drag:dismiss->install#later">
    <div class="w-10 h-1 mx-auto mb-4 rounded-full bg-line" aria-hidden="true"></div>
    <span id="install-sheet-title" class="sr-only">Instalar la app</span>

    <%# Android con permiso: el botón abre el diálogo de instalar del teléfono. %>
    <div data-install-panel="android" hidden>
      <% intro.("Instala FSY en tu teléfono", "Queda como una app más, junto a las otras.") %>
      <%= benefits %>
      <button type="button" data-action="install#install" class="<%= button_classes(:primary, size: :lg, extra: "mt-6 w-full") %>">
        <%= icon "download", class: "size-[18px]" %>
        Instalar
      </button>
      <button type="button" data-action="install#later" class="<%= button_classes(:ghost, size: :lg, extra: "mt-2 w-full") %>">Ahora no</button>
    </div>

    <%# Android sin permiso de instalar desde la página: el menú del navegador lo hace. %>
    <div data-install-panel="android-manual" hidden>
      <% intro.("Instala FSY en tu teléfono", "Se agrega desde el menú del navegador.") %>
      <div class="mt-5 rounded-card bg-sunken p-4">
        <div class="flex items-center gap-2 rounded-control bg-surface border border-line-soft px-3 h-10">
          <%= icon "globe", class: "size-4 text-ink-300" %>
          <span class="flex-1 truncate text-label text-ink-500"><%= request.host %></span>
          <span class="install-pulse size-8 -mr-1.5 rounded-full bg-sun text-primary-900 flex items-center justify-center"><%= icon "ellipsis-vertical", class: "size-[18px]" %></span>
        </div>
        <ol class="mt-4 flex flex-col gap-2 text-body leading-snug text-ink-700 list-decimal pl-5">
          <li>Toca <strong class="text-ink-900">⋮</strong>, arriba a la derecha.</li>
          <li>Elige <strong class="text-ink-900">«Instalar app»</strong> o <strong class="text-ink-900">«Agregar a la pantalla principal»</strong>.</li>
          <li>Confirma con <strong class="text-ink-900">Instalar</strong>.</li>
        </ol>
      </div>
      <button type="button" data-action="install#done" class="<%= button_classes(:primary, size: :lg, extra: "mt-6 w-full") %>">Entendido</button>
    </div>

    <%# iPhone: cuatro láminas que se deslizan; «Siguiente» avanza y los puntos dicen dónde vas. %>
    <div data-install-panel="ios" hidden>
      <div data-install-target="track" data-action="scroll->install#track" class="install-track -mx-5 flex overflow-x-auto snap-x snap-mandatory overscroll-x-contain">
        <div class="w-full shrink-0 snap-center px-5" data-install-slide>
          <% intro.("Instala FSY en tu iPhone", "Son 3 pasos en Safari, menos de un minuto.") %>
          <ul class="mt-5 flex flex-col gap-3">
            <% benefit.("zap", "Se abre con un toque desde tu pantalla de inicio, sin buscar el enlace.") %>
            <% benefit.("maximize", "A pantalla completa, sin la barra del navegador.") %>
            <% benefit.("bell-ring", "En iPhone es la única forma de que te lleguen las alertas.") %>
          </ul>
        </div>

        <div class="w-full shrink-0 snap-center px-5" data-install-slide>
          <% step_badge.(1) %>
          <h3 class="mt-1 text-title font-extrabold text-ink-900">
            <span data-only="safari26">Toca <span aria-label="el botón de los tres puntos">⋯</span> y luego Compartir</span>
            <span data-only="safari">Toca Compartir</span>
            <span data-only="other">Toca Compartir</span>
          </h3>
          <p class="mt-1 text-body leading-snug text-ink-500">
            <span data-only="safari26">Los tres puntos están en la barra de abajo, a la derecha de la dirección.</span>
            <span data-only="safari">Es el cuadrito con una flecha hacia arriba, en la barra de abajo.</span>
            <span data-only="other">En Chrome está arriba, a la derecha de la dirección. En otro navegador, búscalo en su menú.</span>
          </p>
          <div class="mt-5 rounded-card bg-sunken p-4" aria-hidden="true">
            <div data-only="safari26" class="flex items-center gap-2">
              <span class="size-10 shrink-0 rounded-full bg-surface border border-line-soft text-ink-500 flex items-center justify-center"><%= icon "chevron-left", class: "size-5" %></span>
              <span class="flex-1 h-10 rounded-full bg-surface border border-line-soft flex items-center justify-center text-label text-ink-500 truncate px-3"><%= request.host %></span>
              <span class="install-pulse size-10 shrink-0 rounded-full bg-sun text-primary-900 flex items-center justify-center"><%= icon "ellipsis", class: "size-5" %></span>
            </div>
            <div data-only="safari" class="flex items-center justify-around h-11 rounded-tile bg-surface border border-line-soft text-ink-300">
              <%= icon "chevron-left", class: "size-5" %>
              <%= icon "chevron-right", class: "size-5" %>
              <span class="install-pulse size-9 rounded-full bg-sun text-primary-900 flex items-center justify-center"><%= icon "share", class: "size-[18px]" %></span>
              <%= icon "book-open", class: "size-5" %>
              <%= icon "copy", class: "size-5" %>
            </div>
            <div data-only="other" class="flex items-center gap-2 rounded-full bg-surface border border-line-soft pl-3 pr-1 h-11">
              <%= icon "lock", class: "size-4 text-ink-300" %>
              <span class="flex-1 truncate text-label text-ink-500"><%= request.host %></span>
              <span class="install-pulse size-9 rounded-full bg-sun text-primary-900 flex items-center justify-center"><%= icon "share", class: "size-[18px]" %></span>
            </div>
          </div>
        </div>

        <div class="w-full shrink-0 snap-center px-5" data-install-slide>
          <% step_badge.(2) %>
          <h3 class="mt-1 text-title font-extrabold text-ink-900">Elige «Agregar a inicio»</h3>
          <p class="mt-1 text-body leading-snug text-ink-500">Desliza la lista hacia arriba hasta verlo. En algunos iPhone dice «Agregar a pantalla de inicio».</p>
          <div class="mt-5 rounded-card bg-sunken p-3 flex flex-col gap-1.5" aria-hidden="true">
            <div class="flex items-center justify-between h-10 px-3 rounded-inner bg-surface text-label text-ink-300">
              Copiar <%= icon "copy", class: "size-4" %>
            </div>
            <div class="install-pulse flex items-center justify-between h-11 px-3 rounded-inner bg-sun text-primary-900 text-body font-bold">
              Agregar a inicio <%= icon "square-plus", class: "size-5" %>
            </div>
            <div class="flex items-center justify-between h-10 px-3 rounded-inner bg-surface text-label text-ink-300">
              Agregar marcador <%= icon "book-open", class: "size-4" %>
            </div>
          </div>
        </div>

        <div class="w-full shrink-0 snap-center px-5" data-install-slide>
          <% step_badge.(3) %>
          <h3 class="mt-1 text-title font-extrabold text-ink-900">Toca «Agregar»</h3>
          <p class="mt-1 text-body leading-snug text-ink-500">
            <span data-only="safari26">Deja encendido «Abrir como app web» y toca Agregar, arriba a la derecha.</span>
            <span data-only="safari other">Está arriba a la derecha.</span>
            Después ábrela desde el ícono <strong class="text-ink-900">FSY</strong> de tu pantalla de inicio y entra una vez más con tu correo y contraseña.
          </p>
          <div class="mt-5 rounded-card bg-sunken p-3 flex flex-col gap-1.5" aria-hidden="true">
            <div class="flex items-center justify-between h-10 px-1 text-label">
              <span class="text-ink-300">Cancelar</span>
              <span class="install-pulse px-3 h-8 rounded-full bg-sun text-primary-900 font-bold flex items-center">Agregar</span>
            </div>
            <div class="flex items-center gap-3 h-14 px-3 rounded-inner bg-surface">
              <img src="/icon-192.png" alt="" class="size-9 rounded-inner">
              <span class="text-body font-semibold text-ink-900">FSY</span>
            </div>
            <div data-only="safari26" class="flex items-center justify-between h-11 px-3 rounded-inner bg-surface text-label text-ink-700">
              Abrir como app web
              <span class="w-[42px] h-6 rounded-full bg-cat-green-solid p-[2px] flex justify-end"><span class="size-5 rounded-full bg-white shadow-sm"></span></span>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-5 flex justify-center gap-1.5" aria-hidden="true">
        <% 4.times do %>
          <span data-install-target="dot" class="h-1.5 w-1.5 rounded-full bg-line transition-all data-active:w-5 data-active:bg-sun"></span>
        <% end %>
      </div>
      <button type="button" data-install-target="next" data-action="install#next" class="<%= button_classes(:primary, size: :lg, extra: "mt-5 w-full") %>">
        Ver cómo
      </button>
      <button type="button" data-install-target="secondary" data-action="install#later" class="<%= button_classes(:ghost, size: :lg, extra: "mt-2 w-full") %>">Ahora no</button>
      <button type="button" data-action="install#installed" class="mt-1 w-full h-9 text-label font-semibold text-ink-500 cursor-pointer">Ya la tengo instalada</button>
    </div>

    <%# Dentro de Facebook, Instagram o Messenger: se abre la misma dirección en el navegador del teléfono. %>
    <div data-install-panel="inapp" hidden>
      <div class="flex flex-col items-center text-center">
        <span class="size-16 rounded-tile bg-sun/15 text-sun-ink flex items-center justify-center"><%= icon "compass", class: "size-8" %></span>
        <h2 class="mt-3 text-title font-extrabold text-ink-900">Ábrela en tu navegador</h2>
        <p class="mt-1 text-body leading-snug text-ink-500">
          Desde esta app no se puede instalar. Ábrela en
          <span data-only="ios">Safari</span><span data-only="android">Chrome</span>
          y ahí te mostramos cómo.
        </p>
      </div>
      <a href="#" data-install-target="external" class="<%= button_classes(:primary, size: :lg, extra: "mt-6 w-full") %>">
        <%= icon "external-link", class: "size-[18px]" %>
        <span>Abrir en <span data-only="ios">Safari</span><span data-only="android">Chrome</span></span>
      </a>
      <button type="button" data-action="install#copy" class="<%= button_classes(:secondary, size: :lg, extra: "mt-2 w-full") %>">
        <%= icon "copy", class: "size-[18px]" %>
        <span data-install-target="copyLabel">Copiar el enlace</span>
      </button>
      <p class="mt-4 text-label leading-relaxed text-ink-500 text-center">
        Si no se abre, toca <strong class="text-ink-900">⋯</strong> arriba y elige «Abrir en el navegador», o pega el enlace en
        <span data-only="ios">Safari</span><span data-only="android">Chrome</span>.
      </p>
      <button type="button" data-action="install#later" class="<%= button_classes(:ghost, size: :lg, extra: "mt-3 w-full") %>">Ahora no</button>
    </div>

    <%# Tras el sí de Android: dónde quedó. %>
    <div data-install-panel="installed" hidden>
      <div class="flex flex-col items-center text-center py-2">
        <span class="size-16 rounded-full bg-cat-green/15 text-cat-green-ink flex items-center justify-center"><%= icon "check", class: "size-8 stroke-[2.6]" %></span>
        <h2 class="mt-3 text-title font-extrabold text-ink-900">¡Listo!</h2>
        <p class="mt-1 text-body leading-snug text-ink-500">Búscala en tu pantalla de inicio como <strong class="text-ink-900">FSY</strong>. Desde ahora ábrela desde ahí.</p>
      </div>
      <button type="button" data-action="install#close" class="<%= button_classes(:primary, size: :lg, extra: "mt-6 w-full") %>">Entendido</button>
    </div>
  </div>
</dialog>
