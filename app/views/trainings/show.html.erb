<% content_for :page_h1, true %>
<% content_for :title, @training.name %>
<% content_for :eyebrow, "Capacitaciones" %>
<% back_to_origin "Capacitaciones", agenda_trainings_path %>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <span class="w-11 h-11 shrink-0 rounded-tile bg-cat-indigo text-white flex items-center justify-center">
        <%= icon "graduation-cap", class: "w-5 h-5" %>
      </span>
      <div class="min-w-0">
        <h1 class="text-display font-extrabold tracking-tight text-ink-900 truncate"><%= @training.name %></h1>
        <p class="text-label font-semibold text-ink-500">
          <%= SpanishDates.long(@training.held_on) %> de <%= @training.held_on.year %>
          <%= " · #{@training.location}" if @training.location.present? %>
        </p>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if can_manage_agenda? %>
        <%= link_to edit_agenda_training_path(@training), class: button_classes(:secondary) do %>
          <%= icon "pencil", class: "w-4 h-4" %>
          Editar
        <% end %>
      <% end %>
      <% if can_check_in? && @training.scan_window.open? %>
        <%= link_to checkins_path(training_id: @training.id, return_to: request.fullpath),
              class: button_classes do %>
          <%= icon "scan-qr-code", class: "w-4 h-4" %>
          Escanear asistencia
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @training.notes.present? %>
    <div class="mb-5 rounded-tile border border-line-soft bg-canvas px-5 py-4" data-training-notes>
      <p class="text-body font-bold text-ink-700">Notas</p>
      <p class="mt-1 text-body leading-relaxed text-ink-900 whitespace-pre-line"><%= @training.notes %></p>
    </div>
  <% end %>

  <%= render "trainings/roster", training: @training %>
<% end %>
