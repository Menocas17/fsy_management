<% content_for :title, "Capacitaciones" %>
<% content_for :eyebrow, "Agenda" %>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
    <%= render SegmentedToggleComponent.new(label: "Vista de la agenda", items: [
          { text: "Agenda del evento", icon: "calendar-days", href: agenda_path },
          { text: "Capacitaciones", icon: "graduation-cap", href: agenda_trainings_path, active: true }
        ]) %>
    <%# Como en Inventario: escanear es secundario y crear, el botón navy, al final. El PDF de asistencia vive en
        Reportes. En el teléfono los dos caben en una fila con su nombre corto (a 320 px el largo no entra). %>
    <% scan_training = @trainings.find { |training| training.scan_window.open? } if can_check_in? %>
    <% if scan_training || can_manage_agenda? %>
      <div class="grid grid-flow-col auto-cols-fr sm:flex sm:items-center gap-2" data-training-actions>
        <% if scan_training %>
          <%= link_to checkins_path(training_id: scan_training.id, return_to: request.fullpath),
                class: button_classes(:secondary, extra: "max-sm:px-3"), aria: { label: "Escanear asistencia" } do %>
            <%= icon "scan-qr-code", class: "w-4 h-4" %>
            <span class="sm:hidden">Escanear</span><span class="max-sm:hidden">Escanear asistencia</span>
          <% end %>
        <% end %>
        <% if can_manage_agenda? %>
          <%= link_to new_agenda_training_path, class: button_classes(extra: "max-sm:px-3"), aria: { label: "Nueva capacitación" } do %>
            <%= icon "plus", class: "w-4 h-4" %>
            <span class="sm:hidden">Nueva</span><span class="max-sm:hidden">Nueva capacitación</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @trainings.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-5">
      <%= render partial: "trainings/summary_card", collection: @trainings, as: :training %>
    </div>
  <% else %>
    <div class="<%= card_classes("p-5 md:p-6") %>">
      <%= render EmptyStateComponent.new(title: "Todavía no hay capacitaciones", icon: "graduation-cap", tone: :amber, name: "trainings",
            text: "Son las fechas de preparación del staff antes del evento.") do |empty| %>
        <% if can_manage_agenda? %>
          <% empty.with_action { link_to "Crear la primera", new_agenda_training_path, class: button_classes(:secondary) } %>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%= render "trainings/role_breakdown", by_role: @by_role, title: "Última capacitación realizada" %>

  <%# La tabla completa: una columna por fecha, que es la vista que sirve para perseguir a quien falta. %>
  <section class="<%= card_classes("overflow-hidden") %>">
    <div class="flex items-center gap-3 px-5 py-4 border-b border-line-soft">
      <%= render IconTileComponent.new(icon: "user-check", tone: :green) %>
      <div class="min-w-0">
        <h2 class="text-title font-bold text-ink-900">Asistencia del staff</h2>
        <p class="text-label font-semibold text-ink-500"><%= pluralize(@staff.size, "persona") %> · una columna por capacitación</p>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-line-soft">
            <th scope="col" class="px-4 py-3 text-left text-meta font-bold tracking-[.06em] uppercase text-ink-500 sticky left-0 z-[1] bg-surface">Persona</th>
            <th scope="col" class="px-4 py-3 text-left text-meta font-bold tracking-[.06em] uppercase text-ink-500">Rol</th>
            <% @trainings.each do |training| %>
              <th scope="col" class="px-3 py-3 text-center text-meta font-bold tracking-[.06em] uppercase text-ink-500 whitespace-nowrap">
                <%= training.held_on.day %> <%= SpanishDates.month(training.held_on).first(3) %>
              </th>
            <% end %>
            <th scope="col" class="px-4 py-3 text-right text-meta font-bold tracking-[.06em] uppercase text-ink-500">Asistencia</th>
          </tr>
        </thead>
        <tbody>
          <% @staff.each do |person| %>
            <% held = @trainings.reject { |training| training.held_on > Date.current } %>
            <% attended = held.count { |training| @attended[training.id]&.include?(person.id) } %>
            <tr class="group border-b border-line dark:border-line-soft last:border-b-0 hover:bg-canvas dark:hover:bg-muted/40" data-staff-row="<%= person.id %>">
              <%# El nombre queda fijo al desplazar la tabla de lado en el teléfono: si no, se pierde de quién es cada fila. %>
              <td class="px-4 py-3 sticky left-0 z-[1] bg-surface group-hover:bg-canvas dark:group-hover:bg-muted">
                <%= link_to person.full_name, participant_path(person, from: "staff", return_to: return_here),
                      class: "text-body font-bold text-ink-900 hover:underline" %>
              </td>
              <td class="px-4 py-3 text-label font-medium text-ink-700">
                <%= person.role_label %><%= " · #{person.company&.name || person.logistics_area&.name}" if person.company || person.logistics_area %>
              </td>
              <% @trainings.each do |training| %>
                <td class="px-3 py-3 text-center">
                  <% if @attended[training.id]&.include?(person.id) %>
                    <span class="inline-flex w-7 h-7 rounded-inner items-center justify-center bg-cat-green-solid text-white" title="Asistió" data-mark="yes">
                      <%= icon "check", class: "w-4 h-4", "aria-hidden": true %><span class="sr-only">Asistió</span>
                    </span>
                  <% elsif training.held_on > Date.current %>
                    <span class="inline-flex w-7 h-7 rounded-inner items-center justify-center border border-dashed border-ink-300 text-ink-500" title="Todavía no llega" data-mark="pending">
                      <%= icon "clock", class: "w-4 h-4", "aria-hidden": true %><span class="sr-only">Todavía no llega</span>
                    </span>
                  <% else %>
                    <span class="inline-flex w-7 h-7 rounded-inner items-center justify-center bg-cat-rose/15 text-cat-rose-ink ring-1 ring-inset ring-cat-rose/40" title="Faltó" data-mark="no">
                      <%= icon "x", class: "w-4 h-4", "aria-hidden": true %><span class="sr-only">Faltó</span>
                    </span>
                  <% end %>
                </td>
              <% end %>
              <td class="px-4 py-3 text-right text-label font-bold tabular-nums text-ink-900 whitespace-nowrap" data-attendance-total>
                <%= held.any? ? "#{attended} de #{held.size}" : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
