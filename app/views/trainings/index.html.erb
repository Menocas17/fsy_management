<% content_for :title, "Capacitaciones" %>
<% content_for :eyebrow, "Agenda" %>
<%
  tab_base = "inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg text-[12.5px] whitespace-nowrap transition"
  tab_on = "#{tab_base} bg-surface dark:bg-slate-700 shadow-sm font-bold text-ink-900 dark:text-slate-100"
  tab_off = "#{tab_base} font-semibold text-ink-500 dark:text-slate-400 hover:text-ink-900 dark:hover:text-slate-100"
%>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mb-5">
    <nav class="inline-flex p-1 gap-0.5 rounded-[11px] bg-canvas dark:bg-slate-900 border border-line dark:border-slate-700 w-fit" aria-label="Vista de la agenda">
      <%= link_to agenda_path, class: tab_off do %>
        <%= icon "calendar-days", class: "w-3.5 h-3.5" %>
        Agenda del evento
      <% end %>
      <%= link_to agenda_trainings_path, class: tab_on, aria: { current: "page" } do %>
        <%= icon "graduation-cap", class: "w-3.5 h-3.5" %>
        Capacitaciones
      <% end %>
    </nav>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to trainings_reports_path, target: "_blank", rel: "noopener",
            class: "inline-flex items-center gap-2 h-10 px-3.5 rounded-[11px] border border-line dark:border-slate-600 bg-surface dark:bg-slate-800 text-[13px] font-semibold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 transition" do %>
        <%= icon "printer", class: "w-4 h-4" %>
        PDF de asistencia
      <% end %>
      <% if can_check_in? && (next_training = @trainings.find { |training| !training.past? }) %>
        <%= link_to checkins_path(training_id: next_training.id),
              class: "inline-flex items-center gap-2 h-10 px-4 rounded-[11px] bg-primary-700 text-sm font-semibold text-white shadow-sm hover:bg-primary-800 transition" do %>
          <%= icon "scan-qr-code", class: "w-4 h-4" %>
          Escanear asistencia
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-5">
    <%= render partial: "trainings/summary_card", collection: @trainings, as: :training %>
  </div>

  <div class="mb-5">
    <%= render "trainings/role_breakdown", by_role: @by_role, title: "Última capacitación realizada" %>
  </div>

  <%# La tabla completa: una columna por fecha, que es la vista que sirve para perseguir a quien falta. %>
  <section class="<%= card_classes("overflow-hidden") %>">
    <div class="px-5 py-4 border-b border-line-soft dark:border-slate-700">
      <p class="text-[14px] font-bold text-ink-900 dark:text-slate-100">Asistencia del staff</p>
      <p class="text-[11.5px] font-semibold text-ink-500 dark:text-slate-400"><%= pluralize(@staff.size, "persona") %> · una columna por capacitación</p>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-line-soft dark:border-slate-700">
            <th class="px-4 py-3 text-left text-[10.5px] font-bold tracking-[.06em] uppercase text-ink-300 dark:text-slate-500">Persona</th>
            <th class="px-4 py-3 text-left text-[10.5px] font-bold tracking-[.06em] uppercase text-ink-300 dark:text-slate-500">Rol</th>
            <% @trainings.each do |training| %>
              <th class="px-3 py-3 text-center text-[10.5px] font-bold tracking-[.06em] uppercase text-ink-300 dark:text-slate-500 whitespace-nowrap">
                <%= training.held_on.day %> <%= SpanishDates.month(training.held_on).first(3) %>
              </th>
            <% end %>
            <th class="px-4 py-3 text-right text-[10.5px] font-bold tracking-[.06em] uppercase text-ink-300 dark:text-slate-500">Asistencia</th>
          </tr>
        </thead>
        <tbody>
          <% @staff.each do |person| %>
            <% held = @trainings.reject { |training| training.held_on > Date.current } %>
            <% attended = held.count { |training| @attended[training.id]&.include?(person.id) } %>
            <tr class="border-b border-line-soft dark:border-slate-700 last:border-b-0" data-staff-row="<%= person.id %>">
              <td class="px-4 py-3">
                <%= link_to person.full_name, participant_path(person, from: "staff"),
                      class: "text-[13.5px] font-bold text-ink-900 dark:text-slate-100 hover:underline" %>
              </td>
              <td class="px-4 py-3 text-[12.5px] text-ink-500 dark:text-slate-400">
                <%= person.role_label %><%= " · #{person.company&.name || person.logistics_area&.name}" if person.company || person.logistics_area %>
              </td>
              <% @trainings.each do |training| %>
                <td class="px-3 py-3 text-center">
                  <% if @attended[training.id]&.include?(person.id) %>
                    <span class="inline-flex w-6 h-6 rounded-lg items-center justify-center text-cat-green bg-cat-green/12" title="Asistió" data-mark="yes">
                      <%= icon "check", class: "w-3.5 h-3.5" %>
                    </span>
                  <% elsif training.held_on > Date.current %>
                    <span class="inline-flex w-6 h-6 rounded-lg items-center justify-center text-ink-300 dark:text-slate-500 bg-canvas dark:bg-slate-900" title="Todavía no llega" data-mark="pending">
                      <%= icon "clock", class: "w-3.5 h-3.5" %>
                    </span>
                  <% else %>
                    <span class="inline-flex w-6 h-6 rounded-lg items-center justify-center text-cat-rose bg-cat-rose/12" title="Faltó" data-mark="no">
                      <%= icon "x", class: "w-3.5 h-3.5" %>
                    </span>
                  <% end %>
                </td>
              <% end %>
              <td class="px-4 py-3 text-right text-[12.5px] font-bold tabular-nums text-ink-700 dark:text-slate-300" data-attendance-total>
                <%= held.any? ? "#{attended} de #{held.size}" : "—" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
