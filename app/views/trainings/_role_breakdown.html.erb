<section class="<%= card_classes("p-5 md:p-6") %>" data-role-breakdown>
  <%= section_heading title, "chart-column", tone: :indigo %>
  <% if by_role.any? %>
    <ul class="space-y-3">
      <% by_role.each do |label, figures| %>
        <% share = figures[:expected].zero? ? 0 : (figures[:attended] * 100.0 / figures[:expected]).round %>
        <li class="flex items-center gap-3" data-role-row="<%= label.parameterize %>">
          <span class="w-28 sm:w-40 shrink-0 text-body font-bold leading-tight text-ink-900"><%= label %></span>
          <span class="flex-1 flex h-2 rounded-full overflow-hidden bg-canvas">
            <span class="<%= share >= 80 ? "bg-cat-green-solid" : "bg-cat-amber-solid" %>" style="width: <%= share %>%"></span>
          </span>
          <span class="shrink-0 text-label font-bold tabular-nums text-ink-700">
            <%= figures[:attended] %> de <%= figures[:expected] %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-body text-ink-500">Todavía no hay asistencias registradas.</p>
  <% end %>
</section>
