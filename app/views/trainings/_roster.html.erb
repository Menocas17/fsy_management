<%# Cifras y listas de una capacitación. Marcar o quitar a mano vuelve a pintar solo este bloque
    (turbo_stream), así la página no salta arriba entre marca y marca; highlight señala a quién se movió. %>
<% attendances = training.attendances.recent.includes(participant: [ :company, :logistics_area ]) %>
<% absentees = training.absentees.includes(:company, :logistics_area) %>
<% highlight = local_assigns[:highlight] %>
<% pending = training.pending? %>
<% missing_label = pending ? "Pendientes" : "Faltaron" %>
<div id="training-roster">
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-5">
    <% [ [ "Asistieron", training.attended_count, "bg-cat-green", "user-check" ],
         [ missing_label, training.expected_count - training.attended_count, pending ? "bg-cat-amber" : "bg-cat-rose", pending ? "clock" : "x" ],
         [ "Del staff", training.expected_count, "bg-cat-indigo", "users" ] ].each do |label, value, tone, icon_name| %>
      <div class="<%= card_classes("flex items-center gap-4 px-5 py-[18px]") %>">
        <span class="w-[52px] h-[52px] shrink-0 rounded-[14px] text-white flex items-center justify-center <%= tone %>">
          <%= icon icon_name, class: "w-6 h-6" %>
        </span>
        <div>
          <p class="text-[34px] font-extrabold leading-none tabular-nums text-ink-900 dark:text-slate-100" data-figure="<%= label.parameterize %>"><%= value %></p>
          <p class="mt-1 text-[13px] font-semibold text-ink-500 dark:text-slate-400"><%= label %></p>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mb-5"><%= render "trainings/role_breakdown", by_role: training.role_breakdown, title: "Quiénes vinieron" %></div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
    <section class="<%= card_classes("p-5 md:p-6") %>">
      <%= section_heading "Asistieron · #{attendances.size}", "user-check" %>
      <% if attendances.any? %>
        <ul class="divide-y divide-line-soft dark:divide-slate-700" data-attendees>
          <% attendances.each do |attendance| %>
            <li class="flex items-center gap-3 py-2.5 first:pt-0 <%= "roster-moved" if attendance.participant_id == highlight %>">
              <span class="text-[12px] font-bold tabular-nums text-ink-500 dark:text-slate-400 shrink-0"><%= attendance.recorded_at.strftime("%H:%M") %></span>
              <span class="min-w-0 flex-1">
                <span class="block text-[13.5px] font-bold text-ink-900 dark:text-slate-100 truncate"><%= attendance.participant.full_name %></span>
                <span class="block text-[11.5px] font-semibold text-ink-500 dark:text-slate-400">
                  <%= attendance.participant.role_label %><%= " · marcada a mano" if attendance.source_manual? %>
                </span>
              </span>
              <% if can_check_in? %>
                <%= button_to agenda_training_attendance_path(training, attendance), method: :delete,
                      form: { data: { turbo_confirm: "¿Quitar la asistencia de #{attendance.participant.full_name}?",
                                      turbo_confirm_detail: "Se puede volver a marcar después.", turbo_confirm_button: "Sí, quitar" } },
                      class: "shrink-0 inline-flex items-center min-h-11 md:min-h-0 px-2 text-[12px] font-bold text-rose-700 dark:text-cat-rose hover:underline cursor-pointer" do %>
                  Quitar
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-[13px] text-ink-500 dark:text-slate-400">Todavía no hay asistencias registradas.</p>
      <% end %>
    </section>

    <section class="<%= card_classes("p-5 md:p-6") %>">
      <%= section_heading "#{pending ? "Por registrar" : "Faltaron"} · #{absentees.size}", "user-x" %>
      <% if absentees.any? %>
        <ul class="divide-y divide-line-soft dark:divide-slate-700" data-absentees>
          <% absentees.each do |person| %>
            <li class="flex items-center gap-3 py-2.5 first:pt-0 <%= "roster-moved" if person.id == highlight %>">
              <span class="min-w-0 flex-1">
                <span class="block text-[13.5px] font-bold text-ink-900 dark:text-slate-100 truncate"><%= person.full_name %></span>
                <span class="block text-[11.5px] font-semibold text-ink-500 dark:text-slate-400">
                  <%= person.role_label %><%= " · #{person.company&.name || person.logistics_area&.name}" if person.company || person.logistics_area %>
                </span>
              </span>
              <% if can_check_in? %>
                <%= button_to agenda_training_attendances_path(training, participant_id: person.id),
                      class: "shrink-0 inline-flex items-center gap-1.5 h-11 md:h-8 px-3 rounded-[10px] border border-line dark:border-slate-600 text-[12px] font-bold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 active:scale-[0.97] cursor-pointer transition" do %>
                  Marcar
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-[13px] text-ink-500 dark:text-slate-400"><%= pending ? "Ya están todos marcados." : "Vino todo el staff." %></p>
      <% end %>
    </section>
  </div>
</div>
