<% content_for :title, "Inventario" %>
<% content_for :eyebrow, "Gestión" %>
<%
  total_items = @inventories.sum { |inventory| inventory.items.size }
  low_total = @inventories.sum { |inventory| inventory.items.count { |item| item.low? || item.out? } }
  secondary = "inline-flex items-center gap-2 h-10 px-3.5 rounded-control border border-line bg-surface text-body font-semibold text-ink-700 hover:bg-canvas dark:hover:bg-slate-700 transition"
%>
<%= render PageComponent.new(width: :page) do %>
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mb-5">
    <p class="text-body font-semibold text-ink-500" data-inventory-summary>
      <%= pluralize(@inventories.size, "inventario") %>
      · <%= pluralize(total_items, "artículo") %>
      · <%= low_total %> por agotarse
    </p>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to scan_inventories_path, class: secondary do %>
        <%= icon "scan-qr-code", class: "w-4 h-4" %>
        Escanear QR
      <% end %>
      <% if can_manage_inventories? %>
        <%= link_to new_inventory_path, class: button_classes do %>
          <%= icon "plus", class: "w-4 h-4" %>
          Nuevo inventario
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @inventories.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-4 md:gap-5">
      <% @inventories.each do |inventory| %>
        <% low = inventory.items.count(&:low?) %>
        <% out = inventory.items.count(&:out?) %>
        <%= link_to inventory, class: card_classes("p-5 flex flex-col gap-3 transition-[background-color,transform] duration-150 hover:bg-canvas active:scale-[0.99]") do %>
          <div class="flex items-center gap-3">
            <span class="size-10 shrink-0 rounded-tile text-white flex items-center justify-center <%= inventory_tile_class(inventory) %>">
              <%= icon inventory.icon, class: "w-[19px] h-[19px]" %>
            </span>
            <div class="min-w-0">
              <p class="text-title font-bold text-ink-900 truncate"><%= inventory.name %></p>
              <p class="text-label font-semibold text-ink-500 truncate"><%= inventory.description.presence || "Sin descripción" %></p>
            </div>
          </div>
          <div class="flex items-center justify-between gap-2 pt-3 border-t border-line-soft">
            <span class="text-display font-extrabold tabular-nums text-ink-900" data-inventory-count="<%= inventory.code_prefix %>">
              <%= inventory.items.size %>
              <span class="ml-1 text-label font-bold text-ink-500">artículos</span>
            </span>
            <% if out.positive? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-meta font-bold text-cat-rose-ink bg-cat-rose/10"><%= pluralize(out, "agotado") %></span>
            <% elsif low.positive? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-meta font-bold text-cat-amber-ink bg-cat-amber/10"><%= low %> por agotarse</span>
            <% else %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-meta font-bold text-cat-green-ink bg-cat-green/10">al día</span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="<%= card_classes("p-5 md:p-6") %>">
      <%= render EmptyStateComponent.new(title: "Todavía no hay inventarios", icon: "boxes", name: "inventories",
            text: "Crea el primero (Materiales, Comida, Medicinas) y empieza a cargarle artículos.") do |empty| %>
        <% if can_manage_inventories? %>
          <% empty.with_action { link_to "Nuevo inventario", new_inventory_path, class: button_classes(:secondary) } %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
