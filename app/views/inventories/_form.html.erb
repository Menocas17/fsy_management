<%= form_with model: inventory, class: "space-y-5" do |form| %>
  <% if inventory.errors.any? %>
    <div class="rounded-tile border border-cat-rose/30 bg-cat-rose/10 px-5 py-3 text-sm font-semibold text-cat-rose-ink" role="alert">
      <% inventory.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <section class="<%= card_classes("p-5 md:p-6") %>">
    <%= section_heading "Datos del inventario", "boxes" %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
      <div>
        <%= form.label :name, "Nombre", class: field_label_classes %>
        <%= form.text_field :name, required: true, maxlength: 60, placeholder: "Ej. Materiales", class: field_input_classes %>
        <% if inventory.persisted? %>
          <p class="mt-1.5 text-[11.5px] font-medium text-ink-500">
            Los códigos ya impresos siguen siendo <span class="font-mono"><%= inventory.code_prefix %>-0000</span>: el prefijo no cambia.
          </p>
        <% else %>
          <p class="mt-1.5 text-[11.5px] font-medium text-ink-500">De aquí sale el prefijo de los códigos QR (Materiales → MAT-0001).</p>
        <% end %>
      </div>
      <div>
        <%= form.label :description, "Descripción", class: field_label_classes %>
        <%= form.text_field :description, maxlength: 90, placeholder: "Ej. Camisetas, manillas, papelería", class: field_input_classes %>
      </div>
    </div>
  </section>

  <%# Icono y color se eligen viéndolos: cada opción muestra su dibujo y su nombre, y arriba se ve cómo queda. %>
  <% current_icon = inventory.icon.presence_in(Inventory::ICONS.keys) || "package" %>
  <% current_color = inventory.color.presence_in(Inventory::COLORS.keys) || "primary" %>
  <section class="<%= card_classes("p-5 md:p-6") %>" data-controller="inventory-appearance"
           data-inventory-appearance-icon-label-value="<%= Inventory::ICONS[current_icon] %>"
           data-inventory-appearance-color-label-value="<%= Inventory::COLORS[current_color] %>"
           data-inventory-appearance-color-class-value="<%= inventory_color_class(current_color) %>">
    <%= section_heading "Icono y color", "palette" %>

    <div class="flex items-center gap-3 mb-5 rounded-tile bg-canvas px-4 py-3" aria-live="polite">
      <span data-inventory-appearance-target="tile"
            class="w-11 h-11 shrink-0 rounded-tile text-white flex items-center justify-center <%= inventory_color_class(current_color) %>">
        <span data-inventory-appearance-target="icon" class="contents"><%= icon current_icon, class: "w-5 h-5" %></span>
      </span>
      <p class="text-[13px] font-semibold text-ink-500">
        Así se verá:
        <span class="font-bold text-ink-900" data-inventory-appearance-target="summary"><%= Inventory::ICONS[current_icon] %> · <%= Inventory::COLORS[current_color] %></span>
      </p>
    </div>

    <fieldset>
      <legend class="<%= field_label_classes %>">Color</legend>
      <div class="flex flex-wrap gap-2">
        <% Inventory::COLORS.each do |key, label| %>
          <label class="cursor-pointer">
            <%= form.radio_button :color, key, checked: key == current_color, class: "peer sr-only",
                  data: { action: "change->inventory-appearance#pickColor", label: label, color_class: inventory_color_class(key) } %>
            <span class="inline-flex items-center gap-2 h-9 pl-1.5 pr-3 rounded-full border border-line text-[12.5px] font-semibold text-ink-700 hover:bg-canvas transition
                         peer-checked:border-primary-500 peer-checked:bg-primary-50 peer-checked:text-primary-800 dark:peer-checked:bg-primary-700/40 dark:peer-checked:text-white
                         peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500">
              <span class="w-6 h-6 rounded-full <%= inventory_color_class(key) %>" aria-hidden="true"></span>
              <%= label %>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="mt-6">
      <legend class="<%= field_label_classes %>">Icono</legend>
      <div class="max-h-96 overflow-y-auto pr-1 -mr-1">
        <% Inventory::ICON_GROUPS.each do |group, icons| %>
          <p class="mt-3 first:mt-0 mb-1.5 text-[11.5px] font-semibold text-ink-500"><%= group %></p>
          <div class="grid grid-cols-3 min-[420px]:grid-cols-4 sm:grid-cols-6 lg:grid-cols-8 gap-1.5">
            <% icons.each do |key, label| %>
              <label class="cursor-pointer">
                <%= form.radio_button :icon, key, checked: key == current_icon, class: "peer sr-only",
                      data: { action: "change->inventory-appearance#pickIcon", label: label } %>
                <span class="h-full flex flex-col items-center justify-center gap-1 rounded-control border border-line px-1 py-2 text-ink-700 hover:bg-canvas transition
                             peer-checked:border-primary-500 peer-checked:bg-primary-50 peer-checked:text-primary-800 dark:peer-checked:bg-primary-700/40 dark:peer-checked:text-white
                             peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500">
                  <%= icon key, class: "w-5 h-5" %>
                  <span class="text-[11px] font-semibold leading-tight text-center"><%= label %></span>
                </span>
              </label>
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>
  </section>

  <div class="<%= card_classes("px-5 py-4 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3") %>">
    <div>
      <% if inventory.persisted? %>
        <%= button_to inventory_path(inventory), method: :delete,
              form: { data: { turbo_confirm: "Esto borra el inventario y todos sus artículos. ¿Seguro?" } },
              class: "inline-flex items-center gap-2 h-10 px-3 rounded-control text-sm font-semibold text-cat-rose-ink hover:bg-cat-rose/10 transition cursor-pointer" do %>
          <%= icon "trash-2", class: "w-4 h-4" %>
          Borrar inventario
        <% end %>
      <% end %>
    </div>
    <div class="flex gap-2.5 sm:justify-end">
      <%= link_to "Cancelar", inventory.persisted? ? inventory : inventories_path,
            class: button_classes(:secondary, extra: "flex-1 sm:flex-none") %>
      <%= form.submit inventory.persisted? ? "Guardar cambios" : "Crear inventario",
            class: button_classes(:primary, extra: "flex-1 sm:flex-none") %>
    </div>
  </div>
<% end %>
