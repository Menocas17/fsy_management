<%= form_with model: inventory, id: "inventory-form", class: "space-y-5" do |form| %>
  <% if inventory.errors.any? %>
    <div class="rounded-tile border border-cat-rose/30 bg-cat-rose/10 px-5 py-3 text-sm font-semibold text-cat-rose-ink" role="alert">
      <% inventory.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <section class="<%= card_classes("p-5 md:p-6") %>">
    <%= section_heading "Datos del inventario", "boxes" %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
      <div>
        <%= form.label :name, "Nombre", class: field_label_classes %>
        <%= form.text_field :name, required: true, maxlength: 60, placeholder: "Ej. Materiales", class: field_input_classes %>
        <% if inventory.persisted? %>
          <p class="mt-1.5 text-label font-medium text-ink-500">
            Los códigos ya impresos siguen siendo <span class="font-mono"><%= inventory.code_prefix %>-0000</span>: el prefijo no cambia.
          </p>
        <% else %>
          <p class="mt-1.5 text-label font-medium text-ink-500">De aquí sale el prefijo de los códigos QR (Materiales → MAT-0001).</p>
        <% end %>
      </div>
      <div>
        <%= form.label :description, "Descripción", class: field_label_classes %>
        <%= form.text_field :description, maxlength: 90, placeholder: "Ej. Camisetas, manillas, papelería", class: field_input_classes %>
      </div>
    </div>
  </section>

  <%# Marcado, sus artículos son los medicamentos que enfermería da desde la ficha clínica (y descuenta de aquí). %>
  <section class="<%= card_classes("p-5 md:p-6") %>">
    <label class="flex items-start gap-3 cursor-pointer">
      <%= form.check_box :infirmary, class: "mt-[3px] w-4 h-4 accent-primary-600" %>
      <span>
        <span class="flex items-center gap-2 text-body font-bold text-ink-900"><%= icon "heart-pulse", class: "w-4 h-4 text-cat-rose-ink" %>Inventario de enfermería</span>
        <span class="block mt-0.5 text-label text-ink-500">Sus artículos aparecen al anotar un medicamento en la ficha de un joven, y lo que se da se descuenta de aquí solo.</span>
      </span>
    </label>
  </section>

  <section class="<%= card_classes("p-5 md:p-6") %>">
    <%= section_heading "Icono y color", "palette" %>
    <%= render "shared/appearance_picker", form: form, icon: inventory.icon, color: inventory.color %>
  </section>
<% end %>

<%# Los botones van fuera del formulario: «Borrar» es su propio formulario (button_to) y no puede ir
    anidado; «Guardar» apunta al formulario por su id. %>
<div class="<%= card_classes("mt-5 px-5 py-4 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3") %>">
  <div>
    <% if inventory.persisted? %>
      <%= button_to inventory_path(inventory), method: :delete,
            form: { data: { turbo_confirm: "Esto borra el inventario y todos sus artículos. ¿Seguro?" } },
            class: "inline-flex items-center gap-2 h-10 px-3 rounded-control text-sm font-semibold text-cat-rose-ink hover:bg-cat-rose/10 transition cursor-pointer" do %>
        <%= icon "trash-2", class: "w-4 h-4" %>
        Borrar inventario
      <% end %>
    <% end %>
  </div>
  <div class="flex gap-2.5 sm:justify-end">
    <%= link_to "Cancelar", inventory.persisted? ? inventory : inventories_path,
          class: button_classes(:secondary, extra: "flex-1 sm:flex-none") %>
    <%= tag.button inventory.persisted? ? "Actualizar" : "Crear", type: "submit", form: "inventory-form",
          data: { turbo_submits_with: "Guardando…" }, class: button_classes(:primary, extra: "flex-1 sm:flex-none whitespace-nowrap") %>
  </div>
</div>
