<% content_for :title, @auxiliar_company.name %>
<% content_for :eyebrow, "Compañías" %>
<% content_for :heading, "Compañía auxiliar" %>
<% content_for :page_h1, "true" %>
<% back_to "Compañías auxiliares", auxiliar_companies_path %>
<%
  counselor_total = @companies.sum { |company| company.counselors.size }
  counselor_capacity = @companies.size * 2
  jovenes_total = @companies.sum { |company| @jovenes_counts.fetch(company.id, 0) }
  numbers = @auxiliar_company.company_numbers_label
%>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-6xl 2xl:max-w-[1500px] mx-auto">
  <%= render "shared/event_banner" %>

  <div class="<%= card_classes("relative -mt-[58px] mx-3 md:mx-7 px-5 py-5 md:px-7 md:py-6") %>">
    <div class="flex flex-wrap items-center justify-between gap-x-5 gap-y-4">
      <div class="flex items-center gap-4 md:gap-[18px] min-w-0 flex-1 basis-72">
        <span aria-hidden="true"
              class="-mt-10 md:-mt-[46px] shrink-0 w-[72px] h-[72px] md:w-[92px] md:h-[92px] rounded-[20px] md:rounded-[24px] border-4 border-surface dark:border-slate-800 shadow-md bg-brand-tile text-white flex flex-col items-center justify-center">
          <span class="text-[9px] md:text-[10px] font-bold tracking-[.08em] uppercase opacity-75">Aux.</span>
          <span class="text-[26px] md:text-[34px] font-extrabold leading-none"><%= @auxiliar_company.initial %></span>
        </span>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
            <h1 class="text-xl md:text-[22px] font-extrabold tracking-tight text-ink-900 dark:text-slate-100"><%= @auxiliar_company.name %></h1>
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-cat-indigo/15 text-cat-indigo text-xs font-semibold whitespace-nowrap"><%= pluralize(@companies.size, "compañía", plural: "compañías") %></span>
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-cat-blue/15 text-cat-blue text-xs font-semibold whitespace-nowrap"><%= pluralize(jovenes_total, "joven", plural: "jóvenes") %></span>
          </div>
          <p class="mt-1 text-[13px] font-medium text-ink-500 dark:text-slate-400">
            <%= [ numbers && "Compañías #{numbers}", "#{counselor_total} de #{counselor_capacity} consejeros", "#{@auxiliars.size} de 2 auxiliares" ].compact.join(" · ") %>
          </p>
        </div>
      </div>
      <div class="flex gap-2.5 w-full sm:w-auto sm:ml-auto shrink-0">
        <%= link_to safe_return_to(auxiliar_companies_path),
              class: "flex-1 sm:flex-none inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[11px] border border-line dark:border-slate-600 bg-surface dark:bg-slate-800 text-sm font-semibold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 transition" do %>
          <%= icon "arrow-left", class: "w-4 h-4" %>
          Volver
        <% end %>
        <% if can_edit_auxiliar_company?(@auxiliar_company) %>
          <%= link_to edit_auxiliar_company_path(@auxiliar_company),
                class: "flex-1 sm:flex-none inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[11px] bg-primary-700 text-sm font-semibold text-white shadow-sm hover:bg-primary-800 transition" do %>
            <%= icon "square-pen", class: "w-4 h-4" %>
            Editar
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-5 grid grid-cols-1 lg:grid-cols-[minmax(0,336px)_minmax(0,1fr)] 2xl:grid-cols-[minmax(0,380px)_minmax(0,1fr)] gap-5 items-start">
    <div class="space-y-5">
      <section class="<%= card_classes("p-6") %>">
        <%= section_heading "Información general", "layers" %>
        <div>
          <%= info_row "Nombre", "network", @auxiliar_company.name %>
          <%= info_row "Coordinación", "user-check", @auxiliar_company.coordinators.map(&:full_name) %>
          <%= info_row "Compañías", "building-2", numbers %>
          <%= info_row "Consejeros asignados", "users", "#{counselor_total} de #{counselor_capacity}" %>
        </div>
      </section>

      <section class="<%= card_classes("p-6") %>">
        <%= section_heading "Auxiliares", "user-check" %>
        <p class="mb-2 text-[10.5px] font-bold tracking-[.07em] uppercase text-ink-300 dark:text-slate-500">Auxiliares · <%= @auxiliars.size %>/2</p>
        <div class="space-y-2">
          <% %w[H M].each do |gender| %>
            <%= render "companies/leader_slot", person: @auxiliars.find { |auxiliar| auxiliar.gender == gender }, role: "auxiliar", gender: gender %>
          <% end %>
        </div>
      </section>
    </div>

    <section class="min-w-0">
      <div class="flex items-center gap-2.5 mb-3 px-1">
        <%= icon "building-2", class: "w-[17px] h-[17px] text-primary-500 dark:text-primary-300" %>
        <h2 class="text-[11px] font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300">Compañías · <%= @companies.size %></h2>
      </div>
      <% if @companies.any? %>
        <div class="grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-4">
          <%= render partial: "companies/company_card", collection: @companies, as: :company,
                     locals: { jovenes_counts: @jovenes_counts, room_counts: @room_counts } %>
        </div>
      <% else %>
        <div class="<%= card_classes("p-8 text-center") %>">
          <p class="text-ink-500 dark:text-slate-400">Esta compañía auxiliar aún no tiene compañías. Asígnalas desde la edición de cada compañía.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
