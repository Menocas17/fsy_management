<% hint = "mt-1.5 text-label font-medium text-ink-500" %>
<%= form_with model: auxiliar_company, id: "auxiliar-company-form", class: card_classes("relative -mt-10 mx-3 md:mx-7 px-5 py-6 md:px-7") do |form| %>
  <% if auxiliar_company.errors.any? %>
    <div class="mb-5 rounded-tile border border-cat-rose/30 bg-cat-rose/10 px-4 py-3 text-body font-semibold text-cat-rose-ink" role="alert">
      <% auxiliar_company.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-col md:flex-row md:items-start gap-5 md:gap-6">
    <span aria-hidden="true"
          class="w-[72px] h-[72px] md:w-24 md:h-24 shrink-0 rounded-panel md:rounded-panel border-4 border-surface shadow-md bg-brand-tile text-white flex flex-col items-center justify-center">
      <span class="text-meta md:text-meta font-bold tracking-[.08em] uppercase opacity-75">Aux.</span>
      <span class="text-[26px] md:text-[34px] font-extrabold leading-none"><%= auxiliar_company.name.present? ? auxiliar_company.initial : "#" %></span>
    </span>

    <div class="flex-1 min-w-0">
      <%= section_heading "Datos de la compañía auxiliar", "network" %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
        <div class="sm:col-span-2">
          <%= form.label :name, "Nombre", class: field_label_classes %>
          <%= form.text_field :name, required: true, maxlength: 60, placeholder: "Ej. Auxiliar Alfa", class: field_input_classes %>
          <p class="<%= hint %>">Las compañías se asignan a esta rama desde la edición de cada compañía. La cuidan los dos coordinadores, como a todas.</p>
        </div>
      </div>
    </div>
  </div>
<% end %>
