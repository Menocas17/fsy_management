<%= form_with model: auxiliar_company, url: url, class: "bg-white rounded-xl shadow-sm border border-gray-100 p-6" do |f| %>
  <% if auxiliar_company.errors.any? %>
    <div class="bg-rose-50 border border-rose-200 text-rose-700 rounded-lg p-3 mb-4">
      <% auxiliar_company.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :name, "Nombre", class: "block font-semibold mb-1" %>
    <%= f.text_field :name, class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm" %>
  </div>

  <div class="mb-4">
    <%= f.label :coordinator_id, "Coordinador", class: "block font-semibold mb-1" %>
    <%= f.select :coordinator_id,
        options_from_collection_for_select(Participant.coordinators, :id, :full_name, auxiliar_company.coordinator_id),
        { include_blank: "Sin coordinador" },
        class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm" %>
  </div>

  <div class="mb-6">
    <%= f.label :second_coordinator_id, "Segundo coordinador", class: "block font-semibold mb-1" %>
    <%= f.select :second_coordinator_id,
        options_from_collection_for_select(Participant.coordinators, :id, :full_name, auxiliar_company.second_coordinator_id),
        { include_blank: "Sin segundo coordinador" },
        class: "w-full px-3 py-2 rounded-lg border border-gray-200 text-sm" %>
  </div>

  <%= f.submit "Guardar", class: "bg-primary-600 text-white py-2 px-5 rounded-lg text-sm font-bold cursor-pointer" %>
<% end %>
