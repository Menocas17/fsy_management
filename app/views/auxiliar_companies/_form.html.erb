<% hint = "mt-1.5 text-[11.5px] font-medium text-ink-500 dark:text-slate-400" %>
<%= form_with model: auxiliar_company, id: "auxiliar-company-form", class: card_classes("relative -mt-10 mx-3 md:mx-7 px-5 py-6 md:px-7") do |form| %>
  <% if auxiliar_company.errors.any? %>
    <div class="mb-5 rounded-xl border border-cat-rose/30 bg-cat-rose/10 px-4 py-3 text-[13px] font-semibold text-cat-rose" role="alert">
      <% auxiliar_company.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-col md:flex-row md:items-start gap-5 md:gap-6">
    <span aria-hidden="true"
          class="w-[72px] h-[72px] md:w-24 md:h-24 shrink-0 rounded-[20px] md:rounded-3xl border-4 border-surface dark:border-slate-800 shadow-md bg-brand-tile text-white flex flex-col items-center justify-center">
      <span class="text-[9px] md:text-[10px] font-bold tracking-[.08em] uppercase opacity-75">Aux.</span>
      <span class="text-[26px] md:text-[34px] font-extrabold leading-none"><%= auxiliar_company.name.present? ? auxiliar_company.initial : "#" %></span>
    </span>

    <div class="flex-1 min-w-0">
      <%= section_heading "Datos de la compañía auxiliar", "network" %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-5">
        <div class="sm:col-span-2">
          <%= form.label :name, "Nombre", class: field_label_classes %>
          <%= form.text_field :name, required: true, maxlength: 60, placeholder: "Ej. Auxiliar Alfa", class: field_input_classes %>
          <p class="<%= hint %>">Las compañías se asignan a esta rama desde la edición de cada compañía.</p>
        </div>
        <% if auxiliar_company.new_record? || auxiliar_company_edit_level(auxiliar_company) == :full %>
        <% coordinator_options = Participant.coordinators.order(:first_name, :last_name).map { |coordinator| [ coordinator.full_name, coordinator.id ] } %>
        <div>
          <%= form.label :coordinator_id, "Coordinador", class: field_label_classes %>
          <%= form.select :coordinator_id, coordinator_options, { include_blank: "Sin coordinador" }, class: field_select_classes %>
        </div>
        <div>
          <%= form.label :second_coordinator_id, "Segundo coordinador", class: field_label_classes %>
          <%= form.select :second_coordinator_id, coordinator_options, { include_blank: "Sin segundo coordinador" }, class: field_select_classes %>
          <p class="<%= hint %>">Ambos coordinadores supervisan esta compañía auxiliar.</p>
        </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
