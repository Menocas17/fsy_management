<section class="<%= card_classes("p-6") %>">
  <%= section_heading "Compañías", "building-2" %>
  <% if companies.any? %>
    <ul class="space-y-1.5">
      <% companies.each do |company| %>
        <li>
          <%= link_to company_path(company), class: "flex items-center gap-2.5 rounded-tile -mx-2 px-2 py-1.5 hover:bg-canvas dark:hover:bg-muted/50 transition" do %>
            <span class="w-8 h-8 shrink-0 rounded-control bg-primary-100 text-primary-700 dark:bg-primary-700/30 dark:text-primary-100 text-body font-extrabold flex items-center justify-center"><%= company.number || "–" %></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-body font-bold text-ink-900"><%= company.name %></span>
              <span class="block truncate text-label font-semibold text-ink-500"><%= company.nickname.presence || "Sin nombre elegido" %></span>
            </span>
            <span class="shrink-0 text-label font-bold text-ink-500 tabular-nums"><%= company.counselors.size %>/2</span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-body text-ink-500">Sin compañías asignadas.</p>
  <% end %>
  <p class="mt-4 flex gap-2 rounded-tile px-3.5 py-3 bg-primary-50 text-primary-700 dark:bg-primary-700/25 dark:text-primary-100 text-label font-semibold leading-snug">
    <%= icon "info", class: "w-4 h-4 mt-0.5 shrink-0" %>
    <span>Para mover una compañía a esta rama, cambia su compañía auxiliar desde la edición de la compañía.</span>
  </p>
</section>
