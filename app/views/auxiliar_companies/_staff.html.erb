<section id="lideres" class="<%= card_classes("p-6 min-w-0") %>">
  <%= section_heading "Auxiliares", "user-check" %>
  <p class="-mt-2 mb-5 text-[12px] font-medium text-ink-500 dark:text-slate-400">Los cambios se guardan al instante · 1 hombre y 1 mujer. Los consejeros se asignan en cada compañía.</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
    <% %w[H M].each do |gender| %>
      <% person = auxiliars.find { |auxiliar| auxiliar.gender == gender } %>
      <%= render "companies/leader_slot", person: person, role: "auxiliar", gender: gender,
                 remove_url: person && remove_staff_auxiliar_company_path(auxiliar_company, membership_id: membership_ids[person.id]) %>
    <% end %>
  </div>

  <% if auxiliars.size < 2 %>
    <%= form_with url: assign_staff_auxiliar_company_path(auxiliar_company), method: :post, class: "mt-5 pt-5 border-t border-line-soft dark:border-slate-700" do |form| %>
      <%= form.label :participant_id, "Agregar auxiliar", class: field_label_classes %>
      <div class="flex flex-col sm:flex-row gap-3">
        <%= form.select :participant_id, candidates.map { |candidate| [ "#{candidate.full_name} · #{Participant::GENDER_LABELS[candidate.gender]}", candidate.id ] },
              { prompt: candidates.any? ? "Selecciona un auxiliar disponible…" : "No hay auxiliares disponibles" },
              required: true, disabled: candidates.none?, class: "#{field_select_classes} sm:flex-1" %>
        <%= tag.button type: "submit", disabled: candidates.none?,
              class: "inline-flex items-center justify-center gap-2 h-10 px-4 rounded-[11px] bg-primary-700 text-sm font-semibold text-white shadow-sm hover:bg-primary-800 disabled:opacity-50 disabled:cursor-not-allowed transition cursor-pointer" do %>
          <%= icon "plus", class: "w-4 h-4" %>
          Asignar
        <% end %>
      </div>
      <p class="mt-2 text-[11.5px] font-medium text-ink-500 dark:text-slate-400">Solo aparecen auxiliares sin compañía auxiliar que llenan un espacio vacante.</p>
    <% end %>
  <% end %>
</section>
