<div class="px-3 md:px-7 pt-10">
  <div class="flex justify-between mb-5 px-3">
    <h1 class="font-bold text-2xl">Compañías Auxiliares</h1>
    <% if full_company_access? %>
      <%= render(ButtonComponent.new(text: "Nueva", url: new_auxiliar_company_path, type: "primary")) %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    <% @auxiliar_companies.each do |ac| %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex flex-col gap-3">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-bold text-lg text-blue-950"><%= link_to ac.name, ac %></h3>
            <p class="text-sm text-gray-500 mt-1">
              <span class="font-medium">Coordinator:</span>
              <%= ac.coordinator_name %>
            </p>
          </div>
          <%= image_tag "company.svg", class: "w-10 h-10 opacity-70" %>
        </div>

        <div class="grid grid-cols-3 gap-3 text-center text-sm mt-2">
          <%= render(InfoTileComponent.new(title: "Compañías", icon: "company.svg", data: [ac.companies.count])) %>
          <%= render(InfoTileComponent.new(title: "Auxiliares", icon: "people.svg", data: [ac.auxiliar_count])) %>
          <%= render(InfoTileComponent.new(title: "Consejeros", icon: "people.svg", data: [ac.counselor_count])) %>
        </div>

        <div class="flex items-center justify-end gap-2 mt-2">
          <%= render(ButtonComponent.new(text: "Ver", url: ac, type: "muted")) %>
          <% if can_edit_auxiliar_company?(ac) %>
            <%= render(ButtonComponent.new(text: "Editar", url: edit_auxiliar_company_path(ac), type: "muted")) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @auxiliar_companies.empty? %>
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center text-gray-500">
      No hay compañías auxiliares aún.
    </div>
  <% end %>
</div>
