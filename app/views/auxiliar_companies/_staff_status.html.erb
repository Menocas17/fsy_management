    complete: [ "Completa", "bg-cat-green/15 text-cat-green-ink" ],
    missing_auxiliar: [ "Falta auxiliar", "bg-cat-amber/20 text-cat-amber-ink" ],
    no_auxiliars: [ "Sin auxiliares", "bg-cat-rose/15 text-cat-rose-ink" ]
  }.fetch(auxiliar_company.staff_status)
