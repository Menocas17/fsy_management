<div class="<%= card_classes("mt-5 px-5 py-4 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3") %>">
  <div>
    <% if auxiliar_company.persisted? && full_company_access? %>
      <%= button_to auxiliar_company_path(auxiliar_company), method: :delete,
            form: { data: { turbo_confirm: "¿Seguro que deseas borrar #{auxiliar_company.name}? Sus compañías quedarán sin compañía auxiliar." } },
            class: "inline-flex items-center gap-2 h-10 px-3 rounded-control text-sm font-semibold text-cat-rose-ink hover:bg-cat-rose/10 transition cursor-pointer" do %>
        <%= icon "trash-2", class: "w-4 h-4" %>
        Borrar compañía auxiliar
      <% end %>
    <% end %>
  </div>
  <div class="flex gap-2.5 sm:justify-end">
    <%= link_to "Cancelar", auxiliar_company.persisted? ? auxiliar_company_path(auxiliar_company) : auxiliar_companies_path,
          class: button_classes(:secondary, extra: "flex-1 sm:flex-none") %>
    <button type="submit" form="auxiliar-company-form"
            class="<%= button_classes(:primary, extra: "flex-1 sm:flex-none whitespace-nowrap") %>">
      <%= icon "check", class: "w-4 h-4" %>
      <%= auxiliar_company.persisted? ? "Actualizar" : "Crear" %>
    </button>
  </div>
</div>
