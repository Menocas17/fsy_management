<% highlight = local_assigns.fetch(:highlight, false) %>
<% counselors = company.counselors.sort_by { |c| [ c.gender.to_s, c.first_name.to_s ] } %>
<div class="<%= card_classes("inline-block w-full md:w-auto md:min-w-48 text-left px-4 py-3") %> <%= "ring-3 ring-primary-500/20 border-primary-300" if highlight %>"
     data-company-id="<%= company.id %>">
  <div class="flex items-center justify-between gap-3">
    <p class="text-body font-extrabold text-ink-900"><%= company.name %></p>
    <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-cat-blue/15 text-cat-blue-ink text-meta font-bold whitespace-nowrap"
          data-jovenes-count="<%= jovenes_count %>"><%= jovenes_count %> jóv.</span>
  </div>
  <% if company.nickname.present? %>
    <p class="text-meta font-bold text-primary-600 dark:text-primary-300"><%= company.nickname %></p>
  <% end %>
  <div class="mt-2 space-y-1.5">
    <% if counselors.any? %>
      <% counselors.each do |counselor| %>
        <div class="flex items-center gap-2">
          <%= render(AvatarComponent.new(participant: counselor, size: :sm)) %>
          <p class="text-label font-semibold text-ink-700"><%= counselor.full_name %></p>
        </div>
      <% end %>
    <% else %>
      <p class="text-label font-semibold text-ink-500">Sin consejeros asignados</p>
    <% end %>
  </div>
  <%= link_to company_path(company, return_to: return_here),
        class: "mt-2.5 pt-2 flex items-center gap-1 border-t border-line-soft text-meta font-bold text-primary-600 dark:text-primary-300 hover:underline" do %>
    Ver compañía
    <%= icon "arrow-right", class: "w-3 h-3" %>
  <% end %>
</div>
