<div class="inline-block w-full md:w-auto md:min-w-60 text-left rounded-card bg-primary-gradient px-5 py-4 text-white shadow-lg" data-node="direccion">
  <p class="text-meta font-bold tracking-[.08em] uppercase text-white/75">Dirección · <%= Rails.configuration.x.event_name %></p>
  <% if directors.any? %>
    <div class="mt-2 flex items-center gap-2.5">
      <%= render "organigrama/people", people: directors, ring: "ring-primary-900" %>
      <p class="text-body font-bold leading-snug"><%= directors.map(&:full_name).join(" & ") %></p>
    </div>
  <% else %>
    <p class="mt-2 text-body font-semibold text-white/80">Sin director asignado</p>
  <% end %>
</div>
