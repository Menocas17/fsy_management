<%
  company_branch = @show_companies && (@coordinators.any? || @auxiliar_companies.any? || @orphan_companies.any?)
  logistics_branch = @show_logistics && (@logistics_directors.any? || @logistics.any?)
  logistics_groups = logistics_branch ? @logistics.group_by(&:logistics_area).sort_by { |area, _| area&.name || "~" } : []
  by_number = ->(companies) { companies.sort_by { |company| [ company.number || Float::INFINITY, company.name ] } }
  company_node = ->(company) { render("organigrama/company_node", company: company, jovenes_count: @jovenes_counts.fetch(company.id, 0)) }
  control = "w-8 h-8 inline-flex items-center justify-center rounded-lg text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 cursor-pointer transition"
%>

<% if company_branch || logistics_branch || @directors.any? %>
  <div class="hidden md:block">
    <div class="org-chart relative" data-controller="org-chart">
      <div data-org-chart-target="viewport" tabindex="0" role="region"
           aria-label="Organigrama. Arrastra para moverte; usa Ctrl y la rueda del ratón, o las teclas más y menos, para acercar o alejar."
           class="relative h-[calc(100dvh-14rem)] min-h-[460px] overflow-hidden rounded-[18px] border border-line-soft dark:border-slate-700 bg-canvas dark:bg-slate-900 shadow-inner cursor-grab data-[dragging]:cursor-grabbing touch-none select-none focus:outline-none focus-visible:ring-3 focus-visible:ring-primary-500/30"
           data-action="pointerdown->org-chart#pointerDown pointermove->org-chart#pointerMove pointerup->org-chart#pointerUp pointercancel->org-chart#pointerUp wheel->org-chart#wheel:!passive keydown->org-chart#keydown click->org-chart#suppressClick:capture">
        <div data-org-chart-target="canvas" class="absolute left-0 top-0 origin-top-left">
          <div class="org-tree w-max p-12">
            <ul>
              <li>
                <%= render "organigrama/director_node", directors: @directors %>
                <% if company_branch || logistics_branch %>
                  <ul>
                    <% if company_branch %>
                      <li>
                        <%= render "organigrama/coordination_node", coordinators: @coordinators %>
                        <% if @auxiliar_companies.any? || @orphan_companies.any? %>
                          <ul>
                            <% @auxiliar_companies.each do |auxiliar_company| %>
                              <li>
                                <%= render "organigrama/auxiliar_node", auxiliar_company: auxiliar_company %>
                                <% if auxiliar_company.companies.any? %>
                                  <ul class="org-stack">
                                    <% by_number.(auxiliar_company.companies).each do |company| %>
                                      <li><%= company_node.(company) %></li>
                                    <% end %>
                                  </ul>
                                <% end %>
                              </li>
                            <% end %>
                            <% if @orphan_companies.any? %>
                              <li>
                                <%= render "organigrama/group_node", eyebrow: "Sin rama", title: "Sin compañía auxiliar", tone: "text-ink-500 dark:text-slate-400" %>
                                <ul class="org-stack">
                                  <% @orphan_companies.each do |company| %>
                                    <li><%= company_node.(company) %></li>
                                  <% end %>
                                </ul>
                              </li>
                            <% end %>
                          </ul>
                        <% end %>
                      </li>
                    <% end %>
                    <% if logistics_branch %>
                      <li>
                        <%= render "organigrama/logistics_director_node", directors: @logistics_directors %>
                        <% if logistics_groups.any? %>
                          <ul class="org-stack">
                            <% logistics_groups.each do |area, members| %>
                              <li><%= render "organigrama/logistics_area_node", area: area, members: members %></li>
                            <% end %>
                          </ul>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </li>
            </ul>
          </div>
        </div>

        <p class="absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-lg bg-surface/90 dark:bg-slate-800/90 px-2.5 py-1.5 text-[11.5px] font-semibold text-ink-500 dark:text-slate-400 shadow-sm pointer-events-none">
          <%= icon "move", class: "w-3.5 h-3.5" %>
          Arrastra para moverte · Ctrl + rueda para acercar
        </p>

        <div data-org-chart-controls
             class="absolute right-3 bottom-3 flex items-center gap-0.5 p-1 rounded-xl bg-surface/95 dark:bg-slate-800/95 border border-line-soft dark:border-slate-700 shadow-md">
          <button type="button" data-action="org-chart#zoomOut" aria-label="Alejar" title="Alejar" class="<%= control %>">
            <%= icon "zoom-out", class: "w-4 h-4" %>
          </button>
          <span data-org-chart-target="zoomLabel" class="w-11 text-center text-[12px] font-bold tabular-nums text-ink-700 dark:text-slate-300">100%</span>
          <button type="button" data-action="org-chart#zoomIn" aria-label="Acercar" title="Acercar" class="<%= control %>">
            <%= icon "zoom-in", class: "w-4 h-4" %>
          </button>
          <span class="w-px h-5 mx-1 bg-line dark:bg-slate-600"></span>
          <button type="button" data-action="org-chart#fit" title="Ver todo el organigrama"
                  class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-lg text-[12px] font-bold text-ink-700 dark:text-slate-300 hover:bg-canvas dark:hover:bg-slate-700 cursor-pointer transition">
            <%= icon "scan", class: "w-4 h-4" %>
            Ajustar
          </button>
          <button type="button" data-action="org-chart#toggleFullscreen" data-org-chart-target="fullscreenButton"
                  aria-label="Pantalla completa" title="Pantalla completa" class="<%= control %>">
            <%= icon "expand", class: "w-4 h-4" %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="md:hidden space-y-4">
    <%= render "organigrama/director_node", directors: @directors %>
    <% if company_branch || logistics_branch %>
      <div class="ml-4 pl-4 border-l-2 border-line dark:border-slate-600 space-y-6">
        <% if company_branch %>
          <div class="space-y-3">
            <%= render "organigrama/coordination_node", coordinators: @coordinators %>
            <div class="ml-3 pl-3.5 border-l-2 border-line-soft dark:border-slate-700 space-y-4">
              <% @auxiliar_companies.each do |auxiliar_company| %>
                <div>
                  <%= render "organigrama/auxiliar_node", auxiliar_company: auxiliar_company %>
                  <% if auxiliar_company.companies.any? %>
                    <div class="mt-2 ml-3 pl-3.5 border-l-2 border-line-soft dark:border-slate-700 space-y-2">
                      <% by_number.(auxiliar_company.companies).each do |company| %>
                        <%= company_node.(company) %>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
              <% if @orphan_companies.any? %>
                <div>
                  <%= render "organigrama/group_node", eyebrow: "Sin rama", title: "Sin compañía auxiliar", tone: "text-ink-500 dark:text-slate-400" %>
                  <div class="mt-2 ml-3 pl-3.5 border-l-2 border-line-soft dark:border-slate-700 space-y-2">
                    <% @orphan_companies.each do |company| %>
                      <%= company_node.(company) %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if logistics_branch %>
          <div class="space-y-3">
            <%= render "organigrama/logistics_director_node", directors: @logistics_directors %>
            <% if logistics_groups.any? %>
              <div class="ml-3 pl-3.5 border-l-2 border-line-soft dark:border-slate-700 space-y-2">
                <% logistics_groups.each do |area, members| %>
                  <%= render "organigrama/logistics_area_node", area: area, members: members %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="<%= card_classes("p-10 text-center") %>">
    <p class="text-ink-500 dark:text-slate-400">Aún no hay compañías ni personal registrados.</p>
  </div>
<% end %>
