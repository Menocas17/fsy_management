<%
  logistics = @logistics.any? || @logistics_directors.any?
  # The logistica view never loads the company branch, so guard before touching those.
  company_branch =@show_companies && (@coordinators.any? || @auxiliar_companies.any? || @orphan_companies.any?)
  branches = company_branch || logistics
  by_number = ->(companies) { companies.sort_by { |company| [ company.number || Float::INFINITY, company.name ] } }
  logistics_title = @logistics_directors.map(&:full_name).join(" · ").presence || "Logística"
  logistics_groups = @logistics.group_by(&:logistics_area).sort_by { |area, _| area&.name || "~" }
  # El árbol de escritorio y la lista del teléfono muestran el mismo nodo: se dibuja una vez y se reusa.
  company_nodes = Hash.new { |nodes, company| nodes[company] = render("organigrama/company_node", company: company, jovenes_count: @jovenes_counts.fetch(company.id, 0)) }
  company_node = ->(company) { company_nodes[company] }
  control = "w-8 h-8 inline-flex items-center justify-center rounded-inner text-ink-700 hover:bg-muted cursor-pointer transition"
%>

<% if branches || @directors.any? %>
  <%# Desktop: the canvas is the page — no card, no margins, controls floating on top. Al teléfono que lo dice
      (DeviceHelper) no se le manda: el lienzo es un tercio del HTML y allá nunca se ve. %>
  <% if render_desktop_layout? %>
  <div class="hidden md:block h-full">
    <div id="org-chart-<%= @view %>" class="org-chart relative h-full" data-controller="org-chart">
      <div data-org-chart-target="viewport" tabindex="0" role="region"
           aria-label="Organigrama. Arrastra para moverte; usa Ctrl y la rueda del ratón, o las teclas más y menos, para acercar o alejar."
           class="relative h-full w-full overflow-hidden bg-canvas cursor-grab data-[dragging]:cursor-grabbing touch-none select-none focus:outline-none focus-visible:ring-3 focus-visible:ring-inset focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
           data-action="pointerdown->org-chart#pointerDown pointermove->org-chart#pointerMove pointerup->org-chart#pointerUp pointercancel->org-chart#pointerUp wheel->org-chart#wheel:!passive keydown->org-chart#keydown click->org-chart#suppressClick:capture">
        <div data-org-chart-target="canvas" class="absolute left-0 top-0 origin-top-left">
          <div class="org-tree w-max p-12">
            <ul>
              <li>
                <%= render "organigrama/director_node", directors: @directors %>
                <% if branches %>
                  <ul>
                    <% if company_branch %>
                      <li>
                        <%= render "organigrama/coordination_node", coordinators: @coordinators %>
                        <% if @auxiliar_companies.any? || @orphan_companies.any? %>
                          <ul>
                            <%# Companies start collapsed: each auxiliary company opens its own branch, or the toolbar opens them all. %>
                            <% @auxiliar_companies.each do |auxiliar_company| %>
                              <% branch_id = "branch-#{auxiliar_company.id}" %>
                              <li>
                                <%= render "organigrama/auxiliar_node", auxiliar_company: auxiliar_company, branch_id: branch_id %>
                                <% if auxiliar_company.companies.any? %>
                                  <ul class="org-stack" id="<%= branch_id %>" data-org-chart-target="branch" hidden>
                                    <% by_number.(auxiliar_company.companies).each do |company| %>
                                      <li><%= company_node.(company) %></li>
                                    <% end %>
                                  </ul>
                                <% end %>
                              </li>
                            <% end %>
                            <% if @orphan_companies.any? %>
                              <li>
                                <%= render "organigrama/group_node", eyebrow: "Sin rama", title: "Sin compañía auxiliar", tone: "text-ink-500" %>
                                <ul class="org-stack">
                                  <% @orphan_companies.each do |company| %>
                                    <li><%= company_node.(company) %></li>
                                  <% end %>
                                </ul>
                              </li>
                            <% end %>
                          </ul>
                        <% end %>
                      </li>
                    <% end %>
                    <% if logistics %>
                      <li>
                        <%= render "organigrama/logistics_director_node", directors: @logistics_directors %>
                        <% if logistics_groups.any? %>
                          <%# Stacked only when it shares the chart with the companies branch; on its own it spreads out. %>
                          <ul class="<%= "org-stack" if company_branch %>">
                            <% logistics_groups.each do |area, members| %>
                              <li><%= render "organigrama/logistics_area_node", area: area, members: members %></li>
                            <% end %>
                          </ul>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </li>
            </ul>
          </div>
        </div>

        <div class="absolute left-3 top-3"><%= render "organigrama/view_switch", floating: true %></div>

        <p class="absolute left-3 bottom-3 inline-flex items-center gap-1.5 rounded-inner bg-surface/90 px-2.5 py-1.5 text-label font-semibold text-ink-500 shadow-sm pointer-events-none">
          <%= icon "move", class: "w-3.5 h-3.5" %>
          Arrastra para moverte · Ctrl + rueda para acercar
        </p>

        <div data-org-chart-controls
             class="absolute right-3 bottom-3 flex items-center gap-0.5 p-1 rounded-tile bg-surface/95 border border-line-soft shadow-md">
          <button type="button" data-action="org-chart#zoomOut" aria-label="Alejar" title="Alejar" class="<%= control %>">
            <%= icon "zoom-out", class: "w-4 h-4" %>
          </button>
          <span data-org-chart-target="zoomLabel" class="w-11 text-center text-label font-bold tabular-nums text-ink-700">100%</span>
          <button type="button" data-action="org-chart#zoomIn" aria-label="Acercar" title="Acercar" class="<%= control %>">
            <%= icon "zoom-in", class: "w-4 h-4" %>
          </button>
          <span class="w-px h-5 mx-1 bg-line"></span>
          <% if @show_companies && @auxiliar_companies.any? %>
            <button type="button" data-action="org-chart#toggleAll" data-org-chart-target="toggleAllButton" aria-pressed="false"
                    title="Mostrar u ocultar las compañías de cada rama"
                    class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-inner text-label font-bold text-ink-700 hover:bg-muted cursor-pointer transition">
              <%= icon "list-tree", class: "w-4 h-4" %>
              <span data-org-chart-target="toggleAllLabel">Mostrar compañías</span>
            </button>
          <% end %>
          <button type="button" data-action="org-chart#fit" title="Ver todo el organigrama"
                  class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-inner text-label font-bold text-ink-700 hover:bg-muted cursor-pointer transition">
            <%= icon "scan", class: "w-4 h-4" %>
            Ajustar
          </button>
          <button type="button" data-action="org-chart#toggleFullscreen" data-org-chart-target="fullscreenButton"
                  aria-label="Pantalla completa" title="Pantalla completa" class="<%= control %>">
            <%= icon "expand", class: "w-4 h-4" %>
          </button>
        </div>
      </div>
    </div>
  </div>
  <% end %>

  <%# Teléfono: la misma regla que el lienzo, las compañías empiezan cerradas y cada rama abre las suyas. %>
  <div class="<%= layout_split("md:hidden") %> px-4 pt-6 pb-10 space-y-5" data-controller="org-branches">
    <%= render "organigrama/view_switch" %>
    <% if @show_companies && @auxiliar_companies.any? %>
      <button type="button" data-action="org-branches#toggleAll" data-org-branches-target="toggleAllButton" aria-pressed="false"
              class="inline-flex items-center gap-1.5 h-9 px-3.5 rounded-control border border-line bg-surface text-label font-bold text-ink-700 hover:bg-muted cursor-pointer transition">
        <%= icon "list-tree", class: "w-4 h-4" %>
        <span data-org-branches-target="toggleAllLabel">Mostrar compañías</span>
      </button>
    <% end %>
    <div class="space-y-4">
      <%= render "organigrama/director_node", directors: @directors %>
      <% if branches %>
        <div class="ml-4 pl-4 border-l-2 border-line space-y-6">
          <% if company_branch %>
            <div class="space-y-3">
              <%= render "organigrama/coordination_node", coordinators: @coordinators %>
              <div class="ml-3 pl-3.5 border-l-2 border-line-soft space-y-4">
                <% @auxiliar_companies.each do |auxiliar_company| %>
                  <% mobile_branch_id = "branch-mobile-#{auxiliar_company.id}" %>
                  <div>
                    <%= render "organigrama/auxiliar_node", auxiliar_company: auxiliar_company, branch_id: mobile_branch_id, toggle_controller: "org-branches" %>
                    <% if auxiliar_company.companies.any? %>
                      <div class="mt-2 ml-3 pl-3.5 border-l-2 border-line-soft space-y-2" id="<%= mobile_branch_id %>" data-org-branches-target="branch" hidden>
                        <% by_number.(auxiliar_company.companies).each do |company| %>
                          <%= company_node.(company) %>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
                <% if @orphan_companies.any? %>
                  <div>
                    <%= render "organigrama/group_node", eyebrow: "Sin rama", title: "Sin compañía auxiliar", tone: "text-ink-500" %>
                    <div class="mt-2 ml-3 pl-3.5 border-l-2 border-line-soft space-y-2">
                      <% @orphan_companies.each do |company| %>
                        <%= company_node.(company) %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if logistics %>
            <div class="space-y-3">
              <%= render "organigrama/logistics_director_node", directors: @logistics_directors %>
              <% if logistics_groups.any? %>
                <div class="ml-3 pl-3.5 border-l-2 border-line-soft space-y-2">
                  <% logistics_groups.each do |area, members| %>
                    <%= render "organigrama/logistics_area_node", area: area, members: members %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="relative md:h-full bg-canvas">
    <div class="md:hidden px-4 pt-6"><%= render "organigrama/view_switch" %></div>
    <div class="hidden md:block absolute left-3 top-3 z-10"><%= render "organigrama/view_switch", floating: true %></div>
    <div class="px-4 md:px-8 pt-5 md:pt-20 pb-10">
      <div class="<%= card_classes("p-5 md:p-6") %>">
        <%= render EmptyStateComponent.new(title: "Aún no hay compañías ni personal registrados", icon: "network", name: "organigrama") %>
      </div>
    </div>
  </div>
<% end %>
