<% coordinators = auxiliar_company.coordinators %>
<div class="<%= card_classes("inline-block w-full md:w-auto md:min-w-52 text-left px-4 py-3.5") %>" data-node="coordinacion">
  <p class="text-[10px] font-bold tracking-[.08em] uppercase text-cat-indigo">Coordinación · <%= auxiliar_company.name %></p>
  <div class="mt-2 flex items-center gap-2">
    <% if coordinators.any? %>
      <%= render "organigrama/people", people: coordinators, ring: "ring-surface dark:ring-slate-800" %>
      <p class="text-[12.5px] font-semibold leading-snug text-ink-700 dark:text-slate-300"><%= coordinators.map(&:full_name).join(" · ") %></p>
    <% else %>
      <p class="text-[12.5px] font-semibold text-ink-300 dark:text-slate-500">Sin coordinador</p>
    <% end %>
  </div>
</div>
