<% if @my_companies.empty? %>
  <div class="<%= card_classes("p-8 md:p-10 text-center max-w-lg mx-auto") %>">
    <span class="mx-auto w-11 h-11 rounded-full flex items-center justify-center bg-canvas dark:bg-slate-700 text-ink-300 dark:text-slate-400">
      <%= icon "target", class: "w-5 h-5" %>
    </span>
    <p class="mt-3 text-[15px] font-bold text-ink-900 dark:text-slate-100">Tu cuenta no está asignada a ninguna compañía</p>
    <p class="mt-1 text-[13px] text-ink-500 dark:text-slate-400">Consulta la estructura completa en la vista general.</p>
    <%= link_to "Ver organigrama general", organigrama_path,
          class: "mt-4 inline-flex items-center h-10 px-4 rounded-[11px] bg-primary-700 text-sm font-semibold text-white shadow-sm hover:bg-primary-800 transition" %>
  </div>
<% else %>
  <div class="space-y-10">
    <% @my_companies.each do |company| %>
      <section>
        <div class="text-center mb-6">
          <p class="text-[11px] font-bold tracking-[.09em] uppercase text-primary-500 dark:text-primary-300">Tu cadena de mando</p>
          <h2 class="mt-1 text-base md:text-lg font-bold text-ink-900 dark:text-slate-100">
            Ruta directa hasta <span class="text-primary-600 dark:text-primary-300"><%= company.name %></span>
          </h2>
        </div>
        <div class="flex flex-col md:flex-row md:flex-wrap items-center justify-center gap-3 md:gap-2">
          <%= render "organigrama/director_node", directors: @directors %>
          <%= icon "arrow-down", class: "w-5 h-5 text-ink-300 dark:text-slate-500 md:hidden" %>
          <%= icon "arrow-right", class: "w-5 h-5 text-ink-300 dark:text-slate-500 hidden md:block" %>
          <% if company.auxiliar_company %>
            <%= render "organigrama/coordinator_node", auxiliar_company: company.auxiliar_company %>
            <%= icon "arrow-down", class: "w-5 h-5 text-ink-300 dark:text-slate-500 md:hidden" %>
            <%= icon "arrow-right", class: "w-5 h-5 text-ink-300 dark:text-slate-500 hidden md:block" %>
          <% end %>
          <%= render "organigrama/company_node", company: company, jovenes_count: @jovenes_counts.fetch(company.id, 0), highlight: true %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
