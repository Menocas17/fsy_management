<%# Same shell as the general view — floating switch on desktop, inline on mobile — so it never moves or changes style. %>
<div class="relative md:h-full md:overflow-auto bg-canvas">
  <div class="md:hidden px-4 pt-6"><%= render "organigrama/view_switch" %></div>
  <div class="hidden md:block absolute left-3 top-3 z-10"><%= render "organigrama/view_switch", floating: true %></div>

  <div class="px-4 md:px-8 pt-5 md:pt-20 pb-10">
    <% if @my_companies.empty? %>
      <div class="<%= card_classes("p-5 md:p-6 max-w-lg mx-auto") %>">
        <%= render EmptyStateComponent.new(title: "Tu cuenta no está asignada a ninguna compañía", icon: "target", name: "my-company",
              text: "Consulta la estructura completa en la vista general.") do |empty| %>
          <% empty.with_action { link_to "Ver organigrama general", organigrama_path, class: button_classes(:secondary) } %>
        <% end %>
      </div>
    <% else %>
      <div class="space-y-10">
        <% @my_companies.each do |company| %>
          <section>
            <div class="text-center mb-6">
              <p class="text-body font-bold text-ink-700">Tu cadena de mando</p>
              <h2 class="mt-1 text-base md:text-lg font-bold text-ink-900">
                Ruta directa hasta <span class="text-primary-600 dark:text-primary-300"><%= company.name %></span>
              </h2>
            </div>
            <div class="flex flex-col md:flex-row md:flex-wrap items-center justify-center gap-3 md:gap-2">
              <%= render "organigrama/director_node", directors: @directors %>
              <%= icon "arrow-down", class: "w-5 h-5 text-ink-500 md:hidden" %>
              <%= icon "arrow-right", class: "w-5 h-5 text-ink-500 hidden md:block" %>
              <% if company.auxiliar_company %>
                <%= render "organigrama/coordination_node", coordinators: company.auxiliar_company.coordinators %>
                <%= icon "arrow-down", class: "w-5 h-5 text-ink-500 md:hidden" %>
                <%= icon "arrow-right", class: "w-5 h-5 text-ink-500 hidden md:block" %>
                <%= render "organigrama/auxiliar_node", auxiliar_company: company.auxiliar_company %>
                <%= icon "arrow-down", class: "w-5 h-5 text-ink-500 md:hidden" %>
                <%= icon "arrow-right", class: "w-5 h-5 text-ink-500 hidden md:block" %>
              <% end %>
              <%= render "organigrama/company_node", company: company, jovenes_count: @jovenes_counts.fetch(company.id, 0), highlight: true %>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
