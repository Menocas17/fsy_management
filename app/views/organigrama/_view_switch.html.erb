<%
  floating = local_assigns.fetch(:floating, false)
  base = "inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg text-[12.5px] whitespace-nowrap transition"
  active = "#{base} bg-surface dark:bg-slate-700 shadow-sm font-bold text-ink-900"
  idle = "#{base} font-semibold text-ink-500 hover:text-ink-900"
  wrapper = if floating
    "inline-flex p-1 gap-0.5 rounded-control bg-surface/95 border border-line-soft shadow-md"
  else
    "inline-flex p-1 gap-0.5 rounded-control bg-canvas border border-line dark:border-slate-700"
  end
  views = [
    [ "todo", "Todo", "network", organigrama_path ],
    [ "logistica", "Logística", "truck", organigrama_path(scope: "logistica") ],
    [ "mi_compania", "Mi compañía", "target", organigrama_path(scope: "mi_compania") ]
  ]
%>
<nav class="<%= wrapper %>" aria-label="Vista del organigrama">
  <% views.each do |key, label, icon_name, path| %>
    <%= link_to path, class: @view == key ? active : idle, aria: { current: (@view == key ? "page" : nil) }, data: { org_view: key } do %>
      <%= icon icon_name, class: "w-3.5 h-3.5" %>
      <%= label %>
    <% end %>
  <% end %>
</nav>
