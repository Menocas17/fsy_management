<% content_for :title, @area.name %>
<% content_for :eyebrow, "Áreas de logística" %>
<% back_to "Áreas", logistics_areas_path %>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-5 items-start">
  <div class="space-y-5 min-w-0">
    <section class="<%= card_classes("px-5 py-5 md:px-6") %>">
      <div class="flex items-start gap-3">
        <div class="min-w-0 flex-1">
          <h1 class="text-[18px] font-extrabold text-ink-900 break-words"><%= @area.name %></h1>
          <p class="mt-1 text-[13px] text-ink-500"><%= @area.description.presence || "Sin descripción." %></p>
        </div>
        <%= link_to edit_logistics_area_path(@area), class: button_classes(:secondary, size: :sm, extra: "shrink-0") do %>
          <%= icon "pencil", class: "w-3.5 h-3.5" %>
          Editar
        <% end %>
      </div>
    </section>

    <%# Cada interruptor es su propio envío: enciende o apaga una bandera y vuelve aquí. %>
    <section class="<%= card_classes("px-5 py-5 md:px-6") %>" data-area-flags>
      <h2 class="text-[15px] font-extrabold text-ink-900">Permisos del área</h2>
      <p class="mt-1 mb-2 text-[12.5px] text-ink-500">Valen para todos sus miembros. Un área puede tener varias banderas, y varias áreas la misma.</p>
      <% LogisticsArea::FLAGS.each do |flag, (label, hint)| %>
        <% on = @area.public_send(flag) %>
        <div class="flex items-center gap-4 py-3.5 border-t border-line-soft">
          <div class="min-w-0 flex-1">
            <p class="text-[14px] font-bold text-ink-900"><%= label %></p>
            <p class="mt-0.5 text-[12.5px] text-ink-500"><%= hint %></p>
          </div>
          <%= button_to logistics_area_path(@area), method: :patch, params: { logistics_area: { flag => !on } },
                role: "switch", aria: { checked: on, label: label }, data: { flag_switch: flag },
                class: "group relative shrink-0 w-[46px] h-7 rounded-full cursor-pointer transition-colors #{on ? "bg-primary-700" : "bg-ink-300 dark:bg-slate-600"}" do %>
            <span class="absolute top-[3px] size-[22px] rounded-full bg-white shadow transition-[left] <%= on ? "left-[21px]" : "left-[3px]" %>"></span>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="<%= card_classes("px-5 py-5 md:px-6") %>" data-area-members>
      <h2 class="text-[15px] font-extrabold text-ink-900">Miembros <span class="font-semibold text-ink-500">· <%= @members.size %></span></h2>
      <% if @members.empty? %>
        <p class="mt-3 text-[13px] text-ink-500">Esta área no tiene miembros. Agrégalos desde «Agregar miembros».</p>
      <% end %>
      <ul class="mt-2">
        <% @members.each do |member| %>
          <li class="flex items-center gap-3 py-2.5 border-t border-line-soft first:border-t-0" data-member="<%= member.id %>">
            <%= render(AvatarComponent.new(participant: member)) %>
            <%= link_to participant_path(member), class: "min-w-0 flex-1 group" do %>
              <span class="block text-[14px] font-bold text-ink-900 group-hover:underline truncate"><%= member.full_name %></span>
              <span class="block text-[12px] text-ink-500"><%= member.role_label %></span>
            <% end %>
            <%= button_to "Quitar", logistics_area_member_path(@area, member), method: :delete,
                  class: "min-h-11 md:min-h-9 px-3 rounded-lg text-[12.5px] font-bold text-cat-rose-ink hover:bg-cat-rose/10 cursor-pointer transition" %>
          </li>
        <% end %>
      </ul>
    </section>
  </div>

  <aside class="<%= card_classes("px-5 py-5 md:px-6") %> min-w-0" data-area-candidates>
    <h2 class="text-[15px] font-extrabold text-ink-900">Agregar miembros</h2>
    <p class="mt-1 text-[12.5px] text-ink-500">Del comité de logística. Si ya está en otra área, se cambia a esta.</p>
    <%= form_with url: logistics_area_path(@area), method: :get, class: "mt-3",
          data: { controller: "auto-submit", turbo_frame: "area-candidates" } do |form| %>
      <%= form.search_field :query, value: params[:query], placeholder: "Buscar por nombre", autocomplete: "off",
            aria: { label: "Buscar miembro de logística" }, data: { action: "input->auto-submit#typed" },
            class: field_input_classes %>
    <% end %>
    <%= turbo_frame_tag "area-candidates", target: "_top" do %>
      <ul class="mt-2">
        <% @candidates.each do |person| %>
          <li class="flex items-center gap-2.5 py-2.5 border-b border-line-soft last:border-b-0">
            <%= render(AvatarComponent.new(participant: person, size: :sm)) %>
            <span class="min-w-0 flex-1">
              <span class="block text-[13.5px] font-bold text-ink-900 truncate"><%= person.full_name %></span>
              <% if person.logistics_area %>
                <span class="block text-[11.5px] font-semibold text-cat-amber-ink">Está en <%= person.logistics_area.name %> · se cambia</span>
              <% else %>
                <span class="block text-[11.5px] font-semibold text-ink-500">Sin área</span>
              <% end %>
            </span>
            <%= button_to logistics_area_members_path(@area), params: { participant_id: person.id, query: params[:query] },
                  aria: { label: "Agregar a #{person.full_name}" },
                  class: "inline-flex items-center gap-1 min-h-11 md:min-h-9 px-3 rounded-lg border border-primary-100 bg-primary-50 text-[12.5px] font-bold text-primary-700 hover:bg-primary-100 dark:bg-primary-700/30 dark:border-primary-700 dark:text-primary-100 cursor-pointer transition" do %>
              <%= icon "plus", class: "w-3.5 h-3.5" %>
              Agregar
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if @candidates.empty? %>
        <p class="mt-3 text-[13px] text-ink-500">
          <%= params[:query].present? ? "Nadie del comité se llama así." : "Todo el comité de logística ya está en esta área." %>
        </p>
      <% end %>
    <% end %>
  </aside>
</div>
