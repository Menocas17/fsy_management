<%# Una bandera que se explica sola: en escritorio, al pasar el ratón (o con el teclado) sale una nota que
    se va sola; en el teléfono, tocarla abre su diálogo (logistics_areas/_flag_dialogs, flag-help).
    align: hacia dónde se abre la nota (:left en la fila de arriba, :right en la esquina de las tarjetas). %>
<% align = local_assigns.fetch(:align, :left) %>
<% label, description = LogisticsArea::FLAGS.fetch(flag) %>
<span class="relative inline-flex group/flag">
  <button type="button" data-action="flag-help#open" data-flag-help-flag-param="<%= flag %>"
          aria-label="<%= label %>: <%= description %>"
          class="rounded-full cursor-help focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface">
    <%= render "logistics_areas/flag_chip", flag: flag %>
  </button>
  <span role="tooltip" aria-hidden="true" data-flag-tip="<%= flag %>"
        class="pointer-events-none absolute top-full mt-2 z-30 w-64 rounded-tile border border-line-soft bg-surface px-3.5 py-2.5 shadow-lg text-left
               <%= align == :right ? "right-0" : "left-0" %> invisible opacity-0 translate-y-1 transition duration-150 ease-out
               [@media(hover:hover)]:group-hover/flag:visible [@media(hover:hover)]:group-hover/flag:opacity-100 [@media(hover:hover)]:group-hover/flag:translate-y-0
               [@media(hover:hover)]:group-has-[:focus-visible]/flag:visible [@media(hover:hover)]:group-has-[:focus-visible]/flag:opacity-100 [@media(hover:hover)]:group-has-[:focus-visible]/flag:translate-y-0">
    <span class="block text-label font-bold text-ink-900"><%= label %></span>
    <span class="mt-0.5 block text-label font-medium text-ink-700"><%= description %></span>
  </span>
</span>
