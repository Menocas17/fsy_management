<% content_for :title, "Áreas de logística" %>
<% content_for :eyebrow, "Logística" %>
<%= render PageComponent.new(width: :page) do |page| %>
  <% page.with_intro { "Cada miembro del comité pertenece a un área; las banderas del área le dan permisos." } %>
  <% page.with_actions do %>
    <%= link_to new_logistics_area_path, class: button_classes do %>
      <%= icon "plus", class: "size-4" %>
      Nueva área
    <% end %>
  <% end %>

  <section class="grid grid-cols-3 gap-3 md:gap-4" aria-label="Resumen">
    <%= render StatTileComponent.new(value: @committee_count, label: "Miembros de logística", icon: "users", tone: :indigo) %>
    <%= render StatTileComponent.new(value: @areas.size, label: "Áreas", icon: "layout-grid", tone: :blue) %>
    <% if @unassigned.any? %>
      <%= render StatTileComponent.new(value: @unassigned.size, icon: "triangle-alert", tone: :amber, data: { unassigned: true },
            label: "Sin área: #{@unassigned.first(3).map(&:full_name).to_sentence(two_words_connector: " y ", last_word_connector: " y ")}#{" y #{@unassigned.size - 3} más" if @unassigned.size > 3}",
            hint: "Sin área no tienen ningún permiso extra.") %>
    <% else %>
      <%= render StatTileComponent.new(value: 0, label: "Sin área", icon: "circle-check", tone: :green, hint: "Todo el comité tiene su área.") %>
    <% end %>
  </section>

  <%# Qué da cada bandera: una fila en escritorio; en el teléfono se pliega para que las áreas no queden abajo. %>
  <details class="group <%= card_classes %> md:hidden" data-flags-help>
    <summary class="list-none min-h-13 px-4 py-3 flex items-center gap-3 cursor-pointer">
      <%= render IconTileComponent.new(icon: "flag") %>
      <span class="flex-1 text-title font-bold text-ink-900">Qué da cada bandera</span>
      <%= icon "chevron-down", class: "size-[18px] text-ink-500 transition-transform group-open:rotate-180" %>
    </summary>
    <ul class="px-4 pb-4 flex flex-col gap-2.5">
      <% LogisticsArea::FLAGS.each_key do |flag| %>
        <li class="flex items-start gap-2.5"><%= render "logistics_areas/flag_chip", flag: flag %><span class="text-label text-ink-700"><%= LogisticsArea::FLAGS.fetch(flag).last %></span></li>
      <% end %>
    </ul>
  </details>
  <section class="hidden md:flex <%= card_classes("items-center gap-6 px-6 py-5") %>" aria-label="Qué da cada bandera">
    <div class="flex items-center gap-3 shrink-0">
      <%= render IconTileComponent.new(icon: "flag") %>
      <h2 class="text-title font-bold text-ink-900">Qué da cada bandera</h2>
    </div>
    <ul class="flex-1 grid grid-cols-3 gap-5">
      <% LogisticsArea::FLAGS.each_key do |flag| %>
        <li class="flex items-center gap-2.5"><%= render "logistics_areas/flag_chip", flag: flag %><span class="text-label text-ink-700"><%= LogisticsArea::FLAGS.fetch(flag).last %></span></li>
      <% end %>
    </ul>
  </section>

  <% if @areas.any? %>
    <section aria-label="Áreas" class="grid grid-cols-1 md:grid-cols-2 gap-4" data-areas>
      <% @areas.each do |area| %>
        <% tile_icon, tile_tone = area_tile(area) %>
        <article class="<%= card_classes("flex flex-col gap-3.5 p-4 md:px-5 md:py-5") %>" data-area="<%= area.name %>">
          <div class="flex items-start gap-3">
            <%= render IconTileComponent.new(icon: tile_icon, tone: tile_tone) %>
            <div class="min-w-0 flex-1">
              <h2 class="text-title font-bold text-ink-900 break-words"><%= area.name %></h2>
              <% if area.description.present? %>
                <p class="mt-0.5 text-body text-ink-700"><%= area.description %></p>
              <% end %>
            </div>
            <%= link_to "Administrar", logistics_area_path(area), class: button_classes(:secondary, size: :sm, extra: "hidden md:inline-flex shrink-0") %>
          </div>
          <div class="flex items-center justify-between gap-3 pt-3.5 border-t border-line-soft">
            <div class="flex items-center gap-2.5 min-w-0">
              <% members = area.members.sort_by(&:full_name) %>
              <span class="flex">
                <% members.first(5).each do |member| %>
                  <span class="-mr-1.5 rounded-avatar-sm ring-2 ring-surface"><%= render(AvatarComponent.new(participant: member, size: :sm)) %></span>
                <% end %>
              </span>
              <span class="ml-1.5 text-label font-semibold text-ink-500 whitespace-nowrap">
                <%= members.empty? ? "Sin miembros todavía" : pluralize(members.size, "miembro", plural: "miembros") %>
              </span>
            </div>
            <div class="flex flex-wrap justify-end gap-1.5">
              <% area.flags.each do |flag| %>
                <%= render "logistics_areas/flag_chip", flag: flag %>
              <% end %>
              <% if area.flags.empty? %>
                <%= render ChipComponent.new(label: "Sin permisos extra · solo ve") %>
              <% end %>
            </div>
          </div>
          <%= link_to "Administrar", logistics_area_path(area), class: button_classes(:secondary, extra: "md:hidden w-full") %>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="<%= card_classes("p-5 md:p-6") %>">
      <%= render EmptyStateComponent.new(title: "Todavía no hay áreas", icon: "layout-grid", name: "areas",
            text: "Crea la primera, por ejemplo «Registro», y enciéndele su bandera.") %>
    </section>
  <% end %>
<% end %>
