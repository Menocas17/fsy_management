<%# Una bandera encendida de un área, con su color: Registro verde, Finanzas azul, Alimentación ámbar. %>
<% styles = { checkin: [ "scan-line", "bg-cat-green/15 text-cat-green-ink" ],
              finance: [ "wallet", "bg-primary-100 text-primary-700 dark:bg-primary-700/40 dark:text-primary-100" ],
              food: [ "utensils", "bg-cat-amber/15 text-cat-amber-ink" ] } %>
<% icon_name, classes = styles.fetch(flag) %>
<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11.5px] font-bold <%= classes %>" data-flag="<%= flag %>">
  <%= icon icon_name, class: "w-3.5 h-3.5" %>
  <%= LogisticsArea::FLAGS.fetch(flag).first %>
</span>
