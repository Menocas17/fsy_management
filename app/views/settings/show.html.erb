<% content_for :title, "Configuración" %>
<% content_for :eyebrow, "Cuenta" %>
<% back_to "Inicio", dashboard_path %>
<% card_heading = "flex items-center gap-[9px] mb-[18px] text-[15px] font-bold text-ink-900" %>

<div class="px-4 md:px-8 pt-6 md:pt-7 pb-10" data-controller="preferences">
  <div class="max-w-[640px] flex flex-col gap-5">
    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-account">
      <h2 id="settings-account" class="<%= card_heading %>">
        <%= icon "id-card", class: "w-[17px] h-[17px]" %>
        Cuenta
      </h2>
      <div>
        <p class="text-[11.5px] font-semibold text-ink-500">Correo electrónico</p>
        <p class="mt-0.5 text-sm font-semibold text-ink-900 break-all"><%= Current.user.email_address %></p>
      </div>
      <div class="mt-4 pt-4 border-t border-line-soft flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-ink-900">Contraseña</p>
          <p class="mt-0.5 text-[12.5px] text-ink-500">Te enviaremos un enlace para restablecer tu contraseña.</p>
        </div>
        <%= button_to send_password_reset_settings_path, method: :post,
              class: button_classes do %>
          <%= icon "key-round", class: "w-4 h-4" %>
          Cambiar contraseña
        <% end %>
      </div>
    </section>

    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-appearance">
      <h2 id="settings-appearance" class="<%= card_heading %>">
        <%= icon "sun", class: "w-[17px] h-[17px]" %>
        Apariencia
      </h2>
      <%= render(ToggleComponent.new(id: "theme-toggle", label: "Modo oscuro",
            description: "Cambia la apariencia de la aplicación a un tema oscuro.",
            action: "toggleTheme", target: "themeToggle")) %>
    </section>

    <%# El permiso de notificaciones es por dispositivo: este bloque habla del teléfono o la compu que estás usando. %>
    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-push"
             data-controller="push" data-push-public-key-value="<%= Rails.application.credentials.dig(:vapid, :public_key) %>"
             data-push-url-value="<%= push_subscription_notifications_path %>">
      <h2 id="settings-push" class="<%= card_heading %>">
        <%= icon "bell-ring", class: "w-[17px] h-[17px]" %>
        Notificaciones
      </h2>
      <p class="text-[13.5px] font-semibold text-ink-900">Alertas en este dispositivo</p>
      <p class="mt-1 text-[12.5px] leading-relaxed text-ink-500" data-push-target="status">
        Revisando el permiso…
      </p>
      <button type="button" data-action="push#toggle" data-push-target="button"
              class="<%= button_classes(:primary, extra: "mt-3") %>">
        Activar en este dispositivo
      </button>
      <div class="mt-5 pt-4 border-t border-line-soft">
        <%= render(ToggleComponent.new(id: "push-sound-toggle", label: "Sonido y vibración",
              description: "Las alertas llegan con tono y vibración. En iPhone el sonido lo controla el sistema.",
              action: "saveSound", target: "sound", controller: "push")) %>
      </div>
    </section>

    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-accessibility">
      <h2 id="settings-accessibility" class="<%= card_heading %>">
        <%= icon "eye", class: "w-[17px] h-[17px]" %>
        Accesibilidad
      </h2>
      <div class="flex flex-col divide-y divide-line-soft">
        <div class="pb-4">
          <%= render(ToggleComponent.new(id: "reduce-motion-toggle", label: "Reducir movimiento",
                description: "Minimiza las animaciones y transiciones en toda la aplicación.",
                action: "toggleMotion", target: "motionToggle")) %>
        </div>
        <div class="pt-4">
          <%= render(ToggleComponent.new(id: "text-size-toggle", label: "Texto grande",
                description: "Sube un escalón más el texto. En el teléfono la letra ya viene grande de base.",
                action: "toggleTextSize", target: "textSizeToggle")) %>
        </div>
      </div>
    </section>

    <% if Current.user.superadmin? %>
      <%# Solo la cuenta del sistema: por defecto cada registro se escanea únicamente el día que toca. %>
      <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" id="settings-scan" aria-labelledby="settings-scan-title">
        <h2 id="settings-scan-title" class="<%= card_heading %>">
          <%= icon "scan-line", class: "w-[17px] h-[17px]" %>
          Registro por escaneo
        </h2>
        <p class="-mt-2 mb-4 text-[12.5px] leading-relaxed text-ink-500">
          «Solo el día» abre el escáner únicamente en la fecha del registro. «Abierto» lo deja disponible
          cualquier día, por ejemplo para una prueba, y «Cerrado» lo bloquea aunque sea el día.
        </p>
        <%= form_with url: scan_windows_settings_path, method: :patch do %>
          <% rows = [ [ "arrival", "Llegada de los jóvenes", ScanWindow.arrival ] ] +
                    @trainings.map { |training| [ "trainings[#{training.id}]", training.name, training.scan_window ] } %>
          <ul class="divide-y divide-line-soft">
            <% rows.each do |name, label, window| %>
              <li class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 py-3 first:pt-0" data-scan-window="<%= name %>">
                <div class="min-w-0 flex-1">
                  <%= label_tag name.parameterize(separator: "_"), label, class: "block text-[13.5px] font-semibold text-ink-900" %>
                  <p class="text-[12px] font-semibold text-ink-500">
                    <%= SpanishDates.long(window.day) %> ·
                    <span class="<%= window.open? ? "text-emerald-700 dark:text-cat-green" : "text-ink-500 dark:text-slate-400" %>">
                      <%= window.open? ? "abierto ahora" : "cerrado ahora" %>
                    </span>
                  </p>
                </div>
                <%= select_tag name, options_for_select(ScanWindow::MODES.invert, window.mode),
                      id: name.parameterize(separator: "_"), class: "#{field_select_classes} sm:w-44" %>
              </li>
            <% end %>
          </ul>
          <button type="submit" class="<%= button_classes(:primary, extra: "mt-4") %>">
            <%= icon "check", class: "w-4 h-4" %>
            Guardar
          </button>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
