<% content_for :title, "Configuración" %>
<% content_for :eyebrow, "Cuenta" %>
<% back_to "Inicio", dashboard_path %>
<% card_heading = "flex items-center gap-[9px] mb-[18px] text-title font-bold text-ink-900" %>

<%= render PageComponent.new(width: :form, data: { controller: "preferences" }) do %>
  <div class="max-w-[640px] flex flex-col gap-5">
    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-account">
      <h2 id="settings-account" class="<%= card_heading %>">
        <%= icon "id-card", class: "w-[17px] h-[17px]" %>
        Cuenta
      </h2>
      <div>
        <p class="text-label font-semibold text-ink-500">Correo electrónico</p>
        <p class="mt-0.5 text-sm font-semibold text-ink-900 break-all"><%= Current.user.email_address %></p>
      </div>
      <div class="mt-4 pt-4 border-t border-line-soft flex flex-wrap items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-ink-900">Contraseña</p>
          <p class="mt-0.5 text-label text-ink-500">Cámbiala confirmando la que usas ahora.</p>
        </div>
        <%= link_to edit_password_change_path, class: button_classes do %>
          <%= icon "key-round", class: "w-4 h-4" %>
          Cambiar contraseña
        <% end %>
      </div>
    </section>

    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-appearance" data-tour="theme">
      <h2 id="settings-appearance" class="<%= card_heading %>">
        <%= icon "sun", class: "w-[17px] h-[17px]" %>
        Apariencia
      </h2>
      <%= render(ToggleComponent.new(id: "theme-toggle", label: "Modo oscuro",
            description: "Cambia la apariencia de la aplicación a un tema oscuro.",
            action: "toggleTheme", target: "themeToggle")) %>
    </section>

    <% if Current.user.company_reveal_manager? %>
      <%# Dirección abre o cierra a los consejeros su compañía (CompanyReveal). Abrirla pide confirmar: avisa a todos. %>
      <% revealed = CompanyReveal.open? %>
      <% last_change = CompanyReveal.last_change %>
      <% counselors = Participant.consejero.count %>
      <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" id="settings-companies" aria-labelledby="settings-companies-title">
        <h2 id="settings-companies-title" class="<%= card_heading %>">
          <%= icon "building-2", class: "w-[17px] h-[17px]" %>
          Compañías de los consejeros
        </h2>
        <div class="flex items-center justify-between gap-4">
          <div class="min-w-0">
            <p class="text-body font-semibold text-ink-900">Mostrar compañero(a) y jóvenes</p>
            <p class="mt-0.5 text-label leading-relaxed text-ink-500">
              Cada consejero ve quién es su compañero(a) y los nombres y fichas de los jóvenes de su compañía.
            </p>
          </div>
          <%= button_to company_reveal_settings_path, method: :patch, params: { abrir: revealed ? "0" : "1" },
                form: { data: (revealed ? {} : { turbo_confirm: "¿Abrir las compañías?",
                                                 turbo_confirm_detail: "Los #{counselors} consejeros verán a su compañero(a) y los nombres, fotos y fichas de sus jóvenes. Les llegará un aviso.",
                                                 turbo_confirm_button: "Abrir compañías" }) },
                role: "switch", aria: { checked: revealed, label: "Compañías de los consejeros: #{revealed ? "cerrar" : "abrir"}" },
                class: "relative shrink-0 w-[42px] h-6 rounded-full cursor-pointer transition-colors #{revealed ? "bg-primary-600" : "bg-line"} focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500" do %>
            <span class="absolute top-[2px] left-[2px] size-5 rounded-full bg-white shadow-sm <%= "translate-x-[18px]" if revealed %>"></span>
          <% end %>
        </div>
        <p class="mt-4 flex items-start gap-2 rounded-tile px-3 py-2.5 text-label font-semibold <%= revealed ? Tones.tint(:green) : Tones.tint(:amber) %>" data-company-reveal-state="<%= revealed ? "abiertas" : "cerradas" %>">
          <%= icon(revealed ? "eye" : "eye-off", class: "size-4 shrink-0 mt-0.5") %>
          <% if revealed %>
            Abiertas: los consejeros ven a su compañero(a) y a sus jóvenes.
          <% else %>
            Cerradas: los consejeros solo saben que su compañero(a) ya está asignado y ven su compañía en cifras (cuántos jóvenes, edades, estacas y barrios), sin nombres.
          <% end %>
        </p>
        <% if last_change %>
          <p class="mt-2 text-label font-semibold text-ink-500">Último cambio: <%= last_change.actor_name %> · <%= SpanishDates.short_with_time(last_change.created_at) %></p>
        <% end %>
      </section>
    <% end %>

    <%# Se guarda en la cuenta (no en el dispositivo): el servidor arma la barra inferior y el inicio. %>
    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" id="settings-simple" aria-labelledby="settings-simple-title">
      <h2 id="settings-simple-title" class="<%= card_heading %>">
        <%= icon "smartphone", class: "w-[17px] h-[17px]" %>
        Modo simple
      </h2>
      <% simple = Current.user.simple_mode? %>
      <div class="flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="text-body font-semibold text-ink-900">Barra inferior en el teléfono</p>
          <p class="mt-0.5 text-label leading-relaxed text-ink-500">
            El menú queda abajo, a mano del pulgar, y el inicio muestra solo tus cifras. Apágalo para volver al menú completo. En la computadora no cambia nada.
          </p>
        </div>
        <%= button_to simple_mode_settings_path, method: :patch, params: { simple_mode: simple ? "0" : "1" },
              role: "switch", aria: { checked: simple, label: "Modo simple: #{simple ? "apagar" : "encender"}" },
              class: "relative shrink-0 w-[42px] h-6 rounded-full cursor-pointer transition-colors #{simple ? "bg-primary-600" : "bg-line"} focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500" do %>
          <span class="absolute top-[2px] left-[2px] size-5 rounded-full bg-white shadow-sm <%= "translate-x-[18px]" if simple %>"></span>
        <% end %>
      </div>
    </section>

    <% if Tutorial.available_to?(Current.user) %>
      <%# El tutorial recorre la barra de abajo: solo existe en el teléfono con el modo simple. %>
      <section class="md:hidden <%= card_classes("px-5 py-6") %>" aria-labelledby="settings-tutorial" data-settings-tutorial>
        <h2 id="settings-tutorial" class="<%= card_heading %>">
          <%= icon "graduation-cap", class: "w-[17px] h-[17px]" %>
          Tutorial
        </h2>
        <p class="text-label leading-relaxed text-ink-500"><%= Current.user.participant&.joven? ? "Un recorrido de 2 minutos por la app: tu compañía, tu QR, la agenda y los avisos." : "Un recorrido de 5 minutos por la app, para repasar lo que vas a usar. Lo que practiques no se guarda." %></p>
        <%= link_to dashboard_path(tutorial: "ver"), class: button_classes(:secondary, extra: "mt-3 w-full") do %>
          <%= icon "play", class: "w-4 h-4" %>
          Ver el tutorial
        <% end %>
      </section>
    <% end %>

    <%# Abre la hoja de instalar (shared/_install_sheet). Ya instalada no hace falta: abierta desde su ícono, no sale. %>
    <section class="md:hidden standalone:hidden <%= card_classes("px-5 py-6") %>" aria-labelledby="settings-install" data-settings-install>
      <h2 id="settings-install" class="<%= card_heading %>">
        <%= icon "smartphone", class: "w-[17px] h-[17px]" %>
        Instalar la app
      </h2>
      <p class="text-label leading-relaxed text-ink-500">Agrégala a tu pantalla de inicio: se abre con un toque, a pantalla completa, y te llegan las alertas.</p>
      <button type="button" data-install-open class="<%= button_classes(:secondary, extra: "mt-3 w-full") %>">
        <%= icon "download", class: "w-4 h-4" %>
        Instalar en este teléfono
      </button>
    </section>

    <%# El permiso de notificaciones es por dispositivo: este bloque habla del teléfono o la compu que estás usando. %>
    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-push" data-tour="push"
             data-controller="push" data-push-public-key-value="<%= Rails.application.credentials.dig(:vapid, :public_key) %>"
             data-push-url-value="<%= push_subscription_notifications_path %>"
             data-push-test-url-value="<%= push_test_notifications_path %>">
      <h2 id="settings-push" class="<%= card_heading %>">
        <%= icon "bell-ring", class: "w-[17px] h-[17px]" %>
        Notificaciones
      </h2>
      <p class="text-body font-semibold text-ink-900">Alertas en este dispositivo</p>
      <p class="mt-1 text-label leading-relaxed text-ink-500" data-push-target="status">
        Revisando el permiso…
      </p>
      <div class="mt-3 flex flex-wrap gap-2.5">
        <button type="button" data-action="push#toggle" data-push-target="button" class="<%= button_classes(:primary) %>">
          Activar en este dispositivo
        </button>
        <%# Un aviso real desde el servidor: cierra la app al tocarlo para ver si llega con ella cerrada. %>
        <button type="button" hidden data-action="push#sendTest" data-push-target="test" class="<%= button_classes(:secondary) %>">
          <%= icon "send", class: "w-4 h-4" %>
          Enviar una prueba
        </button>
      </div>
      <div class="mt-5 pt-4 border-t border-line-soft">
        <%= render(ToggleComponent.new(id: "push-sound-toggle", label: "Sonido y vibración",
              description: "Las alertas llegan con tono y vibración. En iPhone el sonido lo controla el sistema.",
              action: "saveSound", target: "sound", controller: "push")) %>
      </div>
    </section>

    <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" aria-labelledby="settings-accessibility">
      <h2 id="settings-accessibility" class="<%= card_heading %>">
        <%= icon "eye", class: "w-[17px] h-[17px]" %>
        Accesibilidad
      </h2>
      <div class="flex flex-col divide-y divide-line-soft">
        <div class="pb-4">
          <%= render(ToggleComponent.new(id: "reduce-motion-toggle", label: "Reducir movimiento",
                description: "Minimiza las animaciones y transiciones en toda la aplicación.",
                action: "toggleMotion", target: "motionToggle")) %>
        </div>
        <div class="pt-4">
          <%= render(ToggleComponent.new(id: "text-size-toggle", label: "Texto grande",
                description: "Sube un escalón más el texto. En el teléfono la letra ya viene grande de base.",
                action: "toggleTextSize", target: "textSizeToggle")) %>
        </div>
      </div>
    </section>

    <% if Current.user.scan_manager? %>
      <%# El superadmin y el director de logística: un solo registro abierto a la vez, así nadie escanea en el equivocado. %>
      <section class="<%= card_classes("px-5 py-6 md:px-[26px]") %>" id="settings-scan" aria-labelledby="settings-scan-title">
        <h2 id="settings-scan-title" class="<%= card_heading %>">
          <%= icon "scan-line", class: "w-[17px] h-[17px]" %>
          Registro por escaneo
        </h2>
        <p class="-mt-2 mb-4 text-label leading-relaxed text-ink-500">
          Activa el registro que se está escaneando. Solo hay uno abierto a la vez: al activar otro, el anterior se cierra.
        </p>
        <% rows = [ [ "arrival", "Llegada de los jóvenes", Rails.configuration.x.event_start_on, ScanWindow.arrival ] ] +
                  @trainings.map { |training| [ "training:#{training.id}", training.name, training.held_on, training.scan_window ] } %>
        <ul class="divide-y divide-line-soft">
          <% rows.each do |key, label, day, window| %>
            <% active = window.active? %>
            <li class="flex items-center justify-between gap-4 py-3 first:pt-0 last:pb-0" data-scan-window="<%= key %>">
              <div class="min-w-0">
                <p class="text-body font-semibold text-ink-900"><%= label %></p>
                <p class="text-label font-semibold text-ink-500">
                  <%= SpanishDates.long(day) %>
                  <% if active %> · <span class="text-cat-green-ink">abierto ahora</span><% end %>
                </p>
              </div>
              <%# Apagar el activo cierra el escaneo; encender otro lo cambia. Cada interruptor guarda al tocarlo. %>
              <%= button_to scan_windows_settings_path, method: :patch, params: { scan: active ? "" : key },
                    role: "switch", aria: { checked: active, label: "#{label}: #{active ? "cerrar" : "activar"} el registro" },
                    class: "relative shrink-0 w-[42px] h-6 rounded-full cursor-pointer transition-colors #{active ? "bg-primary-600" : "bg-line"} focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500" do %>
                <span class="absolute top-[2px] left-[2px] size-5 rounded-full bg-white shadow-sm <%= "translate-x-[18px]" if active %>"></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% end %>
