<%# Qué quiere decir cada color e ícono de la cuadrícula de pasillos. %>
<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-label font-semibold text-ink-500" data-rooms-legend>
  <% [ [ "Mujeres", "M" ], [ "Hombres", "H" ], [ "Matrimonio", :mixed ], [ "Libre", :empty ] ].each do |label, tone| %>
    <span class="inline-flex items-center gap-1.5">
      <span class="size-3.5 rounded-[4px] border <%= RoomsHelper::TILE_TONES.fetch(tone) %>" aria-hidden="true"></span>
      <%= label %>
    </span>
  <% end %>
  <% [ [ "shield-user", "Consejeros" ], [ "users-round", "Coordinación" ], [ "boxes", "Logística" ], [ "triangle-alert", "Revisar" ] ].each do |glyph, label| %>
    <span class="inline-flex items-center gap-1.5">
      <%= icon glyph, class: "size-3.5" %>
      <%= label %>
    </span>
  <% end %>
</div>
