<% content_for :title, "Iniciar sesión" %>
<%= render layout: "shared/auth_screen",
           locals: { headline: "Todo el evento, en un solo lugar.",
                     meta_icon: "calendar-days", meta_text: "11 al 16 de enero de 2027" } do %>
  <h1 class="text-[22px] font-extrabold tracking-tight text-ink-900">Iniciar sesión</h1>
  <p class="mt-1.5 text-[13.5px] leading-snug text-ink-500">Entra con el correo que registraste para el evento.</p>

  <%= form_with url: session_url, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Correo electrónico", class: field_label_classes %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            placeholder: "tucorreo@ejemplo.com", value: params[:email_address], class: auth_input_classes %>
    </div>

    <%= render "shared/password_field", form: form, attribute: :password, label: "Contraseña",
               autocomplete: "current-password", placeholder: "Tu contraseña" %>

    <%# Sin correo configurado no hay enlace que mandar: la restablece la coordinación. %>
    <div class="flex justify-end">
      <% if password_reset_emails? %>
        <%= link_to "¿Olvidaste tu contraseña?", new_password_path,
              class: "text-[12.5px] font-bold text-primary-600 hover:underline" %>
      <% else %>
        <p class="text-[12.5px] text-ink-500">¿Olvidaste tu contraseña? Pídele a tu coordinación que la restablezca.</p>
      <% end %>
    </div>

    <%= tag.button type: "submit", class: auth_button_classes do %>
      <%= icon "log-in", class: "w-4 h-4" %>
      Entrar
    <% end %>
  <% end %>

  <p class="mt-6 pt-4 border-t border-line-soft text-[12.5px] leading-snug text-ink-500">
    ¿No tienes cuenta? La crea tu coordinación cuando te registran en el evento.
  </p>
<% end %>
