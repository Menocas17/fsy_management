<div class="mx-auto md:w-2/3 w-full border border-slate-300 rounded-xl shadow-md p-6 mt-20">
  <div class="flex items-center justify-center gap-3 border-b border-slate-200 w-full py-3 mb-10">
    <%= image_tag "fsy_letters.svg", class:"w-30 h-30"%>
    <%= image_tag "fsy-logo.svg", class:"w-30 h-30"%>
  </div>
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 mb-5 text-red-500 font-medium rounded-lg block mx-auto text-center" id="alert"><%= alert %></p>
  <% end %>
  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg block mx-auto text-center" id="notice"><%= notice %></p>
  <% end %>
  <h1 class="font-bold text-4xl text-center">Iniciar Sesión</h1>
  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5 ">
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Ingrese su correo electronico", value: params[:email_address], class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full md:w-2/3 mx-auto" %>
    </div>
    <div class="my-5">
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Ingrese su contraseña", maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full md:w-2/3 mx-auto" %>
    </div>
    <div class="col-span-6 sm:flex sm:items-center sm:gap-4 justify-center">
      <div class="inline">
        <%= form.submit "Iniciar Sesión", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-[#015581] hover:bg-[#0376af] text-white inline-block font-medium cursor-pointer" %>
      </div>
      <div class="mt-4 text-sm text-gray-500 sm:mt-0">
        <%= link_to "Olvido la contraseña?", new_password_path, class: "text-gray-700 underline hover:no-underline" %>
      </div>
    </div>
  <% end %>
</div>
