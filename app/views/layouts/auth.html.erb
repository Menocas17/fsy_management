<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Fsy Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fsy Management">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# El .ico va primero: es el que los navegadores pintan en la pestaña sin reescalar el de 512. %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <%# La letra la sirve la app (app/assets/tailwind/application.css): se pide junto con el CSS, sin ir a Google. %>
    <link rel="preload" href="<%= asset_path("onest-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# Las pantallas de acceso van siempre en claro: no cargan el tema guardado, así el primer contacto con la app es el mismo para todos. %>
  <body class="min-h-dvh bg-canvas text-ink-900 antialiased">
    <main class="min-h-dvh flex items-center justify-center px-4 py-8 md:py-12">
      <%= yield %>
    </main>
  </body>
</html>
