<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Fsy Management" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fsy Management">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <script>
      (function () {
        try {
          if (localStorage.getItem('fsy:theme') === 'dark') {
            document.documentElement.classList.add('dark');
          }
          if (localStorage.getItem('fsy:reduce-motion') === 'true') {
            document.documentElement.classList.add('reduce-motion');
          }
          // La entrada del panel (dashboard_entrance_controller.js) se arma antes del primer cuadro, una vez por
          // sesión. Con movimiento reducido, nunca.
          var calm = document.documentElement.classList.contains('reduce-motion') ||
                     window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!calm && !sessionStorage.getItem('fsy:entrance-seen')) {
            document.documentElement.classList.add('entrance-pending');
          }
          // El teléfono ya viene con la letra grande por CSS; esto es el escalón extra que se elige.
          if (localStorage.getItem('fsy:text-size') === 'large') {
            document.documentElement.classList.add('text-lg-mode');
          }
        } catch (e) {
          // localStorage unavailable (private browsing) — fall back to defaults
        }
      })();
    </script>
    <%# Instalable en el teléfono: sin esto, iOS no deja activar las notificaciones. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#1d2b4a">
    <%# El .ico va primero: es el que los navegadores pintan en la pestaña sin reescalar el de 512. %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@100..900&display=swap" rel="stylesheet">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <%# overflow-clip y no overflow-hidden: el body no debe desplazarse nunca (solo <main>), y con hidden el
      navegador igual lo corría al enfocar algo fuera de vista, dejando la página cortada sin forma de volver. %>
  <body class="h-dvh overflow-clip bg-canvas text-ink-900">
    <%# Canal propio de cada persona: por aquí llega la campanita al instante, sin recargar. %>
    <%= turbo_stream_from Current.user if Current.user&.persisted? %>
    <%= render "shared/toast"%>
    <%# Only <main> scrolls: the sidebar and top bar stay fixed, and main always fills the remaining height. %>
    <div class="flex h-full">
      <%= render "shared/aside"%>
      <div class="relative flex flex-col flex-1 min-w-0 min-h-0" data-controller="pull-refresh">
        <%= render "shared/view_as_banner" %>
        <%= render "shared/top_menu"%>
        <%# Jalar para recargar (pull_refresh_controller): baja desde el borde de <main>, bajo la barra superior. %>
        <div class="relative z-20 h-0">
          <div data-pull-refresh-target="indicator" data-state="idle" aria-hidden="true"
               style="opacity: 0; transform: translate(-50%, -48px)"
               class="group absolute left-1/2 top-0 w-10 h-10 rounded-full flex items-center justify-center bg-surface border border-line shadow-lg text-ink-500 pointer-events-none transition-[transform,opacity] duration-200 ease-out data-[state=armed]:text-primary-600 data-[state=refreshing]:text-primary-600 dark:data-[state=armed]:text-primary-300 dark:data-[state=refreshing]:text-primary-300">
            <span class="block group-data-[state=refreshing]:animate-spin">
              <span data-pull-refresh-target="icon" class="block">
                <%= icon "refresh-cw", class: "w-[18px] h-[18px]" %>
              </span>
            </span>
          </div>
        </div>
        <main data-controller="scroll-memory" data-pull-refresh-target="scroller" class="flex-1 min-h-0 overflow-y-auto overscroll-y-contain bg-canvas">
          <%= yield %>
        </main>
      </div>
    </div>
    <%= render "shared/confirmation_modal"%>
  </body>
</html>
