<%
  colors = {
    "participantes" => "bg-primary-100 text-primary-700 dark:bg-primary-700/30 dark:text-primary-100",
    "asignaciones" => "bg-cat-green/15 text-cat-green-ink",
    "companias" => "bg-cat-blue/15 text-cat-blue-ink",
    "agenda" => "bg-cat-indigo/15 text-cat-indigo-ink",
    "registro" => "bg-sun/20 text-sun-ink",
    "alertas" => "bg-cat-rose/15 text-cat-rose-ink",
    "logistica" => "bg-cat-amber/20 text-cat-amber-ink",
    "finanzas" => "bg-cat-teal/15 text-cat-teal-ink"
  }
%>
<span class="<%= colors.fetch(log.category, "bg-canvas text-ink-500") %> inline-flex items-center px-2.5 py-0.5 rounded-full text-meta font-semibold whitespace-nowrap"><%= log.category_label %></span>
