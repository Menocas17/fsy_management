<% if audit_logs.load.any? %>
  <div class="hidden md:block">
    <div class="<%= card_classes("overflow-hidden") %>">
      <div class="overflow-x-auto px-7">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-line-soft dark:border-slate-700 text-[11px] font-bold tracking-[.06em] uppercase text-ink-300 dark:text-slate-500">
              <th class="pt-5 pb-3 pr-5">Usuario</th>
              <th class="pt-5 pb-3 pr-5">Acción</th>
              <th class="pt-5 pb-3 pr-5">Categoría</th>
              <th class="pt-5 pb-3 pr-5 hidden lg:table-cell">Participante / entidad</th>
              <th class="pt-5 pb-3">Fecha</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-soft dark:divide-slate-700 text-[13.5px] text-ink-700 dark:text-slate-300">
            <% audit_logs.each do |log| %>
              <tr class="hover:bg-primary-50/60 dark:hover:bg-slate-700/40 transition-colors" data-audit-log-id="<%= log.id %>">
                <td class="py-3.5 pr-5"><%= render "audit_logs/actor", log: log %></td>
                <td class="py-3.5 pr-5"><%= log.summary %></td>
                <td class="py-3.5 pr-5"><%= render "audit_logs/category_pill", log: log %></td>
                <td class="py-3.5 pr-5 hidden lg:table-cell"><%= log.target_name.presence || "—" %></td>
                <td class="py-3.5 whitespace-nowrap text-ink-500 dark:text-slate-400"><%= log.created_at.strftime("%d/%m/%Y · %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="flex items-center justify-between gap-4 mt-4 px-1">
      <p class="text-[12.5px] font-medium text-ink-500 dark:text-slate-400">
        Mostrando <%= pagy.from %>–<%= pagy.to %> de <%= pagy.count %> registros
      </p>
      <% if pagy.last > 1 %>
        <%== pagy.series_nav(anchor_string: 'data-turbo-action="advance"') %>
      <% end %>
    </div>
  </div>

  <div class="md:hidden">
    <%= turbo_frame_tag "audit_logs_page_#{pagy.page}" do %>
      <% audit_logs.each do |log| %>
        <article class="<%= card_classes("p-3.5 mb-2.5") %>">
          <div class="flex items-center justify-between gap-3">
            <%= render "audit_logs/actor", log: log %>
            <span class="shrink-0 text-[10.5px] font-semibold text-ink-300 dark:text-slate-500"><%= log.created_at.strftime("%d/%m · %H:%M") %></span>
          </div>
          <p class="mt-2 text-[12.5px] text-ink-700 dark:text-slate-300"><%= log.summary %></p>
          <div class="mt-2.5 pt-2.5 border-t border-line-soft dark:border-slate-700 flex items-center justify-between gap-3">
            <%= render "audit_logs/category_pill", log: log %>
            <span class="text-[11.5px] font-semibold text-ink-700 dark:text-slate-300 truncate"><%= log.target_name %></span>
          </div>
        </article>
      <% end %>
      <% if pagy.next %>
        <%= turbo_frame_tag "audit_logs_page_#{pagy.next}", src: pagy.page_url(:next), loading: :lazy do %>
          <div class="flex items-center justify-center gap-2.5 py-3">
            <span class="w-4 h-4 rounded-full border-2 border-line dark:border-slate-600 border-t-primary-500 animate-spin"></span>
            <span class="text-xs font-semibold text-ink-500 dark:text-slate-400">Cargando más registros…</span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="<%= card_classes("p-10 text-center") %>">
    <p class="text-ink-500 dark:text-slate-400">No hay actividad que coincida con los filtros.</p>
  </div>
<% end %>
