<%# Cuántos y, si hay filtros, cómo quitarlos: aquí dentro del frame para que se actualice con cada filtro. %>
<div class="flex items-center justify-between gap-3 mb-3 px-1 min-h-6">
  <p class="text-label font-medium text-ink-500" data-audit-total>
    <%= pagy.count.zero? ? "Sin registros" : pluralize(pagy.count, "registro", plural: "registros") %>
  </p>
  <% if filtered %>
    <%= link_to "Quitar filtros", audit_logs_path, data: { turbo_frame: "_top", audit_clear: true },
          class: "text-label font-bold text-primary-600 dark:text-primary-300 hover:underline" %>
  <% end %>
</div>

<% if audit_logs.load.any? %>
  <%# Tabla en la compu y tarjetas en el teléfono; al teléfono que lo dice (DeviceHelper) solo le va la suya. %>
  <% if render_desktop_layout? %>
  <div class="hidden md:block">
    <div class="<%= card_classes("overflow-hidden") %>">
      <div class="overflow-x-auto px-7">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-line-soft text-meta font-bold tracking-[.06em] uppercase text-ink-500">
              <th scope="col" class="pt-5 pb-3 pr-5">Acción</th>
              <th scope="col" class="pt-5 pb-3 pr-5">Usuario</th>
              <th scope="col" class="pt-5 pb-3 pr-5 hidden xl:table-cell">Categoría</th>
              <th scope="col" class="pt-5 pb-3 pr-5 hidden lg:table-cell">Participante / entidad</th>
              <th scope="col" class="pt-5 pb-3">Fecha</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-soft text-body text-ink-700">
            <% audit_logs.each do |log| %>
              <tr class="hover:bg-primary-50/60 dark:hover:bg-muted/40 transition-colors" data-audit-log-id="<%= log.id %>">
                <td class="py-3.5 pr-5">
                  <div class="flex items-start gap-3 min-w-64">
                    <%= render "audit_logs/kind_icon", log: log %>
                    <span class="pt-1 text-ink-900"><%= log.summary %></span>
                  </div>
                </td>
                <td class="py-3.5 pr-5 max-w-52"><%= render "audit_logs/actor", log: log %></td>
                <td class="py-3.5 pr-5 hidden xl:table-cell"><%= render "audit_logs/category_pill", log: log %></td>
                <td class="py-3.5 pr-5 hidden lg:table-cell"><%= audit_target(log, targets, class: "font-medium") %></td>
                <td class="py-3.5 whitespace-nowrap text-ink-500"><%= audit_time(log, year: true) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="flex items-center justify-between gap-4 mt-4 px-1">
      <p class="text-label font-medium text-ink-500">
        Mostrando <%= pagy.from %>–<%= pagy.to %> de <%= pagy.count %> registros
      </p>
      <% if pagy.last > 1 %>
        <%== pagy.series_nav(anchor_string: 'data-turbo-action="advance"') %>
      <% end %>
    </div>
  </div>
  <% end %>

  <%# Teléfono: una tarjeta por registro, todo a lo ancho y sin desplazamiento lateral; carga más al bajar. %>
  <div class="<%= layout_split("md:hidden") %>">
    <%= turbo_frame_tag "audit_logs_page_#{pagy.page}" do %>
      <% audit_logs.each do |log| %>
        <article class="<%= card_classes("p-3.5 mb-2.5") %>" data-audit-log-card="<%= log.id %>">
          <div class="flex items-start gap-3">
            <%= render "audit_logs/kind_icon", log: log %>
            <div class="min-w-0 flex-1">
              <p class="text-body font-semibold leading-snug text-ink-900 [overflow-wrap:anywhere]"><%= log.summary %></p>
              <p class="mt-1 text-label font-medium text-ink-500 [overflow-wrap:anywhere]">
                <%= log.actor_name %> · <%= audit_time(log) %>
              </p>
              <div class="mt-2.5 flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
                <%= render "audit_logs/category_pill", log: log %>
                <% if log.target_name.present? %>
                  <%= audit_target(log, targets, class: "min-w-0 text-label font-semibold text-ink-700 [overflow-wrap:anywhere]") %>
                <% end %>
              </div>
            </div>
          </div>
        </article>
      <% end %>
      <% if pagy.next %>
        <%= turbo_frame_tag "audit_logs_page_#{pagy.next}", src: pagy.page_url(:next), loading: :lazy do %>
          <div class="flex items-center justify-center gap-2.5 py-3">
            <span class="w-4 h-4 rounded-full border-2 border-line border-t-primary-500 animate-spin"></span>
            <span class="text-xs font-semibold text-ink-500">Cargando más registros…</span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="<%= card_classes("p-5 md:p-6") %>">
    <%= render EmptyStateComponent.new(name: "audit-logs", icon: filtered ? "search-x" : "clock",
          title: filtered ? "Nada coincide con los filtros" : "Todavía no hay actividad",
          text: filtered ? "Prueba con otra búsqueda o quita los filtros." : "Aquí aparecerá quién cambió qué y cuándo.") %>
  </div>
<% end %>
