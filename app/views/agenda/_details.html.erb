<%# The body of an activity: shown in the side panel on desktop and inside the accordion on phones. %>
<% notes = activity.notes_for(Current.user&.participant) %>
<% last_alert = activity.alerts.recent.first %>

<div class="flex flex-col gap-3">
  <%= info_row "Horario", "clock", "#{spanish_date(activity.day)} · #{activity.time_range}" %>
  <%= info_row "Lugar", "map-pin", activity.location %>
  <%= info_row "Responsables", "user-check", activity.responsible_names.presence %>
  <%= info_row "Alerta enviada a", "megaphone", activity.audience_label %>
</div>

<% if activity.description.present? %>
  <div class="mt-4 pt-4 border-t border-line-soft">
    <p class="text-label font-semibold text-ink-500">Descripción</p>
    <p class="mt-1 text-label leading-relaxed text-ink-700"><%= activity.description %></p>
  </div>
<% end %>

<% if notes.any? %>
  <div class="mt-4 pt-4 border-t border-line-soft flex flex-col gap-2.5">
    <p class="text-meta font-bold tracking-[.07em] uppercase text-ink-500">Notas por rol</p>
    <% notes.each do |note| %>
      <div class="rounded-tile px-3.5 py-3 bg-sunken" data-role-note="<%= note[:label].parameterize %>">
        <p class="flex items-center gap-1.5 text-meta font-bold tracking-[.07em] uppercase text-ink-500">
          <%= icon note[:icon], class: "w-3.5 h-3.5" %>
          <%= note[:label] %>
        </p>
        <p class="mt-1.5 text-label font-semibold leading-relaxed text-ink-700"><%= note[:text] %></p>
      </div>
    <% end %>
  </div>
<% end %>

<% if last_alert %>
  <div class="mt-4 pt-4 border-t border-line-soft flex flex-wrap items-center gap-2">
    <span class="inline-flex items-center gap-1.5 h-6 px-2.5 rounded-full text-label font-bold bg-cat-green/15 text-cat-green-ink">
      <%= icon "check", class: "w-3 h-3" %>
      Alerta enviada
    </span>
    <span class="text-meta font-semibold text-ink-500"><%= last_alert.created_at.strftime("%d/%m · %H:%M") %> · <%= last_alert.sender_name %></span>
  </div>
<% end %>

<% if can_manage_agenda? %>
  <div class="mt-4 flex gap-2.5">
    <%= link_to edit_activity_path(activity), class: button_classes(:primary, extra: "flex-1") do %>
      <%= icon "square-pen", class: "w-4 h-4" %>
      Editar
    <% end %>
    <%= button_to activity_path(activity), method: :delete,
          form: { class: "flex-1", data: { turbo_confirm: "¿Eliminar «#{activity.title}»?", turbo_confirm_detail: "Se avisará a los participantes y no se puede deshacer." } },
          class: "w-full inline-flex items-center justify-center gap-2 h-10 px-4 rounded-control border border-line text-sm font-semibold text-cat-rose-ink hover:bg-cat-rose/10 cursor-pointer transition" do %>
      <%= icon "trash-2", class: "w-4 h-4" %>
      Eliminar
    <% end %>
  </div>
  <p class="mt-2.5 text-meta font-medium text-ink-500">Cada cambio envía una alerta automática a quienes participan.</p>
<% end %>
