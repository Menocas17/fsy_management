<section class="<%= card_classes("p-5 md:p-6") %>" aria-label="Detalle de la actividad">
  <% if activity %>
    <span class="inline-flex items-center h-6 px-2.5 rounded-full text-label font-bold <%= activity.styles[:pill] %>"><%= activity.category_label %></span>
    <h2 class="mt-2 mb-4 text-display font-extrabold text-ink-900" data-activity-title><%= activity.title %></h2>
    <%= render "agenda/details", activity: activity %>
  <% else %>
    <%= render EmptyStateComponent.new(title: "Selecciona una actividad", icon: "calendar-days", name: "agenda-detail",
          text: "Toca cualquier bloque de la agenda para ver el detalle y las notas de tu rol.") %>
  <% end %>
</section>
