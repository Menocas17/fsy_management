<section class="<%= card_classes("px-5 py-5 md:px-6") %>" aria-label="Detalle de la actividad">
  <% if activity %>
    <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-bold <%= activity.styles[:pill] %>"><%= activity.category_label %></span>
    <h2 class="mt-2 mb-4 text-[17px] font-extrabold text-ink-900 dark:text-slate-100" data-activity-title><%= activity.title %></h2>
    <%= render "agenda/details", activity: activity %>
  <% else %>
    <div class="py-8 text-center">
      <span class="mx-auto w-11 h-11 rounded-full flex items-center justify-center bg-canvas dark:bg-slate-700 text-ink-300 dark:text-slate-400">
        <%= icon "calendar-days", class: "w-5 h-5" %>
      </span>
      <p class="mt-3 text-[14px] font-bold text-ink-900 dark:text-slate-100">Selecciona una actividad</p>
      <p class="mt-1 text-[12.5px] text-ink-500 dark:text-slate-400">Toca cualquier bloque de la agenda para ver el detalle y las notas de tu rol.</p>
    </div>
  <% end %>
</section>
