<%# Phones: each activity opens in place, so nobody has to scroll to a separate panel. %>
<div class="flex flex-col gap-4">
  <% days.each do |day| %>
    <% activities = activities_by_day.fetch(day, []) %>
    <div class="<%= card_classes("overflow-hidden") %>">
      <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-line-soft">
        <p class="text-body font-bold text-ink-900"><%= spanish_date(day) %></p>
        <p class="text-label font-semibold text-ink-500"><%= pluralize(activities.size, "actividad", plural: "actividades") %></p>
      </div>

      <% if activities.any? %>
        <div class="divide-y divide-line-soft">
          <% activities.each do |activity| %>
            <details class="group agenda-details" data-activity-id="<%= activity.id %>" <%= "open" if @activity&.id == activity.id && params[:activity_id].present? %>>
              <summary class="flex items-center gap-3 px-4 py-3 cursor-pointer list-none [&::-webkit-details-marker]:hidden border-l-[3px] <%= activity.styles[:block] %>">
                <span class="w-12 shrink-0 text-label font-extrabold tabular-nums"><%= activity.starts_at.strftime("%H:%M") %></span>
                <span class="min-w-0 flex-1">
                  <span class="block text-body font-bold"><%= activity.title %></span>
                  <span class="block text-label font-semibold text-ink-500">
                    <%= [ activity.location.presence, activity.time_range ].compact.join(" · ") %>
                  </span>
                </span>
                <%= icon "chevron-down", class: "w-4 h-4 shrink-0 transition-transform group-open:rotate-180" %>
              </summary>
              <div class="px-4 pt-4 pb-5 bg-surface border-t border-line-soft">
                <%# Lazy: un frame dentro de un <details> cerrado no es visible, así que se pide al abrirlo. %>
                <%= turbo_frame_tag dom_id(activity, :details), src: agenda_activity_path(activity), loading: :lazy do %>
                  <p class="py-2 text-label font-semibold text-ink-500">Cargando…</p>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% else %>
        <div class="px-6 py-8 text-center">
          <p class="text-body font-bold text-ink-900">Sin actividades este día</p>
          <% if can_manage_agenda? %>
            <%= link_to "Agregar una actividad", new_activity_path(date: day), class: "mt-2 inline-block text-body font-bold text-primary-600 dark:text-primary-300 hover:underline" %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
