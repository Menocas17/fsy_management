<% content_for :title, "Agenda" %>
<% content_for :eyebrow, "Gestión" %>
<%
  nav_button = "inline-flex items-center justify-center w-9 h-9 rounded-control border border-line bg-surface text-ink-700 hover:bg-canvas dark:hover:bg-slate-700 transition"
  nav_disabled = "inline-flex items-center justify-center w-9 h-9 rounded-control border border-line-soft text-ink-500 dark:text-slate-600 cursor-not-allowed"
%>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10">
  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3 mb-5">
    <div class="flex items-center gap-3 min-w-0">
      <% if @view == "dia" %>
        <div class="flex items-center gap-1.5 shrink-0">
          <% if @previous_day %>
            <%= link_to agenda_path(date: @previous_day, view: "dia"), class: nav_button, aria: { label: "Día anterior" } do %>
              <%= icon "chevron-left", class: "w-4 h-4" %>
            <% end %>
          <% else %>
            <span class="<%= nav_disabled %>" aria-hidden="true"><%= icon "chevron-left", class: "w-4 h-4" %></span>
          <% end %>
          <% if @next_day %>
            <%= link_to agenda_path(date: @next_day, view: "dia"), class: nav_button, aria: { label: "Día siguiente" } do %>
              <%= icon "chevron-right", class: "w-4 h-4" %>
            <% end %>
          <% else %>
            <span class="<%= nav_disabled %>" aria-hidden="true"><%= icon "chevron-right", class: "w-4 h-4" %></span>
          <% end %>
        </div>
      <% end %>
      <div class="min-w-0">
        <p class="text-[15px] md:text-base font-extrabold text-ink-900 truncate">
          <%= @view == "dia" ? spanish_date(@selected_day) : spanish_range(@days.first, @days.last) %>
        </p>
        <p class="text-[11.5px] font-semibold text-ink-500">
          <% if @view == "dia" %>
            <%= pluralize(@day_activities.size, "actividad", plural: "actividades") %> este día
          <% else %>
            <%= pluralize(@activities_by_day.values.sum(&:size), "actividad", plural: "actividades") %> en los <%= @days.size %> días del evento
          <% end %>
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <%# Las capacitaciones son fechas del staff previas al evento: viven aquí, junto a la agenda. %>
      <%= render SegmentedToggleComponent.new(label: "Vista de la agenda", items: [
            { text: "Semana", icon: "calendar-days", href: agenda_path(date: @selected_day, view: "semana"), active: @view == "semana", data: { agenda_view: "semana" } },
            { text: "Día", icon: "list", href: agenda_path(date: @selected_day, view: "dia"), active: @view == "dia", data: { agenda_view: "dia" } },
            { text: "Capacitaciones", icon: "graduation-cap", href: agenda_trainings_path, data: { agenda_view: "capacitaciones" } }
          ]) %>
      <% if can_manage_agenda? %>
        <%= link_to new_activity_path(date: @selected_day), class: button_classes do %>
          <%= icon "plus", class: "w-4 h-4" %>
          Nueva actividad
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_340px] gap-5 items-start">
    <div class="min-w-0">
      <%# La leyenda va antes de la agenda: los colores se entienden al llegar, no después de recorrerla. %>
      <div class="<%= card_classes("mb-3 flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-2.5") %>" data-agenda-legend>
        <span class="text-[10.5px] font-bold tracking-[.07em] uppercase text-ink-500">Tipos</span>
        <% Activity::CATEGORY_LABELS.each do |key, label| %>
          <span class="inline-flex items-center gap-2 text-[12px] font-semibold text-ink-700">
            <span class="w-2.5 h-2.5 rounded-[3px] <%= Activity::CATEGORY_STYLES[key][:dot] %>"></span>
            <%= label %>
          </span>
        <% end %>
      </div>

      <%# La cuadrícula de la semana necesita unos 680px más el panel de detalle: solo cabe desde xl.
          Por debajo (teléfono, tablet, portátil chica con la barra lateral) cada actividad se abre en su lugar. %>
      <div class="hidden xl:block"><%= render "agenda/week", days: @visible_days %></div>
      <div class="xl:hidden"><%= render "agenda/day_list", days: @visible_days %></div>
    </div>

    <div class="hidden xl:block"><%= render "agenda/detail", activity: @activity %></div>
  </div>
</div>
