<% content_for :title, "Nueva contraseña" %>
<%= render layout: "shared/auth_screen",
           locals: { headline: "Elegí una contraseña nueva.",
                     meta_icon: "lock", meta_text: "Este enlace es solo tuyo" } do %>
  <h1 class="text-[22px] font-extrabold tracking-tight text-ink-900">Actualizar tu contraseña</h1>
  <p class="mt-1.5 text-[13.5px] leading-snug text-ink-500">Reemplaza la anterior y cierra tus sesiones abiertas.</p>

  <% if @user.errors.any? %>
    <div role="alert" class="mt-5 rounded-xl border border-cat-rose/30 bg-cat-rose/10 px-3.5 py-3">
      <p class="flex items-start gap-2.5 text-[13px] font-bold text-cat-rose">
        <%= icon "circle-alert", class: "w-[17px] h-[17px] shrink-0 mt-px" %>
        La contraseña no cumple con los requisitos:
      </p>
      <ul class="mt-1.5 ml-7 list-disc text-[12.5px] font-semibold text-cat-rose">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "mt-6 space-y-4" do |form| %>
    <%= render "shared/password_field", form: form, attribute: :password, label: "Nueva contraseña",
               autocomplete: "new-password", placeholder: "Tu nueva contraseña", rules: true %>

    <%= render "shared/password_field", form: form, attribute: :password_confirmation, label: "Repetir la contraseña",
               autocomplete: "new-password", placeholder: "Escribila de nuevo" %>

    <%= tag.button type: "submit", class: auth_button_classes do %>
      <%= icon "check", class: "w-4 h-4" %>
      Guardar contraseña
    <% end %>
  <% end %>
<% end %>
