<% content_for :title, "Recuperar contraseña" %>
<%= render layout: "shared/auth_screen",
           locals: { headline: "Te mandamos un enlace y volvés a entrar.",
                     meta_icon: "mail", meta_text: "Revisá también la bandeja de spam" } do %>
  <h1 class="text-[22px] font-extrabold tracking-tight text-ink-900">¿Olvidaste tu contraseña?</h1>
  <p class="mt-1.5 text-[13.5px] leading-snug text-ink-500">
    Escribí tu correo y te enviamos las instrucciones para crear una nueva.
  </p>

  <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Correo electrónico", class: field_label_classes %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            placeholder: "tucorreo@ejemplo.com", value: params[:email_address], class: auth_input_classes %>
    </div>

    <%= tag.button type: "submit", class: auth_button_classes do %>
      <%= icon "send", class: "w-4 h-4" %>
      Enviar instrucciones
    <% end %>

    <%= link_to new_session_path,
          class: "w-full inline-flex items-center justify-center gap-2 h-11 rounded-[11px] border border-line bg-surface text-sm font-semibold text-ink-700 hover:bg-canvas transition" do %>
      <%= icon "arrow-left", class: "w-4 h-4" %>
      Volver a iniciar sesión
    <% end %>
  <% end %>
<% end %>
