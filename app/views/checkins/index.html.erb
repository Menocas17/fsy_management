<% content_for :page_h1, true %>
<% content_for :title, @training ? "Asistencia · #{@training.name}" : "Registro de llegadas" %>
<% content_for :eyebrow, "Evento" %>
<%# Vuelve a donde se abrió (una capacitación, la lista de capacitaciones); si no, al inicio. %>
<% back_to_origin "Inicio", dashboard_path %>
<% open = @window.open? %>
<%= render PageComponent.new(width: :page,
            data: (open ? { controller: "checkin-scanner",
                            checkin_scanner_roster_url_value: checkins_roster_path(training_id: @training&.id, return_to: params[:return_to].presence),
                            checkin_scanner_sync_url_value: register_checkins_path(training_id: @training&.id),
                            checkin_scanner_mode_value: @training ? "training-#{@training.id}" : "arrival",
                            checkin_scanner_total_value: @expected,
                            checkin_scanner_arrived_value: @registered } : { scan_closed: true })) do %>

  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-display font-extrabold tracking-tight text-ink-900">
        <%= @training ? "Asistencia a la capacitación" : "Registro de llegadas" %>
      </h1>
      <%# Sin selector: solo hay un registro activo a la vez, se elige en Configuración. %>
      <% if @training %>
        <p class="text-body font-semibold text-ink-700" data-scan-current><%= @training.label %></p>
      <% end %>
      <p class="text-label font-semibold text-ink-500">
        <span class="text-ink-900 tabular-nums" data-checkin-scanner-target="arrived" data-arrived><%= @registered %></span>
        de <%= @expected %> <%= @training ? "del staff" : "jóvenes" %> registrados
      </p>
    </div>
    <span hidden data-checkin-scanner-target="pending" data-pending
          class="inline-flex items-center gap-1.5 h-6 px-2.5 rounded-full text-label font-bold <%= Tones.tint(:amber) %>"></span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] gap-5 items-start">
    <% if open %>
    <section class="<%= card_classes("overflow-hidden") %>">
      <div class="flex items-start gap-3 px-5 py-4 border-b border-line-soft">
        <%= render IconTileComponent.new(icon: "scan-qr-code") %>
        <div class="min-w-0">
          <h2 class="text-title font-bold text-ink-900">Escáner</h2>
          <p class="text-label font-semibold text-primary-600 dark:text-primary-300">
            <%= @training ? @training.label : "Llegada al FSY · #{SpanishDates.long(Rails.configuration.x.event_start_on)}" %>
          </p>
          <p role="status" class="mt-0.5 text-label font-semibold text-ink-500" data-checkin-scanner-target="status">
            Activa la cámara para empezar
          </p>
        </div>
      </div>

      <%# El visor ocupa casi toda la pantalla del teléfono (vertical, como se sostiene). El resultado se pinta
          encima del video, porque quien registra mira la cámara, y se va solo a los 5 segundos (o al tocarlo)
          para no tapar al siguiente; el último queda anotado debajo.
          En el teléfono se abre en pantalla completa (data-fullscreen, .scan-viewer en application.css): solo la
          cámara, cuántos van, el resultado y el código a mano; la ✕ o «atrás» lo devuelven a la página. %>
      <div data-checkin-scanner-target="viewer" data-no-pull-refresh
           class="scan-viewer relative bg-primary-950 aspect-[3/4] sm:aspect-[4/3] max-h-[72dvh] w-full flex items-center justify-center">
        <video data-checkin-scanner-target="video" class="absolute inset-0 w-full h-full object-cover" muted playsinline></video>
        <canvas data-checkin-scanner-target="canvas" class="hidden"></canvas>
        <%# El recuadro guía vive en la zona de arriba (todo menos la franja de 96px de abajo), así la tarjeta
            del resultado nunca lo tapa, sea cual sea el alto de la pantalla. %>
        <div class="absolute inset-x-0 top-0 bottom-24 flex items-center justify-center pointer-events-none">
          <div class="relative h-[min(15rem,85%)] aspect-square">
            <% [ "top-0 left-0 border-r-0 border-b-0 rounded-tl-tile", "top-0 right-0 border-l-0 border-b-0 rounded-tr-tile",
                 "bottom-0 left-0 border-r-0 border-t-0 rounded-bl-tile", "bottom-0 right-0 border-l-0 border-t-0 rounded-br-tile" ].each do |corner| %>
              <span data-checkin-scanner-target="corner" class="absolute w-9 h-9 border-[3px] border-white/90 transition-colors duration-500 ease-out <%= corner %>"></span>
            <% end %>
          </div>
        </div>
        <button type="button" data-action="checkin-scanner#start" data-checkin-scanner-target="start"
                class="absolute inline-flex items-center gap-2 h-11 px-5 rounded-control bg-white text-body font-bold text-primary-800 shadow-md hover:bg-primary-50 active:scale-[0.97] cursor-pointer transition">
          <%= icon "scan-qr-code", class: "w-4 h-4" %>
          Activar la cámara
        </button>
        <div hidden data-checkin-scanner-target="card" role="status" aria-live="polite" aria-atomic="true"
             data-action="click->checkin-scanner#dismissCard"
             class="absolute inset-x-3 bottom-3 z-10"></div>

        <%# Con la cámara prendida en el teléfono: volver a la pantalla completa después de salir. %>
        <button type="button" hidden data-checkin-scanner-target="expand" data-action="checkin-scanner#expand"
                aria-label="Pantalla completa"
                class="md:hidden absolute top-3 right-3 z-10 inline-flex items-center gap-1.5 h-11 px-3.5 rounded-full bg-black/55 text-label font-bold text-white backdrop-blur-sm active:scale-[0.97] cursor-pointer transition">
          <%= icon "maximize", class: "w-4 h-4" %>
          Pantalla completa
        </button>

        <%# Barra de arriba, solo en pantalla completa: salir, cuántos van y escribir el código a mano. %>
        <div data-fullscreen-only
             class="absolute inset-x-0 top-0 z-10 flex items-center gap-2 px-3 pb-6 pt-[max(env(safe-area-inset-top),12px)] bg-gradient-to-b from-black/60 to-transparent">
          <button type="button" data-action="checkin-scanner#collapse" aria-label="Salir de pantalla completa"
                  class="shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-full bg-black/55 text-white backdrop-blur-sm active:scale-[0.95] cursor-pointer transition">
            <%= icon "x", class: "w-5 h-5" %>
          </button>
          <div class="min-w-0 flex-1 flex flex-col items-center text-center text-white">
            <span class="text-body font-extrabold leading-tight">
              <span class="tabular-nums" data-checkin-scanner-target="arrived"><%= @registered %></span>
              <span class="font-semibold text-white/80">de <%= @expected %></span>
            </span>
            <span hidden data-checkin-scanner-target="pending"
                  class="mt-0.5 inline-flex items-center h-5 px-2 rounded-full text-meta font-bold bg-surface text-cat-amber-ink"></span>
          </div>
          <button type="button" data-action="checkin-scanner#askCode"
                  class="shrink-0 inline-flex items-center gap-1.5 h-11 px-3.5 rounded-full bg-black/55 text-label font-bold text-white backdrop-blur-sm active:scale-[0.97] cursor-pointer transition">
            <%= icon "keyboard", class: "w-4 h-4" %>
            Código
          </button>
        </div>
      </div>

      <div class="p-4 space-y-3">
        <div hidden data-checkin-scanner-target="last" data-last-scan
             class="flex items-center gap-3 rounded-tile bg-canvas px-3.5 py-2.5"></div>
        <%= form_with url: "#", method: :get, data: { action: "submit->checkin-scanner#typed" }, class: "flex gap-2" do %>
          <%= text_field_tag :code, nil, placeholder: "Código del gafete (ej. P-0421)", autocomplete: "off", aria: { label: "Código del gafete" },
                data: { checkin_scanner_target: "manual" }, class: "#{field_input_classes} font-mono" %>
          <%= tag.button type: "submit", class: button_classes(:secondary, extra: "shrink-0") do %>
            Registrar
          <% end %>
        <% end %>
        <p class="text-label font-medium text-ink-500">
          Funciona sin señal: el padrón queda guardado en este dispositivo y lo escaneado se envía solo al volver el internet.
        </p>
      </div>

      <%# El código del gafete a mano, desde la pantalla completa (el gafete no se lee o la cámara no enfoca). %>
      <dialog data-checkin-scanner-target="codeDialog" data-code-dialog aria-labelledby="code-title"
              data-action="click->checkin-scanner#closeCodeOutside"
              class="app-dialog p-0 mx-auto mt-[max(env(safe-area-inset-top),4rem)] w-[calc(100%-2rem)] max-w-md rounded-panel shadow-lg backdrop:bg-black/60 backdrop:backdrop-blur-sm">
        <%= form_with url: "#", method: :get, data: { action: "submit->checkin-scanner#typed" }, class: "p-5 bg-surface rounded-panel" do %>
          <div class="flex items-start gap-3">
            <%= render IconTileComponent.new(icon: "keyboard", size: :md) %>
            <div class="min-w-0">
              <h2 id="code-title" class="text-title font-bold text-ink-900">Escribir el código</h2>
              <p class="mt-0.5 text-label text-ink-500">El que viene en el gafete, debajo del QR.</p>
            </div>
          </div>
          <%= text_field_tag :code, nil, id: "code_dialog_input", placeholder: "Ej. P-0421 o 421", autocomplete: "off", inputmode: "text",
                aria: { label: "Código del gafete" }, class: "#{field_input_classes} mt-4 font-mono" %>
          <div class="mt-4 flex gap-2.5 justify-end">
            <button type="button" data-action="checkin-scanner#closeCode" class="<%= button_classes(:secondary) %>">Cancelar</button>
            <%= tag.button type: "submit", class: button_classes(:primary) do %>
              Registrar
            <% end %>
          </div>
        <% end %>
      </dialog>

      <%# Anular un registro: llegó alguien con el gafete de otra persona o se escaneó el que no era. El motivo
          es de una lista; el detalle, opcional. Va en la misma cola que los escaneos (sirve sin señal). %>
      <dialog data-checkin-scanner-target="voidDialog" data-void-dialog aria-labelledby="void-title"
              data-action="click->checkin-scanner#closeVoidOutside"
              class="app-dialog p-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-panel shadow-lg backdrop:bg-black/60 backdrop:backdrop-blur-sm">
        <form data-action="submit->checkin-scanner#confirmVoid" class="p-5 md:p-6 bg-surface rounded-panel">
          <div class="flex items-start gap-3">
            <%= render IconTileComponent.new(icon: "user-x", tone: :rose, size: :md) %>
            <div class="min-w-0">
              <h2 id="void-title" class="text-title font-bold text-ink-900 text-balance">
                ¿Anular <%= @training ? "la asistencia" : "la llegada" %> de <span data-checkin-scanner-target="voidName"></span>?
              </h2>
              <p class="mt-1 text-label text-ink-500">Vuelve a quedar como que no ha llegado. Queda anotado en el Historial.</p>
            </div>
          </div>

          <fieldset class="mt-5 space-y-2">
            <legend class="mb-2 text-label font-bold text-ink-700">Motivo</legend>
            <% [ [ "otra_persona", "No era la persona", "Llegó alguien con el gafete de otra persona." ],
                 [ "escaneo_incorrecto", "Escaneo incorrecto", "Se escaneó o se escribió el gafete equivocado." ],
                 [ "otro", "Otro", nil ] ].each_with_index do |(value, label, hint), index| %>
              <label class="flex items-start gap-3 rounded-control border border-line px-3.5 py-2.5 cursor-pointer transition-colors hover:bg-canvas has-[:checked]:border-cat-rose has-[:checked]:bg-cat-rose/10" data-void-reason="<%= value %>">
                <input type="radio" name="void_reason" value="<%= value %>" <%= "checked" if index.zero? %> class="mt-[3px] w-4 h-4 accent-cat-rose">
                <span>
                  <span class="block text-body font-bold text-ink-900"><%= label %></span>
                  <% if hint %><span class="block text-label font-medium text-ink-500"><%= hint %></span><% end %>
                </span>
              </label>
            <% end %>
          </fieldset>

          <div class="mt-4">
            <label for="void_detail" class="<%= field_label_classes %>">Detalles <span class="font-medium text-ink-500">(opcional)</span></label>
            <textarea id="void_detail" name="void_detail" rows="2" maxlength="300" data-checkin-scanner-target="voidDetail"
                      placeholder="Ej.: llegó su hermano con el gafete" class="<%= field_input_classes %> h-auto py-2.5 resize-none"></textarea>
          </div>

          <div class="mt-5 flex gap-2.5 justify-end">
            <button type="button" data-action="checkin-scanner#closeVoid" class="<%= button_classes(:secondary) %>">Cancelar</button>
            <button type="submit" class="<%= button_classes(:danger) %>">
              <%= icon "user-x", class: "w-4 h-4" %>
              Anular
            </button>
          </div>
        </form>
      </dialog>
    </section>

    <% else %>
      <section class="<%= card_classes("p-5 md:p-6") %>" data-scan-closed-card>
        <%= render EmptyStateComponent.new(title: "Este registro no está abierto", text: @window.closed_reason, icon: "lock", tone: :neutral, name: "scan-closed") do |empty| %>
          <% if Current.user.scan_manager? %>
            <% empty.with_action do %>
              <%= link_to "Activarlo desde Configuración", settings_path(anchor: "settings-scan"), class: button_classes(:secondary) %>
            <% end %>
          <% end %>
        <% end %>
      </section>
    <% end %>

    <section class="<%= card_classes("p-5 md:p-6") %>">
      <%= section_heading @training ? "Últimos en llegar" : "Últimos registrados", "clipboard-check", tone: :green %>
      <% if @recent.any? %>
        <ul class="divide-y divide-line-soft" data-recent-checkins>
          <% @recent.each do |record| %>
            <li class="flex items-center gap-3 py-2.5 first:pt-0" data-recent-record="<%= record.id %>">
              <span class="text-label font-bold tabular-nums text-ink-500"><%= record.recorded_at.strftime("%H:%M") %></span>
              <span class="min-w-0 flex-1">
                <span class="block text-body font-bold text-ink-900 truncate"><%= record.participant.full_name %></span>
                <span class="block text-label font-semibold text-ink-500">
                  <%= record.participant.company&.name || record.participant.role_label %> · registró <%= record.recorded_by_name %>
                </span>
              </span>
              <% if open %>
                <button type="button" data-action="checkin-scanner#askVoid"
                        data-record-id="<%= record.id %>" data-participant-id="<%= record.participant_id %>"
                        data-name="<%= record.participant.full_name %>"
                        class="shrink-0 inline-flex items-center min-h-11 md:min-h-0 px-1 text-label font-bold text-cat-rose-ink hover:underline underline-offset-2 cursor-pointer">
                  Anular
                </button>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render EmptyStateComponent.new(title: "Todavía no hay nadie registrado", text: "Lo que se escanee aparece aquí, con la hora y quién lo registró.", icon: "clipboard-check", tone: :green, name: "recent-checkins") %>
      <% end %>

      <% if @training %>
        <%= link_to agenda_trainings_path, class: "mt-4 inline-flex items-center gap-2 text-label font-bold text-primary-600 dark:text-primary-300 hover:underline" do %>
          <%= icon "chart-column", class: "w-4 h-4" %>
          Ver el resumen de capacitaciones
        <% end %>
      <% end %>
    </section>
  </div>

  <%# Finalizar el registro de llegadas abre a los jóvenes su compañía (CompanyReveal) y les avisa. Se puede
      deshacer si se hizo antes de tiempo. El escáner sigue abierto para quien llegue tarde. %>
  <% if @training.nil? && Current.user.scan_manager? %>
    <% finished = CompanyReveal.open_to_jovenes? %>
    <% last_change = CompanyReveal.last_jovenes_change %>
    <section class="<%= card_classes("p-5 md:p-6") %>" data-registro-finish="<%= finished ? "finalizado" : "abierto" %>">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <div class="min-w-0 flex-1 flex items-start gap-3">
          <%= render IconTileComponent.new(icon: finished ? "circle-check-big" : "flag", tone: finished ? :green : :primary, size: :md) %>
          <div class="min-w-0">
            <h2 class="text-title font-bold text-ink-900"><%= finished ? "Registro finalizado" : "Finalizar el registro" %></h2>
            <p class="mt-0.5 text-label leading-relaxed text-ink-500">
              <% if finished %>
                Los jóvenes ya ven su compañía: sus consejeros, su comedor, su cuarto y sus compañeros. El escáner sigue abierto para quien llegue tarde.
              <% else %>
                Hasta que lo finalices, los jóvenes ven «Próximamente» en su compañía. Al finalizarlo la ven completa y les llega un aviso.
              <% end %>
            </p>
            <% if last_change %>
              <p class="mt-1 text-label font-semibold text-ink-500">Último cambio: <%= last_change.actor_name %> · <%= SpanishDates.short_with_time(last_change.created_at) %></p>
            <% end %>
          </div>
        </div>
        <% if finished %>
          <%= button_to finish_checkins_path, method: :delete, form_class: "shrink-0",
                form: { data: { turbo_confirm: "¿Reabrir el registro?",
                                turbo_confirm_detail: "Los jóvenes vuelven a ver «Próximamente» en su compañía. No les llega ningún aviso.",
                                turbo_confirm_button: "Sí, reabrir" } },
                class: button_classes(:secondary, extra: "w-full sm:w-auto") do %>
            <%= icon "undo-2", class: "w-4 h-4" %>
            Reabrir
          <% end %>
        <% else %>
          <%= button_to finish_checkins_path, method: :patch, form_class: "shrink-0",
                form: { data: { turbo_confirm: "¿Finalizar el registro?",
                                turbo_confirm_detail: "Los #{@expected} jóvenes verán su compañía, sus consejeros, su comedor y su cuarto, y les llegará un aviso.",
                                turbo_confirm_button: "Sí, finalizar" } },
                class: button_classes(:primary, extra: "w-full sm:w-auto") do %>
            <%= icon "flag", class: "w-4 h-4" %>
            Finalizar registro
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
