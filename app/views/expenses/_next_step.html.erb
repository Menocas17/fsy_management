<%# El paso que toca, según la etapa y quién mira. El modelo vuelve a comprobar las reglas al enviarlo.
    Aprobar es del superadmin, el matrimonio director y el director de logística; consolidar, de quien mueve gastos. %>
<% presenter = me && expense.presented_by_id == me.id %>
<% justifier = me && expense.justified_by_id == me.id %>
<% approver = can_approve_expenses? %>

<% case expense.status %>
<% when "presented" %>
  <section class="<%= card_classes("p-5 md:p-6") %>" data-next-step="approve">
    <%= section_heading "Aprobación", "stamp" %>
    <% if presenter %>
      <p class="text-body text-ink-500">Lo presentaste tú: lo aprueban el matrimonio director o el director de logística.</p>
      <div class="mt-4 flex flex-wrap gap-2">
        <%= link_to "Editar", edit_expense_path(expense), class: button_classes(:secondary) %>
        <%= button_to "Retirar", withdraw_expense_path(expense), method: :patch,
              form: { data: { turbo_confirm: "¿Retirar este gasto?", turbo_confirm_detail: "Queda cerrado y ya no se puede aprobar.", turbo_confirm_button: "Sí, retirar" } },
              class: button_classes(:ghost) %>
      </div>
    <% elsif !approver %>
      <p class="text-body text-ink-500" data-awaiting-approval>Lo aprueban el matrimonio director o el director de logística.</p>
    <% else %>
      <div class="flex flex-wrap items-start gap-3">
        <%= button_to approve_expense_path(expense), method: :patch, class: button_classes, data: { turbo_submits_with: "Aprobando…" } do %>
          <%= icon "check", class: "w-4 h-4" %>
          Aprobar
        <% end %>
        <%= form_with url: reject_expense_path(expense), method: :patch, class: "flex-1 min-w-60 flex flex-wrap gap-2" do %>
          <%= label_tag :reject_reason, "Motivo del rechazo", class: "sr-only" %>
          <%= text_field_tag :reason, nil, id: "reject_reason", required: true, placeholder: "Motivo si lo rechazas", class: "#{field_input_classes} flex-1 min-w-40" %>
          <%= tag.button "Rechazar", type: "submit", class: button_classes(:secondary) %>
        <% end %>
      </div>
    <% end %>
  </section>

<% when "approved" %>
  <% if can_operate_finances? %>
  <section class="<%= card_classes("p-5 md:p-6") %>" data-next-step="consolidate">
    <%= section_heading "Consolidar con la factura", "receipt" %>
    <p class="-mt-2 mb-4 text-label text-ink-500">Hecha la compra, sube la foto de la factura con el monto real. Todo gasto debe llevar su comprobante.</p>
    <%= form_with url: consolidate_expense_path(expense), method: :patch, multipart: true, class: "grid grid-cols-1 sm:grid-cols-2 gap-4" do %>
      <div class="sm:col-span-2">
        <%= label_tag :receipt, "Foto de la factura", class: field_label_classes %>
        <%= file_field_tag :receipt, required: true, accept: "image/*,application/pdf",
              class: "block w-full text-body text-ink-700 file:mr-3 file:h-10 file:px-4 file:rounded-control file:border-0 file:bg-primary-700 file:text-white file:font-semibold file:cursor-pointer" %>
      </div>
      <%= render "expenses/purchase_fields", expense: expense, prefix: "consolidate" %>
      <div class="sm:col-span-2">
        <%= tag.button type: "submit", class: button_classes, data: { turbo_submits_with: "Subiendo…" } do %>
          <%= icon "upload", class: "w-4 h-4" %>
          Consolidar
        <% end %>
      </div>
    <% end %>

    <details class="mt-6 rounded-tile border border-line-soft px-4 py-3">
      <summary class="cursor-pointer text-body font-bold text-ink-700">No hay factura: justificar</summary>
      <p class="mt-2 text-label text-ink-500">Solo cuando de verdad no hay comprobante. La justificación la aprueba otra persona y el gasto queda marcado en los reportes.</p>
      <%= form_with url: justify_expense_path(expense), method: :patch, class: "mt-3 grid grid-cols-1 sm:grid-cols-2 gap-4" do %>
        <div class="sm:col-span-2">
          <%= label_tag :justification, "Por qué no hay factura", class: field_label_classes %>
          <%= text_area_tag :justification, nil, rows: 3, required: true, class: field_textarea_classes,
                placeholder: "Ej. Vendedor ambulante sin factura; se pagó en efectivo." %>
        </div>
        <%= render "expenses/purchase_fields", expense: expense, prefix: "justify" %>
        <div class="sm:col-span-2">
          <%= tag.button "Enviar justificación", type: "submit", class: button_classes(:secondary), data: { turbo_submits_with: "Enviando…" } %>
        </div>
      <% end %>
    </details>
  </section>
  <% end %>

<% when "justification_pending" %>
  <section class="<%= card_classes("p-5 md:p-6") %>" data-next-step="approve-justification">
    <%= section_heading "Aprobar la justificación", "stamp" %>
    <% if justifier %>
      <p class="text-body text-ink-500">La escribiste tú: la tiene que aprobar otra persona.</p>
    <% elsif !approver %>
      <p class="text-body text-ink-500" data-awaiting-approval>La aprueban el matrimonio director o el director de logística.</p>
    <% else %>
      <div class="flex flex-wrap items-start gap-3">
        <%= button_to approve_justification_expense_path(expense), method: :patch, class: button_classes do %>
          <%= icon "check", class: "w-4 h-4" %>
          Aceptar y consolidar
        <% end %>
        <%= form_with url: reject_justification_expense_path(expense), method: :patch, class: "flex-1 min-w-60 flex flex-wrap gap-2" do %>
          <%= label_tag :reject_justification_reason, "Motivo", class: "sr-only" %>
          <%= text_field_tag :reason, nil, id: "reject_justification_reason", required: true, placeholder: "Por qué no se acepta", class: "#{field_input_classes} flex-1 min-w-40" %>
          <%= tag.button "No aceptar", type: "submit", class: button_classes(:secondary) %>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
