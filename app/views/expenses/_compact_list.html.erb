<% if expenses.any? %>
  <ul class="divide-y divide-line-soft">
    <% expenses.each do |expense| %>
      <li>
        <%= link_to expense, class: "flex items-center gap-3 py-2.5 -mx-2 px-2 rounded-lg hover:bg-canvas dark:hover:bg-slate-700/40" do %>
          <span class="min-w-0 flex-1">
            <span class="block text-[13.5px] font-bold text-ink-900 truncate"><%= expense.concept %></span>
            <span class="block text-[11.5px] font-semibold text-ink-500 truncate"><%= expense.category_name %> · <%= expense.presented_by_name %></span>
          </span>
          <span class="text-[13px] font-bold tabular-nums text-ink-900 shrink-0"><%= money(expense.estimated_cents, expense.currency) %></span>
          <%= expense_status_chip(expense) %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-[13px] text-ink-500"><%= empty %></p>
<% end %>
