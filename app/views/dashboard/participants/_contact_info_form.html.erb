<section class="flex flex-col md:flex-row gap-5 md:gap-30 border-b-2 justify-left py-4 mx-3  border-gray-300 ">
  <legend class="font-bold mt-5 text-3xl md:text-xl">Contacto</legend>
  <fieldset class="flex-1">
    <div class="mb-4">
      <%= form.label :phone_number, class:" font-semibold block mb-1"%>
      <%= form.phone_field :phone_number, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm md:max-w-3/4" %>
    </div>
    <div class="mb-4">
      <%= form.label :email_address, class:" font-semibold block mb-1"%>
      <%= form.email_field :email_address, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm md:max-w-3/4"%>
    </div>
    <fieldset class="md:max-w-3/4">
      <legend class="font-semibold text-xl md:text-lg mb-3 underline decoration-[#FCB447] decoration-2 underline-offset-5">Contacto de emergencia</legend>
      <div class="mb-4">
        <%= form.label :emergency_contact_number, class:" font-semibold block mb-1"%>
        <%= form.phone_field :emergency_contact_number, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm " %>
      </div>
      <div class="mb-4">
        <%= form.label :emergency_contact_name, class:" font-semibold block mb-1"%>
        <%= form.text_field :emergency_contact_name, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm "%>
      </div>
      <div class="mb-4">
        <%= form.label :emergency_contact_relation, class:" font-semibold block mb-1"%>
        <%= form.text_field :emergency_contact_relation, class:"border rounded-sm border-gray-200 bg-gray-100 w-full py-1 px-2 shadow-sm "%>
      </div>
    </fieldset>
  </fieldset>
</section>