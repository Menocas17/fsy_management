<h1 class="font-bold text-2xl ">Bienvenido de vuelta</h1>
<%= render "main_kpis", participants: @participants %>
<%= render "main_charts", participants: @participants%>
<section class="mt-5 pb-10 grid grid-cols-1 lg:grid-cols-3 gap-8 ">
  <div class="border border-slate-200 inline-block p-4 rounded-lg text-center flex-1">
    <div class="flex gap-3 items-center justify-center">
      <div class="bg-gray-100 rounded-lg p-2">
        <%= image_tag ("numbers.svg"), class: "w-[30px] h-[30px]"%>
      </div>
      <h3 class="text-gray-500 ">Jovenes por genero</h3>
    </div>
    <div class="flex flex-col justify-center items-center mt-8 gap-5">
      <div class="flex gap-5">
        <div class="bg-gray-100 rounded-lg p-2">
          <%= image_tag ("male.svg"), class: "w-[30px] h-[30px]"%>
        </div>
        <p class="font-bold text-3xl"><%= Participant.where(rol: "joven").count %></p>
      </div>
      <div class="flex gap-5">
        <div class="bg-gray-100 rounded-lg p-2">
          <%= image_tag ("female.svg"), class: "w-[30px] h-[30px]"%>
        </div>
        <p class="font-bold text-3xl"><%= Participant.where(rol: "joven").count %></p>
      </div>
    </div>
  </div>
  <%= render "shirt_table", shirt_counts: @shirt_counts %>
  <div class=" border border-slate-200 p-4 rounded-lg shadow-sm flex-1">
    <h3 class="font-bold text-center">Jovenes por edad</h3>
    <%= bar_chart @participants.group(:age).count,
      colors: ["#095581", "#92C47B", "#FCB446", "#C8E7E9", "#268BB5"],
      height: "180px"
    %>
  </div>
</section>
