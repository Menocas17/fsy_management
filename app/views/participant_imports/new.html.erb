<% content_for :title, "Carga de participantes" %>
<% content_for :eyebrow, "Reportes" %>
<% back_to "Reportes", reports_path %>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-5xl mx-auto space-y-5">
  <% if @import && !@import.fatal %>
    <section class="<%= card_classes("p-5 md:p-6") %>" data-import-result>
      <%= section_heading "Resultado de la carga", "clipboard-check" %>
      <div class="grid grid-cols-2 gap-3 mb-5">
        <div class="rounded-tile border border-cat-green/25 bg-cat-green/10 px-4 py-3">
          <p class="text-[26px] font-extrabold leading-none text-cat-green-ink tabular-nums" data-import="imported"><%= @import.imported_count %></p>
          <p class="mt-1 text-[12px] font-bold text-cat-green-ink">creados</p>
        </div>
        <div class="rounded-tile border border-line px-4 py-3">
          <p class="text-[26px] font-extrabold leading-none text-ink-700 tabular-nums" data-import="skipped"><%= @import.skipped_count %></p>
          <p class="mt-1 text-[12px] font-bold text-ink-500">omitidos</p>
        </div>
      </div>

      <% if @import.skipped.any? %>
        <p class="mb-2 text-[12px] font-bold text-ink-700">Filas que no entraron</p>
        <ul class="divide-y divide-line-soft border border-line-soft rounded-tile overflow-hidden">
          <% @import.skipped.each do |row| %>
            <li class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 px-4 py-2.5 text-[13px]">
              <span class="font-bold text-ink-900 tabular-nums">Fila <%= row.number %></span>
              <span class="font-semibold text-ink-700"><%= row.name %></span>
              <span class="text-ink-500">· <%= row.reason %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if @import.warnings.any? %>
        <p class="mt-5 mb-2 text-[12px] font-bold text-cat-amber-ink">Entraron, pero conviene revisarlas</p>
        <ul class="divide-y divide-line-soft border border-cat-amber/30 rounded-tile overflow-hidden" data-import-warnings>
          <% @import.warnings.each do |row| %>
            <li class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 px-4 py-2.5 text-[13px]">
              <span class="font-bold text-ink-900 tabular-nums">Fila <%= row.number %></span>
              <span class="font-semibold text-ink-700"><%= row.name %></span>
              <span class="text-ink-500">· <%= row.reason %></span>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if @import.imported_count.positive? %>
        <%= link_to participants_path, class: button_classes(:primary, extra: "mt-5") do %>
          <%= icon "users", class: "w-4 h-4" %>
          Ver los jóvenes
        <% end %>
      <% end %>
    </section>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] gap-5 items-start">
    <section class="<%= card_classes("p-5 md:p-6") %>">
      <%= section_heading "Subir archivo", "upload" %>
      <%= form_with url: participant_import_path, multipart: true, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :file, "Archivo de Excel (.xlsx) o .csv", class: field_label_classes %>
          <%= form.file_field :file, accept: ".xlsx,.xls,.csv", required: true,
                class: "w-full text-[13px] text-ink-700 file:mr-3 file:h-10 file:px-4 file:rounded-control file:border-0 file:bg-primary-50 dark:file:bg-primary-700/30 file:text-[13px] file:font-semibold file:text-primary-700 dark:file:text-primary-100 file:cursor-pointer" %>
          <p class="mt-1.5 text-[11.5px] font-medium text-ink-500">
            La primera fila tiene que ser la de los títulos de columna.
          </p>
        </div>
        <%= tag.button type: "submit", data: { turbo_submits_with: "Cargando participantes…" }, class: button_classes do %>
          <%= icon "upload", class: "w-4 h-4" %>
          Cargar participantes
        <% end %>
      <% end %>
    </section>

    <section class="<%= card_classes("p-5 md:p-6") %>">
      <%= section_heading "Columnas que reconoce", "table" %>
      <p class="-mt-2 mb-4 text-[12.5px] leading-relaxed text-ink-500">
        No importan mayúsculas, acentos ni el orden. Las columnas que no aparezcan aquí se ignoran, y lo que falte
        se puede completar después desde la ficha.
      </p>
      <div class="flex flex-wrap gap-1.5">
        <% %w[Nombre Apellido Edad Género Estaca Barrio Camisa Rol Cédula Cuarto Compañía Teléfono Correo
              Contacto\ de\ emergencia Teléfono\ de\ emergencia Parentesco Alergias Medicinas Dieta Notas].each do |column| %>
          <span class="px-2.5 py-1 rounded-lg bg-canvas dark:bg-slate-900/60 border border-line-soft text-[11.5px] font-semibold text-ink-700"><%= column %></span>
        <% end %>
      </div>
      <ul class="mt-4 space-y-1.5 text-[12.5px] leading-relaxed text-ink-500 list-disc list-inside">
        <li>Sin <strong>Rol</strong>, la fila entra como joven.</li>
        <li><strong>Compañía</strong> se busca por número; si no existe, la ficha queda sin compañía.</li>
        <li>Se omiten las filas repetidas: manda la cédula y, si no viene, el nombre completo.</li>
      </ul>
    </section>
  </div>
</div>
