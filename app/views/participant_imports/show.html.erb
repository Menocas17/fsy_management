<% content_for :title, "Carga · #{@import.filename}" %>
<% content_for :eyebrow, "Carga de participantes" %>
<% back_to "Cargas", new_participant_import_path %>
<%
  tab_base = "inline-flex items-center gap-1.5 h-9 px-3.5 rounded-lg text-[12.5px] whitespace-nowrap transition"
  tabs = [ [ "Por resolver", "pendientes", @import.pending_count ], [ "Entraron", "entraron", @import.entered_count ],
           [ "Descartadas", "descartadas", @import.count_of(:discarded) ] ]
%>
<div class="px-4 md:px-8 pt-6 md:pt-8 pb-10 max-w-5xl mx-auto space-y-5">
  <section class="<%= card_classes("p-5 md:p-6") %>" data-import-summary>
    <p class="text-[12.5px] font-semibold text-ink-500">
      <%= @import.filename %> · <%= SpanishDates.short_with_time(@import.created_at) %> · subida por <%= @import.uploaded_by_name %>
    </p>
    <div class="mt-3 grid grid-cols-3 gap-3">
      <% [ [ "entraron", @import.entered_count, "border-cat-green/25 bg-cat-green/10 text-cat-green-ink" ],
           [ "por resolver", @import.pending_count, "border-cat-amber/30 bg-cat-amber/10 text-cat-amber-ink" ],
           [ "descartadas", @import.count_of(:discarded), "border-line text-ink-500" ] ].each do |label, value, tone| %>
        <div class="rounded-tile border px-4 py-3 <%= tone %>">
          <p class="text-[26px] font-extrabold leading-none tabular-nums" data-import-count="<%= label.parameterize %>"><%= value %></p>
          <p class="mt-1 text-[12px] font-bold"><%= label %></p>
        </div>
      <% end %>
    </div>
    <% if @import.pending_count.positive? %>
      <p class="mt-4 text-[13px] font-semibold text-cat-amber-ink" role="status">
        Las filas por resolver <strong>no están en la base</strong>. Compáralas con la ficha con la que chocan, corrígelas y apruébalas, o descártalas.
        Este informe queda guardado: puedes salir y volver cuando quieras.
      </p>
    <% end %>
  </section>

  <nav class="flex gap-0.5 p-1 rounded-control bg-canvas border border-line overflow-x-auto w-fit max-w-full" aria-label="Vista del informe">
    <% tabs.each do |label, key, count| %>
      <% current = @tab == key %>
      <%= link_to participant_import_path(@import, vista: key), aria: { current: (current ? "page" : nil) },
            class: "#{tab_base} #{current ? "bg-surface shadow-sm font-bold text-ink-900" : "font-semibold text-ink-500 hover:text-ink-900"}" do %>
        <%= label %> <span class="tabular-nums text-ink-500">(<%= count %>)</span>
      <% end %>
    <% end %>
  </nav>

  <% if @rows.empty? %>
    <p class="<%= card_classes("p-6 text-[13px] text-ink-500") %>">
      <%= { "pendientes" => "No queda nada por resolver.", "entraron" => "Nadie entró todavía.", "descartadas" => "No se descartó ninguna fila." }[@tab] %>
    </p>
  <% elsif @tab == "pendientes" %>
    <div class="space-y-3" data-pending-rows>
      <% @rows.each do |row| %>
        <%= render "participant_import_rows/pending_row", import: @import, row: row %>
      <% end %>
    </div>
  <% else %>
    <section class="<%= card_classes("p-5 md:p-6") %>">
      <ul class="divide-y divide-line-soft" data-rows="<%= @tab %>">
        <% @rows.each do |row| %>
          <li class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5 py-2.5 text-[13px]" id="fila-<%= row.row_number %>">
            <span class="font-bold text-ink-900 tabular-nums">Fila <%= row.row_number %></span>
            <% if row.participant %>
              <%= link_to row.participant.full_name, participant_path(row.participant), class: "font-semibold text-primary-700 dark:text-primary-300 hover:underline" %>
            <% else %>
              <span class="font-semibold text-ink-700"><%= row.name %></span>
            <% end %>
            <span class="text-ink-500">· <%= row.imported? ? "entró directo" : "#{row.status_label.downcase} por #{row.resolved_by_name}" %></span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
