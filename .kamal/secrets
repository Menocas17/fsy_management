# Los secretos de config/deploy.yml. Este archivo sí va en git: aquí no se escribe ningún valor, solo de
# dónde sale cada uno. En GitHub Actions salen de los secrets del repositorio (.github/workflows/ci.yml); para
# desplegar desde tu máquina, expórtalos antes en la terminal (docs/deploy_vps.md).

# Token para subir y bajar la imagen de ghcr.io. En Actions es el GITHUB_TOKEN del propio workflow.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# El contenido de config/master.key.
RAILS_MASTER_KEY=$RAILS_MASTER_KEY

# Contraseña del usuario fsy_management de Postgres: solo letras y números (openssl rand -hex 32), porque
# también va dentro de DATABASE_URL.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
DATABASE_URL=postgres://fsy_management:$POSTGRES_PASSWORD@fsy_management-db:5432/fsy_management_production

# Cloudflare R2, el mismo bucket de fotos de siempre (config/storage.yml).
R2_ACCOUNT_ID=$R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=$R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=$R2_SECRET_ACCESS_KEY
R2_PUBLIC_URL=$R2_PUBLIC_URL

# Correo por el Apps Script de Gmail (config/apps_script_mail.rb). DigitalOcean también bloquea SMTP.
MAIL_RELAY_URL=$MAIL_RELAY_URL
MAIL_RELAY_SECRET=$MAIL_RELAY_SECRET
